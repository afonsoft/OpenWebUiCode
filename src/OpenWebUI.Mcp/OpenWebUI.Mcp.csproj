<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OpenWebUI.Mcp — servidor MCP (Model Context Protocol) stdio que expõe
    o produto como ferramenta para agentes externos (SPEC-20261022
    capability B). Análogo ao Taskboard.Mcp do agent-harness: processo
    filho do cliente MCP falando HTTP com o OpenWebUI.Api.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>openwebui-mcp</AssemblyName>
    <RootNamespace>OpenWebUI.Mcp</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- stdout é protocolo — nada de logging nele -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
