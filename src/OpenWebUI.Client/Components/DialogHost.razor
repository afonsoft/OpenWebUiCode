@implements IDisposable
@inject DialogService Dialogs
@inject LocalizationService L
@inject IJSRuntime JS

@* Host dos diálogos modais in-app (confirm/prompt) — substitui window.confirm
   e window.prompt nativos por um dialog acessível: role=dialog, focus trap,
   Escape cancela, backdrop clica fora cancela. *@

@if (Dialogs.Current is { } req)
{
    <div class="modal-backdrop" @onclick="Cancel">
        <div class="modal max-w-md" role="dialog" aria-modal="true"
             aria-label="@L["common.confirm"]" tabindex="-1"
             @ref="_dialog" @onkeydown="OnKeyDown" @onclick:stopPropagation>
            <div class="modal-body">
                <p class="text-sm whitespace-pre-wrap text-gray-700 dark:text-gray-300">@req.Message</p>
                @if (req.Kind == DialogKind.Prompt)
                {
                    <input class="input mt-3 w-full" aria-label="@req.Message" @bind="_input" @bind:event="oninput" @onkeydown="OnInputKeyDown" />
                }
                <div class="mt-5 flex justify-end gap-2">
                    <button type="button"
                            class="rounded-full px-4 py-1.5 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition cursor-pointer"
                            @onclick="Cancel">
                        @L["common.cancel"]
                    </button>
                    <button type="button"
                            class="rounded-full px-4 py-1.5 text-sm font-medium transition cursor-pointer
                                   @(req.Danger
                                       ? "bg-red-600 text-white hover:bg-red-700"
                                       : "bg-gray-900 text-white hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200")"
                            @onclick="Accept">
                        @(req.Danger ? L["common.delete"] : L["common.ok"])
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ElementReference _dialog;
    private string _input = "";
    private DialogRequest? _rendered;

    protected override void OnInitialized()
    {
        Dialogs.Changed += OnDialogsChanged;
    }

    private void OnDialogsChanged()
    {
        // Reinicia o campo de texto a cada novo pedido de prompt.
        _input = Dialogs.Current?.DefaultValue ?? "";
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Dialogs.Current is { } req && !ReferenceEquals(req, _rendered))
        {
            _rendered = req;
            await JS.InvokeVoidAsync("openwebui.trapFocus", _dialog);
        }
        else if (Dialogs.Current is null && _rendered is not null)
        {
            _rendered = null;
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Cancel();
        }
    }

    private void OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            Accept();
        }
    }

    private void Cancel()
    {
        Dialogs.Resolve(Dialogs.Current?.Kind is DialogKind.Prompt ? null : false);
    }

    private void Accept()
    {
        Dialogs.Resolve(Dialogs.Current?.Kind == DialogKind.Prompt ? _input : true);
    }

    public void Dispose()
    {
        Dialogs.Changed -= OnDialogsChanged;
    }
}
