@inject ApiService Api
@inject BrowserStorage Storage
@inject LocalizationService L
@inject IJSRuntime JS

<div class="relative">
    @if (_models is null)
    {
        <span class="text-sm text-gray-400 dark:text-gray-500">@L["models.loading"]</span>
    }
    else if (_models.Count == 0)
    {
        <span class="text-sm text-gray-400 dark:text-gray-500">@L["models.none"]</span>
    }
    else
    {
        <button class="flex items-center gap-1.5 rounded-xl px-2 py-1 text-[0.9375rem] font-normal text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-850 transition cursor-pointer"
                aria-haspopup="listbox" aria-expanded="@_open" @ref="_trigger"
                @onclick="ToggleOpen">
            @if (IsFusion)
            {
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5 shrink-0 text-blue-500" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" /></svg>
            }
            <span class="truncate max-w-[16rem]">@(SelectedName)</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5 text-gray-400"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
        </button>

        @if (_open)
        {
            <div class="fixed inset-0 z-40" @onclick="() => _open = false"></div>
            <div class="absolute left-0 top-full mt-1 z-50 w-64 max-h-80 overflow-y-auto scrollbar-hidden rounded-2xl bg-white dark:bg-gray-850 border border-gray-100 dark:border-gray-800 shadow-lg py-1"
                 role="listbox" aria-label="@L["models.select"]" @ref="_menu" @onkeydown="OnMenuKeyDown">
                @* SPEC-20261106 adaptive-fusion: primeiro item fixo — par
                   Leader (raciocínio/plano) + Sidekick (execução) escolhidos
                   dentre os modelos do catálogo do chat. *@
                <div class="px-3 pt-2 pb-1 text-[0.6875rem] uppercase tracking-wide text-gray-400 dark:text-gray-500">@L["models.adaptive"]</div>
                <button class="w-full flex items-center justify-between px-3 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900 cursor-pointer"
                        role="option" aria-selected="@IsFusion"
                        title="@L["models.fusion_hint"]"
                        @onclick="SelectFusionAsync">
                    <span class="flex items-center gap-1.5 truncate">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5 shrink-0 text-blue-500" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456Z" /></svg>
                        <span class="truncate">@L["models.fusion"]</span>
                    </span>
                    @if (IsFusion)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                    }
                </button>

                @* SPEC-20261110 adaptive-model-pool: segundo membro da
                   família Adaptive — pool ordenado de até 4 modelos com
                   fallback + sticky entre runs. *@
                <button class="w-full flex items-center justify-between px-3 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900 cursor-pointer"
                        role="option" aria-selected="@IsAdaptive"
                        title="@L["models.adaptive_pool_hint"]"
                        @onclick="SelectAdaptiveAsync">
                    <span class="flex items-center gap-1.5 truncate">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5 shrink-0 text-emerald-500" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                        <span class="truncate">@L["models.adaptive_pool"]</span>
                    </span>
                    @if (IsAdaptive)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                    }
                </button>

                @if (IsAdaptive)
                {
                    <div class="mx-2 mb-1 rounded-xl border border-gray-100 dark:border-gray-800 bg-gray-50/60 dark:bg-gray-900/40 px-2.5 py-2 flex flex-col gap-2"
                         @onkeydown:stopPropagation="true">
                        @for (var i = 0; i < 4; i++)
                        {
                            var slot = i;
                            <label class="flex flex-col gap-1">
                                <span class="text-[0.6875rem] font-medium text-gray-500 dark:text-gray-400">
                                    @string.Format(L["models.adaptive_slot"], slot + 1)
                                    @if (slot > 1)
                                    {
                                        <span class="font-normal text-gray-400 dark:text-gray-500">— @L["models.fusion_fallback_hint"]</span>
                                    }
                                </span>
                                <select class="w-full rounded-lg border border-gray-200 dark:border-gray-750 bg-white dark:bg-gray-850 px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 cursor-pointer"
                                        aria-label="@string.Format(L["models.adaptive_slot"], slot + 1)"
                                        value="@_adaptive[slot]" @onchange="e => OnAdaptiveChanged(slot, e)">
                                    @if (slot > 1)
                                    {
                                        <option value="">@L["models.fusion_none"]</option>
                                    }
                                    @foreach (var m in _models)
                                    {
                                        <option value="@m.Id" selected="@(m.Id == _adaptive[slot])">@m.Name</option>
                                    }
                                </select>
                            </label>
                        }
                    </div>
                }

                @if (IsFusion)
                {
                    <div class="mx-2 mb-1 rounded-xl border border-gray-100 dark:border-gray-800 bg-gray-50/60 dark:bg-gray-900/40 px-2.5 py-2 flex flex-col gap-2"
                         @onkeydown:stopPropagation="true">
                        <label class="flex flex-col gap-1">
                            <span class="text-[0.6875rem] font-medium text-gray-500 dark:text-gray-400">
                                @L["models.fusion_leader"]
                                <span class="font-normal text-gray-400 dark:text-gray-500">— @L["models.fusion_leader_hint"]</span>
                            </span>
                            <select class="w-full rounded-lg border border-gray-200 dark:border-gray-750 bg-white dark:bg-gray-850 px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 cursor-pointer"
                                    aria-label="@L["models.fusion_leader"]"
                                    value="@_leader" @onchange="OnLeaderChanged">
                                @foreach (var m in _models)
                                {
                                    <option value="@m.Id" selected="@(m.Id == _leader)">@m.Name</option>
                                }
                            </select>
                        </label>
                        <label class="flex flex-col gap-1">
                            <span class="text-[0.6875rem] font-medium text-gray-500 dark:text-gray-400">
                                @L["models.fusion_leader2"]
                                <span class="font-normal text-gray-400 dark:text-gray-500">— @L["models.fusion_fallback_hint"]</span>
                            </span>
                            <select class="w-full rounded-lg border border-gray-200 dark:border-gray-750 bg-white dark:bg-gray-850 px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 cursor-pointer"
                                    aria-label="@L["models.fusion_leader2"]"
                                    value="@_leader2" @onchange="OnLeader2Changed">
                                <option value="">@L["models.fusion_none"]</option>
                                @foreach (var m in _models)
                                {
                                    <option value="@m.Id" selected="@(m.Id == _leader2)">@m.Name</option>
                                }
                            </select>
                        </label>
                        <label class="flex flex-col gap-1">
                            <span class="text-[0.6875rem] font-medium text-gray-500 dark:text-gray-400">
                                @L["models.fusion_sidekick"]
                                <span class="font-normal text-gray-400 dark:text-gray-500">— @L["models.fusion_sidekick_hint"]</span>
                            </span>
                            <select class="w-full rounded-lg border border-gray-200 dark:border-gray-750 bg-white dark:bg-gray-850 px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 cursor-pointer"
                                    aria-label="@L["models.fusion_sidekick"]"
                                    value="@_sidekick" @onchange="OnSidekickChanged">
                                @foreach (var m in _models)
                                {
                                    <option value="@m.Id" selected="@(m.Id == _sidekick)">@m.Name</option>
                                }
                            </select>
                        </label>
                        <label class="flex flex-col gap-1">
                            <span class="text-[0.6875rem] font-medium text-gray-500 dark:text-gray-400">
                                @L["models.fusion_sidekick2"]
                                <span class="font-normal text-gray-400 dark:text-gray-500">— @L["models.fusion_fallback_hint"]</span>
                            </span>
                            <select class="w-full rounded-lg border border-gray-200 dark:border-gray-750 bg-white dark:bg-gray-850 px-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 cursor-pointer"
                                    aria-label="@L["models.fusion_sidekick2"]"
                                    value="@_sidekick2" @onchange="OnSidekick2Changed">
                                <option value="">@L["models.fusion_none"]</option>
                                @foreach (var m in _models)
                                {
                                    <option value="@m.Id" selected="@(m.Id == _sidekick2)">@m.Name</option>
                                }
                            </select>
                        </label>
                    </div>
                }

                @foreach (var group in _models.GroupBy(m => m.Provider))
                {
                    <div class="px-3 pt-2 pb-1 text-[0.6875rem] uppercase tracking-wide text-gray-400 dark:text-gray-500">@ProviderLabel(group.Key)</div>
                    @foreach (var model in group)
                    {
                        <button class="w-full flex items-center justify-between px-3 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900 cursor-pointer"
                                role="option" aria-selected="@(model.Id == Value)"
                                @onclick="() => SelectAsync(model.Id)">
                            <span class="truncate">@model.Name</span>
                            @if (model.Id == Value)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" /></svg>
                            }
                        </button>
                    }
                }
            </div>
        }
    }
</div>

@code {
    /// <summary>Modelo atualmente selecionado.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Disparado quando o modelo selecionado muda.</summary>
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    private const string ModelKey = "webui.model";
    private const string FusionLeaderKey = "webui.fusion.leader";
    private const string FusionLeader2Key = "webui.fusion.leader2";
    private const string FusionSidekickKey = "webui.fusion.sidekick";
    private const string FusionSidekick2Key = "webui.fusion.sidekick2";
    private const string AdaptiveSlotKey = "webui.adaptive.{0}";
    private const int AdaptiveSlots = 4;
    private List<ModelInfo>? _models;
    private bool _open;
    private bool _focusMenu;
    private string? _leader;
    private string? _leader2;
    private string? _sidekick;
    private string? _sidekick2;
    private readonly string?[] _adaptive = new string?[AdaptiveSlots];
    private ElementReference _trigger;
    private ElementReference _menu;

    /// <summary>Seleção atual é o par Adaptive/Fusion (SPEC-20261106).</summary>
    private bool IsFusion => FusionModelRef.IsFusion(Value);

    /// <summary>Seleção atual é o pool Adaptive (SPEC-20261110).</summary>
    private bool IsAdaptive => AdaptiveModelRef.IsAdaptive(Value);

    private string SelectedName =>
        IsFusion ? L["models.fusion"]
        : IsAdaptive ? L["models.adaptive_pool"]
        : _models?.FirstOrDefault(m => m.Id == Value)?.Name ?? L["models.select"];

    protected override async Task OnInitializedAsync() => await LoadModelsAsync();

    /// <summary>Chat restaurado com ref fusion: os selects espelham o par
    /// do <see cref="Value"/> (chat.ModelsJson persiste a ref composta).</summary>
    protected override void OnParametersSet()
    {
        if (FusionModelRef.TryParseChain(Value, out var ls, out var ss))
        {
            _leader = ls[0];
            _leader2 = ls.Count > 1 ? ls[1] : null;
            _sidekick = ss[0];
            _sidekick2 = ss.Count > 1 ? ss[1] : null;
        }
        else if (AdaptiveModelRef.TryParse(Value, out var pool))
        {
            for (var i = 0; i < AdaptiveSlots; i++)
            {
                _adaptive[i] = i < pool.Count ? pool[i] : null;
            }
        }
    }

    /// <summary>Busca a lista de modelos — offline vira lista vazia com
    /// retry ao reabrir o menu (nunca propaga pra error UI).</summary>
    private async Task LoadModelsAsync()
    {
        try
        {
            _models = await Api.GetModelsAsync();
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            _models = [];
            await Console.Error.WriteLineAsync($"[ModelSelector] carga falhou: {ex.Message}");
            return;
        }
        catch (Exception ex)
        {
            // _ = LoadModelsAsync() é fire-and-forget: escape = banner.
            _models = [];
            await Console.Error.WriteLineAsync($"[ModelSelector] carga falhou: {ex.Message}");
            return;
        }

        // O Value do pai é autoridade: o ChatView restaura
        // chat.Models[0] nele ao abrir o chat. O default do storage/
        // catálogo só decide quando Value está vazio (chat novo) —
        // sobrescrever aqui era o bug que voltava o seletor pro
        // primeiro modelo ao trocar de chat e retornar.
        if (!string.IsNullOrEmpty(Value))
        {
            if (FusionModelRef.TryParseChain(Value, out var curLs, out var curSs))
            {
                _leader = curLs[0];
                _leader2 = curLs.Count > 1 ? curLs[1] : null;
                _sidekick = curSs[0];
                _sidekick2 = curSs.Count > 1 ? curSs[1] : null;
            }
            else if (AdaptiveModelRef.TryParse(Value, out var curPool))
            {
                for (var i = 0; i < AdaptiveSlots; i++)
                {
                    _adaptive[i] = i < curPool.Count ? curPool[i] : null;
                }
            }
            return;
        }

        string? saved;
        try
        {
            saved = await Storage.GetAsync(ModelKey);
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex) || ex is InvalidOperationException)
        {
            saved = null;
        }

        if (FusionModelRef.TryParseChain(saved, out var savedLs, out var savedSs)
            && HasModel(savedLs[0]) && HasModel(savedSs[0]))
        {
            _leader = savedLs[0];
            _leader2 = savedLs.Count > 1 && HasModel(savedLs[1]) ? savedLs[1] : null;
            _sidekick = savedSs[0];
            _sidekick2 = savedSs.Count > 1 && HasModel(savedSs[1]) ? savedSs[1] : null;
            var restored = CurrentFusionValue();
            if (restored != Value)
            {
                Value = restored;
                await ValueChanged.InvokeAsync(restored);
            }
            return;
        }

        if (AdaptiveModelRef.TryParse(saved, out var savedPool)
            && savedPool.All(HasModel))
        {
            for (var i = 0; i < AdaptiveSlots; i++)
            {
                _adaptive[i] = i < savedPool.Count ? savedPool[i] : null;
            }
            var restoredPool = CurrentAdaptiveValue();
            if (restoredPool != Value)
            {
                Value = restoredPool;
                await ValueChanged.InvokeAsync(restoredPool);
            }
            return;
        }

        var selected = _models.Any(m => m.Id == saved)
            ? saved
            : _models.FirstOrDefault()?.Id;

        if (selected != Value)
        {
            Value = selected;
            await ValueChanged.InvokeAsync(selected);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusMenu)
        {
            _focusMenu = false;
            await JS.InvokeVoidAsync("openwebui.focusFirst", _menu);
        }
    }

    private void ToggleOpen()
    {
        _open = !_open;
        if (_open)
        {
            _focusMenu = true;
            // Refresh a cada abertura: /api/models é cacheado server-side e o
            // picker fica consistente após mexer em conexões (sem reload).
            _ = LoadModelsAsync();
        }
    }

    private async Task OnMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _open = false;
            await _trigger.FocusAsync();
        }
        else if (e.Key is "ArrowDown" or "ArrowUp" or "Home" or "End")
        {
            await JS.InvokeVoidAsync("openwebui.menuNav", _menu, e.Key);
        }
    }

    private bool HasModel(string? id) =>
        id is not null && _models?.Any(m => m.Id == id) == true;

    /// <summary>Seleciona o modo fusion: o menu fica aberto com os selects
    /// Leader/Sidekick — defaults = par salvo ou primeiro modelo do catálogo.</summary>
    private async Task SelectFusionAsync()
    {
        _leader = HasModel(_leader) ? _leader
            : (await Storage.GetAsync(FusionLeaderKey)) is { } stored && HasModel(stored)
            ? stored : _models!.First().Id;
        _leader2 = HasModel(_leader2) ? _leader2
            : (await Storage.GetAsync(FusionLeader2Key)) is { } storedL2 && HasModel(storedL2)
            ? storedL2 : null;
        _sidekick = HasModel(_sidekick) ? _sidekick
            : (await Storage.GetAsync(FusionSidekickKey)) is { } storedSk && HasModel(storedSk)
            ? storedSk : _models!.First().Id;
        _sidekick2 = HasModel(_sidekick2) ? _sidekick2
            : (await Storage.GetAsync(FusionSidekick2Key)) is { } storedSk2 && HasModel(storedSk2)
            ? storedSk2 : null;
        await ApplyFusionValueAsync();
        await _trigger.FocusAsync();
    }

    /// <summary>Seleciona o pool adaptive: menu fica aberto com os 4
    /// selects — slots 1-2 obrigatórios (defaults = salvos ou os dois
    /// primeiros do catálogo), 3-4 opcionais.</summary>
    private async Task SelectAdaptiveAsync()
    {
        for (var i = 0; i < AdaptiveSlots; i++)
        {
            var stored = await Storage.GetAsync(string.Format(AdaptiveSlotKey, i));
            _adaptive[i] = HasModel(_adaptive[i]) ? _adaptive[i]
                : HasModel(stored) ? stored
                : i < 2 && i < _models!.Count ? _models![i].Id
                : i < 2 ? _models!.First().Id
                : null;
        }
        await ApplyAdaptiveValueAsync();
        await _trigger.FocusAsync();
    }

    private async Task OnAdaptiveChanged(int slot, ChangeEventArgs e)
    {
        _adaptive[slot] = e.Value?.ToString() is { Length: > 0 } v ? v : null;
        await ApplyAdaptiveValueAsync();
    }

    /// <summary>Ref adaptive atual — slots 1-2 obrigatórios, vazios do
    /// meio são saltados mantendo a ordem; duplicados removidos.</summary>
    private string? CurrentAdaptiveValue()
    {
        var pool = _adaptive.Where(m => m is not null)
            .Cast<string>()
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        return pool.Count >= AdaptiveModelRef.MinMembers
            ? AdaptiveModelRef.Format(pool)
            : null;
    }

    /// <summary>Grava os slots e publica <c>adaptive:{m1,…,m4}</c>.</summary>
    private async Task ApplyAdaptiveValueAsync()
    {
        if (CurrentAdaptiveValue() is not { } value)
        {
            return;
        }
        Value = value;
        await Storage.SetAsync(ModelKey, value);
        for (var i = 0; i < AdaptiveSlots; i++)
        {
            await Storage.SetAsync(
                string.Format(AdaptiveSlotKey, i), _adaptive[i] ?? "");
        }
        await ValueChanged.InvokeAsync(value);
    }

    private async Task OnLeaderChanged(ChangeEventArgs e)
    {
        _leader = e.Value?.ToString();
        await ApplyFusionValueAsync();
    }

    private async Task OnLeader2Changed(ChangeEventArgs e)
    {
        _leader2 = e.Value?.ToString() is { Length: > 0 } v ? v : null;
        await ApplyFusionValueAsync();
    }

    private async Task OnSidekickChanged(ChangeEventArgs e)
    {
        _sidekick = e.Value?.ToString();
        await ApplyFusionValueAsync();
    }

    private async Task OnSidekick2Changed(ChangeEventArgs e)
    {
        _sidekick2 = e.Value?.ToString() is { Length: > 0 } v ? v : null;
        await ApplyFusionValueAsync();
    }

    /// <summary>Ref fusion atual — segundo slot só emite quando preenchido
    /// e diferente do primeiro da mesma posição.</summary>
    private string? CurrentFusionValue()
    {
        if (_leader is null || _sidekick is null)
        {
            return null;
        }
        var leaders = _leader2 is not null
            && !_leader2.Equals(_leader, StringComparison.OrdinalIgnoreCase)
                ? new[] { _leader, _leader2 }
                : new[] { _leader };
        var sidekicks = _sidekick2 is not null
            && !_sidekick2.Equals(_sidekick, StringComparison.OrdinalIgnoreCase)
                ? new[] { _sidekick, _sidekick2 }
                : new[] { _sidekick };
        return FusionModelRef.Format(leaders, sidekicks);
    }

    /// <summary>Grava a cadeia e publica <c>fusion:{L1[,L2]}&gt;{S1[,S2]}</c>.</summary>
    private async Task ApplyFusionValueAsync()
    {
        if (CurrentFusionValue() is not { } value)
        {
            return;
        }
        Value = value;
        await Storage.SetAsync(ModelKey, value);
        await Storage.SetAsync(FusionLeaderKey, _leader!);
        await Storage.SetAsync(FusionLeader2Key, _leader2 ?? "");
        await Storage.SetAsync(FusionSidekickKey, _sidekick!);
        await Storage.SetAsync(FusionSidekick2Key, _sidekick2 ?? "");
        await ValueChanged.InvokeAsync(value);
    }

    private async Task SelectAsync(string value)
    {
        _open = false;
        Value = value;
        await Storage.SetAsync(ModelKey, value);
        await ValueChanged.InvokeAsync(value);
        await _trigger.FocusAsync();
    }

    /// <summary>Label amigável do provider (reuso: aba Models das settings).</summary>
    internal static string ProviderLabel(string provider) => provider switch
    {
        "ollama" => "Ollama",
        "openai" => "OpenAI",
        "anthropic" => "Anthropic",
        "google" => "Google AI Studio",
        _ => provider,
    };
}
