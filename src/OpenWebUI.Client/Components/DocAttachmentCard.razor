@* SPEC-20261128-chat-doc-attachments: card de documento no estilo do
   anexo do Devin web — miniatura com as primeiras linhas (degradê),
   nome/tipo/tamanho, ações copiar+download, clique abre DocViewerModal.
   Prévia lazy: ~4 KB via openwebui.media.readText; falha cai no chip
   "indisponível" como o AttachmentThumb. *@
@inject LocalizationService L
@inject IJSRuntime JS

@if (_failed)
{
    <span class="flex items-center gap-1.5 rounded-xl bg-gray-100 dark:bg-gray-850 px-2.5 py-1 text-xs text-gray-700 dark:text-gray-300"
          title="@L["chat.attachment_unavailable"]">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="m18.375 12.739-7.693 7.693a4.5 4.5 0 0 1-6.364-6.364l10.94-10.94A3 3 0 1 1 19.5 7.372L8.552 18.32m.009-.01-.01.01m5.699-9.941-7.81 7.81a1.5 1.5 0 0 0 2.112 2.13" /></svg>
        @Name — @L["chat.attachment_unavailable"]
    </span>
}
else
{
    <div class="flex items-stretch gap-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-850 p-2 max-w-xs cursor-pointer hover:border-gray-300 dark:hover:border-gray-600 transition-colors"
         role="button" tabindex="0"
         title="@L["chat.open_attachment"]"
         @onclick="OpenViewer"
         @onkeydown="OnKeyDownAsync">
        @* Miniatura: primeiras linhas do doc em 10px com degradê no rodapé *@
        <div class="relative flex-none w-20 h-16 rounded-lg bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 overflow-hidden" aria-hidden="true">
            @if (_preview is null)
            {
                <div class="absolute inset-0 animate-pulse bg-gray-100 dark:bg-gray-850"></div>
            }
            else
            {
                <pre class="p-1.5 text-[6px] leading-[1.5] text-gray-400 dark:text-gray-500 whitespace-pre-wrap break-words font-mono select-none">@_preview</pre>
            }
            <div class="absolute inset-x-0 bottom-0 h-5 bg-gradient-to-t from-gray-50 dark:from-gray-900 to-transparent"></div>
        </div>
        <div class="flex flex-col justify-center min-w-0 flex-1">
            <span class="truncate text-xs font-medium text-gray-800 dark:text-gray-100">@Name</span>
            <span class="text-[10px] uppercase tracking-wide text-gray-400 dark:text-gray-500">@KindLabel · @FormatSize(Size)</span>
            <span class="flex gap-1 mt-1">
                <button type="button"
                        class="size-6 flex items-center justify-center rounded-md text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:bg-gray-800 dark:hover:text-gray-300 cursor-pointer"
                        title="@L["chat.copy"]" aria-label="@L["chat.copy"]"
                        @onclick="CopyAsync" @onclick:stopPropagation="true">
                    @if (_copied)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5 text-green-600"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" /></svg>
                    }
                </button>
                <button type="button"
                        class="size-6 flex items-center justify-center rounded-md text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:bg-gray-800 dark:hover:text-gray-300 cursor-pointer"
                        title="@L["chat.doc_download"]" aria-label="@L["chat.doc_download"]"
                        @onclick="DownloadAsync" @onclick:stopPropagation="true">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                </button>
            </span>
        </div>
    </div>

    @if (_viewerOpen)
    {
        <DocViewerModal FileId="@FileId" Name="@Name" DocKind="@DocKind"
                        OnClose="() => _viewerOpen = false" />
    }
}

@code {
    /// <summary>Id do arquivo (FileEntry).</summary>
    [Parameter, EditorRequired] public string FileId { get; set; } = string.Empty;

    /// <summary>Nome original do arquivo.</summary>
    [Parameter] public string Name { get; set; } = string.Empty;

    /// <summary>Tamanho em bytes (linha de meta).</summary>
    [Parameter] public long Size { get; set; }

    /// <summary><c>markdown</c> | <c>text</c> — render do viewer.</summary>
    [Parameter] public string DocKind { get; set; } = "text";

    private string? _preview;
    private bool _failed;
    private bool _viewerOpen;
    private bool _copied;
    private string? _loadedFor;

    private string KindLabel => DocKind == "markdown" ? "MARKDOWN" : "TEXT";

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == FileId)
        {
            return;
        }
        _loadedFor = FileId;
        _preview = null;
        _failed = false;
        try
        {
            // ~4 KB bastam para a miniatura; falha → chip "indisponível".
            _preview = await JS.InvokeAsync<string?>(
                "openwebui.media.readText", FileId, 4096);
        }
        catch (JSException)
        {
            _preview = null;
        }
        _failed = _preview is null;
    }

    private void OpenViewer() => _viewerOpen = true;

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            OpenViewer();
        }
        await Task.CompletedTask;
    }

    private async Task CopyAsync()
    {
        var text = _preview;
        if (text is null || text.Length == 4096)
        {
            // Prévia truncada ou não carregada → busca o conteúdo inteiro.
            text = await JS.InvokeAsync<string?>(
                "openwebui.media.readText", FileId, 0);
        }
        if (text is not null)
        {
            await JS.InvokeVoidAsync("openwebui.copyText", text);
            _copied = true;
        }
    }

    private Task DownloadAsync() =>
        JS.InvokeVoidAsync("openwebui.media.download", FileId, Name).AsTask();

    private static string FormatSize(long bytes) =>
        bytes switch
        {
            > 1024 * 1024 => $"{bytes / 1024.0 / 1024.0:F1} MB",
            > 1024 => $"{bytes / 1024.0:F1} KB",
            _ => $"{bytes} B",
        };
}
