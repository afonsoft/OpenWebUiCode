    private string _tab = "general";

    private async Task SelectTab(string tab)
    {
        _tab = tab;
        if (tab == "github")
        {
            var gh = await Api.GetGitHubConfigAsync();
            _ghConfigured = gh?.Configured == true;
            _ghLogin = gh?.Login;
            _ghMessage = null;
        }
        if (tab == "models")
        {
            await LoadModelCatalogAsync();
        }
        if (tab == "tools")
        {
            await LoadToolApprovalsAsync();
        }
        if (tab == "notifications")
        {
            _notifyChatDone = await ChatNotify.GetPrefAsync(
                ChatNotificationsService.PrefInApp, defaultValue: true);
            _notifyBrowser = await ChatNotify.GetPrefAsync(
                ChatNotificationsService.PrefBrowser, defaultValue: false);
            _notifyPush = await ChatNotify.GetPrefAsync(
                ChatNotificationsService.PrefPush, defaultValue: false);
            _notifyPermission = await ChatNotify.BrowserPermissionAsync();
        }
    }

    private async Task OnNotifyChatDoneChanged(ChangeEventArgs e)
    {
        _notifyChatDone = e.Value is true;
        await ChatNotify.SetPrefAsync(ChatNotificationsService.PrefInApp, _notifyChatDone);
    }

    private async Task OnNotifyBrowserChanged(ChangeEventArgs e)
    {
        _notifyBrowser = e.Value is true;
        _notifyPermission = await ChatNotify.SetPrefAsync(
            ChatNotificationsService.PrefBrowser, _notifyBrowser);
        // Permissão negada no browser: o toggle não consegue notificar.
        if (_notifyPermission is "denied" or "unsupported")
        {
            _notifyBrowser = false;
            await ChatNotify.SetPrefAsync(ChatNotificationsService.PrefBrowser, false);
        }
    }

    private async Task OnNotifyPushChanged(ChangeEventArgs e)
    {
        _notifyPush = e.Value is true;
        _notifyPermission = await ChatNotify.SetPrefAsync(
            ChatNotificationsService.PrefPush, _notifyPush);
        if (_notifyPermission is "denied" or "unsupported")
        {
            _notifyPush = false;
            await ChatNotify.SetPrefAsync(ChatNotificationsService.PrefPush, false);
        }
    }
    private string _ghToken = string.Empty;
    private bool _ghConfigured;
    private string? _ghLogin;
    private bool _ghSaving;
    private string? _ghMessage;

    /// <summary>Valida e salva o PAT do GitHub (server-side, nunca retornado).</summary>
    private async Task SaveGitHubTokenAsync()
    {
        _ghSaving = true;
        _ghMessage = null;
        var result = await Api.SetGitHubTokenAsync(_ghToken.Trim());
        _ghSaving = false;
        if (result?.Configured != true)
        {
            _ghMessage = L["settings.github_save_error"];
            return;
        }

        _ghConfigured = true;
        _ghLogin = result.Login;
        _ghToken = string.Empty;
        _ghMessage = L.T("settings.github_connected", ("login", _ghLogin ?? ""));
    }

    private async Task RemoveGitHubTokenAsync()
    {
        _ghMessage = await Api.ClearGitHubTokenAsync()
            ? L["settings.github_removed"]
            : L["settings.github_save_error"];
        if (await Api.GetGitHubConfigAsync() is { } cfg)
        {
            _ghConfigured = cfg.Configured;
            _ghLogin = cfg.Login;
        }
        else
        {
            _ghConfigured = false;
            _ghLogin = null;
        }
    }

    // ── Models tab (visibilidade por usuário, SPEC model-visibility) ──
    private List<CatalogModel>? _modelCatalog;
