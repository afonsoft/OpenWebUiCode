    private void OnProviderTypeChanged(ProviderRow row)
    {
        var knownDefaults = ProviderTypes.All
            .Select(ProviderTypes.DefaultBaseUrl)
            .Where(u => u.Length > 0)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
