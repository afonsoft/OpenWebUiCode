    private void AddComboItem()
    {
        if (!string.IsNullOrWhiteSpace(_comboModelPick) && !_comboItems.Contains(_comboModelPick))
        {
            _comboItems.Add(_comboModelPick);
        }
        _comboModelPick = string.Empty;
    }

    private void EditCombo(ComboResponse combo)
    {
        _comboEditing = combo;
        _comboName = combo.Name;
        _comboStrategy = combo.Strategy;
        _comboItems = [.. combo.Items];
        _comboRpm = combo.RequestsPerMinute;
        _comboTpm = combo.TokensPerMinute;
    }

    private void ResetComboForm()
    {
        _comboEditing = null;
        _comboName = string.Empty;
        _comboStrategy = "priority";
        _comboItems = [];
        _comboRpm = null;
        _comboTpm = null;
        _comboModelPick = string.Empty;
    }

    private async Task SaveComboAsync()
    {
        _comboSaving = true;
        _combosMessage = null;
        var request = new ComboUpsertRequest(
            _comboName.Trim(),
            _comboStrategy,
            _comboItems.Select((m, i) => new ComboItemRequest(m, i)).ToList(),
            _comboRpm is > 0 ? _comboRpm : null,
            _comboTpm is > 0 ? _comboTpm : null,
            Enabled: true);
        var saved = _comboEditing is null
            ? await Api.CreateComboAsync(request)
            : await Api.UpdateComboAsync(_comboEditing.Id, request);
        _combosMessage = saved is null ? L["settings.save_failed"] : L["settings.saved"];
        if (saved is not null)
        {
            ResetComboForm();
            _combos = await Api.GetCombosAsync();
        }
        _comboSaving = false;
    }

    private async Task ToggleComboAsync(ComboResponse combo)
    {
        _comboSaving = true;
        var request = new ComboUpsertRequest(
            combo.Name,
            combo.Strategy,
            combo.Items.Select((m, i) => new ComboItemRequest(m, i)).ToList(),
            combo.RequestsPerMinute,
            combo.TokensPerMinute,
            Enabled: !combo.Enabled);
        if (await Api.UpdateComboAsync(combo.Id, request) is null)
        {
            _combosMessage = L["settings.save_failed"];
        }
        _combos = await Api.GetCombosAsync();
        _comboSaving = false;
    }

