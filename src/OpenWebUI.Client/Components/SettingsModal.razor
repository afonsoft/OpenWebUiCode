@inject ApiService Api
@inject AuthService Auth
@inject ThemeService Theme
@inject LocalizationService L
@inject IJSRuntime JS
@inject ChatNotificationsService ChatNotify

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal" role="dialog" aria-modal="true" aria-label="@L["settings.title"]"
             tabindex="-1" @ref="_modalElement" @onkeydown="OnKeyDown" @onclick:stopPropagation>
            <div class="modal-header">
                <span>@L["settings.title"]</span>
                <button class="icon-btn" aria-label="@L["common.close"]" @onclick="Close">×</button>
            </div>

            <div class="modal-shell">
                <div class="modal-tabs" role="tablist" @ref="_tabList" @onkeydown="OnTabKeyDown">
                    <button class="modal-tab @(_tab == "general" ? "active" : "")" role="tab" aria-selected="@(_tab == "general")" @onclick='() => _tab = "general"'>@L["settings.general"]</button>
                    <button class="modal-tab @(_tab == "account" ? "active" : "")" role="tab" aria-selected="@(_tab == "account")" @onclick='() => _tab = "account"'>@L["settings.account"]</button>
                    <button class="modal-tab @(_tab == "memories" ? "active" : "")" role="tab" aria-selected="@(_tab == "memories")" @onclick='() => _tab = "memories"'>@L["settings.memories"]</button>
                    <button class="modal-tab @(_tab == "notifications" ? "active" : "")" role="tab" aria-selected="@(_tab == "notifications")" @onclick='() => SelectTab("notifications")'>@L["settings.notifications"]</button>
                    <button class="modal-tab @(_tab == "integrations" ? "active" : "")" role="tab" aria-selected="@(_tab == "integrations")" @onclick='() => SelectTab("integrations")'>@L["settings.integrations"]</button>
                    <button class="modal-tab @(_tab == "models" ? "active" : "")" role="tab" aria-selected="@(_tab == "models")" @onclick='() => SelectTab("models")'>@L["settings.models"]</button>
                    <button class="modal-tab @(_tab == "combos" ? "active" : "")" role="tab" aria-selected="@(_tab == "combos")" @onclick='() => SelectTab("combos")'>@L["settings.combos"]</button>
                    <button class="modal-tab @(_tab == "tools" ? "active" : "")" role="tab" aria-selected="@(_tab == "tools")" @onclick='() => SelectTab("tools")'>@L["settings.tools"]</button>
                    <button class="modal-tab @(_tab == "agents" ? "active" : "")" role="tab" aria-selected="@(_tab == "agents")" @onclick='() => SelectTab("agents")'>@L["settings.agents"]</button>
                    @if (Auth.CurrentUser?.Role == "admin")
                    {
                        <button class="modal-tab @(_tab == "connections" ? "active" : "")" role="tab" aria-selected="@(_tab == "connections")" @onclick='() => _tab = "connections"'>@L["settings.connections"]</button>
                        <button class="modal-tab @(_tab == "admin" ? "active" : "")" role="tab" aria-selected="@(_tab == "admin")" @onclick='() => SelectTab("admin")'>@L["settings.admin"]</button>
                        <button class="modal-tab @(_tab == "maintenance" ? "active" : "")" role="tab" aria-selected="@(_tab == "maintenance")" @onclick='() => SelectTab("maintenance")'>@L["settings.maintenance"]</button>
                    }
                    <button class="modal-tab @(_tab == "about" ? "active" : "")" role="tab" aria-selected="@(_tab == "about")" @onclick='() => _tab = "about"'>@L["settings.about"]</button>
                </div>

                <div class="modal-body" role="tabpanel">
                @if (_tab == "general")
                {
                    <SettingsSection Title="@L["settings.sec_appearance"]">
                        <div class="field">
                            <label for="fld-1">@L["settings.theme"]</label>
                            <select class="input" value="@Theme.Current" @onchange="OnThemeChanged" id="fld-1">
                                <option value="system">@L["settings.theme_system"]</option>
                                <option value="dark">@L["settings.theme_dark"]</option>
                                <option value="light">@L["settings.theme_light"]</option>
                            </select>
                        </div>
                        <div class="field">
                            <label for="fld-2">@L["settings.language"]</label>
                            <select class="input" value="@L.Language" @onchange="OnLanguageChanged" id="fld-2">
                                @foreach (var (lang, display) in L.Languages)
                                {
                                    <option value="@lang">@display</option>
                                }
                            </select>
                        </div>
                    </SettingsSection>
                    <SettingsSection Title="@L["settings.sec_audio"]">
                        <div class="field">
                            <label for="fld-3">@L["settings.audio_engine"]</label>
                            <select class="input" value="@_audioEngine" @onchange="OnAudioEngineChanged" id="fld-3">
                                <option value="auto">@L["settings.audio_engine_auto"]</option>
                                <option value="web-speech">Web Speech</option>
                                <option value="server">@L["settings.audio_engine_server"]</option>
                            </select>
                        </div>
                        @if (_ttsSupported || _sttSupported)
                        {
                            <div class="field">
                                <label for="fld-4">@L["settings.audio_voice"]</label>
                                <select class="input" value="@_audioVoice" @onchange="OnAudioVoiceChanged" disabled="@(!_ttsSupported)" id="fld-4">
                                    <option value="">@L["settings.audio_voice_default"]</option>
                                    @foreach (var v in _audioVoices)
                                    {
                                        <option value="@v.Name">@v.Name (@v.Lang)</option>
                                    }
                                </select>
                            </div>
                            <label class="check"><input type="checkbox" checked="@_audioAutoSend" @onchange="OnAutoSendChanged" disabled="@(!_sttSupported)" /> @L["settings.audio_autosend"]</label>
                        }
                        else
                        {
                            <div class="field-note">@L["settings.audio_unavailable"]</div>
                        }
                    </SettingsSection>
                }
                else if (_tab == "account")
                {
                    <SettingsSection Title="@L["settings.sec_profile"]">
                        <div class="field">
                            <label for="fld-5">@L["common.name"]</label>
                            <input class="input" @bind="_name" id="fld-5" />
                        </div>
                        <div class="field">
                            <label for="fld-6">@L["settings.profile_url"]</label>
                            <input class="input" @bind="_profileImage" placeholder="https://…" id="fld-6" />
                        </div>
                    </SettingsSection>

                    <SettingsSection Title="@L["settings.sec_password"]" Description="@L["settings.password_hint"]">
                        <div class="field">
                            <label for="fld-7">@L["settings.current_password"]</label>
                            <input class="input" type="password" autocomplete="current-password" @bind="_currentPassword" id="fld-7" />
                        </div>
                        <div class="field">
                            <label for="fld-8">@L["settings.new_password"]</label>
                            <input class="input" type="password" autocomplete="new-password" @bind="_newPassword" id="fld-8" />
                        </div>
                    </SettingsSection>

                    <SettingsSection Title="@L["settings.sec_api_key"]">
                        <div class="field">
                            <label for="fld-9">@L["settings.api_key"]</label>
                            @if (_apiKeyCreated is not null)
                            {
                                <input class="input" readonly value="@_apiKeyCreated" id="fld-9" />
                                <div class="field-note">@L["settings.api_key_copy_now"]</div>
                            }
                            else if (_apiKeyInfo is not null)
                            {
                                <div class="field-note">@L.T("settings.api_key_active_since", ("date", FormatDate(_apiKeyInfo.CreatedAt)))</div>
                            }
                            else
                            {
                                <div class="field-note">@L["settings.api_key_none"]</div>
                            }
                            <div class="field-actions">
                                <button class="button-sm" @onclick="CreateApiKeyAsync">@L["settings.generate_key"]</button>
                                @if (_apiKeyInfo is not null || _apiKeyCreated is not null)
                                {
                                    <button class="button-sm danger-btn" @onclick="RevokeApiKeyAsync">@L["settings.revoke"]</button>
                                }
                            </div>
                        </div>
                    </SettingsSection>

                    <SettingsSection Title="@L["settings.sec_webhook"]" Description="@L["settings.webhook_hint"]">
                        <div class="field">
                            <label for="fld-10">@L["settings.webhook_url"]</label>
                            <input class="input" @bind="_webhookUrl" placeholder="https://…" id="fld-10" />
                        </div>
                        <div class="field">
                            <div class="field-label">@L["settings.webhook_events"]</div>
                            @foreach (var ev in WebhookEvents)
                            {
                                <label class="check"><input type="checkbox" checked="@_webhookEvents.Contains(ev)" @onchange="e => ToggleWebhookEvent(ev, e)" /> @ev</label>
                            }
                        </div>
                        <label class="check"><input type="checkbox" @bind="_webhookEnabled" /> @L["settings.webhook_enabled"]</label>
                        <div class="field-actions">
                            <button class="button-sm" @onclick="TestWebhookAsync" disabled="@string.IsNullOrWhiteSpace(_webhookUrl)">@L["settings.webhook_test"]</button>
                            <button class="button-sm danger-btn" @onclick="DeleteWebhookAsync" disabled="@(_webhook is null)">@L["settings.webhook_remove"]</button>
                        </div>
                    </SettingsSection>

                    <SettingsSaveBar Busy="@_accountSaving" Dirty="@AccountDirty"
                                     Message="@AccountMessage"
                                     OnSave="SaveAccountAsync" OnDiscard="DiscardAccountAsync" />
                }
                else if (_tab == "memories")
                {
                    <SettingsSection Title="@L["settings.sec_memories"]">
                        <div class="field">
                            <div class="field-label">@L["settings.memories_label"]</div>
                            @if (_memories.Count == 0)
                            {
                                <div class="field-note">@L["settings.memories_empty"]</div>
                            }
                            @foreach (var memory in _memories)
                            {
                                <div class="memory-row">
                                    <span class="memory-text">@memory.Content</span>
                                    <button class="icon-mini" @onclick="() => DeleteMemoryAsync(memory)">×</button>
                                </div>
                            }
                        </div>
                        <div class="field">
                            <label for="fld-11">@L["settings.add_memory"]</label>
                            <div class="flex gap-2">
                                <input class="input flex-1" @bind="_newMemory" placeholder="@L["settings.add_memory_placeholder"]" id="fld-11" />
                                <button class="primary-btn flex-none" disabled="@string.IsNullOrWhiteSpace(_newMemory)"
                                        @onclick="AddMemoryAsync">@L["settings.add"]</button>
                            </div>
                        </div>
                    </SettingsSection>

                    <SettingsSection Title="@L["settings.sec_memsync"]">
                        <div class="field">
                            <label class="check">
                                <input type="checkbox" checked="@(_memSync?.Enabled == true)"
                                       disabled="@(_memSync?.AdminDisabled == true)"
                                       @onchange="OnMemSyncEnabledChanged" id="fld-memsync" />
                                @L["settings.memory_sync_enabled"]
                            </label>
                            @if (_memSync?.AdminDisabled == true)
                            {
                                <div class="field-note">@L["settings.memory_sync_admin_locked"]</div>
                            }
                            @if (_memSync is not null)
                            {
                                <div class="flex gap-2 mb-2">
                                    <div class="field flex-1">
                                        <label for="fld-memsync-int">@L["settings.memory_sync_interval"]</label>
                                        <input class="input" type="number" min="1" max="168"
                                               @bind="_memSyncInterval" id="fld-memsync-int" />
                                    </div>
                                    <div class="field flex-1">
                                        <label for="fld-memsync-age">@L["settings.memory_sync_max_age"]</label>
                                        <input class="input" type="number" min="1" max="365"
                                               @bind="_memSyncMaxAge" id="fld-memsync-age" />
                                    </div>
                                </div>
                                <div class="field-note">@L["settings.memory_sync_hint"]</div>
                            }
                        </div>
                    </SettingsSection>

                    @if (_memSync is not null)
                    {
                        <SettingsSaveBar Busy="@_memSyncSaving" Dirty="@MemSyncDirty"
                                         Message="@_memSyncMessage"
                                         OnSave="SaveMemSyncAsync" OnDiscard="DiscardMemSync" />
                    }
                }
                else if (_tab == "notifications")
                {
                    <SettingsSection Title="@L["settings.sec_notifications"]">
                        <label class="check">
                            <input type="checkbox" checked="@_notifyChatDone" @onchange="OnNotifyChatDoneChanged" />
                            @L["settings.notify_chat_done"]
                        </label>
                        <label class="check">
                            <input type="checkbox" checked="@_notifyBrowser" @onchange="OnNotifyBrowserChanged" />
                            @L["settings.notify_browser"]
                        </label>
                        <label class="check">
                            <input type="checkbox" checked="@_notifyPush" @onchange="OnNotifyPushChanged" />
                            @L["settings.notify_push"]
                        </label>
                        @if (_notifyPermission is "denied" or "unsupported")
                        {
                            <p class="field-note text-red-600 dark:text-red-400">
                                @L[_notifyPermission == "denied"
                                    ? "settings.notify_permission_denied"
                                    : "settings.notify_permission_unsupported"]
                            </p>
                        }
                        <p class="field-note">@L["settings.notify_hint"]</p>
                    </SettingsSection>
                }
                else if (_tab == "integrations")
                {
                    <SettingsSection Title="GitHub" Description="@L["settings.github_token_hint"]">
                        @if (_ghConfigured && _ghSource is not null)
                        {
                            <div class="field-note">
                                @if (_ghSource == "global")
                                {
                                    <span>@L["settings.cfg_source_global"]</span>
                                }
                                else
                                {
                                    <span>@L["settings.cfg_source_user"]</span>
                                }
                            </div>
                        }
                        <div class="field">
                            <label for="gh-token">@L["settings.github_token"]</label>
                            <input id="gh-token" class="input" type="password" autocomplete="off" spellcheck="false"
                                   placeholder="@L["settings.github_token_ph"]" @bind="_ghToken" />
                        </div>
                        @if (_ghConfigured)
                        {
                            <div class="field-note">@L.T("settings.github_connected", ("login", _ghLogin ?? ""))</div>
                            @if (_ghSource == "global")
                            {
                                <div class="field-note">@L["settings.github_inherited_note"]</div>
                            }
                            <div class="field-actions">
                                <button type="button" class="button-sm danger-btn"
                                        @onclick="RemoveGitHubTokenAsync">@L["settings.github_remove"]</button>
                            </div>
                        }
                        <div class="field-note">@L["settings.github_repos_hint"]</div>
                    </SettingsSection>

                    <SettingsSection Title="@L["settings.sec_secrets"]" Description="@L["settings.secrets_hint"]">
                        @if (_secrets is null)
                        {
                            <div>@L["common.loading"]</div>
                        }
                        else
                        {
                            @foreach (var entry in _secrets)
                            {
                                var isMine = entry.Source == "user";
                                <div class="flex items-center justify-between gap-2 min-h-11">
                                    <div class="min-w-0">
                                        <div class="text-sm truncate font-mono">@entry.Name</div>
                                        <div class="text-xs text-gray-400">
                                            @(isMine ? L["settings.cfg_source_user"] : L["settings.cfg_source_global"])
                                            · @DateTimeOffset.FromUnixTimeSeconds(entry.UpdatedAt).LocalDateTime.ToString("d")
                                        </div>
                                    </div>
                                    @if (isMine)
                                    {
                                        <button type="button" class="msg-action danger" disabled="@_secretsBusy"
                                                aria-label="@($"{entry.Name} remove")"
                                                @onclick="() => DeleteSecretAsync(entry.Name)">✕</button>
                                    }
                                    else
                                    {
                                        <span class="text-[0.625rem] text-gray-400" title="@L["settings.secrets_inherited_hint"]">@L["settings.secrets_inherited"]</span>
                                    }
                                </div>
                            }
                            @if (_secrets.Count == 0)
                            {
                                <div class="field-note">@L["settings.secrets_none"]</div>
                            }
                            @if (_secretsMessage is not null)
                            {
                                <div class="field-note">@_secretsMessage</div>
                            }
                            <div class="field mt-2">
                                <div class="field-label">@L["settings.secrets_add"]</div>
                                <div class="flex gap-2 flex-wrap">
                                    <input class="input flex-1 min-w-32 font-mono" @bind="_secretName" aria-label="@L["settings.secret_name_ph"]"
                                           placeholder="@L["settings.secret_name_ph"]" spellcheck="false" />
                                    <input class="input flex-1 min-w-32" type="password" autocomplete="off" @bind="_secretValue" aria-label="@L["settings.secret_value_ph"]"
                                           placeholder="@L["settings.secret_value_ph"]" />
                                    <button class="primary-btn flex-none" disabled="@(_secretsBusy || string.IsNullOrWhiteSpace(_secretName) || string.IsNullOrEmpty(_secretValue))"
                                            @onclick="AddSecretAsync">@L["common.add"]</button>
                                </div>
                                <div class="field-note">@L["settings.secrets_never_shown"]</div>
                            </div>
                        }
                    </SettingsSection>

                    <SettingsSection Title="MCP" Description="@L["settings.mcp_hint"]">
                        @if (_userMcp is null)
                        {
                            <div>@L["common.loading"]</div>
                        }
                        else
                        {
                            @foreach (var entry in _userMcp)
                            {
                                var isMine = entry.Source == "user";
                                <div class="flex items-center justify-between gap-2 min-h-11">
                                    <div class="min-w-0">
                                        <div class="text-sm truncate">@entry.Server.Name</div>
                                        <div class="text-xs text-gray-400">
                                            @(isMine ? L["settings.cfg_source_user"] : L["settings.cfg_source_global"])
                                            @if (entry.Server.LastError is { Length: > 0 } err)
                                            {
                                                <span> · @err</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="flex gap-2 flex-none items-center">
                                        @if (isMine)
                                        {
                                            <button type="button" class="msg-action danger" disabled="@_mcpSaving"
                                                    aria-label="@($"{entry.Server.Name} remove")"
                                                    @onclick="() => DeleteUserMcpAsync(entry.Server.Id)">✕</button>
                                        }
                                        <button type="button" role="switch" aria-checked="@(entry.EnabledForMe ? "true" : "false")"
                                                aria-label="@entry.Server.Name" disabled="@_mcpSaving"
                                                class="flex h-11 w-14 flex-none items-center justify-center cursor-pointer disabled:opacity-50"
                                                @onclick="() => ToggleUserMcpAsync(entry)">
                                            <span class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors @(entry.EnabledForMe ? "bg-blue-600" : "bg-gray-300 dark:bg-gray-700")">
                                                <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform @(entry.EnabledForMe ? "translate-x-6" : "translate-x-1")"></span>
                                            </span>
                                        </button>
                                    </div>
                                </div>
                            }
                            @if (_userMcp.Count == 0)
                            {
                                <div class="field-note">@L["settings.mcp_none"]</div>
                            }
                            @if (_mcpMessage is not null)
                            {
                                <div class="field-note">@_mcpMessage</div>
                            }
                            <div class="field mt-2">
                                <div class="field-label">@L["settings.mcp_add"]</div>
                                <div class="flex gap-2 flex-wrap">
                                    <input class="input flex-1 min-w-32" @bind="_mcpName" aria-label="@L["settings.mcp_name_ph"]"
                                           placeholder="@L["settings.mcp_name_ph"]" />
                                    <input class="input flex-1 min-w-32" @bind="_mcpUrl" aria-label="@L["settings.mcp_url_ph"]"
                                           placeholder="@L["settings.mcp_url_ph"]" />
                                    <button class="primary-btn flex-none" disabled="@(_mcpSaving || string.IsNullOrWhiteSpace(_mcpName) || string.IsNullOrWhiteSpace(_mcpUrl))"
                                            @onclick="AddUserMcpAsync">@L["common.add"]</button>
                                </div>
                            </div>
                        }
                    </SettingsSection>

                    <SettingsSection Title="@L["settings.sec_hooks"]" Description="@L["settings.hooks_hint"]">
                        @if (_hooks is null)
                        {
                            <div>@L["common.loading"]</div>
                        }
                        else
                        {
                            @foreach (var hook in _hooks)
                            {
                                <div class="flex items-center justify-between gap-2 min-h-11">
                                    <div class="min-w-0">
                                        <div class="text-sm truncate">@hook.Name</div>
                                        <div class="text-xs text-gray-400 truncate">@hook.Url</div>
                                    </div>
                                    <button type="button" class="msg-action danger" disabled="@_hooksBusy"
                                            aria-label="@($"{hook.Name} remove")"
                                            @onclick="() => DeleteHookAsync(hook.Id)">✕</button>
                                </div>
                            }
                            @if (_hooks.Count == 0)
                            {
                                <div class="field-note">@L["settings.hooks_none"]</div>
                            }
                            @if (_hooksMessage is not null)
                            {
                                <div class="field-note">@_hooksMessage</div>
                            }
                            <div class="field mt-2">
                                <div class="field-label">@L["settings.hooks_add"]</div>
                                <div class="flex gap-2">
                                    <input class="input flex-1" @bind="_hookName" aria-label="@L["settings.hooks_name_ph"]"
                                           placeholder="@L["settings.hooks_name_ph"]" />
                                    <button class="primary-btn flex-none" disabled="@(_hooksBusy || string.IsNullOrWhiteSpace(_hookName))"
                                            @onclick="CreateHookAsync">@L["common.add"]</button>
                                </div>
                            </div>
                            <div class="field-note">
                                <a href="/automations" class="underline">@L["settings.hooks_manage_automations"]</a>
                            </div>
                        }
                    </SettingsSection>

                    <SettingsSaveBar Busy="@_ghSaving" Dirty="@(!string.IsNullOrWhiteSpace(_ghToken))"
                                     SaveDisabled="@string.IsNullOrWhiteSpace(_ghToken)"
                                     Message="@(_ghMessage ?? _intMessage)"
                                     OnSave="SaveIntegrationsAsync" OnDiscard="DiscardIntegrations" />
                }
                else if (_tab == "connections")
                {
                    @if (_connections is null)
                    {
                        <div>@L["common.loading"]</div>
                    }
                    else
                    {
                        <SettingsSection Title="@L["settings.sec_ollama"]">
                            @foreach (var row in _ollamaRows)
                            {
                                <div class="flex gap-2 mb-1 items-center">
                                    <input class="input w-40" @bind="row.Name" placeholder="@L["common.name"]" aria-label="@L["common.name"]" />
                                    <input class="input flex-1" @bind="row.Url" placeholder="http://localhost:11434" aria-label="URL" />
                                    <button class="msg-action danger flex-none" aria-label="@L["common.delete"]" @onclick="() => _ollamaRows.Remove(row)">✕</button>
                                </div>
                            }
                            <button class="button-sm" @onclick="() => _ollamaRows.Add(new ConnectionRow())">@L["settings.add_connection"]</button>
                        </SettingsSection>
                        <SettingsSection Title="@L["settings.sec_openai"]">
                            @foreach (var row in _openAiRows)
                            {
                                <div class="flex gap-2 mb-1 items-center flex-wrap">
                                    <input class="input flex-1 min-w-32" @bind="row.Name" placeholder="@L["common.name"]" aria-label="@L["common.name"]" />
                                    <input class="input flex-1 min-w-40" @bind="row.Url" placeholder="https://api.openai.com/v1" aria-label="URL" />
                                    <input class="input flex-1 min-w-32" type="password" @bind="row.Key" aria-label="API key"
                                           placeholder="@(row.KeyConfigured ? L["settings.keys_keep"] : "API key")" />
                                    <button class="msg-action danger flex-none" aria-label="@L["common.delete"]" @onclick="() => _openAiRows.Remove(row)">✕</button>
                                </div>
                            }
                            <button class="button-sm" @onclick="() => _openAiRows.Add(new ConnectionRow())">@L["settings.add_connection"]</button>
                        </SettingsSection>
                        <SettingsSection Title="@L["settings.sec_providers"]">
                            @foreach (var row in _providerRows)
                            {
                                <div class="flex gap-2 mb-1 items-center flex-wrap">
                                    <select class="input flex-1 min-w-32" @bind="row.Type" @bind:after="() => OnProviderTypeChanged(row)"
                                            aria-label="@L["settings.provider_type"]">
                                        <option value="anthropic">@L["settings.provider_anthropic"]</option>
                                        <option value="google">@L["settings.provider_google"]</option>
                                    </select>
                                    <input class="input flex-1 min-w-40" @bind="row.Url" placeholder="@ProviderTypes.DefaultBaseUrl(row.Type)" aria-label="URL" />
                                    <input class="input flex-1 min-w-32" type="password" @bind="row.Key" aria-label="API key"
                                           placeholder="@(row.KeyConfigured ? L["settings.keys_keep"] : L["settings.api_key_required"])" />
                                    <button class="msg-action danger flex-none" aria-label="@L["common.delete"]" @onclick="() => _providerRows.Remove(row)">✕</button>
                                </div>
                            }
                            <button class="button-sm" @onclick="AddProviderRow">@L["settings.add_provider"]</button>
                        </SettingsSection>
                        <SettingsSaveBar Busy="@_connSaving" Dirty="@ConnectionsDirty"
                                         Message="@_saveMessage"
                                         OnSave="SaveConnectionsAsync" OnDiscard="DiscardConnections" />

                        @if (Auth.CurrentUser?.Role == "admin")
                        {
                            <SettingsSection Title="@L["settings.sec_ollama_models"]">
                                @if (_ollamaModels is null)
                                {
                                    <div class="field-note">@L["common.loading"]</div>
                                }
                                else if (_ollamaModels.Count == 0)
                                {
                                    <div class="field-note">@L["settings.no_ollama_models"]</div>
                                }
                                else
                                {
                                    @foreach (var model in _ollamaModels)
                                    {
                                        <div class="flex items-center justify-between gap-2 min-h-11">
                                            <span class="text-sm truncate">@model.Name</span>
                                            <button class="button-sm flex-none" @onclick="() => DeleteOllamaModelAsync(model)">@L["common.delete"]</button>
                                        </div>
                                    }
                                }
                                <div class="flex gap-2 mt-2">
                                    <input aria-label="@L["settings.pull_model_placeholder"]" class="input flex-1" @bind="_ollamaPullName"
                                           placeholder="@L["settings.pull_model_placeholder"]" />
                                    <button class="primary-btn flex-none" disabled="@(_ollamaPulling || string.IsNullOrWhiteSpace(_ollamaPullName))"
                                            @onclick="PullOllamaModelAsync">
                                        @(_ollamaPulling ? L["settings.pulling"] : L["settings.pull_model"])</button>
                                </div>
                                @if (_ollamaPullMessage is not null)
                                {
                                    <div class="field-note">@_ollamaPullMessage</div>
                                }
                            </SettingsSection>
                        }
                    }
                }
                else if (_tab == "models")
                {
                    @if (_modelCatalog is null)
                    {
                        <div>@L["common.loading"]</div>
                    }
                    else if (_modelCatalog.Count == 0)
                    {
                        <div class="field-note">@L["models.none"]</div>
                    }
                    else
                    {
                        <SettingsSection Title="@L["settings.model_roles_section"]" Description="@L["settings.model_roles_hint"]">
                            @foreach (var role in RoleKeys)
                            {
                                <div class="flex items-center justify-between gap-2 min-h-11">
                                    <div class="text-sm">
                                        @L[$"settings.model_role_{role}"]
                                        @if (RoleInheritedFrom(role) is { } inheritedFrom)
                                        {
                                            <div class="text-xs text-gray-400">
                                                @L.T("settings.model_role_inherited", ("chain", inheritedFrom))</div>
                                        }
                                    </div>
                                    <select class="input max-w-64" disabled="@_modelsSaving"
                                            value="@RoleValue(role)"
                                            @onchange="e => SetRoleAsync(role, e.Value?.ToString())"
                                            aria-label="@L[$"settings.model_role_{role}"]">
                                        <option value="">@L["settings.model_role_default"]</option>
                                        @foreach (var m in _modelCatalog.OrderBy(m => m.Provider).ThenBy(m => m.Name))
                                        {
                                            <option value="@m.Id">@m.Provider: @m.Name</option>
                                        }
                                    </select>
                                </div>
                            }
                        </SettingsSection>
                        @if (_byok is not null && _byok.Enabled)
                        {
                            <SettingsSection Title="@L["settings.byok_section"]" Description="@L["settings.byok_hint"]">
                                <div>
                                    @foreach (var provider in ByokProviders)
                                    {
                                        var has = _byok.Providers.Contains(provider);
                                        <div class="flex items-center justify-between gap-2 min-h-11">
                                            <div class="text-sm">
                                                @provider
                                                @if (has)
                                                {
                                                    <div class="text-xs text-gray-400">@L["settings.byok_key_set"]</div>
                                                }
                                            </div>
                                            <div class="flex gap-2 flex-none items-center">
                                                <input class="input max-w-48" type="password" autocomplete="off"
                                                       placeholder="@L["settings.byok_key_ph"]"
                                                       aria-label="@provider"
                                                       @bind="_byokDrafts[provider]" />
                                                @if (has)
                                                {
                                                    <button class="msg-action danger" disabled="@_byokSaving"
                                                            @onclick="() => ClearByokAsync(provider)">@L["settings.byok_remove"]</button>
                                                }
                                                else
                                                {
                                                    <button class="button-sm" disabled="@(_byokSaving || string.IsNullOrWhiteSpace(_byokDrafts.GetValueOrDefault(provider)))"
                                                            @onclick="() => SaveByokAsync(provider)">@L["common.save"]</button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </SettingsSection>
                        }
                        <SettingsSection Title="@L["settings.sec_catalog"]">
                        <div class="flex gap-2 mb-3">
                            <input class="input flex-1" @bind="_modelSearch" @bind:event="oninput"
                                   placeholder="@L["settings.models_search"]" aria-label="@L["settings.models_search"]" />
                            <button class="button-sm flex-none" @onclick="LoadModelCatalogAsync"
                                    aria-label="@L["common.retry"]">↻</button>
                        </div>
                        @if (_modelsMessage is not null)
                        {
                            <div class="field-note">@_modelsMessage</div>
                        }
                        @foreach (var group in ModelGroups())
                        {
                            var enabledCount = group.Count(m => ModelEnabled(m));
                            <div class="field">
                                <div class="flex items-center justify-between gap-2 mb-1 flex-wrap">
                                    <div class="field-label">@ModelSelector.ProviderLabel(group.Key)
                                        <span class="text-gray-400 font-normal">@enabledCount/@group.Count()</span>
                                    </div>
                                    <div class="flex gap-2 flex-none">
                                        <button class="button-sm" disabled="@_modelsSaving"
                                                @onclick="() => SetProviderEnabledAsync(group.Key, true)">@L["models.enable_all"]</button>
                                        <button class="button-sm" disabled="@_modelsSaving"
                                                @onclick="() => SetProviderEnabledAsync(group.Key, false)">@L["models.disable_all"]</button>
                                    </div>
                                </div>
                                @foreach (var model in group)
                                {
                                    var key = $"{model.Provider}:{model.Id}";
                                    var on = ModelEnabled(model);
                                    <div class="flex items-center justify-between gap-2 min-h-11">
                                        <div class="min-w-0">
                                            <div class="text-sm truncate">@model.Name</div>
                                            @if (!string.Equals(model.Name, model.Id, StringComparison.Ordinal))
                                            {
                                                <div class="text-xs text-gray-400 truncate">@model.Id</div>
                                            }
                                        </div>
                                        <button type="button" role="switch" aria-checked="@(on ? "true" : "false")"
                                                aria-label="@model.Name" disabled="@_modelsSaving"
                                                class="flex h-11 w-14 flex-none items-center justify-center cursor-pointer disabled:opacity-50"
                                                @onclick="() => ToggleModelAsync(model)">
                                            <span class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors @(on ? "bg-blue-600" : "bg-gray-300 dark:bg-gray-700")">
                                                <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform @(on ? "translate-x-6" : "translate-x-1")"></span>
                                            </span>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                        @if (!ModelGroups().Any())
                        {
                            <div class="field-note">@L["models.none"]</div>
                        }
                        </SettingsSection>
                    }
                }
                else if (_tab == "combos")
                {
                    <SettingsSection Title="@L["settings.sec_combos"]" Description="@L["settings.combos_hint"]">
                        @if (_combos is null)
                        {
                            <div>@L["common.loading"]</div>
                        }
                        else
                        {
                            @foreach (var combo in _combos)
                            {
                                <div class="flex items-center justify-between gap-2 min-h-11">
                                    <div class="min-w-0">
                                        <div class="text-sm truncate">@combo.Name
                                            <span class="role-badge">@combo.Strategy</span>
                                            @if (combo.UserId is null)
                                            {
                                                <span class="role-badge">@L["settings.cfg_source_global"]</span>
                                            }
                                        </div>
                                        <div class="text-xs text-gray-400 truncate">@string.Join(" → ", combo.Items)</div>
                                        @if (_comboStatus.TryGetValue(combo.Id, out var st) && st is not null)
                                        {
                                            <div class="text-xs text-gray-400">
                                                @L.T("settings.combo_effective", ("model", st.EffectiveModel ?? "—"))
                                                @if (st.Cooldowns.Count > 0)
                                                {
                                                    <span> · @L.T("settings.combo_cooldowns", ("count", st.Cooldowns.Count.ToString()))</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="flex gap-1 flex-none items-center">
                                        <button class="button-sm" disabled="@_comboSaving"
                                                aria-label="@($"{combo.Name} status")"
                                                @onclick="() => LoadComboStatusAsync(combo.Id)">↻</button>
                                        @if (combo.UserId is not null)
                                        {
                                            <button class="button-sm" disabled="@_comboSaving"
                                                    @onclick="() => EditCombo(combo)">@L["common.edit"]</button>
                                            <button class="msg-action danger" disabled="@_comboSaving"
                                                    aria-label="@($"{combo.Name} remove")"
                                                    @onclick="() => DeleteComboAsync(combo.Id)">✕</button>
                                        }
                                        <button type="button" role="switch" aria-checked="@(combo.Enabled ? "true" : "false")"
                                                aria-label="@combo.Name" disabled="@_comboSaving"
                                                class="flex h-11 w-14 flex-none items-center justify-center cursor-pointer disabled:opacity-50"
                                                @onclick="() => ToggleComboAsync(combo)">
                                            <span class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors @(combo.Enabled ? "bg-blue-600" : "bg-gray-300 dark:bg-gray-700")">
                                                <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform @(combo.Enabled ? "translate-x-6" : "translate-x-1")"></span>
                                            </span>
                                        </button>
                                    </div>
                                </div>
                            }
                            @if (_combos.Count == 0)
                            {
                                <div class="field-note">@L["settings.combos_none"]</div>
                            }
                        }
                    </SettingsSection>

                    <SettingsSection Title="@(_comboEditing is null ? L["settings.sec_combo_new"] : L.T("settings.combo_editing", ("name", _comboEditing.Name)))">
                        <div class="field">
                            <label for="combo-name">@L["common.name"]</label>
                            <input class="input" id="combo-name" @bind="_comboName" placeholder="@L["settings.combo_name_ph"]" />
                        </div>
                        <div class="field">
                            <label for="combo-strategy">@L["settings.combo_strategy"]</label>
                            <select class="input" id="combo-strategy" @bind="_comboStrategy">
                                <option value="priority">@L["settings.combo_strategy_priority"]</option>
                                <option value="round-robin">@L["settings.combo_strategy_rr"]</option>
                                <option value="priority-round-robin">@L["settings.combo_strategy_prr"]</option>
                            </select>
                        </div>
                        <div class="field">
                            <div class="field-label">@L["settings.combo_models"]</div>
                            @foreach (var item in _comboItems)
                            {
                                var idx = _comboItems.IndexOf(item);
                                <div class="memory-row">
                                    <span class="memory-text">@(idx + 1). @item</span>
                                    <button class="icon-mini" aria-label="@($"{item} remove")"
                                            @onclick="() => _comboItems.Remove(item)">×</button>
                                </div>
                            }
                            <div class="flex gap-2 mt-1">
                                <select class="input flex-1" @bind="_comboModelPick" aria-label="@L["settings.combo_models"]">
                                    <option value="">@L["settings.combo_pick_model"]</option>
                                    @foreach (var m in (_modelCatalog ?? []).OrderBy(m => m.Provider).ThenBy(m => m.Name))
                                    {
                                        <option value="@m.Id">@m.Provider: @m.Name</option>
                                    }
                                </select>
                                <button class="button-sm flex-none" disabled="@string.IsNullOrWhiteSpace(_comboModelPick)"
                                        @onclick="AddComboItem">@L["common.add"]</button>
                            </div>
                        </div>
                        <div class="flex gap-2">
                            <div class="field flex-1">
                                <label for="combo-rpm">@L["settings.combo_rpm"]</label>
                                <input class="input" id="combo-rpm" type="number" min="0" @bind="_comboRpm" />
                            </div>
                            <div class="field flex-1">
                                <label for="combo-tpm">@L["settings.combo_tpm"]</label>
                                <input class="input" id="combo-tpm" type="number" min="0" @bind="_comboTpm" />
                            </div>
                        </div>
                        @if (_comboEditing is not null)
                        {
                            <div class="field-actions">
                                <button class="button-sm" @onclick="ResetComboForm">@L["common.cancel"]</button>
                            </div>
                        }
                    </SettingsSection>

                    <SettingsSaveBar Busy="@_comboSaving"
                                     SaveDisabled="@(string.IsNullOrWhiteSpace(_comboName) || _comboItems.Count == 0)"
                                     Message="@_combosMessage"
                                     OnSave="SaveComboAsync" OnDiscard="ResetComboForm"
                                     Dirty="@(_comboEditing is not null)" />
                }
                else if (_tab == "tools")
                {
                    <SettingsSection Title="@L["settings.tool_approvals_title"]" Description="@L["settings.tool_approvals_hint"]">
                        @if (_toolApprovals is null)
                        {
                            <div>@L["common.loading"]</div>
                        }
                        else
                        {
                            @if (_toolsMessage is not null)
                            {
                                <div class="field-note">@_toolsMessage</div>
                            }
                            @foreach (var tool in _toolApprovals)
                            {
                                <div class="flex items-center justify-between gap-2 min-h-11">
                                    <div class="min-w-0">
                                        <div class="text-sm truncate font-mono">@tool.Name</div>
                                        <div class="text-xs text-gray-400">@L[$"settings.tier_{tool.Tier}"]</div>
                                    </div>
                                    <select class="input flex-none" style="max-width: 9rem"
                                            aria-label="@tool.Name" disabled="@_toolsSaving"
                                            value="@(tool.Override ?? "")"
                                            @onchange="e => SetToolOverrideAsync(tool.Name, e.Value?.ToString())">
                                        <option value="">@L["settings.tool_override_default"]</option>
                                        <option value="allow">@L["settings.tool_override_allow"]</option>
                                        <option value="prompt">@L["settings.tool_override_prompt"]</option>
                                        <option value="deny">@L["settings.tool_override_deny"]</option>
                                    </select>
                                </div>
                            }
                        }
                    </SettingsSection>
                }
                else if (_tab == "agents")
                {
                    <SettingsSection Title="@L["settings.sec_agent_catalog"]" Description="@L["settings.agents_hint"]">
                        @if (_agentCatalog is null)
                        {
                            <div>@L["common.loading"]</div>
                        }
                        else
                        {
                            @foreach (var agent in _agentCatalog.Agents)
                            {
                                <div class="flex items-center justify-between gap-2 min-h-11">
                                    <div class="min-w-0">
                                        <div class="text-sm truncate">@agent.Name
                                            <span class="role-badge">@agent.Source</span>
                                        </div>
                                        <div class="text-xs text-gray-400 truncate">@agent.Description</div>
                                        @if (agent.Model is not null)
                                        {
                                            <div class="text-xs text-gray-400">@L.T("settings.agent_model", ("model", agent.Model))</div>
                                        }
                                    </div>
                                </div>
                            }
                            @if (_agentCatalog.Agents.Count == 0)
                            {
                                <div class="field-note">@L["settings.agents_empty"]</div>
                            }
                            @if (_agentCatalog.WorkspaceAgentsPresent)
                            {
                                <label class="toggle mt-2">
                                    <input type="checkbox" checked="@_agentCatalog.WorkspaceOptIn"
                                           disabled="@_agentsBusy"
                                           @onchange="e => SetAgentWorkspaceAsync(e.Value is true)" />
                                    @L["settings.agent_workspace_optin"]
                                </label>
                                <div class="field-note">@L["settings.agent_workspace_hint"]</div>
                            }
                            @if (_agentsMessage is not null)
                            {
                                <div class="field-note">@_agentsMessage</div>
                            }
                        }
                    </SettingsSection>

                    <SettingsSection Title="@L["settings.sec_agent_external"]" Description="@L["settings.ext_agents_hint"]">
                        @if (_externalAgents is null)
                        {
                            <div>@L["common.loading"]</div>
                        }
                        else
                        {
                            @foreach (var ext in _externalAgents)
                            {
                                <div class="flex items-center justify-between gap-2 min-h-11">
                                    <div class="min-w-0">
                                        <div class="text-sm truncate">@ext.Name
                                            @if (ext.Installed && ext.Version is not null)
                                            {
                                                <span class="role-badge">@ext.Version</span>
                                            }
                                        </div>
                                        <div class="text-xs text-gray-400">
                                            @(ext.Installed
                                                ? (ext.SkillInstalled ? L["settings.ext_skill_ok"] : L["settings.ext_skill_missing"])
                                                : L["settings.ext_not_installed"])
                                        </div>
                                    </div>
                                    <button type="button" role="switch" aria-checked="@(ext.Selected ? "true" : "false")"
                                            aria-label="@ext.Name" disabled="@(_agentsBusy || !ext.Installed)"
                                            class="flex h-11 w-14 flex-none items-center justify-center cursor-pointer disabled:opacity-50"
                                            @onclick="() => SetExternalSelectedAsync(ext.Id, !ext.Selected)">
                                        <span class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors @(ext.Selected ? "bg-blue-600" : "bg-gray-300 dark:bg-gray-700")">
                                            <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform @(ext.Selected ? "translate-x-6" : "translate-x-1")"></span>
                                        </span>
                                    </button>
                                </div>
                            }
                        }
                    </SettingsSection>

                    <SettingsSection Title="@L["settings.sec_personas"]" Description="@L["settings.personas_hint"]">
                        @if (_personas is null)
                        {
                            <div>@L["common.loading"]</div>
                        }
                        else
                        {
                            @foreach (var persona in _personas)
                            {
                                <div class="flex items-center justify-between gap-2 min-h-11">
                                    <div class="min-w-0">
                                        <div class="text-sm truncate">@persona.Name
                                            <span class="role-badge">@persona.ModelId</span>
                                            @if (!persona.Enabled)
                                            {
                                                <span class="role-badge">@L["common.inactive"]</span>
                                            }
                                        </div>
                                        <div class="text-xs text-gray-400 truncate">@persona.SystemPrompt</div>
                                    </div>
                                    <div class="flex items-center gap-1 flex-none">
                                        <button class="msg-action" aria-label="@L["common.edit"]"
                                                @onclick="() => EditPersona(persona)">✎</button>
                                        <button class="msg-action danger" aria-label="@L["common.delete"]"
                                                @onclick="() => DeletePersonaAsync(persona)">🗑</button>
                                    </div>
                                </div>
                            }
                            @if (_personas.Count == 0)
                            {
                                <div class="field-note">@L["settings.personas_none"]</div>
                            }
                        }
                        <div class="flex flex-col gap-2 w-full text-sm mt-2">
                            <input aria-label="@L["settings.persona_name"]" class="input" @bind="_personaName"
                                   placeholder="@(_personaEditing is null ? L["settings.persona_name"] : L.T("settings.persona_editing", ("name", _personaEditing)))" />
                            @if (_modelCatalog is not null)
                            {
                                <select aria-label="@L["settings.combo_pick_model"]" class="input" @bind="_personaModel">
                                    @foreach (var m in _modelCatalog)
                                    {
                                        <option value="@m.Id">@m.Id</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input aria-label="@L["settings.combo_pick_model"]" class="input" @bind="_personaModel" placeholder="model id" />
                            }
                            <textarea aria-label="@L["settings.persona_prompt"]" class="input" rows="3"
                                      @bind="_personaPrompt" placeholder="@L["settings.persona_prompt"]"></textarea>
                            <label class="check"><input type="checkbox" @bind="_personaEnabled" /> @L["common.active"]</label>
                            <SettingsSaveBar Busy="@_personaSaving"
                                             SaveDisabled="@(string.IsNullOrWhiteSpace(_personaName) || string.IsNullOrWhiteSpace(_personaPrompt) || string.IsNullOrWhiteSpace(_personaModel))"
                                             Message="@_personaMessage" OnSave="SavePersonaAsync" OnDiscard="ResetPersonaForm" />
                        </div>
                    </SettingsSection>

                    <SettingsSection Title="@L["settings.sec_agent_links"]">
                        <div class="flex flex-col gap-1">
                            <a class="msg-action" href="/automations">@L["settings.link_automations"]</a>
                            <a class="msg-action" href="/workspace/skills">@L["settings.link_skills"]</a>
                        </div>
                    </SettingsSection>
                }
                else if (_tab == "admin")
                {
                    @if (!_adminLoaded)
                    {
                        <div>@L["common.loading"]</div>
                    }
                    else
                    {
                        <SettingsSection Title="@L["settings.sec_instance"]">
                            <div class="field">
                                <label for="fld-14">@L["settings.instance_name"]</label>
                                <input class="input" @bind="_adminWebUiName" id="fld-14" />
                            </div>
                            <div class="field">
                                <label for="fld-15">@L["settings.default_role"]</label>
                                <select class="input" @bind="_adminDefaultRole" id="fld-15">
                                    <option value="pending">@L["settings.role_pending"]</option>
                                    <option value="user">@L["settings.role_user"]</option>
                                    <option value="admin">@L["settings.role_admin"]</option>
                                </select>
                            </div>
                            <label class="check"><input type="checkbox" @bind="_adminEnableSignup" /> @L["settings.allow_signup"]</label>
                            <label class="check"><input type="checkbox" @bind="_adminEnableLoginForm" /> @L["settings.allow_password_login"]</label>
                            <label class="check"><input type="checkbox" @bind="_adminEnableApiKeys" /> @L["settings.allow_api_keys"]</label>
                            <label class="check"><input type="checkbox" @bind="_adminEnableRating" /> @L["settings.enable_rating"]</label>
                            <label class="check"><input type="checkbox" @bind="_adminEnableFolders" /> @L["settings.enable_folders"]</label>
                            <label class="check"><input type="checkbox" @bind="_adminEnableMemories" /> @L["settings.enable_memories"]</label>

                            <div class="field-note">@L["settings.media_moved_to_integrations"]</div>
                        </SettingsSection>

                        <SettingsSection Title="@L["settings.audio_admin_section"]">
                        <div class="field">
                            <label for="fld-16">@L["settings.audio_tts_engine"]</label>
                            <select class="input" @bind="_ttsEngine" id="fld-16">
                                @foreach (var engine in TtsEngines)
                                {
                                    <option value="@engine">@engine</option>
                                }
                            </select>
                        </div>
                        @if (_ttsEngine == "provider")
                        {
                            <div class="field">
                                <label for="fld-17">@L["settings.audio_provider"]</label>
                                <select class="input" @bind="_ttsProvider" @bind:after="LoadTtsProviderModelsAsync" id="fld-17">
                                    <option value="">—</option>
                                    @foreach (var url in ProviderOptions(_capabilities?.BaseUrl, _ttsProvider))
                                    {
                                        <option value="@url">@url</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (_ttsEngine is "openai" or "transformers" or "elevenlabs" or "azure")
                        {
                            <div class="field">
                                <label for="fld-18">@L["settings.audio_tts_base_url"]</label>
                                <input class="input" @bind="_ttsBaseUrl" placeholder="https://api.openai.com/v1" id="fld-18" />
                            </div>
                            <div class="field">
                                <label for="fld-19">@L["settings.audio_tts_api_key"]</label>
                                <input class="input" type="password" @bind="_ttsApiKey" placeholder="@L["settings.keys_keep"]" id="fld-19" />
                            </div>
                        }
                        @if (_ttsEngine is not "none")
                        {
                            <div class="field">
                                <label for="fld-20">@L["settings.audio_tts_model"]</label>
                                @if (TtsModelOptions().Any())
                                {
                                    <select class="input" @bind="_ttsModel" id="fld-20">
                                        @foreach (var m in TtsModelOptions())
                                        {
                                            <option value="@m">@m</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input aria-label="@L["settings.audio_tts_model"]" class="input" @bind="_ttsModel" placeholder="tts-1" />
                                }
                            </div>
                            <div class="field">
                                <label for="fld-21">@L["settings.audio_tts_voice"]</label>
                                <input class="input" @bind="_ttsVoice" placeholder="alloy" id="fld-21" />
                            </div>
                            <button class="auth-submit" type="button" @onclick="TestAudioAsync" disabled="@_audioTesting">
                                @(_audioTesting ? L["settings.audio_testing"] : L["settings.audio_test"])
                            </button>
                        }
                        <div class="field">
                            <label for="fld-22">@L["settings.audio_stt_engine"]</label>
                            <select class="input" @bind="_sttEngine" id="fld-22">
                                @foreach (var engine in SttEngines)
                                {
                                    <option value="@engine">@engine</option>
                                }
                            </select>
                        </div>
                        @if (_sttEngine == "provider")
                        {
                            <div class="field">
                                <label for="fld-23">@L["settings.audio_provider"]</label>
                                <select class="input" @bind="_sttProvider" @bind:after="LoadSttProviderModelsAsync" id="fld-23">
                                    <option value="">—</option>
                                    @foreach (var url in ProviderOptions(_capabilities?.BaseUrl, _sttProvider))
                                    {
                                        <option value="@url">@url</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (_sttEngine is "openai" or "deepgram" or "whisper")
                        {
                            <div class="field">
                                <label for="fld-24">@L["settings.audio_stt_base_url"]</label>
                                <input class="input" @bind="_sttBaseUrl" placeholder="https://api.openai.com/v1" id="fld-24" />
                            </div>
                        }
                        @if (_sttEngine is not "none")
                        {
                            <div class="field">
                                <label for="fld-25">@L["settings.audio_stt_model"]</label>
                                @if (SttModelOptions().Any())
                                {
                                    <select class="input" @bind="_sttModel" id="fld-25">
                                        @foreach (var m in SttModelOptions())
                                        {
                                            <option value="@m">@m</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input aria-label="@L["settings.audio_stt_model"]" class="input" @bind="_sttModel" placeholder="whisper-1" />
                                }
                            </div>
                        }
                        </SettingsSection>

                        <SettingsSection Title="@L["settings.webhook_admin_section"]">
                            <div class="field">
                                <label for="fld-26">@L["settings.webhook_url"]</label>
                                <input class="input" @bind="_adminWebhookUrl" placeholder="https://…" id="fld-26" />
                            </div>
                            <div class="field">
                                <div class="field-label">@L["settings.webhook_events"]</div>
                                @foreach (var ev in WebhookEvents)
                                {
                                    <label class="check"><input type="checkbox" checked="@_adminWebhookEvents.Contains(ev)" @onchange="e => ToggleAdminWebhookEvent(ev, e)" /> @ev</label>
                                }
                            </div>
                            <label class="check"><input type="checkbox" @bind="_adminWebhookEnabled" /> @L["settings.webhook_enabled"]</label>
                            <div class="field-actions">
                                <button class="button-sm" @onclick="TestAdminWebhookAsync" disabled="@string.IsNullOrWhiteSpace(_adminWebhookUrl)">@L["settings.webhook_test"]</button>
                                <button class="button-sm danger-btn" @onclick="DeleteAdminWebhookAsync" disabled="@(_adminWebhook is null)">@L["settings.webhook_remove"]</button>
                            </div>
                        </SettingsSection>

                        <SettingsSection Title="@L["settings.admin_defaults_section"]">
                            <div class="field">
                                <label for="admin-gh-token">@L["settings.admin_github_token"]</label>
                                <input id="admin-gh-token" class="input" type="password" autocomplete="off" spellcheck="false"
                                       placeholder="@L["settings.github_token_ph"]" @bind="_adminGhToken" />
                                <div class="field-note">
                                    @if (_adminGhConfigured)
                                    {
                                        @L.T("settings.github_connected", ("login", _adminGhLogin ?? ""))
                                    }
                                    else
                                    {
                                        @L["settings.admin_github_hint"]
                                    }
                                </div>
                                @if (_adminGhConfigured)
                                {
                                    <div class="field-actions">
                                        <button type="button" class="button-sm danger-btn" disabled="@_adminGhSaving"
                                                @onclick="ClearAdminGitHubAsync">@L["settings.github_remove"]</button>
                                    </div>
                                }
                            </div>
                            <div class="field">
                                <div class="field-label">@L["settings.admin_secrets_label"]</div>
                                @if (_adminSecrets is not null)
                                {
                                    @foreach (var entry in _adminSecrets)
                                    {
                                        <div class="flex items-center justify-between gap-2 min-h-11">
                                            <div class="min-w-0">
                                                <div class="text-sm truncate font-mono">@entry.Name</div>
                                                <div class="text-xs text-gray-400">
                                                    @DateTimeOffset.FromUnixTimeSeconds(entry.UpdatedAt).LocalDateTime.ToString("d")
                                                </div>
                                            </div>
                                            <button type="button" class="msg-action danger" disabled="@_adminSecretsBusy"
                                                    aria-label="@($"{entry.Name} remove")"
                                                    @onclick="() => DeleteAdminSecretAsync(entry.Name)">✕</button>
                                        </div>
                                    }
                                    @if (_adminSecrets.Count == 0)
                                    {
                                        <div class="field-note">@L["settings.secrets_none"]</div>
                                    }
                                    @if (_adminSecretsMessage is not null)
                                    {
                                        <div class="field-note">@_adminSecretsMessage</div>
                                    }
                                    <div class="flex gap-2 flex-wrap mt-1">
                                        <input class="input flex-1 min-w-32 font-mono" @bind="_adminSecretName" aria-label="@L["settings.secret_name_ph"]"
                                               placeholder="@L["settings.secret_name_ph"]" spellcheck="false" />
                                        <input class="input flex-1 min-w-32" type="password" autocomplete="off" @bind="_adminSecretValue" aria-label="@L["settings.secret_value_ph"]"
                                               placeholder="@L["settings.secret_value_ph"]" />
                                        <button class="primary-btn flex-none" disabled="@(_adminSecretsBusy || string.IsNullOrWhiteSpace(_adminSecretName) || string.IsNullOrEmpty(_adminSecretValue))"
                                                @onclick="AddAdminSecretAsync">@L["common.add"]</button>
                                    </div>
                                    <div class="field-note">@L["settings.secrets_never_shown"]</div>
                                }
                            </div>
                            <label class="toggle">
                                <input type="checkbox" checked="@_adminByokEnabled"
                                       @onchange="e => SetAdminByokAsync(e.Value is true)" />
                                @L["settings.admin_byok_toggle"]
                            </label>
                            <div class="field-note">@L["settings.admin_byok_hint"]</div>
                            @if (_adminCfgMessage is not null)
                            {
                                <div class="field-note">@_adminCfgMessage</div>
                            }
                        </SettingsSection>

                        <SettingsSaveBar Busy="@_adminSaving" Dirty="@AdminDirty"
                                         Message="@AdminMessage"
                                         OnSave="SaveAdminTabAsync" OnDiscard="DiscardAdmin" />
                    }
                }
                else if (_tab == "maintenance")
                {
                    <SettingsSection Title="@L["settings.sec_maint_status"]">
                        @if (_maintStatus is null)
                        {
                            <div>@L["common.loading"]</div>
                        }
                        else
                        {
                            <div class="field">
                                <div class="field-label">@L["settings.maint_last_run"]</div>
                                <div class="text-sm">
                                    @if (_maintStatus.LastRun is null)
                                    {
                                        @L["settings.maint_never"]
                                    }
                                    else
                                    {
                                        @FormatDate(_maintStatus.LastRun.FinishedAt)
                                        <span class="field-note">
                                            · @L.T("settings.maint_result",
                                                ("chats", _maintStatus.LastRun.ChatsPurged.ToString()),
                                                ("mems", _maintStatus.LastRun.MemoriesSynthesized.ToString()),
                                                ("ops", _maintStatus.LastRun.OpsPurged.ToString()))
                                            @(_maintStatus.LastRun.Vacuumed ? " · vacuum" : "")
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="field">
                                <div class="field-label">@L["settings.maint_next_run"]</div>
                                <div class="text-sm">
                                    @(_maintStatus.NextRunAt is null ? L["common.inactive"] : FormatDate(_maintStatus.NextRunAt.Value))
                                </div>
                            </div>
                            <div class="field">
                                <div class="field-label">@L["settings.maint_db_size"]</div>
                                <div class="text-sm">@FormatBytes(_maintStatus.DbSizeBytes)</div>
                            </div>
                        }
                    </SettingsSection>

                    <SettingsSection Title="@L["settings.sec_maint_retention"]" Description="@L["settings.maint_retention_hint"]">
                        <div class="field">
                            <label for="maint-days">@L["settings.maint_chat_days"]</label>
                            <input class="input w-40" id="maint-days" type="number" min="0" max="3650" @bind="_maintChatDays" />
                        </div>
                    </SettingsSection>

                    <SettingsSection Title="@L["settings.sec_maint_run"]" Description="@L["settings.maint_run_hint"]">
                        <div class="field-actions">
                            <button class="button-sm" disabled="@_maintBusy"
                                    @onclick="() => RunMaintenanceAsync(true)">@L["settings.maint_run_dry"]</button>
                            <button class="primary-btn" disabled="@_maintBusy"
                                    @onclick="() => RunMaintenanceAsync(false)">
                                @(_maintBusy ? L["settings.maint_running"] : L["settings.maint_run_now"])</button>
                        </div>
                        @if (_maintResult is not null)
                        {
                            <div class="field-note mt-2">
                                @L.T("settings.maint_result",
                                    ("chats", _maintResult.ChatsPurged.ToString()),
                                    ("mems", _maintResult.MemoriesSynthesized.ToString()),
                                    ("ops", _maintResult.OpsPurged.ToString()))
                                @(_maintResult.DryRun ? $" · {L["settings.maint_dryrun"]}" : "")
                            </div>
                        }
                    </SettingsSection>

                    <SettingsSaveBar Busy="@_maintBusy" Dirty="@MaintDirty"
                                     Message="@_maintMessage"
                                     OnSave="SaveMaintenanceAsync" OnDiscard="DiscardMaintenance" />
                }
                else
                {
                    <div class="field">
                        <div class="field-label">@L["settings.backend_version"]</div>
                        <div>@(_version ?? "…")</div>
                    </div>
                    <div class="field">
                        <div class="field-label">Stack</div>
                        <div>.NET 10 · C# 14 · Blazor WebAssembly</div>
                    </div>
                }
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Controla a visibilidade do modal.</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Disparado quando o modal é fechado.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private string _tab = "general";

    private async Task SelectTab(string tab)
    {
        _tab = tab;
        if (tab == "integrations")
        {
            var gh = await Api.GetGitHubConfigAsync();
            _ghConfigured = gh?.Configured == true;
            _ghLogin = gh?.Login;
            _ghSource = gh?.Source;
            _ghMessage = null;
            _intMessage = null;
            await LoadUserMcpAsync();
            await LoadSecretsAsync();
            await LoadHooksAsync();
        }
        if (tab == "combos")
        {
            _combosMessage = null;
            var combosTask = Api.GetCombosAsync();
            if (_modelCatalog is null)
            {
                await LoadModelCatalogAsync();
            }
            _combos = await combosTask;
        }
        if (tab == "agents")
        {
            _agentsMessage = null;
            var catTask = Api.GetAgentCatalogAsync();
            var extTask = Api.GetExternalAgentsAsync();
            var personaTask = Api.GetAgentPersonasAsync();
            if (_modelCatalog is null)
            {
                await LoadModelCatalogAsync();
            }
            await Task.WhenAll(catTask, extTask, personaTask);
            _agentCatalog = catTask.Result;
            _externalAgents = extTask.Result;
            _personas = personaTask.Result;
        }
        if (tab == "maintenance")
        {
            _maintMessage = null;
            _maintStatus = await Api.GetMaintenanceStatusAsync();
            if (_maintStatus is not null)
            {
                _maintChatDays = _maintStatus.ChatDays;
            }
        }
        if (tab == "models")
        {
            await LoadModelCatalogAsync();
            _byok = await Api.GetUserProviderKeysAsync();
        }
        if (tab == "tools")
        {
            await LoadToolApprovalsAsync();
        }
        if (tab == "admin")
        {
            await LoadAdminConfigLayersAsync();
        }
        if (tab == "notifications")
        {
            _notifyChatDone = await ChatNotify.GetPrefAsync(
                ChatNotificationsService.PrefInApp, defaultValue: true);
            _notifyBrowser = await ChatNotify.GetPrefAsync(
                ChatNotificationsService.PrefBrowser, defaultValue: false);
            _notifyPush = await ChatNotify.GetPrefAsync(
                ChatNotificationsService.PrefPush, defaultValue: false);
            _notifyPermission = await ChatNotify.BrowserPermissionAsync();
        }
    }

    private async Task OnNotifyChatDoneChanged(ChangeEventArgs e)
    {
        _notifyChatDone = e.Value is true;
        await ChatNotify.SetPrefAsync(ChatNotificationsService.PrefInApp, _notifyChatDone);
    }

    private async Task OnNotifyBrowserChanged(ChangeEventArgs e)
    {
        _notifyBrowser = e.Value is true;
        _notifyPermission = await ChatNotify.SetPrefAsync(
            ChatNotificationsService.PrefBrowser, _notifyBrowser);
        // Permissão negada no browser: o toggle não consegue notificar.
        if (_notifyPermission is "denied" or "unsupported")
        {
            _notifyBrowser = false;
            await ChatNotify.SetPrefAsync(ChatNotificationsService.PrefBrowser, false);
        }
    }

    private async Task OnNotifyPushChanged(ChangeEventArgs e)
    {
        _notifyPush = e.Value is true;
        _notifyPermission = await ChatNotify.SetPrefAsync(
            ChatNotificationsService.PrefPush, _notifyPush);
        if (_notifyPermission is "denied" or "unsupported")
        {
            _notifyPush = false;
            await ChatNotify.SetPrefAsync(ChatNotificationsService.PrefPush, false);
        }
    }
    private string _ghToken = string.Empty;
    private bool _ghConfigured;
    private string? _ghLogin;
    private string? _ghSource;
    private bool _ghSaving;
    private string? _ghMessage;

    /// <summary>Valida e salva o PAT do GitHub (server-side, nunca retornado).</summary>
    private async Task SaveGitHubTokenAsync()
    {
        _ghSaving = true;
        _ghMessage = null;
        var result = await Api.SetGitHubTokenAsync(_ghToken.Trim());
        _ghSaving = false;
        if (result?.Configured != true)
        {
            _ghMessage = L["settings.github_save_error"];
            return;
        }

        _ghConfigured = true;
        _ghLogin = result.Login;
        _ghSource = result.Source;
        _ghToken = string.Empty;
        _ghMessage = L.T("settings.github_connected", ("login", _ghLogin ?? ""));
    }

    // ── Secrets do agente (SPEC-20261017-agent-secrets-env) ──
    private List<SecretEntryResponse>? _secrets;
    private string _secretName = string.Empty;
    private string _secretValue = string.Empty;
    private bool _secretsBusy;
    private string? _secretsMessage;

    /// <summary>Carrega os secrets resolvidos (global + override do usuário).</summary>
    private async Task LoadSecretsAsync()
    {
        _secretsMessage = null;
        try
        {
            _secrets = await Api.GetSecretsAsync();
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            _secrets = [];
        }
        _secrets ??= [];
    }

    /// <summary>Cria/atualiza o secret do usuário (valor write-only).</summary>
    private async Task AddSecretAsync()
    {
        _secretsBusy = true;
        _secretsMessage = null;
        var err = await Api.PutSecretAsync(_secretName.Trim(), _secretValue);
        _secretsBusy = false;
        if (err is not null)
        {
            _secretsMessage = err;
            return;
        }
        _secretName = string.Empty;
        _secretValue = string.Empty;
        await LoadSecretsAsync();
    }

    /// <summary>Remove o secret do usuário — o global de mesmo nome volta a valer.</summary>
    private async Task DeleteSecretAsync(string name)
    {
        _secretsBusy = true;
        _secretsMessage = null;
        var ok = await Api.DeleteSecretAsync(name);
        _secretsBusy = false;
        _secretsMessage = ok ? null : L["settings.secrets_op_error"];
        await LoadSecretsAsync();
    }

    private async Task RemoveGitHubTokenAsync()
    {
        _ghMessage = await Api.ClearGitHubTokenAsync()
            ? L["settings.github_removed"]
            : L["settings.github_save_error"];
        if (await Api.GetGitHubConfigAsync() is { } cfg)
        {
            _ghConfigured = cfg.Configured;
            _ghLogin = cfg.Login;
            _ghSource = cfg.Source;
        }
        else
        {
            _ghConfigured = false;
            _ghLogin = null;
            _ghSource = null;
        }
    }

    // ── Models tab (visibilidade por usuário, SPEC model-visibility) ──
    private List<CatalogModel>? _modelCatalog;
    private Dictionary<string, object> _modelsSettings = [];
    private HashSet<string> _disabledModels = new(StringComparer.OrdinalIgnoreCase);
    private string _modelSearch = string.Empty;
    private string? _modelsMessage;
    private bool _modelsSaving;

    // ── Tools tab (overrides de aprovação por tool,
    //    SPEC-20261013-approval-tiers) ──
    private List<ToolApprovalEntry>? _toolApprovals;
    private string? _toolsMessage;
    private bool _toolsSaving;

    /// <summary>Carrega o catálogo de tools + overrides do usuário.</summary>
    private async Task LoadToolApprovalsAsync()
    {
        _toolsMessage = null;
        try
        {
            _toolApprovals =
                (await Api.GetToolApprovalsAsync())?.Tools ?? [];
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            _toolApprovals = [];
            _toolsMessage = L["settings.tools_load_error"];
        }
    }

    /// <summary>Grava (ou remove, com "") o override de uma tool.</summary>
    private async Task SetToolOverrideAsync(string tool, string? action)
    {
        _toolsSaving = true;
        try
        {
            var result = await Api.UpdateToolApprovalsAsync(
                new Dictionary<string, string?> { [tool] = action });
            if (result is not null)
            {
                _toolApprovals = result.Tools;
                _toolsMessage = null;
            }
            else
            {
                _toolsMessage = L["settings.tools_save_error"];
            }
        }
        finally
        {
            _toolsSaving = false;
        }
    }

    /// <summary>Modelo habilitado quando a chave provider:id não está no
    /// conjunto de desabilitados (default = habilitado).</summary>
    private bool ModelEnabled(CatalogModel model) =>
        !_disabledModels.Contains($"{model.Provider}:{model.Id}");

    /// <summary>Grupos por provider respeitando o filtro de busca (nome/id).</summary>
    private IEnumerable<IGrouping<string, CatalogModel>> ModelGroups() =>
        (_modelCatalog ?? [])
            .Where(m => string.IsNullOrWhiteSpace(_modelSearch)
                || m.Name.Contains(_modelSearch, StringComparison.OrdinalIgnoreCase)
                || m.Id.Contains(_modelSearch, StringComparison.OrdinalIgnoreCase))
            .GroupBy(m => m.Provider);

    /// <summary>Carrega catálogo + settings do usuário (aba Models).</summary>
    private async Task LoadModelCatalogAsync()
    {
        _modelsMessage = null;
        try
        {
            _modelCatalog = await Api.GetAllModelsAsync();
            _modelsSettings = await Api.GetUserSettingsAsync() ?? [];
            _disabledModels = _modelCatalog
                .Where(m => !m.Enabled)
                .Select(m => $"{m.Provider}:{m.Id}")
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            var rolesResponse = await Api.GetModelRolesFullAsync();
            _modelRoles = rolesResponse?.Roles?.ToDictionary(kv => kv.Key, kv => kv.Value) ?? [];
            _modelRolesGlobal = rolesResponse?.Global?.ToDictionary(kv => kv.Key, kv => kv.Value) ?? [];
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            _modelCatalog = [];
            _modelsMessage = L["settings.models_load_error"];
        }
    }

    // ── Papéis de modelo (SPEC-20261013-model-roles RF-005) ──
    private static readonly string[] RoleKeys = ["tasks", "memory", "advisor"];
    private Dictionary<string, List<string>> _modelRoles = [];
    private Dictionary<string, List<string>> _modelRolesGlobal = [];

    /// <summary>Primeiro id da cadeia do papel (UI v1 = um modelo por papel;
    /// o resolver já suporta cadeias para uso futuro).</summary>
    private string RoleValue(string role) =>
        _modelRoles.TryGetValue(role, out var chain) && chain.Count > 0
            ? chain[0] : string.Empty;

    /// <summary>
    /// Cadeia herdada do admin quando o papel não tem override do usuário
    /// (SPEC-20261014-config-layers RF-004/RF-006) — vira hint de provenance.
    /// </summary>
    private string? RoleInheritedFrom(string role) =>
        string.IsNullOrEmpty(RoleValue(role))
            && _modelRolesGlobal.TryGetValue(role, out var chain) && chain.Count > 0
                ? string.Join(", ", chain)
                : null;

    /// <summary>Define/remove o modelo de um papel e persiste no servidor.</summary>
    private async Task SetRoleAsync(string role, string? modelId)
    {
        if (string.IsNullOrWhiteSpace(modelId))
        {
            _modelRoles.Remove(role);
        }
        else
        {
            _modelRoles[role] = [modelId];
        }
        _modelsSaving = true;
        _modelsMessage = null;
        var saved = await Api.UpdateModelRolesAsync(
            _modelRoles.ToDictionary(kv => kv.Key, kv => kv.Value));
        _modelsSaving = false;
        if (!saved)
        {
            _modelsMessage = L["settings.model_roles_error"];
        }
    }

    // ── BYOK — chaves de provider do usuário (SPEC-20261014-config-layers RF-005) ──
    private static readonly string[] ByokProviders = ["openai", "anthropic", "google"];
    private UserProviderKeysResponse? _byok;
    private readonly Dictionary<string, string?> _byokDrafts = new();
    private bool _byokSaving;

    /// <summary>Grava a chave BYOK do provider (valor nunca volta do servidor).</summary>
    private async Task SaveByokAsync(string provider)
    {
        var key = _byokDrafts.GetValueOrDefault(provider)?.Trim();
        if (string.IsNullOrEmpty(key))
        {
            return;
        }
        _byokSaving = true;
        if (await Api.SetUserProviderKeyAsync(provider, key))
        {
            _byokDrafts[provider] = null;
            _byok = await Api.GetUserProviderKeysAsync();
        }
        _byokSaving = false;
    }

    /// <summary>Remove a chave BYOK do provider (volta à chave global).</summary>
    private async Task ClearByokAsync(string provider)
    {
        _byokSaving = true;
        if (await Api.DeleteUserProviderKeyAsync(provider))
        {
            _byok = await Api.GetUserProviderKeysAsync();
        }
        _byokSaving = false;
    }

    // ── MCP do usuário (SPEC-20261014-config-layers RF-002) ──
    private List<UserMcpServerEntry>? _userMcp;
    private string _mcpName = string.Empty;
    private string _mcpUrl = string.Empty;
    private bool _mcpSaving;
    private string? _mcpMessage;

    /// <summary>Carrega o catálogo efetivo de MCP do usuário.</summary>
    private async Task LoadUserMcpAsync()
    {
        _mcpMessage = null;
        try
        {
            _userMcp = await Api.GetUserMcpServersAsync();
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            _userMcp = [];
        }
    }

    /// <summary>Toggle do servidor: global grava tombstone; próprio liga/desliga.</summary>
    private async Task ToggleUserMcpAsync(UserMcpServerEntry entry)
    {
        _mcpSaving = true;
        var ok = await Api.SetUserMcpServerEnabledAsync(entry.Server.Id, !entry.EnabledForMe);
        _mcpSaving = false;
        if (ok)
        {
            await LoadUserMcpAsync();
        }
        else
        {
            _mcpMessage = L["settings.mcp_error"];
        }
    }

    /// <summary>Cria um servidor MCP do usuário (só transporte http remoto).</summary>
    private async Task AddUserMcpAsync()
    {
        _mcpSaving = true;
