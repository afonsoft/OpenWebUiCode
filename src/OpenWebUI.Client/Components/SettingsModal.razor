        }
        await SaveDisabledModelsAsync();
    }

    /// <summary>Habilita/desabilita todos os modelos de um provider.</summary>
    private async Task SetProviderEnabledAsync(string provider, bool enabled)
    {
        foreach (var model in (_modelCatalog ?? []).Where(m => m.Provider == provider))
        {
            var key = $"{model.Provider}:{model.Id}";
            if (enabled)
            {
                _disabledModels.Remove(key);
            }
            else
            {
                _disabledModels.Add(key);
            }
        }
        await SaveDisabledModelsAsync();
    }

