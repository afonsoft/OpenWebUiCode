    /// <summary>Índice da conexão OpenAI cuja URL casa com o provider selecionado.</summary>
    private int? ProviderIndex(string? providerUrl)
    {
        if (string.IsNullOrWhiteSpace(providerUrl) || _connections is null)
        {
            return null;
        }
        for (var i = 0; i < _connections.OpenAiBaseUrls.Count; i++)
        {
            if (string.Equals(_connections.OpenAiBaseUrls[i].TrimEnd('/'),
                    providerUrl.TrimEnd('/'), StringComparison.OrdinalIgnoreCase))
            {
                return i;
            }
        }
        return null;
    }

