    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        // Sadece kapalı→açık geçişinde yükle. Önceden OnParametersSetAsync'ti:
        // Blazor ilk render'ı await bitene kadar bekletiyordu — modal ~10
        // sıralı HTTP çağrısı (uzun provider timeout'ları dahil) boyunca
        // açılmıyordu ve her parent render'da baştan çalışıyordu.
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            _ = LoadAsync();
        }
        else if (!IsOpen)
        {
            _wasOpen = false;
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            // 1. lote: bağımsız temel veriler paralel (önceden sıralıydı).
            var versionTask = Api.GetVersionAsync();
            var apiKeyTask = Api.GetApiKeyAsync();
            var memoriesTask = Api.GetMemoriesAsync();
            var webhookTask = Api.GetWebhookAsync();
            var memSyncTask = Api.GetMemorySyncAsync();
            await Task.WhenAll(
                versionTask, apiKeyTask, memoriesTask, webhookTask, memSyncTask);

            _version = versionTask.Result?.Version;
            _name = Auth.CurrentUser?.Name ?? string.Empty;
            _profileImage = Auth.CurrentUser?.ProfileImageUrl ?? string.Empty;
            _loadedName = _name;
            _loadedImage = _profileImage;
            _apiKeyInfo = apiKeyTask.Result;
            _memories = memoriesTask.Result;
            _memSync = memSyncTask.Result;
            if (_memSync is not null)
            {
                _memSyncInterval = _memSync.IntervalHours;
                _memSyncMaxAge = _memSync.MaxAgeDays;
            }

            _webhook = webhookTask.Result;
            if (_webhook is not null)
            {
                _webhookUrl = _webhook.Url;
                _webhookEvents = _webhook.Events.ToHashSet();
                _webhookEnabled = _webhook.Enabled;
            }
            await LoadAudioSettingsAsync();
            await InvokeAsync(StateHasChanged);

            if (Auth.CurrentUser?.Role != "admin")
            {
                return;
            }

            // 2. lote: admin + provider keşfi paralel; uzun timeout'lu
            // provider sorguları açılışı kilitlemeden arka planda doluyor.
            var connectionsTask = Api.GetConnectionsAsync();
            var adminConfigTask = Api.GetAdminConfigAsync();
            var ollamaTask = LoadOllamaModelsAsync();
            await Task.WhenAll(connectionsTask, adminConfigTask, ollamaTask);

            _connections = connectionsTask.Result;
            RebuildConnectionRows();
            _connSnapshot = ConnectionsSnapshot();

            var adminConfig = adminConfigTask.Result;
            if (adminConfig is not null)
            {
                _adminWebUiName = adminConfig.WebUiName;
                _adminDefaultRole = adminConfig.DefaultUserRole;
                _adminEnableSignup = adminConfig.EnableSignup;
                _adminEnableLoginForm = adminConfig.EnableLoginForm;
                _adminEnableApiKeys = adminConfig.EnableApiKeys;
                _adminEnableRating = adminConfig.EnableMessageRating;
                _adminEnableFolders = adminConfig.EnableFolders;
                _adminEnableMemories = adminConfig.EnableMemories;

                // 3. lote: bağımsız admin verileri paralel.
                var capsTask = Api.GetDetectedCapabilitiesAsync();
                var audioTask = Api.GetAudioConfigAsync();
                var adminWebhookTask = Api.GetAdminWebhookAsync();
                await Task.WhenAll(capsTask, audioTask, adminWebhookTask);

                _capabilities = capsTask.Result;

                var audio = audioTask.Result;
                if (audio is not null)
                {
                    _ttsEngine = audio.TtsEngine;
                    _ttsProvider = audio.TtsProvider ?? string.Empty;
                    _ttsBaseUrl = audio.TtsBaseUrl ?? string.Empty;
                    _ttsModel = audio.TtsModel ?? string.Empty;
                    _ttsVoice = audio.TtsVoice ?? "alloy";
                    _sttEngine = audio.SttEngine;
                    _sttProvider = audio.SttProvider ?? string.Empty;
                    _sttBaseUrl = audio.SttBaseUrl ?? string.Empty;
                    _sttModel = audio.SttModel ?? string.Empty;
                }
                // Bu ikisi provider alanlarına bağımlı — audio geldikten sonra.
                await Task.WhenAll(LoadSttProviderModelsAsync(), LoadTtsProviderModelsAsync());

                _adminWebhook = adminWebhookTask.Result;
                if (_adminWebhook is not null)
                {
                    _adminWebhookUrl = _adminWebhook.Url;
                    _adminWebhookEvents = _adminWebhook.Events.ToHashSet();
                    _adminWebhookEnabled = _adminWebhook.Enabled;
                }

                _adminLoaded = true;
                _adminBaseline = CurrentAdminConfig();
                _adminDirtySnapshot = AdminSnapshot();
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"settings load: {ex.Message}");
        }
    }

