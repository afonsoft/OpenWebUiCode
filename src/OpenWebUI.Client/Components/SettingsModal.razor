    /// <summary>Save unificado da tab Account: perfil + senha (se preenchida) + webhook.</summary>
    private async Task SaveAccountAsync()
    {
        _accountSaving = true;
        _accountMessage = null;
        _webhookMessage = null;
        var ok = true;
        if (_name != (_loadedName ?? string.Empty) || _profileImage != (_loadedImage ?? string.Empty))
        {
            var user = await Api.UpdateProfileAsync(_name.Trim(), _profileImage.Trim());
            if (user is null)
            {
                ok = false;
            }
            else
            {
                await Auth.RefreshUserAsync();
                _loadedName = _name;
                _loadedImage = _profileImage;
            }
        }
        if (_currentPassword.Length > 0 || _newPassword.Length > 0)
        {
            ok &= await Api.UpdatePasswordAsync(_currentPassword, _newPassword);
            _currentPassword = string.Empty;
            _newPassword = string.Empty;
        }
        if (WebhookDirty)
        {
            var saved = await Api.SaveWebhookAsync(new NotificationWebhookRequest(
                _webhookUrl.Trim(), _webhookEvents.ToList(), _webhookEnabled));
            _webhook = saved;
            ok &= saved is not null;
        }
        _accountSaving = false;
        _accountMessage = ok ? L["settings.saved"] : L["settings.save_failed"];
    }

    /// <summary>Descarta as edições da tab Account restaurando os baselines.</summary>
    private void DiscardAccountAsync()
    {
        _name = _loadedName ?? string.Empty;
        _profileImage = _loadedImage ?? string.Empty;
        _currentPassword = string.Empty;
        _newPassword = string.Empty;
        _webhookUrl = _webhook?.Url ?? string.Empty;
        _webhookEvents = _webhook?.Events.ToHashSet() ?? [];
        _webhookEnabled = _webhook?.Enabled ?? true;
        _accountMessage = null;
        _webhookMessage = null;
    }

