    private bool _ttsSupported;
    private bool _sttSupported;
    private bool _audioAutoSend;
    private string _audioVoice = string.Empty;
    private string _audioEngine = "auto";
    private List<VoiceInfo> _audioVoices = [];

    private sealed record VoiceInfo(string Name, string Lang);

    private async Task LoadAudioSettingsAsync()
    {
        _audioEngine = await JS.InvokeAsync<string>("openwebui.audio.getEngine");
        _ttsSupported = await JS.InvokeAsync<bool>("openwebui.audio.ttsSupported");
        _sttSupported = await JS.InvokeAsync<bool>("openwebui.audio.sttSupported");
        if (!_ttsSupported && !_sttSupported)
        {
            return;
        }

        _audioVoice = await JS.InvokeAsync<string>("openwebui.audio.getVoice");
        _audioAutoSend = await JS.InvokeAsync<bool>("openwebui.audio.getAutoSend");
        _audioVoices = await JS.InvokeAsync<List<VoiceInfo>>("openwebui.audio.voices");
    }

    private async Task OnAudioEngineChanged(ChangeEventArgs e)
    {
        _audioEngine = e.Value as string ?? "auto";
        await JS.InvokeVoidAsync("openwebui.audio.setEngine", _audioEngine);
        _ttsSupported = await JS.InvokeAsync<bool>("openwebui.audio.ttsSupported");
        _sttSupported = await JS.InvokeAsync<bool>("openwebui.audio.sttSupported");
    }

    private async Task OnAudioVoiceChanged(ChangeEventArgs e)
    {
        _audioVoice = e.Value as string ?? string.Empty;
        await JS.InvokeVoidAsync("openwebui.audio.setVoice", _audioVoice);
    }

    private async Task OnAutoSendChanged(ChangeEventArgs e)
    {
        _audioAutoSend = e.Value is true;
        await JS.InvokeVoidAsync("openwebui.audio.setAutoSend", _audioAutoSend);
    }

    private async Task SaveProfileAsync()
    {
        var user = await Api.UpdateProfileAsync(_name.Trim(), _profileImage.Trim());
        if (user is not null)
        {
            await Auth.RefreshUserAsync();
            _accountMessage = L["settings.profile_saved"];
        }
        else
        {
            _accountMessage = L["settings.profile_failed"];
        }
    }

    private async Task ChangePasswordAsync()
    {
        var ok = await Api.UpdatePasswordAsync(_currentPassword, _newPassword);
        _accountMessage = ok ? L["settings.password_changed"] : L["settings.password_failed"];
        _currentPassword = string.Empty;
        _newPassword = string.Empty;
    }

    private async Task CreateApiKeyAsync()
    {
        var created = await Api.CreateApiKeyAsync();
        _apiKeyCreated = created?.ApiKey;
    }

    private async Task RevokeApiKeyAsync()
    {
        await Api.DeleteApiKeyAsync();
        _apiKeyCreated = null;
        _apiKeyInfo = null;
    }

    private async Task AddMemoryAsync()
    {
        var added = await Api.AddMemoryAsync(_newMemory.Trim());
        if (added is not null)
        {
            _memories.Add(added);
            _newMemory = string.Empty;
        }
    }

    private async Task DeleteMemoryAsync(MemoryResponse memory)
    {
        if (await Api.DeleteMemoryAsync(memory.Id))
        {
            _memories.Remove(memory);
        }
    }

    private async Task LoadOllamaModelsAsync()
    {
        // Sem conexão Ollama cadastrada o endpoint devolveria 503 — nem chama.
        if (_ollamaRows.Count == 0)
        {
            _ollamaModels = [];
            return;
        }
        var tags = await Api.GetOllamaTagsAsync();
        _ollamaModels = tags?.Models.ToList() ?? [];
    }

    private async Task PullOllamaModelAsync()
    {
        _ollamaPulling = true;
        _ollamaPullMessage = null;
        var ok = await Api.PullOllamaModelAsync(_ollamaPullName.Trim());
        _ollamaPulling = false;
        _ollamaPullMessage = ok ? L["settings.model_pulled"] : L["settings.pull_failed"];
        if (ok)
        {
            _ollamaPullName = string.Empty;
            await LoadOllamaModelsAsync();
        }
    }

    private async Task DeleteOllamaModelAsync(OllamaModelInfo model)
    {
        if (model.Name is not null && await Api.DeleteOllamaModelAsync(model.Name))
        {
            _ollamaModels?.Remove(model);
        }
    }

    private async Task SaveConnectionsAsync()
    {
        var ollama = _ollamaRows.Select(r => r.Url.Trim()).Where(u => u.Length > 0).ToList();
        var ollamaNames = _ollamaRows.Where(r => r.Url.Trim().Length > 0).Select(r => r.Name.Trim()).ToList();
        var openAiRows = _openAiRows.Where(r => r.Url.Trim().Length > 0).ToList();
        var openAi = openAiRows.Select(r => r.Url.Trim()).ToList();
        var openAiNames = openAiRows.Select(r => r.Name.Trim()).ToList();
        var keys = openAiRows.Select(r => r.Key.Trim()).ToList();
        var providerRows = _providerRows
            .Where(r => r.Url.Trim().Length > 0)
            .Select(r => new ProviderConnection(
                r.Type, r.Url.Trim(),
                r.Key.Trim().Length > 0 ? r.Key.Trim() : null,
                r.Name.Trim().Length > 0 ? r.Name.Trim() : null))
            .ToList();

        // Chaves deixadas em branco são preservadas pelo servidor.
        var result = await Api.UpdateConnectionsAsync(
            new ConnectionsConfig(ollama, openAi, keys, ollamaNames, openAiNames, providerRows));
        _saveMessage = result is null ? L["settings.save_failed"] : L["settings.saved"];
        _connections = result;
        if (result is not null)
        {
            for (var i = 0; i < _openAiRows.Count && i < result.OpenAiKeyConfigured.Count; i++)
            {
                _openAiRows[i].KeyConfigured = result.OpenAiKeyConfigured[i];
                _openAiRows[i].Key = string.Empty;
            }

            for (var i = 0; i < _providerRows.Count && result.Providers is not null && i < result.Providers.Count; i++)
            {
                _providerRows[i].KeyConfigured = result.Providers[i].KeyConfigured;
                _providerRows[i].Key = string.Empty;
            }
        }
    }

    private async Task SaveAdminAsync()
    {
        var result = await Api.UpdateAdminConfigAsync(new AdminConfig(
            _adminEnableSignup,
            _adminEnableLoginForm,
            _adminEnableApiKeys,
            _adminDefaultRole,
            _adminEnableRating,
            _adminEnableFolders,
            _adminEnableMemories,
            _adminWebUiName.Trim()));
        var audio = await SaveAudioAsync();
        _adminMessage = result is null || audio is null
            ? L["settings.save_failed"]
            : L["settings.admin_saved"];
    }

    /// <summary>Persiste apenas a configuração de áudio (admin) e invalida o cache de capabilities do JS.</summary>
    private async Task<AudioConfig?> SaveAudioAsync()
    {
        var saved = await Api.UpdateAudioConfigAsync(new AudioConfig(
            _sttEngine,
            _sttEngine is "openai" or "deepgram" or "whisper" ? _sttBaseUrl.Trim() : null,
            null,
            string.IsNullOrWhiteSpace(_sttModel) ? null : _sttModel.Trim(),
            _ttsEngine,
            _ttsEngine is "openai" or "transformers" or "elevenlabs" or "azure"
                ? _ttsBaseUrl.Trim() : null,
            null,
            string.IsNullOrWhiteSpace(_ttsModel) ? null : _ttsModel.Trim(),
            _ttsVoice.Trim(),
            null,
            _sttEngine == "provider" ? _sttProvider : null,
            _ttsEngine == "provider" ? _ttsProvider : null));
        await JS.InvokeVoidAsync("openwebui.audio.refreshCaps");
        return saved;
    }

    /// <summary>Índice da conexão OpenAI cuja URL casa com o provider selecionado.</summary>
    private int? ProviderIndex(string? providerUrl)
    {
        if (string.IsNullOrWhiteSpace(providerUrl) || _connections is null)
        {
            return null;
        }
        for (var i = 0; i < _connections.OpenAiBaseUrls.Count; i++)
        {
            if (string.Equals(_connections.OpenAiBaseUrls[i].TrimEnd('/'),
                    providerUrl.TrimEnd('/'), StringComparison.OrdinalIgnoreCase))
            {
                return i;
            }
        }
        return null;
    }

    /// <summary>Carrega modelos STT da conexão selecionada como provider.</summary>
    private async Task LoadSttProviderModelsAsync()
    {
        var index = ProviderIndex(_sttProvider);
        var caps = index is null ? null : await Api.GetConnectionCapabilitiesAsync("openai", index.Value);
        _sttProviderModels = caps?.Stt.ToList() ?? [];
    }

    /// <summary>Carrega modelos TTS da conexão selecionada como provider.</summary>
    private async Task LoadTtsProviderModelsAsync()
    {
        var index = ProviderIndex(_ttsProvider);
        var caps = index is null ? null : await Api.GetConnectionCapabilitiesAsync("openai", index.Value);
        _ttsProviderModels = caps?.Tts.ToList() ?? [];
    }

    /// <summary>Modelos TTS do provider selecionado (ou agregados para engines diretas).</summary>
    private IEnumerable<string> TtsModelOptions() =>
        ModelOptions(_ttsEngine == "provider" ? _ttsProviderModels : _capabilities?.Tts ?? [], _ttsModel);

    /// <summary>Modelos STT do provider selecionado (ou agregados para engines diretas).</summary>
    private IEnumerable<string> SttModelOptions() =>
        ModelOptions(_sttEngine == "provider" ? _sttProviderModels : _capabilities?.Stt ?? [], _sttModel);

    private async Task TestAudioAsync()
    {
        _audioTesting = true;
        _adminMessage = null;
        await SaveAudioAsync();
        var result = await Api.TestAudioConfigAsync();
        _adminMessage = result is null
            ? L["settings.save_failed"]
            : result.Ok ? L["settings.audio_test_ok"] : $"{L["settings.audio_test_fail"]}: {result.Detail}";
        _audioTesting = false;
    }

    /// <summary>Opções do combo: modelos detectados + valor atual caso ausente.</summary>
    private static IEnumerable<string> ModelOptions(
        IReadOnlyList<string> detected, string current)
    {
        if (!string.IsNullOrWhiteSpace(current) && !detected.Contains(current))
        {
            yield return current;
        }
        foreach (var m in detected)
        {
            yield return m;
        }
    }

    /// <summary>URLs das conexões cadastradas + base detectada + valor atual.</summary>
    private IEnumerable<string> ProviderOptions(string? detectedBase, string current)
    {
        var urls = _connections?.OpenAiBaseUrls ?? [];
        foreach (var url in urls.Where(u => !string.IsNullOrWhiteSpace(u)))
        {
            yield return url.TrimEnd('/');
        }
        if (!string.IsNullOrWhiteSpace(detectedBase) && !urls.Contains(detectedBase))
        {
            yield return detectedBase;
        }
        if (!string.IsNullOrWhiteSpace(current) && !urls.Contains(current)
            && current != detectedBase)
        {
            yield return current;
        }
    }

    private string FormatDate(long unixSeconds) =>
        L.FormatDate(DateTimeOffset.FromUnixTimeSeconds(unixSeconds).LocalDateTime);

    private Task Close() => OnClose.InvokeAsync();
}
