    private async Task SaveConnectionsAsync()
    {
        var ollama = _ollamaRows.Select(r => r.Url.Trim()).Where(u => u.Length > 0).ToList();
        var ollamaNames = _ollamaRows.Where(r => r.Url.Trim().Length > 0).Select(r => r.Name.Trim()).ToList();
        var openAiRows = _openAiRows.Where(r => r.Url.Trim().Length > 0).ToList();
        var openAi = openAiRows.Select(r => r.Url.Trim()).ToList();
        var openAiNames = openAiRows.Select(r => r.Name.Trim()).ToList();
        var keys = openAiRows.Select(r => r.Key.Trim()).ToList();
        var providerRows = _providerRows
            .Where(r => r.Url.Trim().Length > 0)
            .Select(r => new ProviderConnection(
                r.Type, r.Url.Trim(),
                r.Key.Trim().Length > 0 ? r.Key.Trim() : null,
                r.Name.Trim().Length > 0 ? r.Name.Trim() : null))
            .ToList();

        // Chaves deixadas em branco são preservadas pelo servidor.
        _connSaving = true;
        var result = await Api.UpdateConnectionsAsync(
            new ConnectionsConfig(ollama, openAi, keys, ollamaNames, openAiNames, providerRows));
        _connSaving = false;
        _saveMessage = result is null ? L["settings.save_failed"] : L["settings.saved"];
        _connections = result;
        if (result is not null)
        {
            for (var i = 0; i < _openAiRows.Count && i < result.OpenAiKeyConfigured.Count; i++)
            {
                _openAiRows[i].KeyConfigured = result.OpenAiKeyConfigured[i];
                _openAiRows[i].Key = string.Empty;
            }

            for (var i = 0; i < _providerRows.Count && result.Providers is not null && i < result.Providers.Count; i++)
            {
                _providerRows[i].KeyConfigured = result.Providers[i].KeyConfigured;
                _providerRows[i].Key = string.Empty;
            }

            _connSnapshot = ConnectionsSnapshot();
        }
    }

