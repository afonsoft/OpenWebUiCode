@inject ApiService Api
@inject LocalizationService L

@* Painel de vínculo repo↔workspace (SPEC-20261008-github-repo-workspace):
   exibe o repo/branch vinculados, lista repositórios do usuário (PAT
   configurado), permite digitar owner/repo manualmente, escolhe a branch
   e abre o checkout no workspace. Usado pelo RepoPickerModal (header do
   chat) e pela aba Integrações das configurações admin. *@
@if (_loading)
{
    <div class="field-note">@L["common.loading"]</div>
}
else
{
    @if (_bound?.Repo is { } boundRepo)
    {
        <div class="memory-row">
            <div class="memory-text min-w-0">
                <div class="text-sm text-gray-800 dark:text-gray-100 truncate font-mono">@boundRepo</div>
                <div class="field-note mt-0">@L.T("chat.repo_bound_branch", ("branch", _bound.Branch ?? ""))
                    @if (_source is { } src)
                    {
                        <span class="role-badge ms-1">@L[$"chat.repo_source_{src}"]</span>
                    }
                </div>
            </div>
            <div class="card-actions">
                <button type="button" class="msg-action danger"
                        @onclick="UnbindAsync">@L["chat.repo_unbind"]</button>
            </div>
        </div>
    }

    @if (_ghConfigured)
    {
        <div class="field">
            <label for="repo-search">@L["chat.repo_search_label"]</label>
            <input id="repo-search" class="input" type="search"
                   placeholder="@L["chat.repo_search_ph"]"
                   @bind="_filter" @bind:event="oninput" />
        </div>
        @if (_repos is null)
        {
            <div class="field-note">@L["common.loading"]</div>
        }
        else if (Filtered.Count == 0)
        {
            <div class="field-note">@L["chat.repo_search_empty"]</div>
        }
        else
        {
            <div class="card-list max-h-56 overflow-y-auto">
                @foreach (var repo in Filtered)
                {
                    <button type="button"
                            class="card-row w-full text-left @(repo.FullName == _slug ? "ring-2 ring-gray-300/60 dark:ring-gray-600" : "")"
                            @onclick="() => SelectRepoAsync(repo)">
                        <div class="card-main">
                            <div class="card-title font-mono">@repo.FullName</div>
                            @if (repo.Description is { Length: > 0 } desc)
                            {
                                <div class="card-sub">@desc</div>
                            }
                        </div>
                        @if (repo.Private)
                        {
                            <span class="role-badge">@L["chat.repo_private"]</span>
                        }
                    </button>
                }
            </div>
        }
    }
    else
    {
        <div class="field-note">@L["chat.repo_no_token"]</div>
    }

    <hr class="modal-sep" />

    <div class="field">
        <label for="repo-slug">@L["chat.repo_manual"]</label>
        <input id="repo-slug" class="input font-mono" type="text"
               placeholder="owner/repo" @bind="_slug" @bind:event="oninput"
               @bind:after="OnSlugChangedAsync" />
    </div>
    <div class="field">
        <label for="repo-branch">@L["chat.repo_branch_label"]</label>
        @if (_branches is { Count: > 0 })
        {
            <select id="repo-branch" class="input" @bind="_branch">
                @foreach (var b in _branches)
                {
                    <option value="@b">@b</option>
                }
            </select>
        }
        else
        {
            <input id="repo-branch-text" class="input font-mono" type="text"
                   aria-label="@L.T("chat.repo_branch")"
                   placeholder="main" @bind="_branch" />
        }
    </div>
    @if (_message is not null)
    {
        <div class="field-note">@_message</div>
    }
    <div class="field-actions">
        <button type="button" class="auth-submit"
                disabled="@(_opening || string.IsNullOrWhiteSpace(_slug) || string.IsNullOrWhiteSpace(_branch) || !_slug.Contains('/'))"
                @onclick="OpenAsync">
            @(_opening ? L["chat.repo_opening"] : L["chat.repo_open_btn"])
        </button>
    </div>
}

@code {
    /// <summary>Disparado quando o binding muda (null = desvinculado).</summary>
    [Parameter] public EventCallback<WorkspaceRepoResponse?> BoundChanged { get; set; }

    /// <summary>Disparado com a origem do binding efetivo (chat|user|none).</summary>
    [Parameter] public EventCallback<string?> SourceChanged { get; set; }

    /// <summary>
    /// Escopo do binding (SPEC-20261010-chat-repo-binding): quando setado,
    /// o painel opera no binding POR CHAT; null = global do usuário.
    /// </summary>
    [Parameter] public string? ChatId { get; set; }

    /// <summary>
    /// SPEC-15: true = o painel nunca toca o binding global — sem
    /// <see cref="ChatId"/> a escolha volta ao pai como seleção pendente
    /// (sintética) e vira binding por chat quando o chat existir.
    /// </summary>
    [Parameter] public bool ChatScopedOnly { get; set; }

    /// <summary>Disparado após abrir um repo com sucesso (o modal fecha).</summary>
    [Parameter] public EventCallback Opened { get; set; }

    /// <summary>Disparado após desvincular (o modal devolve o foco ao dialog).</summary>
    [Parameter] public EventCallback Unbound { get; set; }

    private bool _loading = true;
    private bool _opening;
    private bool _ghConfigured;
    private List<GitHubRepoResponse>? _repos;
    private List<string>? _branches;
    private WorkspaceRepoResponse? _bound;
    private string? _source;
    private string _filter = string.Empty;
    private string _slug = string.Empty;
    private string _branch = "main";
    private string? _message;

    private List<GitHubRepoResponse> Filtered
    {
        get
        {
            if (_repos is null)
            {
                return [];
            }
            if (string.IsNullOrWhiteSpace(_filter))
            {
                return _repos;
            }
            return _repos.Where(r =>
                r.FullName.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cfgTask = Api.GetGitHubConfigAsync();
            if (ChatId is { } cid)
            {
                var resp = await Api.GetChatWorkspaceRepoAsync(cid);
                _bound = resp?.Binding;
                _source = resp?.Source;
            }
            else if (!ChatScopedOnly)
            {
                _bound = await Api.GetWorkspaceRepoAsync();
                _source = null;
            }
            var cfg = await cfgTask;
            _ghConfigured = cfg?.Configured == true;
            if (_bound?.Repo is { } repo)
            {
                _slug = repo;
                _branch = _bound.Branch ?? "main";
                _ = LoadBranchesAsync();
            }
            if (_ghConfigured)
            {
                _repos = await Api.GetGitHubReposAsync();
            }
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            _message = L["chat.repo_load_error"];
        }
        _loading = false;
    }

    private async Task SelectRepoAsync(GitHubRepoResponse repo)
    {
        _slug = repo.FullName;
        _branch = repo.DefaultBranch;
        await LoadBranchesAsync();
    }

    private async Task OnSlugChangedAsync()
    {
        _branches = null;
        if (_ghConfigured && _slug.Split('/') is { Length: 2 } parts
            && parts.All(p => p.Length > 0))
        {
            await LoadBranchesAsync();
        }
    }

    private async Task LoadBranchesAsync()
    {
        var parts = _slug.Split('/');
        if (parts.Length != 2)
        {
            return;
        }
        var result = await Api.GetGitHubBranchesAsync(parts[0], parts[1]);
        _branches = result?.Branches.ToList();
        if (result is not null && !string.IsNullOrEmpty(result.DefaultBranch)
            && (_branches?.Contains(_branch) != true || _branch == "main"))
        {
            _branch = result.DefaultBranch;
        }
    }

    private async Task OpenAsync()
    {
        _opening = true;
        _message = null;
        WorkspaceRepoResponse? opened;
        if (ChatId is { } cid)
        {
            var resp = await Api.PutChatWorkspaceRepoAsync(cid, _slug.Trim(), _branch.Trim());
            opened = resp?.Binding;
            _source = resp?.Source;
            await SourceChanged.InvokeAsync(_source);
        }
        else if (ChatScopedOnly)
        {
            // Chat ainda não persistido: devolve a seleção pendente — o pai
            // cria o binding por chat no primeiro envio (SPEC-15).
            opened = new WorkspaceRepoResponse(_slug.Trim(), _branch.Trim(), null);
            _source = "pending";
            await SourceChanged.InvokeAsync(_source);
        }
        else
        {
            opened = await Api.OpenWorkspaceRepoAsync(_slug.Trim(), _branch.Trim());
        }
        _opening = false;
        if (opened?.Repo is null)
        {
            _message = L["chat.repo_open_error"];
            return;
        }

        _bound = opened;
        await BoundChanged.InvokeAsync(opened);
        await Opened.InvokeAsync();
    }

    private async Task UnbindAsync()
    {
        if (ChatId is null && ChatScopedOnly)
        {
            // Só havia seleção pendente (sem chat) — limpa localmente.
            _bound = null;
            _source = null;
            await BoundChanged.InvokeAsync(null);
            await SourceChanged.InvokeAsync(null);
            await Unbound.InvokeAsync();
            return;
        }
        if (ChatId is { } cid)
        {
            // Desvincula o binding POR CHAT — SPEC-15: a resposta volta
            // "none" (o global não vaza mais para dentro do chat).
            var resp = await Api.PutChatWorkspaceRepoAsync(cid, null, null);
            if (resp is not null)
            {
                _bound = resp.Binding;
                _source = resp.Source;
                await BoundChanged.InvokeAsync(resp.Binding);
                await SourceChanged.InvokeAsync(resp.Source);
                await Unbound.InvokeAsync();
                return;
            }
        }
        else if (await Api.UnbindWorkspaceRepoAsync())
        {
            _bound = null;
            await BoundChanged.InvokeAsync(null);
            await Unbound.InvokeAsync();
            return;
        }
        _message = L["chat.repo_unbind_error"];
    }
}
