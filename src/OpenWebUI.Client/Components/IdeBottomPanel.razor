@inject ApiService Api
@inject LocalizationService L
@inject IJSRuntime JS

@* Panel inferior estilo VS Code (SPEC-20261011-ide-workbench Fase A): abas
   Problems | Terminal | Jobs | Preview com ✕ de fechar; altura controlada
   pela página (sash arrastável). *@

<div class="flex h-full min-h-0 flex-col border-t border-gray-200 dark:border-gray-800">
    <div class="flex items-center border-b border-gray-200 dark:border-gray-800"
         role="tablist" aria-label="@L["ide.bottom_panel"]" @ref="_tabList" @onkeydown="OnTabKeyDown">
        @foreach (var tab in Tabs)
        {
            var isActive = _tab == tab;
            <button class="px-3 py-1 text-xs @(isActive ? "border-b-2 border-blue-500 text-gray-900 dark:text-white font-medium" : "text-gray-500 hover:text-gray-800 dark:hover:text-gray-200")"
                    role="tab" aria-selected="@(isActive ? "true" : "false")"
                    @onclick="() => _tab = tab">
                @TabLabel(tab)@if (tab == "problems" && ProblemsCount > 0)
                {
                    <text> (@ProblemsCount)</text>
                }
            </button>
        }
        <div class="flex-1"></div>
        <button class="msg-action" title="@L["ide.toggle_bottom"]" aria-label="@L["ide.toggle_bottom"]"
                @onclick="() => OnClose.InvokeAsync()">✕</button>
    </div>
    <div class="flex-1 min-h-0 overflow-auto">
        @switch (_tab)
        {
            case "problems":
                @if (Problems.Count == 0)
                {
                    <div class="px-3 py-6 text-center text-xs text-gray-400">@L["ide.problems_none"]</div>
                }
                else
                {
                    <div class="divide-y divide-gray-100 dark:divide-gray-800">
                        @foreach (var p in Problems)
                        {
                            <button class="flex w-full items-center gap-2 px-3 py-1 text-left hover:bg-gray-50 dark:hover:bg-gray-800/50"
                                    @onclick="() => OnProblemClick.InvokeAsync(p)">
                                <span class="shrink-0 text-[0.625rem] @(p.Severity == 1 ? "text-red-500" : "text-amber-500")" aria-hidden="true">
                                    @(p.Severity == 1 ? "✖" : "⚠")
                                </span>
                                <span class="min-w-0 flex-1 truncate text-[0.6875rem] text-gray-700 dark:text-gray-300">@p.Message</span>
                                <span class="shrink-0 font-mono text-[0.625rem] text-gray-400">@p.Path:@p.Line:@p.Col</span>
                            </button>
                        }
                    </div>
                }
                break;
            case "terminal":
                <TerminalView />
                break;
            case "jobs":
                @if (Jobs.Count == 0)
                {
                    <div class="px-3 py-6 text-center text-xs text-gray-400">@L["chat.panel_no_jobs"]</div>
                }
                else
                {
                    <div class="divide-y divide-gray-100 dark:divide-gray-800">
                        @foreach (var job in Jobs)
                        {
                            <div class="flex items-center gap-2 px-3 py-1.5">
                                <span class="h-1.5 w-1.5 shrink-0 rounded-full @JobDotCss(job.Status)" aria-hidden="true"></span>
                                <span class="min-w-0 flex-1 truncate font-mono text-[0.6875rem] text-gray-700 dark:text-gray-300" title="@job.Command">@job.Command</span>
                                <span class="text-[0.625rem] text-gray-400">@job.Status</span>
                                @if (job.Status == "running")
                                {
                                    <button class="text-[0.625rem] text-red-500 hover:underline"
                                            @onclick="() => KillJobAsync(job.Id)">kill</button>
                                }
                            </div>
                        }
                    </div>
                }
                break;
            case "preview":
                <IdePreviewPanel />
                break;
        }
    </div>
</div>

@code {
    /// <summary>Jobs de background do usuário.</summary>
    [Parameter] public List<ChatJobResponse> Jobs { get; set; } = [];

    /// <summary>Diagnósticos LSP agregados (do editor).</summary>
    [Parameter] public IReadOnlyList<LspDiagnosticItem> Problems { get; set; } = [];

    /// <summary>Callback: fechar o panel (Ctrl+J / ✕).</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Callback: clique num problema → goto no editor.</summary>
    [Parameter] public EventCallback<LspDiagnosticItem> OnProblemClick { get; set; }

    /// <summary>Callback pós-kill — página recarrega jobs.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private ElementReference _tabList;
    private string _tab = "problems";
    private bool _terminalEnabled;
    private bool _previewEnabled;

    private int ProblemsCount => Problems.Count;

    private IEnumerable<string> Tabs => (_terminalEnabled, _previewEnabled) switch
    {
        (true, true) => ["problems", "terminal", "jobs", "preview"],
        (true, false) => ["problems", "terminal", "jobs"],
        (false, true) => ["problems", "jobs", "preview"],
        _ => ["problems", "jobs"],
    };

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _terminalEnabled = await Api.GetTerminalEnabledAsync();
            _previewEnabled = await Api.GetPreviewEnabledAsync();
        }
        catch (HttpRequestException ex)
        {
            await Console.Error.WriteLineAsync($"[IdeBottomPanel] init falhou: {ex.Message}");
        }
    }

    /// <summary>Abre o panel já numa aba específica (ex.: Ctrl+` → terminal).</summary>
    public void ShowTab(string tab)
    {
        if (Tabs.Contains(tab))
        {
            _tab = tab;
            StateHasChanged();
        }
    }

    private async Task OnTabKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "ArrowLeft" or "ArrowRight" or "ArrowUp" or "ArrowDown" or "Home" or "End")
        {
            await JS.InvokeVoidAsync("openwebui.rovingFocus", _tabList, e.Key);
        }
    }

    private string TabLabel(string tab) => tab switch
    {
        "problems" => L["ide.problems"],
        "terminal" => L["chat.panel_tab_terminal"],
        "jobs" => L["chat.panel_tab_jobs"],
        "preview" => L["chat.panel_tab_preview"],
        _ => tab,
    };

    private async Task KillJobAsync(string jobId)
    {
        await Api.KillJobAsync(jobId);
        await OnChanged.InvokeAsync();
    }

    private static string JobDotCss(string status) => status switch
    {
        "running" => "bg-blue-500 animate-pulse",
        "completed" => "bg-green-500",
        "killed" or "failed" => "bg-red-500",
        _ => "bg-gray-300 dark:bg-gray-600",
    };
}
