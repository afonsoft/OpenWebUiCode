@inject LocalizationService L
@using OpenWebUI.Client.Utils

@* Quick Open / Command Palette / Go to Line / Go to Symbol (SPEC-20261011-ide-editor-core, Fase B).
   Modal no topo estilo VS Code: prefixo '>' comandos, ':' linha, '@' símbolos,
   vazio → arquivos (fuzzy). *@

<div class="fixed inset-0 z-50 flex items-start justify-center pt-[15%]" role="dialog" aria-modal="true"
     aria-label="@L["ide.quick_open"]" @onclick="OnClose">
    <div class="w-[36rem] max-w-[92vw] rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-2xl overflow-hidden"
         @onclick:stopPropagation>
        <input @ref="_input" class="w-full border-b border-gray-200 dark:border-gray-800 bg-transparent px-3 py-2 text-sm outline-none"
               placeholder="@L["ide.quick_open_hint"]"
               aria-label="@L["ide.quick_open"]"
               @bind="_query" @bind:event="oninput" @bind:after="OnQueryChanged"
               @onkeydown="OnKeyDown" />
        <div class="max-h-72 overflow-y-auto" role="listbox">
            @if (_mode == "files")
            {
                @foreach (var (f, i) in _items.Select((f, i) => (f, i)))
                {
                    <button class="flex w-full items-center gap-2 px-3 py-1.5 text-left text-xs @(i == _sel ? "bg-blue-100 dark:bg-blue-900/40" : "hover:bg-gray-100 dark:hover:bg-gray-800")"
                            role="option" aria-selected="@(i == _sel ? "true" : "false")"
                            @onclick="() => PickFile(f)">
                        <span aria-hidden="true">📄</span>
                        <span class="truncate">@f</span>
                    </button>
                }
                @if (_items.Count == 0)
                {
                    <div class="px-3 py-3 text-xs text-gray-400">@L["ide.no_results"]</div>
                }
            }
            else if (_mode == "commands")
            {
                @foreach (var (cmd, i) in _commands.Select((c, i) => (c, i)))
                {
                    <button class="flex w-full items-center gap-2 px-3 py-1.5 text-left text-xs @(i == _sel ? "bg-blue-100 dark:bg-blue-900/40" : "hover:bg-gray-100 dark:hover:bg-gray-800")"
                            role="option" aria-selected="@(i == _sel ? "true" : "false")"
                            @onclick="() => PickCommand(cmd.Id)">
                        <span aria-hidden="true">⌘</span>
                        <span class="truncate">@cmd.Label</span>
                    </button>
                }
            }
            else if (_mode == "line")
            {
                <div class="px-3 py-3 text-xs text-gray-400">
                    @L.T("ide.goto_line_hint", ("line", _lineNum > 0 ? _lineNum.ToString() : "?"))
                </div>
            }
            else
            {
                @foreach (var (s, i) in _symbols.Select((s, i) => (s, i)))
                {
                    <button class="flex w-full items-center gap-2 px-3 py-1.5 text-left text-xs @(i == _sel ? "bg-blue-100 dark:bg-blue-900/40" : "hover:bg-gray-100 dark:hover:bg-gray-800")"
                            role="option" aria-selected="@(i == _sel ? "true" : "false")"
                            @onclick="() => PickSymbol(s.Line)">
                        <span aria-hidden="true">◈</span>
                        <span class="truncate">@s.Label</span>
                        <span class="ml-auto shrink-0 text-gray-400">@s.Line</span>
                    </button>
                }
                @if (_symbols.Count == 0)
                {
                    <div class="px-3 py-3 text-xs text-gray-400">@L["ide.no_results"]</div>
                }
            }
        </div>
    </div>
</div>

@code {
    /// <summary>Arquivos do workdir (flat) — a página preenche lazy.</summary>
    [Parameter] public IReadOnlyList<string> Files { get; set; } = [];

    /// <summary>Comandos da paleta (id + label localizado).</summary>
    [Parameter] public IReadOnlyList<IdeCommand> Commands { get; set; } = [];

    /// <summary>Símbolos do documento ativo (linha 1-based + label).</summary>
    [Parameter] public IReadOnlyList<IdeSymbol> Symbols { get; set; } = [];

    /// <summary>Prefixo inicial do input ('', '&gt;', ':', '@').</summary>
    [Parameter] public string Seed { get; set; } = "";

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnPickFile { get; set; }
    [Parameter] public EventCallback<string> OnPickCommand { get; set; }
    [Parameter] public EventCallback<int> OnPickLine { get; set; }
    [Parameter] public EventCallback<int> OnPickSymbol { get; set; }

    /// <summary>Item da paleta de comandos.</summary>
    public sealed record IdeCommand(string Id, string Label);

    /// <summary>Símbolo para Go to Symbol.</summary>
    public sealed record IdeSymbol(int Line, string Label);

    private string _query = "";
    private string _mode = "files";
    private List<string> _items = [];
    private List<IdeCommand> _commands = [];
    private List<IdeSymbol> _symbols = [];
    private int _sel;
    private int _lineNum;
    private ElementReference _input;
    private bool _seeded;

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_seeded)
        {
            _seeded = true;
            _query = Seed;
            ApplyQuery();
            await _input.FocusAsync();
        }
    }

    private IReadOnlyList<string>? _lastFiles;

    /// <summary>Re-filtra quando o índice de arquivos chega depois (walk async).</summary>
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_lastFiles, Files))
        {
            _lastFiles = Files;
            ApplyQuery();
        }
    }

    private void OnQueryChanged() => ApplyQuery();

    private void ApplyQuery()
    {
        _sel = 0;
        var q = _query;
        _mode = q.StartsWith('>') ? "commands"
            : q.StartsWith(':') ? "line"
            : q.StartsWith('@') ? "symbols"
            : "files";
        var body = _mode == "files" ? q : q[1..];
        switch (_mode)
        {
            case "files": _items = IdeQuickOpenFuzzy.Match(body, Files); break;
            case "commands":
                _commands = Commands
                    .Where(c => string.IsNullOrWhiteSpace(body)
                        || c.Label.Contains(body, StringComparison.OrdinalIgnoreCase)
                        || c.Id.Contains(body, StringComparison.OrdinalIgnoreCase))
                    .Take(30).ToList();
                break;
            case "line":
                _ = int.TryParse(body, out _lineNum);
                break;
            case "symbols":
                _symbols = Symbols
                    .Where(s => string.IsNullOrWhiteSpace(body)
                        || s.Label.Contains(body, StringComparison.OrdinalIgnoreCase))
                    .Take(50).ToList();
                break;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        var count = _mode switch
        {
            "files" => _items.Count,
            "commands" => _commands.Count,
            "symbols" => _symbols.Count,
            _ => 0,
        };
        switch (e.Key)
        {
            case "Escape":
                await OnClose.InvokeAsync();
                break;
            case "ArrowDown" when count > 0:
                _sel = (_sel + 1) % count;
                break;
            case "ArrowUp" when count > 0:
                _sel = (_sel - 1 + count) % count;
                break;
            case "Enter":
                await PickCurrentAsync();
                break;
        }
    }

    private async Task PickCurrentAsync()
    {
        switch (_mode)
        {
            case "files" when _items.Count > 0:
                await PickFile(_items[Math.Min(_sel, _items.Count - 1)]);
                break;
            case "commands" when _commands.Count > 0:
                await PickCommand(_commands[Math.Min(_sel, _commands.Count - 1)].Id);
                break;
            case "line" when _lineNum > 0:
                await OnPickLine.InvokeAsync(_lineNum);
                await OnClose.InvokeAsync();
                break;
            case "symbols" when _symbols.Count > 0:
                await PickSymbol(_symbols[Math.Min(_sel, _symbols.Count - 1)].Line);
                break;
        }
    }

    private async Task PickFile(string f)
    {
        await OnPickFile.InvokeAsync(f);
        await OnClose.InvokeAsync();
    }

    private async Task PickCommand(string id)
    {
        await OnPickCommand.InvokeAsync(id);
        await OnClose.InvokeAsync();
    }

    private async Task PickSymbol(int line)
    {
        await OnPickSymbol.InvokeAsync(line);
        await OnClose.InvokeAsync();
    }
}
