@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav
@inject ChatListState ChatList
@inject AttentionInboxState Attention
@inject LocalizationService L
@inject ThemeService Theme
@inject IJSRuntime JS
@inject DialogService Dialogs
@implements IDisposable

@* Mobile: backdrop fecha a gaveta (overlay abaixo do md) *@
@if (MobileOpen)
{
    <div class="fixed inset-0 z-40 bg-gray-950/50 md:hidden" aria-hidden="true"
         @onclick="CloseMobile"></div>
}

@if (_collapsed)
{
    @* Rail fina quando a sidebar está recolhida, como no upstream *@
    <div class="w-[42px] shrink-0 py-1 px-1 hidden md:flex flex-col justify-between text-gray-700 dark:text-gray-300 h-full z-10 transition-[width] border-e-[0.5px] border-gray-50 dark:border-gray-850/30">
        <div class="flex flex-col flex-1 items-center">
            <button class="flex size-8.5 items-center justify-center transition group cursor-pointer" title="@L["sidebar.new_chat"]" aria-label="@L["sidebar.new_chat"]" @onclick="NewChat">
                <div class="self-center flex size-[30px] items-center justify-center rounded-lg transition group-hover:bg-gray-100 dark:group-hover:bg-gray-900">
                    <img src="favicon.png" class="size-5 rounded-full" alt="Open WebUI" />
                </div>
            </button>
            @* Expandir no topo também — o botão do rodapé fica fora da tela
               em janelas altas (o usuário não o enxergava). *@
            <button class="flex size-8.5 items-center justify-center transition group cursor-pointer" title="@L["sidebar.expand"]" aria-label="@L["sidebar.expand"]" @onclick="() => _collapsed = false">
                <div class="self-center flex size-[30px] items-center justify-center rounded-lg transition group-hover:bg-gray-100 dark:group-hover:bg-gray-900">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
                </div>
            </button>
            <NotificationBell MenuClass="left-0" />
            <AttentionBadge Count="Attention.Count" Active="Attention.FilterActive" OnClick="OpenAttentionFromRail" />
        </div>
        <div class="flex justify-center items-center">
            <button class="cursor-pointer flex size-8.5 items-center justify-center transition group" title="@L["sidebar.expand"]" aria-label="@L["sidebar.expand"]" @onclick="() => _collapsed = false">
                <div class="self-center flex size-[30px] items-center justify-center rounded-lg transition group-hover:bg-gray-100 dark:group-hover:bg-gray-900">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
                </div>
            </button>
        </div>
    </div>
}
else
{
    @* Mobile: gaveta fixa que desliza; desktop: coluna estática *@
    <div class="my-auto flex flex-col justify-between h-screen max-h-[100dvh] w-[260px] shrink-0 overflow-x-hidden scrollbar-hidden z-50 bg-white dark:bg-gray-900 border-e border-gray-50 dark:border-gray-850/30
                fixed inset-y-0 left-0 transition-transform duration-200 @(MobileOpen ? "translate-x-0 shadow-2xl" : "-translate-x-full") md:static md:translate-x-0 md:z-10 md:shadow-none"
         role="@(MobileOpen ? "dialog" : null)" aria-modal="@(MobileOpen ? "true" : null)" aria-label="@(MobileOpen ? L["sidebar.expand"] : null)"
         @onkeydown="OnKeyDown">
        <div class="px-1 pt-1.5 pb-1 flex justify-between space-x-1 text-gray-600 dark:text-gray-400 sticky top-0 z-10 -mb-2">
            <button class="flex items-center rounded-xl size-8.5 h-full justify-center hover:bg-gray-100 dark:hover:bg-gray-900 transition cursor-pointer" @onclick="NewChat" aria-label="@L["sidebar.new_chat"]">
                <img src="favicon.png" class="size-5 rounded-full" alt="" />
            </button>

            <button class="flex flex-1 px-0.5 cursor-pointer" @onclick="NewChat">
                <div class="self-center font-normal text-gray-700 dark:text-gray-200">Open WebUI</div>
            </button>

            <NotificationBell />
            <AttentionBadge Count="Attention.Count" Active="Attention.FilterActive" OnClick="ToggleAttentionFilter" />

            <button class="hidden md:flex size-[1.875rem] justify-center items-center rounded-lg hover:bg-gray-100 dark:hover:bg-gray-900 transition cursor-w-resize"
                    title="@L["sidebar.collapse"]" aria-label="@L["sidebar.collapse"]" @onclick="() => _collapsed = true">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 self-center" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
            </button>
            <button class="flex md:hidden size-[1.875rem] justify-center items-center rounded-lg hover:bg-gray-100 dark:hover:bg-gray-900 transition cursor-pointer"
                    aria-label="@L["sidebar.collapse"]" @onclick="CloseMobile">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 self-center" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
            </button>
        </div>

        <div class="relative flex flex-col flex-1 overflow-y-auto scrollbar-hidden space-y-1.5 pt-2.5 pb-2.5">
            <div class="pb-1">
                <div class="px-1 flex justify-center text-gray-700 dark:text-gray-300">
                    <button class="group grow flex items-center space-x-2 rounded-xl px-2 py-1.5 hover:bg-gray-100 dark:hover:bg-gray-900 transition outline-none cursor-pointer"
                            @onclick="NewChat" aria-label="@L["sidebar.new_chat"]">
                        <div class="self-center flex size-4 shrink-0 items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" /></svg>
                        </div>
                        <div class="flex flex-1 self-center translate-y-[0.5px]">
                            <div class="self-center text-[0.8125rem] leading-5">@L["sidebar.new_chat"]</div>
                        </div>
                    </button>
                </div>

                <div class="px-1 flex justify-center text-gray-700 dark:text-gray-300">
                    <div class="group grow flex items-center space-x-2 rounded-xl px-2 py-1.5 hover:bg-gray-100 dark:hover:bg-gray-900 transition outline-none">
                        <div class="self-center flex size-4 shrink-0 items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
                        </div>
                        <input type="text" placeholder="@L["sidebar.search"]"
                               aria-label="@L["sidebar.search"]"
                               class="flex-1 bg-transparent outline-none text-[0.8125rem] leading-5 placeholder:text-gray-400 dark:placeholder:text-gray-600 min-w-0 min-h-6"
                               @bind="_query" @bind:event="oninput" />
                    </div>
                </div>
            </div>

            <div>
                <div class="px-2.5 pb-1 w-full flex items-center justify-between text-[0.75rem] leading-5 font-normal text-gray-500 dark:text-gray-500">
                    <span>@L["sidebar.channels"]</span>
                    <span>
                        <button class="text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 min-w-6 min-h-6 cursor-pointer"
                                title="@L["sidebar.new_dm"]" aria-label="@L["sidebar.new_dm"]" @onclick="CreateDmAsync">@@</button>
                        <button class="text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 min-w-6 min-h-6 cursor-pointer"
                                title="@L["sidebar.create_channel"]" aria-label="@L["sidebar.create_channel"]" @onclick="CreateChannelAsync">+</button>
                    </span>
                </div>
                <div class="flex flex-col">
                    @foreach (var channel in _channels)
                    {
                        var current = Nav.Uri.Contains($"/channels/{channel.Id}");
                        <a class="w-full flex items-center rounded-xl px-2.5 py-1.5 mx-1 text-[0.8125rem] leading-5 truncate transition
                                  @(current
                                      ? "bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-100"
                                      : "text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900")"
                           href="/channels/@channel.Id" draggable="false">
                            <span class="truncate">@(channel.Type == "dm" ? "@" : "#") @channel.Name</span>
                            @if (channel.UnreadCount > 0 && !current)
                            {
                                <span class="ml-auto rounded-full bg-blue-500 px-1.5 text-[0.65rem] font-medium text-white">
                                    @channel.UnreadCount
                                </span>
                            }
                        </a>
                    }
                </div>
            </div>
            }

            @if (Attention.FilterActive)
            {
                @* D2: vista "aguardando" — só chats com run bloqueada no dono. *@
                <div>
                    <div class="px-2.5 pb-1 text-[0.75rem] leading-5 font-normal text-amber-600 dark:text-amber-400">@L["sidebar.attention"]</div>
                    @if (AwaitingChats().Count == 0)
                    {
                        <div class="px-3 text-[0.8125rem] text-gray-400 dark:text-gray-600">@L["sidebar.attention_empty"]</div>
                    }
                    else
                    {
                        <div class="flex flex-col">
                            <Virtualize Items="AwaitingChats()" Context="chat" OverscanCount="8">
                                @ChatItem(chat)
                            </Virtualize>
                        </div>
                    }
                </div>
            }
            else
            {
            @if (ActiveRuns().Count > 0)
            {
                <div>
                    <div class="px-2.5 pb-1 text-[0.75rem] leading-5 font-normal text-gray-500 dark:text-gray-500">@L["sidebar.runs"]</div>
                    <div class="flex flex-col">
                        @foreach (var run in ActiveRuns())
                        {
                            <a class="w-full flex items-center rounded-xl px-2.5 py-1.5 text-[0.8125rem] leading-5 truncate transition
                                      text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900"
                               href="/c/@run.ChatId" draggable="false"
                               title="@run.ChatTitle — @run.Status">
                                <span class="mr-1.5 flex size-2 shrink-0 rounded-full @RunDotClass(run.Status)" aria-hidden="true"></span>
                                <span class="truncate">@(run.ParentRunId is null ? "" : "↳ ")@run.ChatTitle</span>
                            </a>
                        }
                    </div>
                </div>
            }

            @if (_pinned.Count > 0)
            {
                <div>
                    <div class="px-2.5 pb-1 text-[0.75rem] leading-5 font-normal text-gray-500 dark:text-gray-500">@L["sidebar.pinned"]</div>
                    <div class="flex flex-col">
                        @foreach (var chat in _pinned)
                        {
                            @ChatItem(chat)
                        }
                    </div>
                </div>
            }

            @foreach (var folder in _folders)
            {
                <div class="flex items-center justify-between px-2.5 pb-1 text-[0.75rem] leading-5 font-normal text-gray-500 dark:text-gray-500">
                    <button class="flex-1 flex items-center gap-1 text-left cursor-pointer"
                            aria-expanded="@folder.Expanded"
                            @onclick="() => folder.Expanded = !folder.Expanded">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3 transition-transform @(folder.Expanded ? "rotate-90" : "")"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
                        @folder.Name
                    </button>
                    <button class="text-gray-400 hover:text-red-500 px-1 cursor-pointer" title="@L["sidebar.delete_folder"]"
                            aria-label="@L["sidebar.delete_folder"]"
                            @onclick="() => DeleteFolderAsync(folder)">×</button>
                </div>
                @if (folder.Expanded)
                {
                    <div class="ml-3 pl-1 flex flex-col border-s border-gray-100 dark:border-gray-900">
                        @foreach (var chat in folder.Chats)
                        {
                            @ChatItem(chat)
                        }
                    </div>
                }
            }

            @if (_loadFailed && FilteredChats().Count == 0 && _pinned.Count == 0 && _folders.Count == 0 && _channels.Count == 0)
            {
                @* Offline: casca/nav continuam; hint + retry manual (o reload
                   também volta a rodar via eventos/poll). *@
                <div class="px-3 text-[0.8125rem] text-gray-400 dark:text-gray-600 flex items-center gap-2"
                     data-offline-fallback>
                    <span>@L["common.offline_load"]</span>
                    <button class="text-blue-500 hover:text-blue-600 cursor-pointer" @onclick="LoadAsync">@L["common.retry"]</button>
                </div>
            }
            else if (FilteredChats().Count == 0 && _pinned.Count == 0 && _folders.Count == 0)
            {
                <div class="px-3 text-[0.8125rem] text-gray-400 dark:text-gray-600">
                    @(string.IsNullOrEmpty(_query) ? L["sidebar.empty"] : L["sidebar.no_results"])
                </div>
            }
            else if (FilteredChats().Count > 0)
            {
                <div>
                    <div class="px-2.5 pb-1 text-[0.75rem] leading-5 font-normal text-gray-500 dark:text-gray-500">@L["sidebar.chats"]</div>
                    <div class="flex flex-col">
                        @* Agrupamento pai↔filho quebra o Virtualize — lista raiz
                           + filhos indentados num único foreach. *@
                        @foreach (var chat in FilteredChats())
                        {
                            @ChatItem(chat)
                            @if (chat.ChildrenCount > 0 && _expandedParents.Contains(chat.Id))
                            {
                                var children = ChildrenOf(chat.Id);
                                if (children.Count > 0)
                                {
                                    <div class="ml-3 pl-1 flex flex-col border-s border-gray-100 dark:border-gray-900">
                                        @foreach (var child in children)
                                        {
                                            @ChatItem(child)
                                        }
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            }
            }
        </div>

        <div class="px-1 pb-1.5">
            <div class="px-1 flex flex-col text-gray-700 dark:text-gray-300">
                <button class="group grow flex items-center space-x-2 rounded-xl px-2 py-1.5 hover:bg-gray-100 dark:hover:bg-gray-900 transition cursor-pointer"
                        @onclick='() => Nav.NavigateTo("/workspace")'>
                    <div class="self-center flex size-4 shrink-0 items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z" /></svg>
                    </div>
                    <div class="self-center text-[0.8125rem] leading-5">Workspace</div>
                </button>
                <button class="group grow flex items-center space-x-2 rounded-xl px-2 py-1.5 hover:bg-gray-100 dark:hover:bg-gray-900 transition cursor-pointer"
                        @onclick='() => Nav.NavigateTo("/playground")'>
                    <div class="self-center flex size-4 shrink-0 items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25h13.5A2.25 2.25 0 0 0 21 18v-1.5m-18-9h18m-18 0V7.5m7.5 4.125v3.75m0 0-2.25 2.25m2.25-2.25 2.25 2.25" /></svg>
                    </div>
                    <div class="self-center text-[0.8125rem] leading-5">@L["sidebar.playground"]</div>
                </button>
                <button class="group grow flex items-center space-x-2 rounded-xl px-2 py-1.5 hover:bg-gray-100 dark:hover:bg-gray-900 transition cursor-pointer"
                        @onclick='() => Nav.NavigateTo("/automations")'>
                    <div class="self-center flex size-4 shrink-0 items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                    </div>
                    <div class="self-center text-[0.8125rem] leading-5">@L["sidebar.automations"]</div>
                </button>
                <button class="group grow flex items-center space-x-2 rounded-xl px-2 py-1.5 hover:bg-gray-100 dark:hover:bg-gray-900 transition cursor-pointer"
                        @onclick='() => Nav.NavigateTo("/calendar")'>
                    <div class="self-center flex size-4 shrink-0 items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>
                    </div>
                    <div class="self-center text-[0.8125rem] leading-5">@L["sidebar.calendar"]</div>
                </button>
                <button class="group grow flex items-center space-x-2 rounded-xl px-2 py-1.5 hover:bg-gray-100 dark:hover:bg-gray-900 transition cursor-pointer"
                        @onclick='() => Nav.NavigateTo("/terminal")'>
                    <div class="self-center flex size-4 shrink-0 items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m6.75 7.5 3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>
                    </div>
                    <div class="self-center text-[0.8125rem] leading-5">@L["sidebar.terminal"]</div>
                </button>
                <button class="group grow flex items-center space-x-2 rounded-xl px-2 py-1.5 hover:bg-gray-100 dark:hover:bg-gray-900 transition cursor-pointer"
                        @onclick='() => Nav.NavigateTo("/notes")'>
                    <div class="self-center flex size-4 shrink-0 items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Z" /></svg>
                    </div>
                    <div class="self-center text-[0.8125rem] leading-5">@L["sidebar.notes"]</div>
                </button>
                @if (Auth.CurrentUser?.Role == "admin")
                {
                    <button class="group grow flex items-center space-x-2 rounded-xl px-2 py-1.5 hover:bg-gray-100 dark:hover:bg-gray-900 transition cursor-pointer"
                            @onclick='() => Nav.NavigateTo("/admin")'>
                        <div class="self-center flex size-4 shrink-0 items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.828c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.828a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
                        </div>
                        <div class="self-center text-[0.8125rem] leading-5">@L["sidebar.admin"]</div>
                    </button>
                }
            </div>

            <div class="px-1 mt-1">
                <div class="relative">
                    <button class="w-full flex items-center gap-2 rounded-xl px-1.5 py-1.5 hover:bg-gray-100 dark:hover:bg-gray-900 transition cursor-pointer"
                            @onclick="() => _userMenuOpen = !_userMenuOpen">
                        <div class="size-6 rounded-full bg-gray-300 dark:bg-gray-600 flex items-center justify-center text-[0.625rem] font-medium text-gray-700 dark:text-gray-200 shrink-0">
                            @Initials
                        </div>
                        <div class="flex-1 text-left text-[0.8125rem] leading-5 truncate text-gray-700 dark:text-gray-300">
                            @Auth.CurrentUser?.Name
                        </div>
                    </button>

                    @if (_userMenuOpen)
                    {
                        <div class="fixed inset-0 z-40" @onclick="() => _userMenuOpen = false"></div>
                        <div class="absolute bottom-full left-0 mb-1 z-50 w-full min-w-[10rem] rounded-2xl bg-white dark:bg-gray-850 border border-gray-100 dark:border-gray-800 shadow-lg py-1">
                            <div class="flex items-center gap-1 px-2 py-1">
                                @foreach (var opt in _themeOptions)
                                {
                                    <button class="flex-1 flex items-center justify-center gap-1 h-7 rounded-lg text-[0.75rem] cursor-pointer transition @(Theme.Current == opt.Value ? "bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-100 font-medium" : "text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-900")"
                                            title="@opt.Label" aria-pressed="@(Theme.Current == opt.Value)"
                                            @onclick="() => SetThemeAsync(opt.Value)">
                                        @((MarkupString)opt.Icon)
                                        <span>@opt.Label</span>
                                    </button>
                                }
                            </div>
                            <hr class="border-gray-100 dark:border-gray-800 my-1" />
                            <button class="flex h-7 w-full items-center gap-2 rounded-lg px-2.5 text-[0.8125rem] text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900 cursor-pointer"
                                    @onclick="OpenSettingsAndClose">
                                @L["sidebar.settings"]
                            </button>
                            <button class="flex h-7 w-full items-center gap-2 rounded-lg px-2.5 text-[0.8125rem] text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900 cursor-pointer"
                                    @onclick='() => { _userMenuOpen = false; Nav.NavigateTo("/archived"); }'>
                                @L["sidebar.archived"]
                            </button>
                            <hr class="border-gray-100 dark:border-gray-800 my-1" />
                            <button class="flex h-7 w-full items-center gap-2 rounded-lg px-2.5 text-[0.8125rem] text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900 cursor-pointer"
                                    @onclick="SignOutAsync">
                                @L["sidebar.sign_out"]
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (_menuFor is not null)
{
    <div class="fixed inset-0 z-40" @onclick="CloseMenu"></div>
    <div class="fixed z-50 min-w-[10rem] rounded-2xl bg-white dark:bg-gray-850 border border-gray-100 dark:border-gray-800 shadow-lg py-1"
         role="menu" aria-label="@L["sidebar.options"]" @ref="_chatMenu" @onkeydown="OnChatMenuKeyDown"
         style="left: 280px; top: 30%;">
        <button role="menuitem" class="flex h-7 w-full items-center gap-2 rounded-lg px-2.5 text-[0.8125rem] text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900 cursor-pointer" @onclick="() => PinAsync(_menuFor)">@(_menuFor.Pinned ? L["sidebar.unpin"] : L["sidebar.pin"])</button>
        <button role="menuitem" class="flex h-7 w-full items-center gap-2 rounded-lg px-2.5 text-[0.8125rem] text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900 cursor-pointer" @onclick="() => RenameAsync(_menuFor)">@L["sidebar.rename"]</button>
        <button role="menuitem" class="flex h-7 w-full items-center gap-2 rounded-lg px-2.5 text-[0.8125rem] text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900 cursor-pointer" @onclick="() => CloneAsync(_menuFor)">@L["sidebar.clone"]</button>
        <button role="menuitem" class="flex h-7 w-full items-center gap-2 rounded-lg px-2.5 text-[0.8125rem] text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900 cursor-pointer" @onclick="() => ShareAsync(_menuFor)">@L["sidebar.share"]</button>
        <button role="menuitem" class="flex h-7 w-full items-center gap-2 rounded-lg px-2.5 text-[0.8125rem] text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900 cursor-pointer" @onclick="() => ArchiveAsync(_menuFor)">@L["sidebar.archive"]</button>
        @if (_folders.Count > 0)
        {
            <hr class="border-gray-100 dark:border-gray-800 my-1" />
            <div class="px-2.5 py-0.5 text-[0.6875rem] text-gray-400 dark:text-gray-500">@L["sidebar.move_to"]</div>
            @foreach (var folder in _folders)
            {
                <button role="menuitem" class="flex h-7 w-full items-center gap-2 rounded-lg px-2.5 text-[0.8125rem] text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900 cursor-pointer" @onclick="() => MoveToFolderAsync(_menuFor, folder.Id)">@folder.Name</button>
            }
            <button role="menuitem" class="flex h-7 w-full items-center gap-2 rounded-lg px-2.5 text-[0.8125rem] text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900 cursor-pointer" @onclick="() => MoveToFolderAsync(_menuFor, null)">@L["sidebar.remove_from_folder"]</button>
        }
        <hr class="border-gray-100 dark:border-gray-800 my-1" />
        <button role="menuitem" class="flex h-7 w-full items-center gap-2 rounded-lg px-2.5 text-[0.8125rem] text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900 cursor-pointer" @onclick="() => CreateFolderForAsync(_menuFor)">@L["sidebar.new_folder"]</button>
        <button role="menuitem" class="flex h-7 w-full items-center gap-2 rounded-lg px-2.5 text-[0.8125rem] text-red-500 hover:bg-gray-100 dark:hover:bg-gray-900 cursor-pointer" @onclick="() => DeleteAsync(_menuFor)">@L["common.delete"]</button>
    </div>
}

@if (_shareUrl is not null)
{
    <div class="fixed inset-0 z-50 bg-gray-900/40 dark:bg-gray-950/60 flex items-center justify-center" @onclick="() => _shareUrl = null">
        <div class="w-full max-w-md rounded-2xl bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 shadow-2xl p-5"
             role="dialog" aria-modal="true" aria-label="@L["sidebar.share_title"]" tabindex="-1"
             @ref="_shareDialog" @onkeydown="OnShareKeyDown" @onclick:stopPropagation>
            <div class="flex items-center justify-between mb-3">
                <span class="text-base font-medium text-gray-800 dark:text-gray-100">@L["sidebar.share_title"]</span>
                <button class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 cursor-pointer"
                        aria-label="@L["common.close"]" @onclick="() => _shareUrl = null">×</button>
            </div>
            <label class="block text-xs text-gray-500 dark:text-gray-400 mb-1">@L["sidebar.public_link"]</label>
            <input class="w-full rounded-xl bg-gray-50 dark:bg-gray-850 border border-gray-200 dark:border-gray-800 px-3 py-2 text-sm outline-none text-gray-800 dark:text-gray-100"
                   readonly value="@_shareUrl" aria-label="@L["sidebar.public_link"]" @onclick="CopyShareLink" />
            <button class="mt-3 w-full rounded-full bg-gray-700/5 hover:bg-gray-700/10 dark:bg-gray-100/5 dark:hover:bg-gray-100/10 dark:text-gray-300 dark:hover:text-white transition font-normal text-sm py-2.5 cursor-pointer"
                    @onclick="CopyShareLink">@(_copied ? L["sidebar.copied"] : L["sidebar.copy_link"])</button>
            <button class="mt-2 w-full rounded-full text-sm py-2.5 text-red-500 hover:bg-red-500/10 transition cursor-pointer"
                    @onclick="UnshareAsync">@L["sidebar.disable_sharing"]</button>
        </div>
    </div>
}

@code {
    /// <summary>Disparado quando o usuário abre as configurações.</summary>
    [Parameter] public EventCallback OnOpenSettings { get; set; }

    /// <summary>Gaveta mobile aberta (controlada pelo layout).</summary>
    [Parameter] public bool MobileOpen { get; set; }

    /// <summary>Disparado quando a gaveta mobile deve fechar (backdrop, Escape, navegação).</summary>
    [Parameter] public EventCallback OnCloseMobile { get; set; }

    private List<ChatSummaryResponse> _chats = [];
    private List<ParallelRunResponse> _runs = [];
    private List<ChatSummaryResponse> _pinned = [];
    private List<FolderWithChats> _folders = [];
    private List<ChannelResponse> _channels = [];
    private string _query = string.Empty;
    private ChatSummaryResponse? _menuFor;
    private string? _shareUrl;
    private string? _shareChatId;
    private bool _copied;
    private bool _collapsed;
    private bool _userMenuOpen;
    private bool _loadFailed;

    private record ThemeOption(string Value, string Label, string Icon);

    private ThemeOption[] _themeOptions = [];

    /// <summary>Seletor de tema no menu do usuário (SPEC theme-layout-refresh T2).</summary>
    private async Task SetThemeAsync(string theme)
    {
        await Theme.SetAsync(theme);
        StateHasChanged();
    }

    /// <summary>
    /// Chats raiz visíveis (SPEC-20261010-runs-hierarchy): filhos delegados
    /// não aparecem no topo — renderizam indentados sob o pai. Órfãos (pai
    /// deletado/fora da lista) voltam pra raiz. Em busca, a lista fica flat.
    /// </summary>
    private List<ChatSummaryResponse> FilteredChats() =>
        !string.IsNullOrWhiteSpace(_query)
            ? _chats.Where(c => c.Title.Contains(_query, StringComparison.OrdinalIgnoreCase)).ToList()
            : _chats.Where(c => c.ParentChatId is null || !_chats.Any(p => p.Id == c.ParentChatId)).ToList();

    /// <summary>Filhos delegados de um chat, em ordem de criação.</summary>
    private List<ParallelRunResponse> ActiveRuns() =>
        _runs.Where(r => r.Status is "queued" or "running" or "paused").ToList();

    private static string RunDotClass(string status) => status switch
    {
        "running" => "bg-blue-500 animate-pulse",
        "queued" => "bg-gray-400",
        "paused" => "bg-amber-500",
        "failed" => "bg-red-500",
        _ => "bg-green-500",
    };

    private List<ChatSummaryResponse> ChildrenOf(string parentId) =>
        _chats.Where(c => c.ParentChatId == parentId)
            .OrderBy(c => c.CreatedAt).ToList();

    /// <summary>Ids dos grupos pai↔filho expandidos na sidebar.</summary>
    private readonly HashSet<string> _expandedParents = [];

    /// <summary>Chats com run esperando ação do dono (D2) — o filtro "aguardando".</summary>
    private List<ChatSummaryResponse> AwaitingChats() =>
        _chats.Where(c => c.Awaiting).ToList();

    /// <summary>Clique do badge na rail recolhida: expande e já aplica o filtro.</summary>
    private void OpenAttentionFromRail()
    {
        _collapsed = false;
        Attention.SetFilter(true);
    }

    /// <summary>Badge da barra expandida: alterna a vista "aguardando".</summary>
    private void ToggleAttentionFilter() =>
        Attention.SetFilter(!Attention.FilterActive);

    /// <summary>Count/filtro mudou — recarrega a lista para refletir os flags awaiting.</summary>
    private async void OnAttentionChanged()
    {
        try
        {
            await LoadAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is ObjectDisposedException or InvalidOperationException)
        {
            // async void: desmonte entre evento e render não pode vazar —
            // exceção aqui cairia direto na blazor-error-ui.
        }
    }

    private string Initials =>
        string.Concat((Auth.CurrentUser?.Name ?? "U").Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2).Select(p => char.ToUpperInvariant(p[0])));

    protected override async Task OnInitializedAsync()
    {
        _themeOptions =
        [
            new("light", L["settings.theme_light"],
                """<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"/></svg>"""),
            new("dark", L["settings.theme_dark"],
                """<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z"/></svg>"""),
            new("system", L["settings.theme_system"],
                """<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25"/></svg>"""),
        ];
        ChatList.Changed += OnChatsChanged;
        Attention.Changed += OnAttentionChanged;
        _ = Attention.EnsureStartedAsync();
        // Sem isso Nav.Uri fica avaliado só no primeiro render: o chat atual
        // nunca ganha highlight e o botão ⋯ fica display:none para sempre.
        Nav.LocationChanged += OnLocationChanged;
        await LoadAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (MobileOpen)
        {
            _ = OnCloseMobile.InvokeAsync();
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private void CloseMobile() => _ = OnCloseMobile.InvokeAsync();

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && MobileOpen)
        {
            CloseMobile();
        }
    }

    private ElementReference _shareDialog;
    private bool _shareFocusTrapped;
    private ElementReference _chatMenu;
    private bool _focusChatMenu;
    private string? _menuChatId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shareUrl is not null && !_shareFocusTrapped)
        {
            _shareFocusTrapped = true;
            await JS.InvokeVoidAsync("openwebui.trapFocus", _shareDialog);
        }
        else if (_shareUrl is null && _shareFocusTrapped)
        {
            _shareFocusTrapped = false;
            await JS.InvokeVoidAsync("openwebui.releaseFocus", _shareDialog);
        }
        if (_focusChatMenu)
        {
            _focusChatMenu = false;
            await JS.InvokeVoidAsync("openwebui.focusFirst", _chatMenu);
        }
    }

    private void OpenMenu(ChatSummaryResponse chat)
    {
        _menuFor = chat;
        _menuChatId = chat.Id;
        _focusChatMenu = true;
    }

    private async Task OnChatMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _menuFor = null;
            await JS.InvokeVoidAsync("openwebui.focusSelector",
                $"[data-options-for='{_menuChatId}']");
        }
        else if (e.Key is "ArrowDown" or "ArrowUp" or "Home" or "End")
        {
            await JS.InvokeVoidAsync("openwebui.menuNav", _chatMenu, e.Key);
        }
    }

    private void OnShareKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _shareUrl = null;
        }
    }

    private async void OnChatsChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        try
        {
            // Chamadas independentes em paralelo (antes: 4 sequenciais por recarga).
            var chatsTask = Api.GetChatsAsync();
            var pinnedTask = Api.GetPinnedChatsAsync();
            var foldersTask = Api.GetFoldersAsync();
            var channelsTask = Api.GetChannelsAsync();
            var runsTask = Api.GetRunsConsoleAsync();
            await Task.WhenAll(chatsTask, pinnedTask, foldersTask, channelsTask, runsTask);
            _chats = chatsTask.Result;
            _pinned = pinnedTask.Result;
            _folders = foldersTask.Result;
            _channels = channelsTask.Result;
            _runs = runsTask.Result;
            _loadFailed = false;
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            // Offline/SW: mantém a nav/casca renderizando com listas vazias
            // (ou o último dado) — nunca propagar para a blazor-error-ui.
            _loadFailed = true;
            await Console.Error.WriteLineAsync($"[Sidebar] carga falhou: {ex.Message}");
        }
    }

    private async Task CreateDmAsync()
    {
        var email = await JS.InvokeAsync<string?>("prompt", L["sidebar.prompt_dm_email"]);
        if (string.IsNullOrWhiteSpace(email))
        {
            return;
        }
        var users = await Api.GetUsersAsync(query: email.Trim());
        var user = users.Users.FirstOrDefault(u =>
            u.Email.Equals(email.Trim(), StringComparison.OrdinalIgnoreCase));
        if (user is null)
        {
            return;
        }
        var channel = await Api.CreateDmAsync(user.Id);
        if (channel is not null)
        {
            _channels = await Api.GetChannelsAsync();
            Nav.NavigateTo($"/channels/{channel.Id}");
        }
    }

    private async Task CreateChannelAsync()
    {
        var name = await JS.InvokeAsync<string?>("prompt", L["sidebar.prompt_channel_name"]);
        if (string.IsNullOrWhiteSpace(name))
        {
            return;
        }
        var channel = await Api.CreateChannelAsync(name.Trim());
        if (channel is not null)
        {
            _channels = await Api.GetChannelsAsync();
            Nav.NavigateTo($"/channels/{channel.Id}");
        }
    }

    private RenderFragment ChatItem(ChatSummaryResponse chat) => __builder =>
    {
        var current = Nav.Uri.Contains($"/c/{chat.Id}");
        <div class="group relative px-1">
            @if (chat.ChildrenCount > 0)
            {
                <button class="absolute left-0.5 top-1/2 -translate-y-1/2 z-10 flex size-4 items-center justify-center rounded text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 cursor-pointer"
                        title="@L["sidebar.children"]" aria-label="@L["sidebar.children"]"
                        aria-expanded="@_expandedParents.Contains(chat.Id)"
                        @onclick="() => ToggleChildren(chat.Id)" @onclick:stopPropagation @onclick:preventDefault>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                         class="size-3 transition-transform @(_expandedParents.Contains(chat.Id) ? "rotate-90" : "")"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
                </button>
            }
            <a class="w-full flex items-center rounded-xl py-1.5 text-[0.8125rem] leading-5 truncate transition
                      @(chat.ChildrenCount > 0 ? "pl-6 pr-2.5" : "px-2.5")
                      @(current
                          ? "bg-gray-100 dark:bg-gray-900 text-gray-800 dark:text-gray-100"
                          : "text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900")"
               href="/c/@chat.Id" draggable="false">
                @if (chat.Awaiting)
                {
                    <span class="mr-1.5 flex size-3.5 shrink-0 items-center text-amber-500" title="@L["sidebar.attention_item"]" aria-label="@L["sidebar.attention_item"]">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                    </span>
                }
                <span class="truncate flex-1">@chat.Title</span>
                @if (chat.ParentChatId is not null)
                {
                    <span class="ml-1.5 shrink-0 rounded bg-gray-200 dark:bg-gray-800 px-1 text-[0.625rem] leading-4 text-gray-500 dark:text-gray-400"
                          title="@L["sidebar.delegated"]">@L["sidebar.delegated_badge"]</span>
                }
            </a>
            <button class="absolute right-2 top-1/2 -translate-y-1/2 size-5 items-center justify-center rounded-md text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 cursor-pointer
                           @(current ? "flex" : "flex opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 focus-visible:opacity-100 pointer-coarse:opacity-100 pointer-events-none group-hover:pointer-events-auto group-focus-within:pointer-events-auto focus-visible:pointer-events-auto pointer-coarse:pointer-events-auto")"
                    title="@L["sidebar.options"]" aria-label="@L["sidebar.options"]" aria-haspopup="menu"
                    aria-expanded="@(_menuFor == chat)" data-options-for="@chat.Id"
                    @onclick="() => OpenMenu(chat)" @onclick:stopPropagation @onclick:preventDefault>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 12a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm6 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm6 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" /></svg>
            </button>
        </div>
    };

    private void ToggleChildren(string chatId)
    {
        if (!_expandedParents.Remove(chatId))
        {
            _expandedParents.Add(chatId);
        }
    }

    private void NewChat() => Nav.NavigateTo("/");

    private void OpenSettingsAndClose()
    {
        _userMenuOpen = false;
        OnOpenSettings.InvokeAsync();
    }

    private void CloseMenu() => _menuFor = null;

    private async Task PinAsync(ChatSummaryResponse chat)
    {
        _menuFor = null;
        await Api.TogglePinChatAsync(chat.Id);
        await LoadAsync();
    }

    private async Task RenameAsync(ChatSummaryResponse chat)
    {
        _menuFor = null;
        var title = await Dialogs.PromptAsync( L["sidebar.prompt_rename"], chat.Title);
        if (string.IsNullOrWhiteSpace(title))
        {
            return;
        }

        // PATCH leve: antes baixava e reenviava o chat inteiro com todas
        // as mensagens só para mudar o título.
        if (await Api.PatchChatAsync(chat.Id, title: title.Trim()) is not null)
        {
            await LoadAsync();
        }
    }

    private async Task CloneAsync(ChatSummaryResponse chat)
    {
        _menuFor = null;
        var clone = await Api.CloneChatAsync(chat.Id);
        if (clone is not null)
        {
            Nav.NavigateTo($"/c/{clone.Id}");
            await LoadAsync();
        }
    }

    private async Task ShareAsync(ChatSummaryResponse chat)
    {
        _menuFor = null;
        var updated = await Api.ShareChatAsync(chat.Id);
        if (updated?.ShareId is not null)
        {
            _shareChatId = chat.Id;
            _shareUrl = $"{Nav.BaseUri.TrimEnd('/')}/s/{updated.ShareId}";
            _copied = false;
        }
    }

    private async Task CopyShareLink()
    {
        if (_shareUrl is not null)
        {
            await JS.InvokeVoidAsync("openwebui.copyText", _shareUrl);
            _copied = true;
        }
    }

    private async Task UnshareAsync()
    {
        if (_shareChatId is not null)
        {
            await Api.UnshareChatAsync(_shareChatId);
            _shareUrl = null;
            _shareChatId = null;
        }
    }

    private async Task ArchiveAsync(ChatSummaryResponse chat)
    {
        _menuFor = null;
        await Api.ToggleArchiveChatAsync(chat.Id);
        ChatList.NotifyChanged();
        if (Nav.Uri.Contains($"/c/{chat.Id}"))
        {
            Nav.NavigateTo("/");
        }

        await LoadAsync();
    }

    private async Task MoveToFolderAsync(ChatSummaryResponse chat, string? folderId)
    {
        _menuFor = null;
        await Api.SetChatFolderAsync(chat.Id, folderId);
        await LoadAsync();
    }

    private async Task CreateFolderForAsync(ChatSummaryResponse chat)
    {
        _menuFor = null;
        var name = await Dialogs.PromptAsync( L["sidebar.prompt_folder_name"], "");
        if (string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        var folder = await Api.CreateFolderAsync(name.Trim());
        if (folder is not null)
        {
            await Api.SetChatFolderAsync(chat.Id, folder.Id);
            await LoadAsync();
        }
    }

    private async Task DeleteFolderAsync(FolderWithChats folder)
    {
        if (!await Dialogs.ConfirmAsync(
            L.T("sidebar.confirm_delete_folder", ("name", folder.Name)), danger: true))
        {
            return;
        }

        await Api.DeleteFolderAsync(folder.Id);
        await LoadAsync();
    }

    private async Task DeleteAsync(ChatSummaryResponse chat)
    {
        _menuFor = null;
        if (!await Dialogs.ConfirmAsync( L.T("common.confirm_delete", ("name", chat.Title)), danger: true))
        {
            return;
        }

        await Api.DeleteChatAsync(chat.Id);
        if (Nav.Uri.Contains($"/c/{chat.Id}"))
        {
            Nav.NavigateTo("/");
        }

        await LoadAsync();
    }

    private async Task SignOutAsync()
    {
        _userMenuOpen = false;
        await Auth.SignOutAsync();
        Nav.NavigateTo("/auth", replace: true);
    }

    /// <summary>Limpa inscrições.</summary>
    public void Dispose()
    {
        ChatList.Changed -= OnChatsChanged;
        Attention.Changed -= OnAttentionChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
