@* SPEC-20261128-chat-doc-attachments: viewer de documento anexado —
   markdown renderiza via MarkdownService (mesmo pipeline da MessageBubble);
   demais textos caem em <pre> monoespaçado. Mobile = sheet full-screen,
   desktop ~80vw/80vh. Fecha por Esc, ✕ e backdrop. *@
@inject LocalizationService L
@inject IJSRuntime JS

<div class="fixed inset-0 z-50 flex items-stretch sm:items-center justify-center bg-black/70 backdrop-blur-sm"
     role="dialog" aria-modal="true" aria-label="@Name"
     @onclick="CloseAsync"
     @onkeydown="OnKeyDownAsync"
     tabindex="-1" @ref="_overlay">
    <div class="flex flex-col w-full h-full sm:h-[80vh] sm:max-w-[80vw] sm:rounded-xl bg-white dark:bg-gray-900 shadow-2xl overflow-hidden"
         @onclick:stopPropagation="true">
        @* Header: nome + copiar/download/fechar *@
        <div class="flex items-center gap-2 px-4 py-2.5 border-b border-gray-200 dark:border-gray-800 flex-none">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 flex-none text-gray-400"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
            <span class="flex-1 truncate text-sm font-medium text-gray-800 dark:text-gray-100" title="@Name">@Name</span>
            <button type="button" class="size-8 flex items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800 dark:text-gray-400 cursor-pointer"
                    title="@L["chat.copy"]" aria-label="@L["chat.copy"]"
                    @onclick="CopyAsync" @onclick:stopPropagation="true">
                @if (_copied)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-green-600"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" /></svg>
                }
            </button>
            <button type="button" class="size-8 flex items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800 dark:text-gray-400 cursor-pointer"
                    title="@L["chat.doc_download"]" aria-label="@L["chat.doc_download"]"
                    @onclick="DownloadAsync" @onclick:stopPropagation="true">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
            </button>
            <button type="button" class="size-8 flex items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800 dark:text-gray-400 text-xl leading-none cursor-pointer"
                    aria-label="@L["chat.close_preview"]"
                    @onclick="CloseAsync" @onclick:stopPropagation="true">×</button>
        </div>

        @* Corpo: markdown renderizado ou pre *@
        <div class="flex-1 overflow-auto px-4 py-3">
            @if (_content is null)
            {
                <div class="h-24 rounded-lg bg-gray-100 dark:bg-gray-850 animate-pulse" aria-hidden="true"></div>
            }
            else if (DocKind == "markdown")
            {
                <div class="prose prose-sm dark:prose-invert max-w-none text-gray-800 dark:text-gray-100">
                    @((MarkupString)_html)
                </div>
            }
            else
            {
                <pre class="text-xs leading-relaxed text-gray-800 dark:text-gray-200 whitespace-pre-wrap break-words font-mono">@_content</pre>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>Id do arquivo (FileEntry) — conteúdo via <c>openwebui.media</c>.</summary>
    [Parameter, EditorRequired] public string FileId { get; set; } = string.Empty;

    /// <summary>Nome do arquivo (header).</summary>
    [Parameter] public string Name { get; set; } = string.Empty;

    /// <summary><c>markdown</c> renderiza HTML; <c>text</c> cai em pre.</summary>
    [Parameter] public string DocKind { get; set; } = "text";

    /// <summary>Fechamento do modal (Esc/✕/backdrop).</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _overlay;
    private string? _content;
    private string _html = string.Empty;
    private bool _copied;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _content = await JS.InvokeAsync<string?>(
            "openwebui.media.readText", FileId, 0);
        _content ??= string.Empty;
        if (DocKind == "markdown")
        {
            _html = MarkdownService.ToHtml(_content);
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _overlay.FocusAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private async Task CopyAsync()
    {
        if (_content is { Length: > 0 })
        {
            await JS.InvokeVoidAsync("openwebui.copyText", _content);
            _copied = true;
        }
    }

    private Task DownloadAsync() =>
        JS.InvokeVoidAsync("openwebui.media.download", FileId, Name).AsTask();

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }
}
