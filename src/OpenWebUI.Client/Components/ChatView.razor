    public void OnTtsEnded() => _speakingIndex = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (ChatId == _loadedChatId)
        {
            return;
        }

        _error = null;
        _followUps = [];
        _attachedFiles.Clear();
        _liveToolCalls.Clear();
        _runTasks = [];
        _runChanges = [];
        _runCheckpoints = [];
        _git = null;
        _pendingApproval = null;
        _pendingQuestion = null;
        _paused = false;
        _statusLabel = null;
        if (_loadedChatId is not null)
        {
            await Realtime.LeaveChatAsync(_loadedChatId);
        }
        if (ChatId is null)
        {
            _loadedChatId = null;
            _chatTitle = "New Chat";
            _parentChatId = null;
            _parentTitle = null;
            _messages.Clear();
            // Chat novo: só as tools genéricas vêm selecionadas por padrão.
            _toolIds = DefaultToolIds();
            // Modo de permissão volta ao padrão do composer (última escolha).
            try
            {
                _approvalPreset = await StoredPresetAsync();
                _agentMode = await StoredAgentModeAsync();
                await LoadComposerStateAsync(null);
            }
            catch (Exception ex) when (ClientErrors.IsTransient(ex) || ex is InvalidOperationException)
            {
                // Interop indisponível: segue com defaults (lifecycle nunca propaga).
                await Console.Error.WriteLineAsync($"[ChatView] composer state falhou: {ex.Message}");
            }
            return;
        }

        _loading = true;
        ChatResponse? chat;
        try
        {
            chat = await Api.GetChatAsync(ChatId);
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            // Offline: o chat não abre — erro honesto na área de mensagens,
            // não a blazor-error-ui.
            _loading = false;
            _error = L["common.offline_load"];
            await Console.Error.WriteLineAsync($"[ChatView] carga do chat falhou: {ex.Message}");
            return;
        }
        try
        {
            if (chat is null)
            {
                Nav.NavigateTo("/", replace: true);
                return;
            }

            _loadedChatId = chat.Id;
            await Realtime.JoinChatAsync(chat.Id);
            _chatTitle = chat.Title;
            _parentChatId = chat.ParentChatId;

        // Binding por chat: substitui o global carregado no init.
        try
        {
            var chatRepo = await Api.GetChatWorkspaceRepoAsync(chat.Id);
            _repo = chatRepo?.Binding;
            _repoSource = chatRepo?.Source;
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            // Sem o binding o chat abre sem contexto de repo — degradado, não crash.
            await Console.Error.WriteLineAsync($"[ChatView] repo binding falhou: {ex.Message}");
        }
            _parentTitle = chat.ParentTitle;
            // Chat sem ToolIds persistidos (legado/nunca tocado): default genérico.
            _toolIds = chat.ToolIds.Count > 0
                ? chat.ToolIds.ToHashSet()
                : DefaultToolIds();
            _approvalPreset = chat.ApprovalPreset;
            _agentMode = chat.Mode is "plan" ? "plan" : "build";
            _messages.Clear();
            _messages.AddRange(chat.Messages);
            await LoadComposerStateAsync(chat.Id);
            if (chat.Models.Count > 0)
            {
                _model = chat.Models[0];
            }

            // Run ainda em execução (aba fechou/reload): anexa ao stream e mostra a geração ao vivo.
            ChatRunResponse? activeRun = null;
            try
            {
                activeRun = await ChatStream.GetActiveRunAsync(chat.Id);
            }
            catch (Exception ex) when (ClientErrors.IsTransient(ex))
            {
                await Console.Error.WriteLineAsync($"[ChatView] active run falhou: {ex.Message}");
            }
            _ = activeRun is not null
                ? AttachActiveRunAsync(activeRun)
                // Git bar: snapshot do workspace quando há runs anteriores.
                : RefreshGitAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnModelChanged(string? model) => _model = model;

    private void HandleChatMessageUpdated(string chatId, string messageId, string content)
    {
        if (chatId != _loadedChatId)
        {
            return;
        }

        var index = _messages.FindIndex(m => m.Id == messageId);
        if (index >= 0 && _messages[index].Content != content)
        {
            var m = _messages[index];
            var versions = (m.Versions ?? []).ToList();
            versions.Add(new ChatMessageVersionModel(m.Content, m.Model, m.Timestamp));
            _messages[index] = m with { Content = content, Versions = versions };
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void HandleChatMessageDeleted(string chatId, string messageId)
    {
        if (chatId != _loadedChatId)
        {
            return;
        }

        var index = _messages.FindIndex(m => m.Id == messageId);
        if (index >= 0)
        {
            _messages.RemoveRange(index, _messages.Count - index);
            _ = InvokeAsync(StateHasChanged);
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        Realtime.OnChatMessageUpdated -= HandleChatMessageUpdated;
        Realtime.OnChatMessageDeleted -= HandleChatMessageDeleted;
        _cts?.Dispose();
        _ttsRef?.Dispose();
        GC.SuppressFinalize(this);
    }

    private void UsePrompt(PromptResponse prompt)
    {
        _input = prompt.Content;
    }

    private void UseSuggestion(PromptSuggestion suggestion)
    {
        _input = suggestion.Content;
    }

    private async Task SelectPrompt(SlashItem item)
    {
        _promptSuggestions = [];
        if (item.Source == "prompt")
        {
            var prompt = _prompts.FirstOrDefault(
                p => p.Command.Equals(item.Command, StringComparison.OrdinalIgnoreCase));
            if (prompt is not null)
            {
                _input = prompt.Content;
            }

            return;
        }

        // skill → corpo markdown no input; command → template com $N interpolado.
        var args = RepoSlashCommands.ArgsAfter(_input);
        if (item.Source == "skill")
        {
            var detail = await Api.GetRepoSkillAsync(item.Command);
            _input = detail?.Content ?? _input;
        }
        else
        {
            var detail = await Api.GetRepoCommandAsync(item.Command);
            _input = detail is null ? _input : RepoSlashCommands.Interpolate(detail.Content, args);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // Esc fecha o dropdown de menções (RF-001).
        if (e.Key == "Escape" && _mentionItems.Count > 0)
        {
            _mentionItems = [];
            return;
        }

        // Backspace no input vazio remove o chip inteiro (RF-001 — chip é unidade atômica).
        if (e.Key == "Backspace" && string.IsNullOrEmpty(_input) && _mentionPaths.Count > 0)
        {
            _mentionPaths.RemoveAt(_mentionPaths.Count - 1);
            return;
        }

        if (e.Key == "Enter" && !e.ShiftKey && !SendDisabled && !_streaming)
        {
            await SendAsync();
            return;
        }

        // Histórico do composer (RF-006): ↑/↓ no input vazio (ou navegando)
        // percorre os prompts enviados deste chat.
        if (e.Key == "ArrowUp" && _inputHistory.Count > 0
            && (string.IsNullOrEmpty(_input) || _historyIndex >= 0))
        {
            _historyIndex = _historyIndex < 0
                ? _inputHistory.Count - 1
                : Math.Max(0, _historyIndex - 1);
            _input = _inputHistory[_historyIndex];
            return;
        }
        if (e.Key == "ArrowDown" && _historyIndex >= 0)
        {
            _historyIndex++;
            if (_historyIndex >= _inputHistory.Count)
            {
                _historyIndex = -1;
                _input = string.Empty;
            }
            else
            {
                _input = _inputHistory[_historyIndex];
            }
            return;
        }

        UpdatePromptSuggestions();
    }

    /// <summary>
    /// @bind:after do composer: agenda o lookup de menções @path e grava o rascunho.
    /// </summary>
    private async Task OnComposerInputAsync()
    {
        // Sugestões de slash atualizam APÓS o bind — no @onkeydown o _input
        // ainda não recebeu o char digitado (a lista ficava 1 tecla atrasada
        // e '/' sozinho não abria nada).
        UpdatePromptSuggestions();
        QueueMentionLookup();
        await SaveDraftAsync();
    }

    /// <summary>
    /// Token @path no fim do input (RF-001): detecta <c>@query</c> com ≥1 char
    /// e agenda o filtro da árvore do workdir com debounce (~250ms).
    /// </summary>
    private void QueueMentionLookup()
    {
        var match = MentionTokenRegex.Match(_input);
        _mentionCts?.Cancel();
        if (!match.Success)
        {
            _mentionItems = [];
            return;
        }

        var query = match.Groups["q"].Value;
        _mentionCts = new CancellationTokenSource();
        var ct = _mentionCts.Token;
        _ = RefreshMentionSuggestionsAsync(query, ct);
    }

    /// <summary>Filtra a árvore (top-20, dirs primeiro) após o debounce.</summary>
    private async Task RefreshMentionSuggestionsAsync(string query, CancellationToken ct)
    {
        try
        {
            await Task.Delay(250, ct);
            var tree = await EnsureMentionTreeAsync();
            _mentionItems = tree is null
                ? []
                : tree
                    .Where(e => e.Path.Contains(query, StringComparison.OrdinalIgnoreCase)
                                || e.Name.Contains(query, StringComparison.OrdinalIgnoreCase))
                    .OrderByDescending(e => e.Type == "dir")
                    .ThenBy(e => e.Path, StringComparer.OrdinalIgnoreCase)
                    .Take(20)
                    .ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // keystroke mais recente venceu — esperado.
        }
    }

    /// <summary>Carrega e cacheia a árvore do workdir (até 3 páginas) por repo vinculado.</summary>
    private async Task<List<WorkspaceFileEntryResponse>?> EnsureMentionTreeAsync()
    {
        var repoKey = _repo?.Repo;
        if (_mentionTree is not null && _mentionTreeFor == repoKey)
        {
            return _mentionTree;
        }

        var all = new List<WorkspaceFileEntryResponse>();
        var cursor = (string?)null;
        for (var page = 0; page < 3; page++)
        {
            var tree = await Api.GetWorkspaceTreeAsync("", 3, cursor, _loadedChatId);
            if (tree is null)
            {
                return null;
            }
            all.AddRange(tree.Entries);
            cursor = tree.NextCursor;
            if (cursor is null)
            {
                break;
            }
        }
        _mentionTree = all;
        _mentionTreeFor = repoKey;
        return all;
    }

    /// <summary>Seleção do dropdown: troca o token @query por um chip com o path (RF-001).</summary>
    private void SelectMention(WorkspaceFileEntryResponse item)
    {
        var match = MentionTokenRegex.Match(_input);
        if (match.Success)
        {
            _input = _input[..match.Index];
        }
        if (!_mentionPaths.Contains(item.Path, StringComparer.Ordinal))
        {
            _mentionPaths.Add(item.Path);
        }
        _mentionItems = [];
    }

    /// <summary>
    /// Rascunho persistido por chat (RF-006): o composer sobrevive a
    /// reload/troca de aba — chave <c>chat:draft:{chatId|new}</c>.
    /// </summary>
    private CancellationTokenSource? _draftCts;

    private async Task SaveDraftAsync()
    {
        _historyIndex = -1;
        var key = $"chat:draft:{_loadedChatId ?? "new"}";
        var text = _input;
        // Debounce: antes cada keystroke fazia uma escrita no localStorage
        // via interop; agora só grava ~400ms após a última tecla.
        if (_draftCts is not null) { await _draftCts.CancelAsync(); }
        _draftCts = new CancellationTokenSource();
        var ct = _draftCts.Token;
        try
        {
            await Task.Delay(400, ct);
            if (string.IsNullOrEmpty(text))
            {
                await Storage.RemoveAsync(key);
            }
            else
            {
                await Storage.SetAsync(key, text);
            }
        }
        catch (OperationCanceledException)
        {
            // Tecla seguinte chegou antes do debounce — essa gravação morre.
        }
        catch (JSException)
        {
            // localStorage indisponível — draft é best-effort.
        }
    }

    /// <summary>Restaura draft + histórico de prompts do chat carregado.</summary>
    private async Task LoadComposerStateAsync(string? chatId)
    {
        _historyIndex = -1;
        _inputHistory = [];
        var prefix = chatId ?? "new";
        try
        {
            _input = await Storage.GetAsync($"chat:draft:{prefix}") ?? string.Empty;
            var raw = await Storage.GetAsync($"chat:hist:{prefix}");
            if (raw is not null)
            {
                _inputHistory = JsonSerializer.Deserialize<List<string>>(raw) ?? [];
            }
        }
        catch (JSException)
        {
            _input = string.Empty;
        }
        catch (JsonException)
        {
            _inputHistory = [];
        }
    }

    /// <summary>Grava o prompt enviado no histórico do chat (cap 50).</summary>
    private async Task PushHistoryAsync(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return;
        }
        _inputHistory.Remove(text);
        _inputHistory.Add(text);
        if (_inputHistory.Count > 50)
        {
            _inputHistory.RemoveAt(0);
        }
        _historyIndex = -1;
        try
        {
            await Storage.SetAsync(
                $"chat:hist:{_loadedChatId ?? "new"}",
                JsonSerializer.Serialize(_inputHistory));
        }
        catch (JSException)
        {
            // best-effort
        }
    }

    private void UpdatePromptSuggestions()
    {
        // RF-003: '/' mescla prompts do usuário + skills/commands do repo.
        var prefix = _input.StartsWith('/')
            ? _input[1..].Split(' ', 2)[0]
            : null;
        _promptSuggestions = prefix is null
            ? []
            : RepoSlashCommands.Merge(_prompts, _repoSkills, _repoCommands, prefix);
    }

    private async Task TriggerFilePicker()
    {
        await JS.InvokeVoidAsync("openwebui.openFilePicker", _fileInput?.Element);
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _uploading = true;
        try
        {
            foreach (var file in e.GetMultipleFiles(10))
            {
                await using var stream = file.OpenReadStream(100 * 1024 * 1024);
                var uploaded = await Api.UploadFileAsync(stream, file.Name, file.ContentType);
                if (uploaded is not null)
                {
                    _attachedFiles.Add(uploaded);
                }
                else
                {
                    _error = L.T("chat.upload_failed", ("file", file.Name));
                }
            }
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task SendAsync()
    {
        var text = _input.Trim();
        var fileIds = _attachedFiles.Select(f => f.Id).ToList();
        var mentionPaths = _mentionPaths.Count > 0 ? _mentionPaths.ToList() : null;
        if ((text.Length == 0 && fileIds.Count == 0 && mentionPaths is null) || string.IsNullOrEmpty(_model))
        {
            return;
        }

        _input = string.Empty;
        _promptSuggestions = [];
        _mentionItems = [];
        _followUps = [];
        _error = null;
        _ = PushHistoryAsync(text);
        _ = Storage.RemoveAsync($"chat:draft:{_loadedChatId ?? "new"}");

        var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        var content = text.Length > 0
            ? text
            : _attachedFiles.Count > 0 ? L["chat.files_attached"] : text;
        if (_attachedFiles.Count > 0 && text.Length > 0)
        {
            content += "\n\n📎 " + string.Join(", ", _attachedFiles.Select(f => f.Filename));
        }
        // Os chips @path viram marcadores 📄 na mensagem persistida — o conteúdo
        // real é expandido server-side via MentionPaths (o usuário vê o chip, não o dump).
        if (mentionPaths is not null)
        {
            content += (content.Length > 0 ? "\n\n" : "") + "📄 " + string.Join(", ", mentionPaths);
        }

        _messages.Add(new ChatMessageModel(Guid.NewGuid().ToString(), "user", content, null, now));
        _attachedFiles.Clear();
        _mentionPaths.Clear();

        var isNew = _loadedChatId is null && !Playground;
        if (isNew)
        {
            var title = text.Length > 60 ? text[..60] : text;
            if (string.IsNullOrEmpty(title))
            {
                title = "New Chat";
            }

            // Chat criado vazio: a mensagem do usuário é persistida pelo enqueue da run.
            var created = await Api.CreateChatAsync(
                new ChatUpsertRequest(title, [_model!], [],
                    _toolIds.Count > 0 ? _toolIds.ToList() : []));
            if (created is null)
            {
                _error = L["chat.create_failed"];
                _messages.RemoveAt(_messages.Count - 1);
                return;
            }

            _loadedChatId = created.Id;
            _chatTitle = created.Title;
            _pendingNavigateId = created.Id;
            ChatList.NotifyChanged();
            // Modo escolhido antes do primeiro envio: aplica no chat criado
            // (o gate relê o preset por call — vale já na primeira tool).
            if (_approvalPreset != "approve-mutations" || _agentMode != "build")
            {
                _ = Api.PatchChatAsync(created.Id, _approvalPreset, mode: _agentMode);
            }
        }

        // Chats persistidos usam runs desacopladas (a geração sobrevive a fechar a aba);
        // playground e demais caminhos seguem no stream direto legado.
        var detached = _loadedChatId is not null && !Playground;
        await StreamAssistantAsync(fileIds, detached ? content : null, mentionPaths);
        if (!detached)
        {
            await PersistAsync();
        }

        if (_pendingNavigateId is not null)
        {
            var id = _pendingNavigateId;
            _pendingNavigateId = null;
            Nav.NavigateTo($"/c/{id}");
        }

        if (isNew)
        {
            _ = GenerateTitleAsync();
        }

        _ = LoadFollowUpsAsync();
    }

    private async Task SendFollowUpAsync(string text)
    {
        _input = text;
        _followUps = [];
        await SendAsync();
    }

    private void EditAt(int index)
    {
        if (_streaming)
        {
            return;
        }

        _input = _messages[index].Content;
    }

    private async Task RegenerateAtAsync(int index)
    {
        if (_streaming || _messages.Count == 0)
        {
            return;
        }

        // Remove a resposta na posição e tudo depois dela, depois gera de novo.
        while (_messages.Count > index)
        {
            _messages.RemoveAt(_messages.Count - 1);
        }

        if (_messages.Count == 0 || string.IsNullOrEmpty(_model))
        {
            return;
        }

        _error = null;
        _followUps = [];
        var detached = _loadedChatId is not null && !Playground;
        if (detached)
        {
            // Sincroniza as remoções no servidor antes de regenerar sobre o histórico.
            await PersistAsync();
        }
        await StreamAssistantAsync([]);
        if (!detached)
        {
            await PersistAsync();
        }
        _ = LoadFollowUpsAsync();
    }

    private async Task GenerateImageAtAsync(int index)
    {
        if (_streaming)
        {
            return;
        }

        var message = _messages[index];
        List<GeneratedImage>? generated;
        try
        {
            generated = await Api.GenerateImagesAsync(message.Content);
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            generated = null;
        }

        if (generated is { Count: > 0 })
        {
            var markdown = string.Concat(generated.Select(g => $"\n\n![imagem gerada]({g.Url})"));
            _messages[index] = message with { Content = message.Content + markdown };
        }
        else
        {
            _messages[index] = message with
            {
                Content = $"{message.Content}\n\n> {L["chat.image_error"]}",
            };
        }

        await PersistAsync();
        await InvokeAsync(StateHasChanged);
    }

