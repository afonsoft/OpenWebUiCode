@inject ApiService Api
@inject ChatStreamService ChatStream
@inject AuthService Auth
@inject ChatListState ChatList
@inject NavigationManager Nav
@inject LocalizationService L
@inject MarkdownService Markdown
@inject IJSRuntime JS
@inject RealtimeService Realtime
@inject BrowserStorage Storage
@inject AttentionInboxState Attention
@implements IDisposable

<div class="flex h-full w-full min-w-0">
<div class="flex flex-col flex-1 h-full w-full min-w-0">
    <div class="sticky top-0 z-30 w-full">
        <div class="flex items-center w-full pl-1.5 pr-1">
            <div class="flex max-w-full w-full mx-auto bg-transparent">
                <div class="flex items-center w-full max-w-full">
                    <div class="flex-1 max-w-full mt-0.5 py-0.5 pl-1">
                        <div class="flex max-w-full min-w-0 items-center gap-2 mr-2">
                            <ModelSelector Value="@_model" ValueChanged="OnModelChanged" />
                        </div>
                    </div>
                    <div class="lg:mr-1 flex flex-none items-center gap-2 self-center">
                        @if (_streaming || _agentMode == "plan")
                        {
                            <AgentModeBadge Mode="@_agentMode" />
                        }
                        @if (_streaming && !string.IsNullOrEmpty(_statusLabel))
                        {
                            <span class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-gray-200 dark:border-gray-750 bg-gray-50 dark:bg-gray-850 px-2.5 py-1 text-[0.6875rem] font-medium text-gray-500 dark:text-gray-400"
                                  role="status" aria-live="polite">
                                <svg class="size-3 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z" />
                                </svg>
                                @_statusLabel
                            </span>
                        }
                        @if (_parentChatId is { } parentId)
                        {
                            <a class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-gray-200 dark:border-gray-750 bg-gray-50 dark:bg-gray-850 px-2.5 py-1 text-[0.6875rem] font-medium text-gray-500 transition hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800"
                               href="/c/@parentId" title="@L["chat.parent"]" aria-label="@L["chat.parent"]">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" /></svg>
                                <span class="max-w-24 truncate">@(_parentTitle ?? L["chat.parent"])</span>
                            </a>
                        }
                        @if (_git is { Git: true } g)
                        {
                            <button class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-gray-200 dark:border-gray-750 bg-gray-50 dark:bg-gray-850 px-2.5 py-1 text-[0.6875rem] font-medium text-gray-500 transition hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 cursor-pointer"
                                    title="@L["chat.git_title"]" @onclick="OpenPanelAtChangesAsync">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 3v12" />
                                    <circle cx="18" cy="6" r="3" />
                                    <circle cx="6" cy="18" r="3" />
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 9a9 9 0 0 1-9 9" />
                                </svg>
                                <span class="max-w-24 truncate font-mono">@g.Branch</span>
                                @if (g.Added > 0 || g.Removed > 0)
                                {
                                    <span class="font-mono text-green-600 dark:text-green-400">+@g.Added</span>
                                    <span class="font-mono text-red-500 dark:text-red-400">−@g.Removed</span>
                                }
                            </button>
                        }
                        @if (_repo is { Repo: { } repoSlug })
                        {
                            <div class="inline-flex items-center gap-1.5">
                                <a class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 dark:border-gray-750 bg-gray-50 dark:bg-gray-850 px-2.5 py-1 text-[0.6875rem] font-medium text-gray-500 transition hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800"
                                   href="https://github.com/@repoSlug" target="_blank" rel="noopener noreferrer"
                                   title="@L.T("chat.repo_open", ("repo", repoSlug))"
                                   aria-label="@L.T("chat.repo_open", ("repo", repoSlug))">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-3" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
                                    <span class="max-w-16 sm:max-w-44 truncate font-mono">@repoSlug</span>
                                </a>
                                <button type="button" class="inline-flex items-center gap-1 rounded-full border border-gray-200 dark:border-gray-750 bg-gray-50 dark:bg-gray-850 px-2.5 py-1 text-[0.6875rem] font-medium text-gray-500 transition hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 cursor-pointer"
                                        title="@L["chat.repo_branch_title"]" aria-label="@L["chat.repo_branch_title"]"
                                        @onclick="() => _repoPicker = true">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 3v12" />
                                        <circle cx="18" cy="6" r="3" />
                                        <circle cx="6" cy="18" r="3" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M18 9a9 9 0 0 1-9 9" />
                                    </svg>
                                    <span class="max-w-14 sm:max-w-44 truncate font-mono">@_repo.Branch</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
                                </button>
                                <a href="@(_loadedChatId is null ? "/ide" : $"/ide?chatId={_loadedChatId}")" class="flex size-6 cursor-pointer items-center justify-center rounded-lg text-gray-500 transition hover:bg-gray-50/40 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-gray-800/40 dark:hover:text-gray-200"
                                        title="@L["ide.open"]" aria-label="@L["ide.open"]">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" /></svg>
                                </a>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="flex size-6 cursor-pointer items-center justify-center rounded-lg text-gray-500 transition hover:bg-gray-50/40 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-gray-800/40 dark:hover:text-gray-200"
                                    title="@L["chat.repo_link"]" aria-label="@L["chat.repo_link"]" @onclick="() => _repoPicker = true">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-3.5" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
                            </button>
                        }
                        @if (_voiceSupported)
                        {
                            <button class="flex size-6 cursor-pointer items-center justify-center rounded-lg text-gray-500 transition hover:bg-gray-50/40 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-gray-800/40 dark:hover:text-gray-200"
                                    title="@L["voice.call"]" aria-label="@L["voice.call"]" @onclick="() => _callActive = true">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg>
                            </button>
                        }
                        @if (_loadedChatId is not null)
                        {
                            <button class="flex size-6 cursor-pointer items-center justify-center rounded-lg text-gray-500 transition hover:bg-gray-50/40 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-gray-800/40 dark:hover:text-gray-200"
                                    title="@L["chat.share"]" aria-label="@L["chat.share"]" @onclick="ShareAsync">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z" /></svg>
                            </button>
                        }
                        <button class="flex size-6 cursor-pointer items-center justify-center rounded-lg transition
                                       @(_showPanel ? "bg-gray-900 text-white dark:bg-white dark:text-gray-900" : "text-gray-500 hover:bg-gray-50/40 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-gray-800/40 dark:hover:text-gray-200")"
                                title="@L["chat.panel_title"]" aria-label="@L["chat.panel_title"]" @onclick="TogglePanelAsync">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v12a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 20.25h16.5a.75.75 0 0 0 0-1.5H3.75a.75.75 0 0 0 0 1.5ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v12a2.25 2.25 0 0 1-2.25 2.25h-2.25A2.25 2.25 0 0 1 13.5 18V6Z" /></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="flex-1 overflow-y-auto scrollbar-hidden" @ref="_scrollContainer">
        <div class="mx-auto w-full max-w-4xl px-4 pb-6">
            @if (_messages.Count == 0 && !_loading)
            {
                <div class="flex flex-col items-center justify-center text-center min-h-[60vh]">
                    <img src="assets/splash-dark.png" alt="" class="size-24 rounded-full mb-4 dark:opacity-90" />
                    <div class="text-2xl font-normal text-gray-700 dark:text-gray-200">Open WebUI</div>
                    <div class="mt-1 text-sm text-gray-500 dark:text-gray-400">@L["chat.empty_help"]</div>
                    @if (_suggestions.Count > 0)
                    {
                        <div class="mt-6 flex flex-wrap justify-center gap-2">
                            @foreach (var suggestion in _suggestions.Take(4))
                            {
                                <button class="rounded-xl border border-gray-100 dark:border-gray-850 px-3 py-1.5 text-xs text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-850 transition cursor-pointer"
                                        @onclick="() => UseSuggestion(suggestion)">
                                    @suggestion.Title
                                </button>
                            }
                        </div>
                    }
                    @if (_prompts.Count > 0)
                    {
                        <div class="mt-3 flex flex-wrap justify-center gap-2">
                            @foreach (var prompt in _prompts.Take(4))
                            {
                                <button class="rounded-xl border border-gray-100 dark:border-gray-850 px-3 py-1.5 text-xs text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-850 transition cursor-pointer"
                                        @onclick="() => UsePrompt(prompt)">
                                    /@prompt.Command — @prompt.Title
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="flex flex-col gap-5 py-4" role="log" aria-live="polite" aria-relevant="additions">
                    @for (var i = 0; i < _messages.Count; i++)
                    {
                        var index = i;
                        var message = _messages[i];
                        if (message.Role == "tool")
                        {
                            @* Histórico: bloco de tool calls consecutivas vira o
                               mesmo work log colapsado (derivado client-side). *@
                            var lastTool = index;
                            while (lastTool + 1 < _messages.Count
                                && _messages[lastTool + 1].Role == "tool")
                            {
                                lastTool++;
                            }
                            var persisted = _messages
                                .Skip(index).Take(lastTool - index + 1)
                                .Select(PersistedToolCall).ToList();
                            <RunActivityFeed Calls="persisted" Streaming="false" Collapsed="true" />
                            i = lastTool;
                            continue;
                        }
                        var isLastAssistant = message.Role == "assistant" && i == _messages.Count - 1;
                        var msgKey = message.Id ?? $"m{index}";
                        @if (isLastAssistant && _liveToolCalls.Count > 0)
                        {
                            @* Padrão Devin web: painel de atividade ACIMA do
                               texto que a run produz — feed em cima, resposta
                               embaixo. No histórico as role=tool já ficam
                               antes da resposta por natureza. *@
                            <RunActivityFeed Calls="_liveToolCalls" Streaming="_streaming" Collapsed="!_streaming" />
                        }
                        <MessageBubble @key="msgKey"
                            Message="message"
                            Streaming="_streaming && isLastAssistant"
                            ShowActions="true"
                            Initials="@UserInitials"
                            OnRegenerate="() => RegenerateAtAsync(index)"
                            OnEdit="() => EditAt(index)"
                            OnRate="rating => RateAsync(message, rating)"
                            OnGenerateImage="() => GenerateImageAtAsync(index)"
                            Speaking="_speakingIndex == index"
                            TtsSupported="_ttsSupported"
                            OnSpeak="() => SpeakAtAsync(index)" />
                    }
                </div>
            }

            @if (_liveToolCalls.Count > 0
                && (_messages.Count == 0 || _messages[^1].Role != "assistant"))
            {
                @* Fallback: feed embaixo quando a run ainda não tem
                   placeholder de assistant na lista (ex.: eventos antes
                   da primeira delta). *@
                <RunActivityFeed Calls="_liveToolCalls" Streaming="_streaming" Collapsed="!_streaming" />
            }

            @if (_runTasks.Count > 0)
            {
                <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/60 dark:bg-gray-900/40 px-3 py-2 my-1.5">
                    <div class="mb-1 text-[0.6875rem] font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500">
                        @L["chat.tasks"]
                    </div>
                    <ul class="flex flex-col gap-0.5">
                        @foreach (var task in _runTasks)
                        {
                            <li class="flex items-center gap-1.5 text-xs">
                                @if (task.Status == "completed")
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5 flex-none text-green-600 dark:text-green-400">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
                                    </svg>
                                    <span class="text-gray-400 dark:text-gray-500 line-through decoration-gray-300 dark:decoration-gray-600">@task.Content</span>
                                }
                                else if (task.Status == "in_progress")
                                {
                                    <svg class="size-3 flex-none animate-spin text-blue-600 dark:text-blue-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z" />
                                    </svg>
                                    <span class="text-gray-800 dark:text-gray-200 font-medium">@task.Content</span>
                                }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5 flex-none text-gray-300 dark:text-gray-600">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                    </svg>
                                    <span class="text-gray-600 dark:text-gray-400">@task.Content</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (_pendingApproval is { } pendingApproval)
            {
                <div class="py-1">
                    <PermissionPromptCard
                        ToolName="@pendingApproval.ToolName"
                        Kind="@pendingApproval.Kind"
                        ArgsPreview="@pendingApproval.ArgsPreview"
                        OnDecide="d => DecideApprovalAsync(pendingApproval.CallId, d.Decision, d.Remember, d.Message)" />
                </div>
            }
            else if (_pendingQuestion is { } pendingQuestion)
            {
                <div class="py-1">
                    <QuestionPromptCard
                        Question="@pendingQuestion.Question"
                        Options="@pendingQuestion.Options"
                        Multiple="@pendingQuestion.Multiple"
                        OnAnswer="answer => AnswerQuestionAsync(pendingQuestion.CallId, answer)" />
                </div>
            }
            else if (_streaming && !string.IsNullOrEmpty(_statusLabel))
            {
                @* No mobile o chip do header fica oculto — mantém o status inline *@
                <div class="sm:hidden py-1 flex items-center gap-1.5 text-xs text-gray-400 dark:text-gray-500">
                    <svg class="size-3 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z" />
                    </svg>
                    @_statusLabel
                </div>
            }

            @if (_arena is not null)
            {
                <div class="my-3 grid grid-cols-1 gap-3 md:grid-cols-2">
                    @foreach (var r in _arena.Responses)
                    {
                        <div class="rounded-xl border border-gray-100 dark:border-gray-850 px-4 py-3">
                            <div class="mb-1 text-xs font-semibold text-gray-500 dark:text-gray-400">
                                @(_arenaFeedback is null
                                    ? L.T("arena.model_label", ("label", r.Label))
                                    : r.Label == "A" ? _arenaFeedback.ModelA : _arenaFeedback.ModelB)
                            </div>
                            <div class="markdown-body text-sm text-gray-800 dark:text-gray-200">
                                @((MarkupString)Markdown.ToHtml(r.Content))
                            </div>
                        </div>
                    }
                </div>
                @if (_arenaFeedback is null)
                {
                    <div class="mb-3 flex flex-wrap gap-2">
                        <button class="rounded-full border border-gray-200 px-3 py-1.5 text-xs text-gray-600 transition hover:bg-gray-50 disabled:opacity-40 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-850"
                                disabled="@_arenaVoting" @onclick='() => VoteArenaAsync("a")'>@L["arena.vote_a"]</button>
                        <button class="rounded-full border border-gray-200 px-3 py-1.5 text-xs text-gray-600 transition hover:bg-gray-50 disabled:opacity-40 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-850"
                                disabled="@_arenaVoting" @onclick='() => VoteArenaAsync("tie")'>@L["arena.vote_tie"]</button>
                        <button class="rounded-full border border-gray-200 px-3 py-1.5 text-xs text-gray-600 transition hover:bg-gray-50 disabled:opacity-40 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-850"
                                disabled="@_arenaVoting" @onclick='() => VoteArenaAsync("both_bad")'>@L["arena.vote_both_bad"]</button>
                        <button class="rounded-full border border-gray-200 px-3 py-1.5 text-xs text-gray-600 transition hover:bg-gray-50 disabled:opacity-40 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-850"
                                disabled="@_arenaVoting" @onclick='() => VoteArenaAsync("b")'>@L["arena.vote_b"]</button>
                    </div>
                }
                else
                {
                    <div class="mb-3 text-xs text-gray-500 dark:text-gray-400">
                        @L.T("arena.revealed", ("a", _arenaFeedback.ModelA), ("b", _arenaFeedback.ModelB))
                        — @_arenaFeedback.RatingA.ToString("F0") / @_arenaFeedback.RatingB.ToString("F0")
                    </div>
                }
            }

            @if (_error is not null)
            {
                <div class="my-3 rounded-xl border border-red-200 dark:border-red-900/50 bg-red-50 dark:bg-red-900/20 px-4 py-2 text-sm text-red-600 dark:text-red-400" role="alert">@_error</div>
            }

            @if (_followUps.Count > 0 && !_streaming)
            {
                <div class="flex flex-col gap-1.5 mb-2">
                    @foreach (var suggestion in _followUps)
                    {
                        <button class="text-left rounded-xl border border-gray-100 dark:border-gray-850 px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-850 transition cursor-pointer"
                                @onclick="() => SendFollowUpAsync(suggestion)">@suggestion</button>
                    }
                </div>
            }
        </div>
    </div>

    <div class="w-full bg-transparent">
        <div class="mx-auto w-full max-w-4xl px-4 pb-3">
            @if (_attachedFiles.Count > 0)
            {
                <div class="mb-1 mx-1 flex flex-wrap gap-1.5">
                    @foreach (var file in _attachedFiles)
                    {
                        <span class="flex items-center gap-1.5 rounded-xl bg-gray-100 dark:bg-gray-850 px-2.5 py-1 text-xs text-gray-700 dark:text-gray-300">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="m18.375 12.739-7.693 7.693a4.5 4.5 0 0 1-6.364-6.364l10.94-10.94A3 3 0 1 1 19.5 7.372L8.552 18.32m.009-.01-.01.01m5.699-9.941-7.81 7.81a1.5 1.5 0 0 0 2.112 2.13" /></svg>
                            @file.Filename
                            <button class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 cursor-pointer" @onclick="() => _attachedFiles.Remove(file)">×</button>
                        </span>
                    }
                </div>
            }
            @if (_mentionPaths.Count > 0)
            {
                @* Chips de menção @path (RF-001): unidade atômica — × ou Backspace remove inteiro. *@
                <div class="mb-1 mx-1 flex flex-wrap gap-1.5" aria-label="@L["chat.mentions"]">
                    @foreach (var path in _mentionPaths)
                    {
                        <span class="mention-chip">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" /></svg>
                            @path
                            <button class="text-blue-400 hover:text-blue-600 dark:hover:text-blue-200 cursor-pointer" aria-label="@L["chat.mention_remove"]" @onclick="() => _mentionPaths.Remove(path)">×</button>
                        </span>
                    }
                </div>
            }

            <div class="flex-1 flex flex-col relative w-full shadow-lg rounded-3xl border border-gray-100/30 dark:border-gray-850/30 hover:border-gray-200 focus-within:border-gray-100 hover:dark:border-gray-800 focus-within:dark:border-gray-800 transition px-0.5 bg-white/5 dark:bg-gray-500/5 backdrop-blur-sm dark:text-gray-100">
                <div class="px-2 relative">
                    @if (_promptSuggestions.Count > 0)
                    {
                        <div class="mb-1 rounded-2xl bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800/50 overflow-hidden" role="listbox">
                            @foreach (var p in _promptSuggestions)
                            {
                                <button class="w-full text-left px-3 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-850 cursor-pointer flex items-center gap-2"
                                        role="option"
                                        @onclick="() => SelectPrompt(p)">
                                    <span class="text-[10px] uppercase tracking-wide px-1 rounded bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 shrink-0">@L[$"chat.src_{p.Source}"]</span>
                                    <span class="truncate">/@p.Command @p.Title</span>
                                </button>
                            }
                        </div>
                    }
                    @if (_mentionItems.Count > 0)
                    {
                        @* Dropdown @path (RF-001): top-20, dirs primeiro, substring no nome/caminho. *@
                        <div class="mention-list" role="listbox" aria-label="@L["chat.mentions"]">
                            @foreach (var item in _mentionItems)
                            {
                                <button class="w-full text-left px-3 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-850 cursor-pointer flex items-center gap-2"
                                        role="option"
                                        @onclick="() => SelectMention(item)">
                                    <span class="text-[10px] uppercase tracking-wide px-1 rounded bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400 shrink-0">@(item.Type == "dir" ? "dir" : "file")</span>
                                    <span class="truncate">@item.Path</span>
                                </button>
                            }
                        </div>
                    }
                    <textarea
                        class="scrollbar-hidden bg-transparent dark:text-gray-100 outline-none w-full py-3 px-1 resize-none h-fit max-h-96 overflow-auto placeholder:text-gray-400 dark:placeholder:text-gray-600 text-[0.9375rem]"
                        aria-label="@L["chat.input_placeholder"]"
                        placeholder="@(_uploading ? L["chat.uploading"] : L["chat.input_placeholder"])"
                        rows="1"
                        @bind="_input"
                        @bind:event="oninput"
                        @bind:after="OnComposerInputAsync"
                        @onkeydown="OnKeyDown"
                        disabled="@_loading"></textarea>
                </div>

                <div class="flex justify-between mt-0.5 mb-2 mx-0.5 max-w-full" dir="ltr">
                    <div class="ml-1 self-end flex items-center flex-1 min-w-0">
                        @if (_tools.Count > 0 || _webSearchAvailable)
                        {
                            <div class="relative">
                                <button class="size-8 flex items-center justify-center rounded-full transition cursor-pointer disabled:opacity-40
                                               @(_toolIds.Count > 0 || _webSearch ? "text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-950/40" : "text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800")"
                                        title="@L["chat.tools"]" aria-label="@L["chat.tools"]" aria-expanded="@_showToolsMenu" aria-haspopup="dialog" disabled="@_loading"
                                        @ref="_toolsTrigger" @onclick="ToggleToolsMenu">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" /></svg>
                                </button>
                                @if (_showToolsMenu)
                                {
                                    <div class="fixed inset-0 z-30" @onclick="() => _showToolsMenu = false"></div>
                                    <div class="absolute bottom-10 left-0 z-40 w-64 rounded-2xl bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800/50 shadow-lg max-h-[60vh] overflow-y-auto overflow-x-hidden"
                                         role="group" aria-label="@L["chat.tools"]" @ref="_toolsMenu" @onkeydown="OnToolsMenuKeyDown">
                                        @if (_webSearchAvailable)
                                        {
                                            <div class="px-3 py-2 text-xs font-medium text-gray-500 dark:text-gray-400">@L["chat.tools_features"]</div>
                                            <label class="flex items-center gap-2 px-3 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-850 cursor-pointer">
                                                <input type="checkbox" checked="@_webSearch"
                                                       @onchange="ToggleWebSearchAsync" />
                                                @CategoryIcon("web")
                                                <span class="truncate">@L["chat.web_search"]</span>
                                            </label>
                                        }
                                        @if (_tools.Count > 0)
                                        {
                                            <div class="px-3 py-2 text-xs font-medium text-gray-500 dark:text-gray-400">@L["chat.tools_in_chat"]</div>
                                            @foreach (var cat in ToolCategoryOrder)
                                            {
                                                var catTools = _tools.Where(t => ToolCategory(t) == cat).ToList();
                                                if (catTools.Count == 0)
                                                {
                                                    continue;
                                                }
                                                var catConfigured = CategoryConfigured(cat);
                                                <label class="flex items-center gap-2 px-3 py-1.5 text-xs font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-850 border-t border-gray-50 dark:border-gray-850/60 first:border-t-0
                                                            @(catConfigured ? "cursor-pointer" : "opacity-50 cursor-not-allowed")"
                                                       title="@(catConfigured ? null : L["chat.tool_not_configured"])">
                                                    <input type="checkbox" checked="@IsCategoryEnabled(cat)"
                                                           disabled="@(!catConfigured)"
                                                           @onchange="() => ToggleCategoryAsync(cat)" />
                                                    @CategoryIcon(cat)
                                                    <span class="truncate flex-1">@L[$"chat.tools_cat_{cat}"]</span>
                                                    @if (!catConfigured)
                                                    {
                                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5 flex-none text-red-500"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 0 0 5.636 5.636m12.728 12.728A9 9 0 0 1 5.636 5.636m12.728 12.728L5.636 5.636" /></svg>
                                                    }
                                                </label>
                                                @foreach (var tool in catTools)
                                                {
                                                    <label class="flex items-center gap-2 pl-7 pr-3 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-850
                                                                  @(catConfigured ? "cursor-pointer" : "opacity-50 cursor-not-allowed")">
                                                        <input type="checkbox" checked="@_toolIds.Contains(tool.Id)"
                                                               disabled="@(!catConfigured)"
                                                               @onchange="() => ToggleToolAsync(tool.Id)" />
                                                        <span class="truncate">@tool.Name</span>
                                                        @if (tool.RequiresApproval)
                                                        {
                                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                                                                 class="size-3 flex-none text-amber-500" title="@L["chat.tool_approval_title"]">
                                                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                                                            </svg>
                                                        }
                                                    </label>
                                                }
                                            }
                                        }
                                        @if (_loadedChatId is not null && !Playground)
                                        {
                                            <div class="border-t border-gray-100 dark:border-gray-800 px-3 py-2 text-xs font-medium text-gray-500 dark:text-gray-400">
                                                @L["chat.approval_preset"]
                                            </div>
                                            @foreach (var preset in ApprovalPresets)
                                            {
                                                <label class="flex items-center gap-2 px-3 py-1 text-xs text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-850 cursor-pointer">
                                                    <input type="radio" name="approvalPreset"
                                                           checked="@(_approvalPreset == preset)"
                                                           @onchange="() => SetApprovalPresetAsync(preset)" />
                                                    <span class="truncate">@L["chat.preset_" + preset]</span>
                                                </label>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @if (CategoryHasTools("image"))
                        {
                            <button class="relative size-8 flex items-center justify-center rounded-full transition disabled:opacity-40
                                           @(CategoryIconClass("image"))"
                                    title="@(CategoryConfigured("image") ? L["chat.generate_image"] : L["chat.tool_not_configured"])"
                                    aria-label="@L["chat.generate_image"]"
                                    disabled="@(_loading || !CategoryConfigured("image"))"
                                    @onclick='() => ToggleCategoryAsync("image")'>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>
                                @if (!CategoryConfigured("image"))
                                {
                                    <span class="absolute left-1.5 right-1.5 top-1/2 h-0.5 -translate-y-1/2 -rotate-45 bg-red-500 rounded-full pointer-events-none"></span>
                                }
                            </button>
                        }
                        @if (CategoryHasTools("video"))
                        {
                            <button class="relative size-8 flex items-center justify-center rounded-full transition disabled:opacity-40
                                           @(CategoryIconClass("video"))"
                                    title="@(CategoryConfigured("video") ? L["chat.generate_video"] : L["chat.tool_not_configured"])"
                                    aria-label="@L["chat.generate_video"]"
                                    disabled="@(_loading || !CategoryConfigured("video"))"
                                    @onclick='() => ToggleCategoryAsync("video")'>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>
                                @if (!CategoryConfigured("video"))
                                {
                                    <span class="absolute left-1.5 right-1.5 top-1/2 h-0.5 -translate-y-1/2 -rotate-45 bg-red-500 rounded-full pointer-events-none"></span>
                                }
                            </button>
                        }
                        @if (CategoryHasTools("web") || _webSearchAvailable)
                        {
                            <button class="relative size-8 flex items-center justify-center rounded-full transition disabled:opacity-40
                                           @(CategoryIconClass("web"))"
                                    title="@(CategoryConfigured("web") ? L["chat.web_search"] : L["chat.tool_not_configured"])"
                                    aria-label="@L["chat.web_search"]"
                                    disabled="@(_loading || !CategoryConfigured("web"))"
                                    @onclick='() => ToggleCategoryAsync("web")'>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.5 0 4.5-4 4.5-9S14.5 3 12 3m0 18c-2.5 0-4.5-4-4.5-9S9.5 3 12 3m-8.7 6h17.4M3.3 15h17.4" /></svg>
                                @if (!CategoryConfigured("web"))
                                {
                                    <span class="absolute left-1.5 right-1.5 top-1/2 h-0.5 -translate-y-1/2 -rotate-45 bg-red-500 rounded-full pointer-events-none"></span>
                                }
                            </button>
                        }
                        <button class="size-8 flex items-center justify-center rounded-full text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 transition cursor-pointer disabled:opacity-40"
                                title="@L["chat.attach"]" aria-label="@L["chat.attach"]" disabled="@(_loading || _uploading)"
                                @onclick="TriggerFilePicker">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                        </button>
                        <InputFile @ref="_fileInput" OnChange="OnFileSelected" class="hidden" />
                        <VoiceButton Disabled="@(_loading || _streaming)" Lang="@SttLang"
                                     OnDictationStarted="() => _sttBase = _input"
                                     OnTranscript="OnSttTranscript"
                                     OnDictationEnded="OnSttDoneAsync"
                                     OnError="OnSttErr" />
                        <div class="relative">
                            <button class="size-8 flex items-center justify-center rounded-full transition cursor-pointer disabled:opacity-40 @(ModeButtonClass)"
                                    title="@ModeTitle" aria-label="@ModeTitle" aria-expanded="@_showModeMenu" aria-haspopup="menu" disabled="@_loading"
                                    @ref="_modeTrigger" @onclick="ToggleModeMenu">
                                @ModeIcon(_approvalPreset)
                            </button>
                            @if (_showModeMenu)
                            {
                                <div class="fixed inset-0 z-30" @onclick="() => _showModeMenu = false"></div>
                                <div class="absolute bottom-10 right-0 z-40 w-64 rounded-2xl bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800/50 shadow-lg overflow-hidden"
                                     role="menu" aria-label="@L["chat.mode_title"]" @ref="_modeMenu" @onkeydown="OnModeMenuKeyDown">
                                    <div class="px-3 py-2 text-xs font-medium text-gray-500 dark:text-gray-400">
                                        @L["chat.mode_title"]
                                    </div>
                                    @foreach (var mode in ModeOptions)
                                    {
                                        <button class="w-full flex items-center gap-2.5 px-3 py-2 text-left transition hover:bg-gray-50 dark:hover:bg-gray-850 cursor-pointer
                                                       @(_approvalPreset == mode ? "text-blue-600 dark:text-blue-400" : "text-gray-700 dark:text-gray-300")"
                                                role="menuitemradio" aria-checked="@(_approvalPreset == mode)"
                                                @onclick="() => SelectModeAsync(mode)">
                                            @ModeIcon(mode)
                                            <span class="flex-1 min-w-0">
                                                <span class="block truncate text-sm">@L["chat.preset_" + mode]</span>
                                                <span class="block truncate text-[0.6875rem] text-gray-400 dark:text-gray-500">@L["chat.mode_hint_" + mode]</span>
                                            </span>
                                            @if (_approvalPreset == mode)
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 flex-none">
                                                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                                                </svg>
                                            }
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="self-end flex items-center gap-1 mr-1">
                        <AgentModeToggle Mode="@_agentMode" Disabled="@_loading"
                                         OnToggle="ToggleAgentModeAsync" />
                        @if (_streaming)
                        {
                            if (_paused)
                            {
                                <button class="size-8 flex items-center justify-center rounded-full bg-blue-600 text-white transition cursor-pointer"
                                        title="@L["chat.resume"]" aria-label="@L["chat.resume"]" @onclick="ResumeStreaming">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd" /></svg>
                                </button>
                            }
                            else
                            {
                                <button class="size-8 flex items-center justify-center rounded-full bg-gray-900 text-white dark:bg-white dark:text-gray-900 transition cursor-pointer"
                                        title="@L["chat.pause"]" aria-label="@L["chat.pause"]" @onclick="PauseStreaming">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M6.75 5.25a.75.75 0 0 1 .75-.75H9a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75H7.5a.75.75 0 0 1-.75-.75V5.25Zm7.5 0a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v13.5a.75.75 0 0 1-.75.75H15a.75.75 0 0 1-.75-.75V5.25Z" clip-rule="evenodd" /></svg>
                                </button>
                            }
                            <button class="size-8 flex items-center justify-center rounded-full bg-gray-900 text-white dark:bg-white dark:text-gray-900 transition cursor-pointer"
                                    title="@L["chat.stop"]" aria-label="@L["chat.stop"]" @onclick="StopStreaming">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M4.5 7.5a3 3 0 0 1 3-3h9a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3h-9a3 3 0 0 1-3-3v-9Z" clip-rule="evenodd" /></svg>
                            </button>
                        }
                        else
                        {
                            <button class="size-8 flex items-center justify-center rounded-full transition cursor-pointer disabled:opacity-40
                                           @(SendDisabled ? "bg-gray-100 text-gray-400 dark:bg-gray-800 dark:text-gray-600" : "bg-gray-900 text-white dark:bg-white dark:text-gray-900")"
                                    title="@L["chat.send"]" aria-label="@L["chat.send"]" disabled="@SendDisabled" @onclick="SendAsync">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" /></svg>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-1.5 text-center text-[0.6875rem] text-gray-400 dark:text-gray-600">
                Open WebUI .NET — Blazor WebAssembly — by Afonsoft
            </div>
        </div>
    </div>

    <RepoPickerModal @bind-Active="_repoPicker" Bound="OnRepoBoundAsync"
                     Source="OnRepoSourceChanged" ChatId="_loadedChatId" />
    <CallOverlay Active="_callActive" Lang="@SttLang"
                 OnTurn="ExecuteVoiceTurnAsync"
                 OnClose="() => _callActive = false" />
</div>

@if (_showPanel)
{
    @* Painel de workspace (RF-015): coluna ≥lg, drawer no mobile. *@
    <aside class="hidden lg:flex w-80 xl:w-96 flex-none relative" @ref="_panelEl">
        <div class="absolute inset-y-0 -left-1 w-2 z-10 cursor-col-resize rounded transition-colors hover:bg-blue-500/20 active:bg-blue-500/30"
             role="separator" aria-orientation="vertical" aria-label="@L["chat.panel_resize"]"
             title="@L["chat.panel_resize"]" tabindex="0" @ref="_panelResizer"></div>
        <ChatWorkspacePanel Tasks="_runTasks" Changes="_runChanges" Jobs="_jobs"
                            Mcps="_mcps" PhaseLabel="@_statusLabel" Preset="@_approvalPreset"
                            Model="@_model" RunId="@_activeRunId" Git="_git"
