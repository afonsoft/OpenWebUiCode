    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Chamadas independentes em paralelo (antes: ~6 sequenciais no boot).
            var promptsTask = Api.GetPromptsAsync();
            var toolsTask = Api.GetToolsAsync();
            var modelsTask = Api.GetModelsConfigAsync();
            var configTask = Api.GetAppConfigCachedAsync();
            var storedTask = StoredWebSearchAsync();
            var repoTask = Api.GetWorkspaceRepoAsync();
            // Por chat (SPEC-20261010-chat-repo-binding): depois que o chat
            // carrega, o binding efetivo + origem vem do endpoint por chat.
            await Task.WhenAll(promptsTask, toolsTask, modelsTask, configTask, storedTask, repoTask);

            _prompts = promptsTask.Result;
            _tools = toolsTask.Result;
            _suggestions = modelsTask.Result?.PromptSuggestions ?? [];
            _repo = repoTask.Result;
            if (_repo?.Repo is not null)
            {
                _repoSkills = await Api.GetRepoSkillsAsync();
                _repoCommands = await Api.GetRepoCommandsAsync();
            }
            var features = configTask.Result?.Features;
            _webSearchAvailable = features?.EnableWebSearch ?? false;
            _imageGenEnabled = features?.EnableImageGeneration ?? false;
            _videoGenEnabled = features?.EnableVideoGeneration ?? false;
            // Busca web desligada por padrão (o usuário habilita no ícone);
            // a escolha explícita do usuário (localStorage) tem precedência.
            _webSearch = storedTask.Result == "true" && _webSearchAvailable;
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            // Offline/SW: chat renderiza degradado (sem prompts/tools/modelos)
            // em vez de cair na blazor-error-ui.
            await Console.Error.WriteLineAsync($"[ChatView] init falhou: {ex.Message}");
        }
        catch (Exception ex)
        {
            // OnInitializedAsync é lifecycle: qualquer escape vai direto pra
            // blazor-error-ui — loga e renderiza degradado em vez de cair.
            await Console.Error.WriteLineAsync($"[ChatView] init falhou: {ex}");
        }

        // OnParametersSetAsync pode rodar antes das tools carregarem —
        // garante o default "genéricas ligadas" num chat novo.
        if (ChatId is null && _toolIds.Count == 0)
        {
            _toolIds = DefaultToolIds();
        }

        Realtime.OnChatMessageUpdated += HandleChatMessageUpdated;
        Realtime.OnChatMessageDeleted += HandleChatMessageDeleted;
        try
        {
            await Realtime.ConnectAsync(Nav.BaseUri, Auth.Token);
        }
        catch (Exception ex)
        {
            // Realtime é best-effort: falha na conexão não pode derrubar a página.
            await Console.Error.WriteLineAsync($"[ChatView] realtime falhou: {ex.Message}");
        }
    }

    private async Task<string?> StoredWebSearchAsync()
    {
        try
        {
            return await JS.InvokeAsync<string?>("localStorage.getItem", "webui.chat.websearch");
        }
        catch (JSException ex)
        {
            Console.WriteLine($"localStorage indisponível: {ex.Message}");
            return null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _voiceSupported = await JS.InvokeAsync<bool>("openwebui.audio.sttSupported");
                _ttsSupported = await JS.InvokeAsync<bool>("openwebui.audio.ttsSupported");
                // Listener de "perto do fim" para o auto-scroll do stream.
                await JS.InvokeVoidAsync("openwebui.initPinnedScroll", _scrollContainer);
            }
            catch (Exception ex) when (ClientErrors.IsTransient(ex) || ex is InvalidOperationException)
            {
                // Interop indisponível: áudio/scroll degradam sem derrubar a página.
                await Console.Error.WriteLineAsync($"[ChatView] js init falhou: {ex.Message}");
            }
            if (_voiceSupported || _ttsSupported)
            {
                StateHasChanged();
            }
        }
        if (_focusToolsMenu)
        {
            _focusToolsMenu = false;
            await JS.InvokeVoidAsync("openwebui.focusFirst", _toolsMenu);
        }
        if (_focusModeMenu)
        {
            _focusModeMenu = false;
            await JS.InvokeVoidAsync("openwebui.focusFirst", _modeMenu);
        }
        if (_showPanel)
        {
            // Divisor arrastável da coluna (idempotente via flag no elemento).
            await JS.InvokeVoidAsync("openwebui.panelResize", _panelResizer, _panelEl);
        }
        if (_showPanel && !_drawerTrapped)
        {
            _drawerTrapped = true;
            await JS.InvokeVoidAsync("openwebui.trapFocus", _drawerEl);
        }
        else if (!_showPanel && _drawerTrapped)
        {
            _drawerTrapped = false;
            await JS.InvokeVoidAsync("openwebui.releaseFocus", _drawerEl);
        }
    }

    private void ToggleToolsMenu()
