    /// <summary>Recarrega o chat do servidor (fonte da verdade após run desacoplada).</summary>
    private async Task ReloadChatAsync()
    {
        if (_loadedChatId is null)
        {
            return;
        }

        var chat = await Api.GetChatAsync(_loadedChatId);
        if (chat is null)
        {
            return;
        }

        _messages.Clear();
        _messages.AddRange(chat.Messages);
        _chatTitle = chat.Title;
        ChatList.NotifyChanged();
        await InvokeAsync(StateHasChanged);
        await ScrollToEndAsync();
    }

    private async Task VoteArenaAsync(string winner)
    {
        if (_arena is null || _arenaVoting)
        {
            return;
        }
        _arenaVoting = true;
        try
        {
            var feedback = await Api.VoteArenaAsync(_arena.BattleId, winner);
            if (feedback is not null)
            {
                _arenaFeedback = feedback;
                var winnerModel = winner switch
                {
                    "a" => feedback.ModelA,
                    "b" => feedback.ModelB,
                    _ => null,
                };
                var label = winnerModel is null
                    ? L[winner == "tie" ? "arena.result_tie" : "arena.result_both_bad"]
                    : L.T("arena.result_winner", ("model", winnerModel));
                var index = _messages.Count - 1;
                if (index >= 0 && _messages[index].Role == "assistant")
                {
                    _messages[index] = _messages[index] with { Content = label };
                }
                await PersistAsync();
            }
        }
        finally
        {
            _arenaVoting = false;
        }
    }

    private void StopStreaming()
    {
        // Run desacoplada: pede o stop no servidor (o cancel local só fecha o attach).
        if (_activeRunId is not null && _loadedChatId is not null)
        {
            _ = ChatStream.StopRunAsync(_loadedChatId, _activeRunId);
        }
    }

    /// <summary>Pausa a run ativa no servidor — ela bloqueia no próximo checkpoint.</summary>
    private void PauseStreaming()
    {
        if (_activeRunId is not null && _loadedChatId is not null)
        {
            _ = ChatStream.PauseRunAsync(_loadedChatId, _activeRunId);
        }
    }

    /// <summary>Retoma a run pausada de onde ela parou.</summary>
    private void ResumeStreaming()
    {
        if (_activeRunId is not null && _loadedChatId is not null)
        {
            _paused = false;
            _ = ChatStream.ResumeRunAsync(_loadedChatId, _activeRunId);
        }
    }

