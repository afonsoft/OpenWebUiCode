    /// <summary>
    /// Snapshot git do workspace (RF-018): usa a run ativa, senão a mais
    /// recente do chat. Silencioso — sem repo retorna <c>Git=false</c>.
    /// </summary>
    /// <summary>Binding repo↔workspace mudou: atualiza o pill e o snapshot git.</summary>
    private async Task OnRepoBoundAsync(WorkspaceRepoResponse? binding)
    {
        _repo = binding?.Repo is null ? null : binding;
        _repoSource ??= "chat";
        if (_repo?.Repo is not null)
        {
            _repoSkills = await Api.GetRepoSkillsAsync(_loadedChatId);
            _repoCommands = await Api.GetRepoCommandsAsync(_loadedChatId);
        }
        else
        {
            _repoSkills = [];
            _repoCommands = [];
        }
        _git = null;
        await RefreshGitAsync();
        StateHasChanged();
    }

    private Task OnRepoSourceChanged(string? source)
    {
        _repoSource = source;
        return Task.CompletedTask;
    }

    /// <summary>Pós-revert de checkpoint (S6): recarrega o git bar/aba Changes.</summary>
    private async Task OnCheckpointRevertedAsync() => await RefreshGitAsync();

    private async Task RefreshGitAsync()
    {
        if (_loadedChatId is null)
        {
            return;
        }

        var runId = _activeRunId;
        if (runId is null)
        {
            try
            {
                runId = (await ChatStream.GetRunsAsync(_loadedChatId))
                    .FirstOrDefault()?.Id;
            }
            catch (Exception ex) when (ClientErrors.IsTransient(ex)) { return; }
        }
        if (runId is null)
        {
            return;
        }

        try
        {
            _git = await Api.GetRunDiffAsync(_loadedChatId, runId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"git diff indisponível: {ex.Message}");
        }
        // Chamado fire-and-forget no load do chat — precisa repintar o chip.
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Recarrega jobs do usuário e servidores MCP (admin).</summary>
    private async Task RefreshPanelAsync()
    {
        try
        {
            _jobs = await Api.GetJobsAsync(_loadedChatId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"jobs indisponíveis: {ex.Message}");
        }
        if (Auth.CurrentUser?.Role == UserRoles.Admin)
        {
            try
            {
                _mcps = await Api.GetMcpServersAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"MCPs indisponíveis: {ex.Message}");
            }
        }
    }

    /// <summary>Mata um job em background a partir do painel.</summary>
    private async Task KillJobAsync(string jobId)
    {
        await Api.KillJobAsync(jobId);
        await RefreshPanelAsync();
    }

    /// <summary>
    /// Categorias de tools do picker, na ordem de exibição. A categoria de
    /// uma tool builtin é dada pelo nome (após <c>builtin:</c>); tools de
    /// usuário/MCP caem em <c>custom</c>.
    /// </summary>
    private static readonly (string Key, string[] Names)[] ToolCategoryDefs =
    [
        ("web",          ["web_search", "fetch_url", "browser_screenshot"]),
        ("image",        ["generate_image"]),
        ("video",        ["generate_video"]),
        ("files",        ["file_list", "file_read", "file_grep", "file_glob", "file_write", "file_edit"]),
        ("code",         ["shell_exec", "code_interpreter"]),
        ("jobs",         ["job_list", "job_output", "job_kill"]),
        ("tasks",        ["todo_write", "ask_user", "delegate_task"]),
        ("integrations", ["n8n_list_workflows", "n8n_trigger"]),
        ("custom",       []),
    ];

    private static readonly string[] ToolCategoryOrder =
        ToolCategoryDefs.Select(c => c.Key).ToArray();

    private static string ToolCategory(ToolResponse tool)
    {
        var name = tool.Id.StartsWith("builtin:", StringComparison.OrdinalIgnoreCase)
            ? tool.Id["builtin:".Length..]
            : tool.Name;
        foreach (var (key, names) in ToolCategoryDefs)
        {
            if (names.Contains(name, StringComparer.OrdinalIgnoreCase))
            {
                return key;
            }
        }
        return "custom";
    }

    private List<string> CategoryIds(string category) =>
        _tools.Where(t => ToolCategory(t) == category).Select(t => t.Id).ToList();

    private bool CategoryHasTools(string category) =>
        _tools.Any(t => ToolCategory(t) == category);

    /// <summary>
    /// Categorias que dependem de recurso configurado no backend — começam
    /// desligadas e só podem ser habilitadas quando o admin configura.
    /// </summary>
    private static readonly HashSet<string> GatedCategories = ["image", "video", "web"];

    /// <summary>Default de chat novo: todas as tools, menos as categorias gated.</summary>
    private HashSet<string> DefaultToolIds() =>
        _tools.Where(t => !GatedCategories.Contains(ToolCategory(t)))
            .Select(t => t.Id).ToHashSet();

    /// <summary>Se a categoria tem o recurso correspondente configurado no backend.</summary>
    private bool CategoryConfigured(string category) => category switch
    {
        "image" => _imageGenEnabled,
        "video" => _videoGenEnabled,
        "web" => _webSearchAvailable,
        _ => true,
    };

    /// <summary>Classes dos ícones rápidos: azul ativo, cinza normal, riscado quando não configurado.</summary>
    private string CategoryIconClass(string category) =>
        !CategoryConfigured(category)
            ? "text-gray-400 dark:text-gray-600 cursor-not-allowed"
            : IsCategoryEnabled(category)
                ? "text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-950/40 cursor-pointer"
                : "text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 cursor-pointer";

    /// <summary>Categoria ligada: todas as tools dela selecionadas (web exige também o flag de busca).</summary>
    private bool IsCategoryEnabled(string category)
    {
        if (!CategoryConfigured(category))
        {
            return false;
        }

        var ids = CategoryIds(category);
        var toolsOn = ids.Count > 0 && ids.All(_toolIds.Contains);
        return category == "web"
            ? _webSearch && (ids.Count == 0 || toolsOn)
            : toolsOn;
    }

    /// <summary>Liga/desliga a categoria inteira de uma vez (ícones rápidos e cabeçalho do menu).</summary>
    private async Task ToggleCategoryAsync(string category)
    {
        if (!CategoryConfigured(category))
        {
            return;
        }

        var on = IsCategoryEnabled(category);
        var ids = CategoryIds(category);
        foreach (var id in ids)
        {
            if (on)
            {
                _toolIds.Remove(id);
            }
            else
            {
                _toolIds.Add(id);
            }
        }
        if (category == "web")
        {
            await SetWebSearchAsync(!on);
        }
        await PersistAsync();
    }

