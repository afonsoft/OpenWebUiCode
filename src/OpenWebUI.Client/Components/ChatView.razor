    /// <summary>Preset padrão do composer (localStorage) para chats novos.</summary>
    private async Task<string> StoredPresetAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>(
                "localStorage.getItem", "webui.chat.preset");
            return stored is "approve-mutations" or "always-allow"
                or "smart" or "auto" or "allow-readonly"
                ? stored
                : "approve-mutations";
        }
        catch (JSException)
        {
            return "approve-mutations";
        }
