    private async Task StreamAssistantAsync(
        IReadOnlyList<string> fileIds, string? runContent = null,
        IReadOnlyList<string>? mentionPaths = null)
    {
        if (_loadedChatId is not null && !Playground)
        {
            await StreamDetachedRunAsync(fileIds, runContent, mentionPaths);
            return;
        }

        var placeholder = new ChatMessageModel(
            Guid.NewGuid().ToString(), "assistant", string.Empty, _model,
            DateTimeOffset.UtcNow.ToUnixTimeSeconds());
        _messages.Add(placeholder);
        var index = _messages.Count - 1;

        _streaming = true;
        _arena = null;
        _arenaFeedback = null;
        _cts = new CancellationTokenSource();
        var content = new System.Text.StringBuilder();

        try
        {
            var request = new ChatCompletionRequest(
                _model!,
                _messages.Take(index)
                    .Select(m => new ChatCompletionMessage(m.Role, m.Content))
                    .ToList(),
                Stream: true,
                FileIds: fileIds.Count > 0 ? fileIds : null,
                ToolIds: _toolIds.Count > 0 ? _toolIds.ToList() : null,
                WebSearch: _webSearch ? true : null,
                MentionPaths: mentionPaths);

            var lastRender = DateTime.MinValue;
            await foreach (var delta in ChatStream.StreamCompletionAsync(request, _cts.Token))
            {
                content.Append(delta);
                _messages[index] = placeholder with { Content = content.ToString() };
                if ((DateTime.UtcNow - lastRender).TotalMilliseconds >= RenderIntervalMs)
                {
                    lastRender = DateTime.UtcNow;
                    await InvokeAsync(StateHasChanged);
                    await ScrollToEndIfPinnedAsync();
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Cancelamento é o caminho esperado de shutdown.
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            if (ChatStream.LastArenaResult is { } arenaResult)
            {
                _arena = arenaResult;
            }
            _streaming = false;
            _cts?.Dispose();
            _cts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>
    /// Caminho desacoplado (SPEC-20261007-chat-detached-runs): enfileira a run
    /// (o servidor persiste a mensagem do usuário e reconstrói o histórico),
    /// anexa ao stream e, ao fim, recarrega o chat — o servidor é a fonte da
    /// verdade das mensagens.
    /// </summary>
    private async Task StreamDetachedRunAsync(
        IReadOnlyList<string> fileIds, string? runContent,
        IReadOnlyList<string>? mentionPaths = null)
    {
        var placeholder = new ChatMessageModel(
            Guid.NewGuid().ToString(), "assistant", string.Empty, _model,
            DateTimeOffset.UtcNow.ToUnixTimeSeconds());
        _messages.Add(placeholder);
        var index = _messages.Count - 1;

        _streaming = true;
        _hasDeltas = false;
        _statusLabel ??= _thinkingLabel;
        _arena = null;
        _arenaFeedback = null;
        _cts = new CancellationTokenSource();
        var content = new System.Text.StringBuilder();

        try
        {
            var run = await ChatStream.EnqueueRunAsync(
                _loadedChatId!, runContent, _model!,
                fileIds.Count > 0 ? fileIds : null,
                _toolIds.Count > 0 ? _toolIds.ToList() : null,
                _webSearch ? true : null,
                mentionPaths,
                _cts.Token);
            _activeRunId = run.Id;

            await ConsumeRunEventsAsync(
                _loadedChatId!, run.Id, content, placeholder, index, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Cancelamento é o caminho esperado de shutdown.
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _activeRunId = null;
            _pendingApproval = null;
            _pendingQuestion = null;
            _paused = false;
            _statusLabel = null;
            if (ChatStream.LastArenaResult is { } arenaResult)
            {
                _arena = arenaResult;
            }
            _streaming = false;
            _cts?.Dispose();
            _cts = null;
            // Render já: o avatar volta ao normal mesmo se o reload falhar.
            await InvokeAsync(StateHasChanged);
            try
            {
                await RefreshGitAsync();
                await ReloadChatAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"reload pós-run falhou: {ex.Message}");
            }
        }
    }

    /// <summary>Anexa a uma run em andamento ao carregar o chat (reload/aba reaberta).</summary>
    private async Task AttachActiveRunAsync(ChatRunResponse run)
    {
        var placeholder = new ChatMessageModel(
            Guid.NewGuid().ToString(), "assistant", string.Empty, run.Model,
            DateTimeOffset.UtcNow.ToUnixTimeSeconds());
        _messages.Add(placeholder);
        var index = _messages.Count - 1;

        _streaming = true;
        _hasDeltas = false;
        _statusLabel ??= _thinkingLabel;
        _activeRunId = run.Id;
        // Reattach numa run pausada já entra com o botão de resume.
        _paused = run.Status == "paused";
        _cts = new CancellationTokenSource();
        var content = new System.Text.StringBuilder();
        await InvokeAsync(StateHasChanged);

        try
        {
            await ConsumeRunEventsAsync(
                run.ChatId, run.Id, content, placeholder, index, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            // Cancelamento é o caminho esperado de shutdown.
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _activeRunId = null;
            _pendingApproval = null;
            _pendingQuestion = null;
            _paused = false;
            _statusLabel = null;
            _streaming = false;
            _cts?.Dispose();
            _cts = null;
            await InvokeAsync(StateHasChanged);
            try
            {
                await RefreshGitAsync();
                await ReloadChatAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"reload pós-reattach falhou: {ex.Message}");
            }
        }
    }

    /// <summary>
    /// Consome o stream tipado de uma run (SPEC-20261007-chat-tool-streaming):
    /// deltas viram conteúdo do placeholder; tool_call/tool_result viram
    /// cards ao vivo; status vira o chip de fase; approval_asked mostra o
    /// prompt de permissão.
    /// </summary>
    private async Task ConsumeRunEventsAsync(
        string chatId, string runId,
        System.Text.StringBuilder content,
        ChatMessageModel placeholder, int index, CancellationToken ct)
    {
        _liveToolCalls.Clear();
        _runTasks = [];
        _runChanges = [];
        _runCheckpoints = [];

        // Resume loop (SPEC-20261007-chat-tool-streaming): se o stream cair
        // no meio da run (proxy derrubando SSE ocioso, troca de rede, aba
        // em background), re-anexa com lastSeq — sem isso a UI congela e
        // só um refresh manual a destrava. O stall watchdog re-anexa quando
        // nada (nem heartbeat) chega por StallMs.
        var lastSeq = 0;
        var emptyAttaches = 0;
        var sawEvent = false;
        const int StallMs = 60_000;
        const int MaxEmptyAttaches = 5;
        var lastRender = DateTime.MinValue;
        var dirty = false;

        while (true)
        {
            var terminal = false;
            using var stall = CancellationTokenSource.CreateLinkedTokenSource(ct);
            stall.CancelAfter(StallMs);
            try
            {
                await foreach (var evt in ChatStream.StreamRunEventsAsync(
                    chatId, runId, lastSeq, stall.Token))
                {
                    stall.CancelAfter(StallMs);
                    if (evt.Seq > 0)
                    {
                        lastSeq = evt.Seq;
                    }
                    sawEvent = true;
                    terminal = await ApplyRunEventAsync(
                        evt, content, placeholder, index);
                    if (terminal)
                    {
                        break;
                    }
                    // Deltas chegam em rajada: o conteúdo é sempre aplicado
                    // acima, mas a tela só re-renderiza na cadência
                    // RenderIntervalMs (eventos de tool/fase renderizam já).
                    dirty |= evt is ChatStreamService.ChatStreamEvent.Delta;
                    if (evt is ChatStreamService.ChatStreamEvent.Delta
                        or ChatStreamService.ChatStreamEvent.Heartbeat
                        && (!dirty
                            || (DateTime.UtcNow - lastRender).TotalMilliseconds < RenderIntervalMs))
                    {
                        continue;
                    }
                    dirty = false;
                    lastRender = DateTime.UtcNow;
                    await InvokeAsync(StateHasChanged);
                    await ScrollToEndIfPinnedAsync();
                }
            }
            catch (OperationCanceledException) when (ct.IsCancellationRequested)
            {
                throw;
            }
            catch (Exception ex)
            {
                // Falha de transporte no meio do stream → tenta re-anexar.
                Console.WriteLine($"stream da run {runId} caiu: {ex.Message}");
            }

            if (terminal || ct.IsCancellationRequested)
            {
                return;
            }

            // Attach que não rendeu nenhum evento: a run pode já ter
            // finalizado (close sem fase terminal) — confere o status antes
            // de gastar backoff re-anexando.
            if (!sawEvent)
            {
                emptyAttaches++;
                var run = await ChatStream.GetRunAsync(chatId, runId, ct);
                if (run is null
                    || run.Status is "completed" or "failed" or "stopped" or "interrupted"
                    || emptyAttaches >= MaxEmptyAttaches)
                {
                    return;
                }
            }
            else
            {
                sawEvent = false;
                emptyAttaches = 0;
            }

            await Task.Delay(
                Math.Min(500 * (1 << emptyAttaches), 4_000), ct);
        }
    }

    /// <summary>
    /// Aplica um evento tipado da run ao estado da tela; retorna true na
    /// fase terminal (a run acabou — encerra o consumo do stream).
    /// </summary>
    private async Task<bool> ApplyRunEventAsync(
        ChatStreamService.ChatStreamEvent evt,
        System.Text.StringBuilder content,
        ChatMessageModel placeholder, int index)
    {
        switch (evt)
        {
                case ChatStreamService.ChatStreamEvent.Delta delta:
                    content.Append(delta.Text);
                    _messages[index] = placeholder with { Content = content.ToString() };
                    _hasDeltas = true;
                    if (_statusLabel == _thinkingLabel)
                    {
                        _statusLabel = L["chat.status_writing"];
                    }
                    break;
                case ChatStreamService.ChatStreamEvent.ToolCall call:
                    _liveToolCalls.Add(new ToolCallView { Call = call.Call });
                    break;
                case ChatStreamService.ChatStreamEvent.ToolResult result:
                {
                    var entry = _liveToolCalls.FindLast(t => t.Call.Id == result.Result.Id)
                        ?? _liveToolCalls.FindLast(t => t.Call.Name == result.Result.Name);
                    if (entry is null)
                    {
                        entry = new ToolCallView
                        {
                            Call = new RunToolCallEvent(
                                result.Result.Id, result.Result.Name, null),
                        };
                        _liveToolCalls.Add(entry);
                    }
                    entry.Result = result.Result;
                    // Job criado/atualizado por job_* ou shell_exec background
                    // reflete na aba Jobs do painel, se aberto.
                    if (_showPanel
                        && result.Result.Name.Contains("job", StringComparison.OrdinalIgnoreCase))
                    {
                        _ = RefreshPanelAsync();
                    }
                    break;
                }
                case ChatStreamService.ChatStreamEvent.Tasks tasks:
                    _runTasks = tasks.Snapshot.Tasks.ToList();
                    break;
                case ChatStreamService.ChatStreamEvent.Changes changes:
                    _runChanges = changes.Snapshot.Changes.ToList();
                    // file_* escreveu no workdir — a git bar/aba Changes atualiza.
                    await RefreshGitAsync();
                    break;
                case ChatStreamService.ChatStreamEvent.Checkpoint checkpoint:
                    _runCheckpoints.Add(new WorkspaceCheckpointItem(
                        checkpoint.Snapshot.Hash, checkpoint.Snapshot.Turn,
                        DateTimeOffset.UtcNow.ToUnixTimeSeconds()));
                    break;
                case ChatStreamService.ChatStreamEvent.Phase phase:
                    switch (phase.Status.Phase)
                    {
                        case "auto_approved":
                            _statusLabel = L.T("chat.status_auto_approved",
                                ("name", phase.Status.Label ?? ""));
                            break;
                        case "paused":
                            _paused = true;
                            _statusLabel = L["chat.status_paused"];
                            break;
                        case "resumed":
                            _paused = false;
                            _statusLabel = null;
                            break;
                        case "completed" or "failed" or "stopped" or "interrupted":
                            // Estado terminal da run: encerra sem depender do
                            // fechamento do SSE (proxies podem segurar o FIN).
                            return true;
                        case "generating":
                            _statusLabel = _hasDeltas
                                ? L["chat.status_writing"]
                                : _thinkingLabel;
                            break;
                        case "running_tool":
                            // Chip acompanha a atividade amigável da call atual.
                            _statusLabel = _liveToolCalls.LastOrDefault(t => t.Result is null)
                                is { } live
                                ? L[ToolActivityMap.KeyFor(live.Call.Name)]
                                : L["chat.activity.tool"];
                            break;
                        case "awaiting_approval":
                            _statusLabel = L["chat.status_approval"];
                            break;
                        default:
                            _paused = false;
                            _statusLabel = phase.Status.Label;
                            break;
                    }
                    break;
                case ChatStreamService.ChatStreamEvent.ApprovalAsked asked:
                    _pendingApproval = asked.Asked;
                    _ = Attention.RefreshAsync();
                    break;
                case ChatStreamService.ChatStreamEvent.QuestionAsked question:
                    _pendingQuestion = question.Asked;
                    _ = Attention.RefreshAsync();
                    break;
                case ChatStreamService.ChatStreamEvent.Mode modeEvt:
                    // plan_exit aprovado promoveu o chat a build mid-run.
                    _agentMode = modeEvt.Info.Mode is "plan" ? "plan" : "build";
                    break;
            }
        return false;
    }

    /// <summary>
    /// Envia a decisão (approve|deny) de uma aprovação pendente e limpa o
    /// prompt — a tool_result chega depois pelo stream.
    /// </summary>
    private async Task DecideApprovalAsync(
        string callId, string decision, bool remember, string? message = null)
    {
        _pendingApproval = null;
        if (_loadedChatId is null || _activeRunId is null)
        {
            return;
        }
        await ChatStream.DecideApprovalAsync(
            _loadedChatId, _activeRunId, callId, decision, remember, message);
        _ = Attention.RefreshAsync();
    }

    /// <summary>
    /// Responde a pergunta do ask_user (RF-005): approve + message = a
    /// resposta; null = o usuário pulou → deny (a run segue com "não
    /// respondeu"). O tool_result chega depois pelo stream.
    /// </summary>
    private async Task AnswerQuestionAsync(string callId, string? answer)
    {
        _pendingQuestion = null;
        if (_loadedChatId is null || _activeRunId is null)
        {
            return;
        }
        await ChatStream.DecideApprovalAsync(
            _loadedChatId, _activeRunId, callId,
            answer is null ? "deny" : "approve", false, answer);
        _ = Attention.RefreshAsync();
    }

    /// <summary>
    /// Troca o preset de aprovação (re-lido por call no servidor — mudança
    /// mid-run vale já na próxima tool). Persiste como padrão do composer
    /// para os próximos chats novos; chat existente recebe PATCH.
    /// </summary>
    private async Task SetApprovalPresetAsync(string preset)
    {
        _approvalPreset = preset;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "webui.chat.preset", preset);
        }
        catch (JSException)
        {
            // localStorage indisponível — o preset vale só nesta tela.
        }
        if (_loadedChatId is null)
        {
            return;
        }
        var updated = await Api.PatchChatAsync(_loadedChatId, preset);
        if (updated is not null)
        {
            _approvalPreset = updated.ApprovalPreset;
        }
    }

    /// <summary>
    /// Alterna o modo do agente plan↔build (SPEC-20261009 RF-004): persiste
    /// como padrão do composer (localStorage) e aplica no chat carregado
    /// via PATCH — o executor relê o modo por call.
    /// </summary>
    private async Task ToggleAgentModeAsync() =>
        await SetAgentModeAsync(_agentMode == "plan" ? "build" : "plan");

    /// <summary>Aplica o modo do agente (composer + chat carregado).</summary>
    private async Task SetAgentModeAsync(string mode)
    {
        _agentMode = mode;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "webui.chat.agentmode", mode);
        }
        catch (JSException)
        {
            // localStorage indisponível — o modo vale só nesta tela.
        }
        if (_loadedChatId is null)
        {
            return;
        }
        var updated = await Api.PatchChatAsync(_loadedChatId, mode: mode);
        if (updated is not null)
        {
            _agentMode = updated.Mode is "plan" ? "plan" : "build";
        }
    }

    /// <summary>Modo padrão do composer (localStorage) para chats novos.</summary>
    private async Task<string> StoredAgentModeAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>(
                "localStorage.getItem", "webui.chat.agentmode");
            return stored is "plan" ? "plan" : "build";
        }
        catch (JSException)
        {
            return "build";
        }
    }

