@inject ApiService Api
@inject LocalizationService L
@inject DialogService Dialog
@inject IJSRuntime JS

@* File explorer da /ide (S2 RF-001): tree lazy via GET /tree, menu de contexto
   com New file/folder, Rename, Delete (confirm). Branch + dirty badge no topo. *@

<div class="flex h-full min-h-0 flex-col">
    <div class="flex items-center gap-2 px-2 py-1.5 border-b border-gray-200 dark:border-gray-800">
        <span class="min-w-0 flex-1 truncate font-mono text-[0.6875rem] text-gray-600 dark:text-gray-400"
              title="@Branch">
            <span aria-hidden="true">⑂</span> @(Branch ?? "—")
            @if (DirtyCount > 0)
            {
                <span class="ms-1 text-amber-600 dark:text-amber-400">●@DirtyCount</span>
            }
        </span>
        <button class="msg-action" title="@L["ide.new_file"]" aria-label="@L["ide.new_file"]"
                @onclick="() => PromptAsync(FileAction.NewFile, null)">📄+</button>
        <button class="msg-action" title="@L["ide.new_folder"]" aria-label="@L["ide.new_folder"]"
                @onclick="() => PromptAsync(FileAction.NewFolder, null)">📁+</button>
        <button class="msg-action" title="@L["common.refresh"]" aria-label="@L["common.refresh"]"
                @onclick="RefreshAsync">⟳</button>
    </div>

    <div class="flex-1 min-h-0 overflow-auto py-1" role="tree" aria-label="@L["ide.explorer"]">
        <CascadingValue Value="this">
            @foreach (var node in _roots)
            {
                <IdeTreeNode Node="node" Depth="0"
                             OnOpenFile="OnOpenFile"
                         OnAction="@(t => PromptAsync(t.Item1, t.Item2))" />
            }
        </CascadingValue>
        @if (_loadFailed && _roots.Count == 0)
        {
            <OfflineRetry OnRetry="RefreshAsync" />
        }
        else if (_roots.Count == 0)
        {
            <div class="px-3 py-2 text-xs text-gray-400">@L["ide.empty_tree"]</div>
        }
    </div>

    @* Menu de contexto do item (SPEC-20261011-ide-search-scm). *@
    @if (_ctxNode is not null)
    {
        <div class="fixed inset-0 z-50" @onclick="() => _ctxNode = null" @oncontextmenu="() => _ctxNode = null" @oncontextmenu:preventDefault></div>
        <div class="fixed z-50 min-w-44 rounded-md border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 py-1 shadow-xl"
             style="left:@(_ctxX)px; top:@(_ctxY)px" role="menu">
            <button class="ide-menu-item" role="menuitem" @onclick='() => MenuActionAsync("new_file")'>@L["ide.new_file"]</button>
            <button class="ide-menu-item" role="menuitem" @onclick='() => MenuActionAsync("new_folder")'>@L["ide.new_folder"]</button>
            <div class="my-1 border-t border-gray-100 dark:border-gray-800"></div>
            <button class="ide-menu-item" role="menuitem" @onclick='() => MenuActionAsync("rename")'>@L["ide.rename"]</button>
            <button class="ide-menu-item" role="menuitem" @onclick='() => MenuActionAsync("copy_path")'>@L["ide.tab_copy_path"]</button>
            <button class="ide-menu-item" role="menuitem" @onclick='() => MenuActionAsync("delete")'>@L["ide.delete"]</button>
        </div>
    }
</div>

@code {
    /// <summary>Branch corrente do workdir (badge do topo).</summary>
    [Parameter] public string? Branch { get; set; }

    /// <summary>Arquivos alterados (numstat) — badge de dirty do topo.</summary>
    [Parameter] public int DirtyCount { get; set; }

    /// <summary>Callback quando um arquivo é clicado (path relativo).</summary>
    [Parameter] public EventCallback<string> OnOpenFile { get; set; }

    /// <summary>Callback pós-ação (rename/delete/create) — pai recarrega git/tree.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Chat cujo binding resolve o workdir (null = global).</summary>
    [Parameter] public string? ChatId { get; set; }

    /// <summary>Status git por path (decoration SPEC-20261011-ide-search-scm).</summary>
    [Parameter] public IReadOnlyDictionary<string, string>? GitStatus { get; set; }

    private List<IdeTreeEntry> _roots = [];
    private bool _loadFailed;
    private IdeTreeEntry? _ctxNode;
    private int _ctxX, _ctxY;

    /// <summary>Nó de tree com filhos carregados sob demanda.</summary>
    public sealed class IdeTreeEntry
    {
        public required string Name { get; init; }
        public required string Path { get; init; }
        public required string Type { get; init; }
        public bool Collapsed { get; init; }
        public bool Expanded { get; set; }
        public bool Loading { get; set; }
        public List<IdeTreeEntry>? Children { get; set; }
    }

    /// <summary>Ação do menu de contexto.</summary>
    public enum FileAction { NewFile, NewFolder, Rename, Delete, CopyPath }

    /// <summary>Status git do path (decoration): M/A/??/D/etc.</summary>
    public string? GitStatusFor(string path) =>
        GitStatus is not null && GitStatus.TryGetValue(path, out var s) ? s : null;

    /// <summary>Botão direito num nó → menu de contexto posicionado.</summary>
    internal void OnNodeContext(MouseEventArgs e, IdeTreeEntry node)
    {
        _ctxNode = node;
        _ctxX = (int)e.ClientX;
        _ctxY = (int)e.ClientY;
    }

    /// <summary>Dispatch do menu de contexto da tree.</summary>
    private async Task MenuActionAsync(string action)
    {
        var node = _ctxNode;
        _ctxNode = null;
        switch (action)
        {
            case "new_file": await PromptAsync(FileAction.NewFile, node); break;
            case "new_folder": await PromptAsync(FileAction.NewFolder, node); break;
            case "rename": await PromptAsync(FileAction.Rename, node); break;
            case "delete": await PromptAsync(FileAction.Delete, node); break;
            case "copy_path":
                if (node is not null)
                {
                    await JS.InvokeVoidAsync("owuiIdeLayout.copyText", node.Path);
                }
                break;
        }
    }

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync() => await RefreshAsync();

    /// <summary>Recarrega a raiz (raiz+2 níveis — lazy nos filhos expandidos).</summary>
    public async Task RefreshAsync()
    {
        try
        {
            var tree = await Api.GetWorkspaceTreeAsync(path: "", depth: 3, chatId: ChatId);
            if (tree is null)
            {
                // 404/erro (chatId inválido, checkout removido, repo desvinculado):
                // estado de falha com retry, nunca "Diretório vazio" falso.
                _roots = [];
                _loadFailed = true;
                return;
            }
            _roots = tree.Entries.Select(ToEntry).ToList();
            _loadFailed = false;
        }
        catch (HttpRequestException ex)
        {
            // Offline: tree vazia + retry em vez da blazor-error-ui.
            _loadFailed = true;
            await Console.Error.WriteLineAsync($"[IdeExplorer] refresh falhou: {ex.Message}");
        }
    }

    private static IdeTreeEntry ToEntry(WorkspaceFileEntryResponse e) => new()
    {
        Name = e.Name, Path = e.Path, Type = e.Type, Collapsed = e.Collapsed,
    };

    /// <summary>Expande/colapsa um dir; lazy-load na primeira expansão.</summary>
    internal async Task ToggleAsync(IdeTreeEntry node)
    {
        node.Expanded = !node.Expanded;
        if (node.Expanded && node.Children is null && !node.Loading)
        {
            node.Loading = true;
            try
            {
                var tree = await Api.GetWorkspaceTreeAsync(path: node.Path, depth: 1, chatId: ChatId);
                node.Children = tree?.Entries.Select(ToEntry).ToList() ?? [];
            }
            catch (HttpRequestException ex)
            {
                // Offline: nó fica sem filhos; nova expansão retenta.
                await Console.Error.WriteLineAsync($"[IdeExplorer] expand falhou: {ex.Message}");
            }
            node.Loading = false;
        }
    }

    /// <summary>Ações do menu: prompt simples via DialogService, chama a file API.</summary>
    private async Task PromptAsync(FileAction action, IdeTreeEntry? node)
    {
        var name = node?.Path ?? "";
        switch (action)
        {
            case FileAction.NewFile:
            case FileAction.NewFolder:
                {
                    var title = action == FileAction.NewFile
                        ? L["ide.new_file"] : L["ide.new_folder"];
                    var path = await Dialog.PromptAsync(
                        $"{title} — {L["ide.path_hint"]}",
                        name is "" ? "" : name + "/");
                    if (string.IsNullOrWhiteSpace(path))
                    {
                        return;
                    }
                    if (action == FileAction.NewFolder)
                    {
                        await Api.WorkspaceMkdirAsync(path, ChatId);
                    }
                    else
                    {
                        await Api.PutWorkspaceFileAsync(path, "");
                    }
                    break;
                }
            case FileAction.Rename:
                {
                    var to = await Dialog.PromptAsync(
                        $"{L["ide.rename"]} — {L["ide.path_hint"]}", name);
                    if (string.IsNullOrWhiteSpace(to) || to == name)
                    {
                        return;
                    }
                    await Api.WorkspaceRenameAsync(name, to, ChatId);
                    break;
                }
            case FileAction.Delete:
                {
                    var ok = await Dialog.ConfirmAsync(
                        L.T("ide.confirm_delete", ("path", name)));
                    if (!ok)
                    {
                        return;
                    }
                    await Api.WorkspaceDeleteAsync(name, ChatId);
                    break;
                }
        }
        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }
}
