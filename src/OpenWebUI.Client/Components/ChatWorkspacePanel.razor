                    }
                    @if (RunId is not null)
                    {
                        <div class="flex justify-between gap-2">
                            <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_info_run"]</dt>
                            <dd class="truncate font-mono text-[0.6875rem] text-gray-500 dark:text-gray-400" title="@RunId">@RunId[..Math.Min(12, RunId.Length)]</dd>
                        </div>
                    }
                    <div class="flex justify-between gap-2">
                        <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_tab_tasks"]</dt>
                        <dd class="text-gray-700 dark:text-gray-300">@Tasks.Count</dd>
                    </div>
                    <div class="flex justify-between gap-2">
                        <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_tab_changes"]</dt>
                        <dd class="text-gray-700 dark:text-gray-300">@Changes.Count</dd>
                    </div>
                    <div class="flex justify-between gap-2">
                        <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_tab_jobs"]</dt>
                        <dd class="text-gray-700 dark:text-gray-300">@Jobs.Count(j => j.Status == "running")/@Jobs.Count</dd>
                    </div>
                </dl>

                @* Uso de LLM do chat: tokens/custo por run + por modelo. *@
                <div class="mt-2 border-t border-gray-100 dark:border-gray-800 px-1 pt-2">
                    <div class="mb-1 text-[0.625rem] font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">@L["chat.panel_usage_title"]</div>
                    @if (_usageLoading)
                    {
                        <div class="py-4 text-center text-[0.6875rem] text-gray-400 dark:text-gray-500">@L["chat.panel_usage_loading"]</div>
                    }
                    else if (_usage is not { } usage || usage.Totals.Runs == 0)
                    {
                        <div class="py-4 text-center text-[0.6875rem] text-gray-400 dark:text-gray-500">@L["chat.panel_usage_empty"]</div>
                    }
                    else
                    {
                        <dl class="flex flex-col gap-1 text-xs">
                            <div class="flex justify-between gap-2">
                                <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_usage_runs"]</dt>
                                <dd class="text-gray-700 dark:text-gray-300">@usage.Totals.Runs</dd>
                            </div>
                            <div class="flex justify-between gap-2">
                                <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_usage_input"]</dt>
                                <dd class="font-mono text-[0.6875rem] text-gray-700 dark:text-gray-300">@FormatCount(usage.Totals.PromptTokens)</dd>
                            </div>
                            <div class="flex justify-between gap-2">
                                <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_usage_output"]</dt>
                                <dd class="font-mono text-[0.6875rem] text-gray-700 dark:text-gray-300">@FormatCount(usage.Totals.CompletionTokens)</dd>
                            </div>
                            @if (usage.Totals.ReasoningTokens > 0)
                            {
                                <div class="flex justify-between gap-2">
                                    <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_usage_reasoning"]</dt>
                                    <dd class="font-mono text-[0.6875rem] text-gray-700 dark:text-gray-300">@FormatCount(usage.Totals.ReasoningTokens)</dd>
                                </div>
                            }
                            <div class="flex justify-between gap-2">
                                <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_usage_cost"]</dt>
                                <dd class="font-mono text-[0.6875rem] text-gray-700 dark:text-gray-300">$@usage.Totals.CostUsd.ToString("0.####")</dd>
                            </div>
                            <div class="flex justify-between gap-2">
                                <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_usage_avg_tokens"]</dt>
                                <dd class="font-mono text-[0.6875rem] text-gray-700 dark:text-gray-300">@FormatCount((usage.Totals.PromptTokens + usage.Totals.CompletionTokens + usage.Totals.ReasoningTokens) / usage.Totals.Runs)</dd>
                            </div>
                            <div class="flex justify-between gap-2">
                                <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_usage_avg_cost"]</dt>
                                <dd class="font-mono text-[0.6875rem] text-gray-700 dark:text-gray-300">$@((usage.Totals.CostUsd / usage.Totals.Runs).ToString("0.####"))</dd>
                            </div>
                            <div class="flex justify-between gap-2">
                                <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_usage_steps"]</dt>
                                <dd class="font-mono text-[0.6875rem] text-gray-700 dark:text-gray-300">@usage.Runs.Sum(r => r.Steps) (@L["chat.panel_usage_avg_abbr"] @((usage.Runs.Sum(r => r.Steps) / (double)usage.Totals.Runs).ToString("0.#")))</dd>
                            </div>
                            @if (usage.Runs.Count(r => r.ParentRunId is not null) is { } subRuns && subRuns > 0)
                            {
                                <div class="flex justify-between gap-2">
                                    <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_usage_subagents"]</dt>
                                    <dd class="font-mono text-[0.6875rem] text-gray-700 dark:text-gray-300">@(usage.Totals.Runs - subRuns)/@subRuns</dd>
                                </div>
                            }
                            <div class="flex justify-between gap-2">
                                <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_usage_last"]</dt>
                                <dd class="font-mono text-[0.6875rem] text-gray-700 dark:text-gray-300">@FormatDate(usage.Runs.Max(r => r.CreatedAt))</dd>
                            </div>
                        </dl>

                        @* Série por run (tokens/run por modelo). *@
                        <div class="mt-2">
                            <LineChart Series="@UsageSeries()" AriaLabel="@L["chat.panel_usage_chart"]" />
                        </div>

                        @* Custo acumulado por run. *@
                        @if (usage.Runs.Any(r => r.CostUsd is > 0))
                        {
                            <div class="mt-2">
                                <div class="mb-0.5 text-[0.625rem] text-gray-400 dark:text-gray-500">@L["chat.panel_usage_chart_cost"]</div>
                                <LineChart Series="@CostSeries()" AriaLabel="@L["chat.panel_usage_chart_cost"]" />
                            </div>
                        }

                        @* Share por modelo (tokens + %). *@
                        <div class="mt-1.5 flex flex-col gap-1">
                            @foreach (var (model, index) in usage.Models.Select((m, i) => (m, i)))
                            {
                                var pct = usage.Totals.PromptTokens + usage.Totals.CompletionTokens + usage.Totals.ReasoningTokens is { } total && total > 0
                                    ? model.Tokens * 100.0 / total : 0d;
                                <div>
                                    <div class="flex items-center justify-between gap-2 text-[0.625rem]">
                                        <span class="min-w-0 flex-1 truncate font-mono text-gray-600 dark:text-gray-400" title="@model.ModelId">
                                            <span class="mr-1 inline-block size-1.5 rounded-full" style="background:@ModelColor(index)"></span>@model.ModelId
                                        </span>
                                        <span class="flex-none font-mono text-gray-500 dark:text-gray-400">@FormatCount(model.Tokens) · $@model.CostUsd.ToString("0.###") · @pct.ToString("0.#")%</span>
                                    </div>
                                    <div class="mt-0.5 h-1 overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800">
                                        <div class="h-full rounded-full" style="width:@pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%;background:@ModelColor(index)"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                @* Uso do usuário no mês + barra do cap efetivo. *@
                @if (_myUsage is { } myUsage)
                {
                    <div class="mt-2 border-t border-gray-100 dark:border-gray-800 px-1 pt-2">
                        <div class="mb-1 text-[0.625rem] font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">@L["chat.panel_month_title"] · @myUsage.Month</div>
                        <dl class="flex flex-col gap-1 text-xs">
                            <div class="flex justify-between gap-2">
                                <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_usage_runs"]</dt>
                                <dd class="text-gray-700 dark:text-gray-300">@myUsage.Runs</dd>
                            </div>
                            <div class="flex justify-between gap-2">
                                <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_usage_input"] + @L["chat.panel_usage_output"]</dt>
                                <dd class="font-mono text-[0.6875rem] text-gray-700 dark:text-gray-300">@FormatCount(myUsage.PromptTokens) / @FormatCount(myUsage.CompletionTokens)</dd>
                            </div>
                            <div class="flex justify-between gap-2">
                                <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_usage_cost"]</dt>
                                <dd class="font-mono text-[0.6875rem] text-gray-700 dark:text-gray-300">$@myUsage.CostUsd.ToString("0.##")</dd>
                            </div>
                        </dl>
                        @if (myUsage.Cap is { } cap)
                        {
                            <div class="mt-1.5">
                                <div class="flex items-center justify-between text-[0.625rem]">
                                    <span class="text-gray-400 dark:text-gray-500">@L["chat.panel_month_cap"]</span>
                                    <span class="font-mono text-gray-500 dark:text-gray-400">$@myUsage.CostUsd.ToString("0.##") / $@cap.UsdPerMonth.ToString("0.##") · @cap.UsedPct.ToString("0.#")%</span>
                                </div>
                                <div class="mt-0.5 h-1 overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800">
                                    <div class="h-full rounded-full @UsageBarCss(cap.UsedPct)" style="width:@Math.Min(cap.UsedPct, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                break;
        }
    </div>
</div>

@code {
    private ElementReference _tabList;

    private async Task OnTabKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "ArrowLeft" or "ArrowRight" or "ArrowUp" or "ArrowDown" or "Home" or "End")
        {
            await JS.InvokeVoidAsync("openwebui.rovingFocus", _tabList, e.Key);
        }
    }

    /// <summary>Snapshot de tarefas da run (evento <c>tasks</c>).</summary>
    [Parameter] public IReadOnlyList<RunTaskItem> Tasks { get; set; } = [];

    /// <summary>Arquivos alterados pela run (evento <c>changes</c>).</summary>
    [Parameter] public IReadOnlyList<RunChangeItem> Changes { get; set; } = [];

    /// <summary>Jobs de background do usuário (GET /api/v1/jobs).</summary>
    [Parameter] public IReadOnlyList<ChatJobResponse> Jobs { get; set; } = [];

    /// <summary>Servidores MCP configurados (admin).</summary>
    [Parameter] public IReadOnlyList<McpServerResponse> Mcps { get; set; } = [];

    /// <summary>Rótulo da fase atual da run (chip de estado).</summary>
    [Parameter] public string? PhaseLabel { get; set; }

    /// <summary>Preset de aprovação do chat.</summary>
    [Parameter] public string Preset { get; set; } = "approve-mutations";

    /// <summary>Modelo da run ativa.</summary>
    [Parameter] public string? Model { get; set; }

    /// <summary>Id da run ativa.</summary>
    [Parameter] public string? RunId { get; set; }

    /// <summary>Snapshot git do workspace (aba Changes em modo repo — RF-018).</summary>
    [Parameter] public WorkspaceGitResponse? Git { get; set; }

    /// <summary>Checkpoints do workdir emitidos pela run (S6 — aba Changes).</summary>
    [Parameter] public IReadOnlyList<WorkspaceCheckpointItem> Checkpoints { get; set; } = [];

    /// <summary>Disparado após um revert bem-sucedido (pai recarrega o git).</summary>
    [Parameter] public EventCallback OnReverted { get; set; }

    /// <summary>Aba a abrir quando o valor muda (chip git do header → "changes").</summary>
    [Parameter] public string? RequestedTab { get; set; }

    /// <summary>Mostra a aba MCPs (endpoints são admin-only).</summary>
    [Parameter] public bool IsAdmin { get; set; }

    /// <summary>Fecha o painel.</summary>
    /// <summary>Chat cujo binding resolve o workspace (SPEC-20261010-workspace-chatid-scope); null = global.</summary>
    [Parameter] public string? ChatId { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Pede o kill de um job (id).</summary>
    [Parameter] public EventCallback<string> OnKillJob { get; set; }

    private string _tab = "tasks";
    private bool _scrollTabPending;
    private string? _expandedChange;
    private string? _consumedTab;
    private bool _mergingWorktree;
    private MergeWorktreeResponse? _mergeResult;
    private string? _mergeError;

    /// <summary>
    /// Merge do worktree da run no workdir compartilhado (E16 S9 RF-002):
    /// confirma → POST merge-worktree → conflitos listados ficam na tela;
    /// merge limpo remove o worktree e o pai recarrega o git.
    /// </summary>
    private async Task MergeWorktreeAsync()
    {
        if (RunId is null || _mergingWorktree
            || !await Dialogs.ConfirmAsync(L["chat.worktree_merge_confirm"]))
        {
            return;
        }

        _mergingWorktree = true;
        _mergeResult = null;
        _mergeError = null;
        try
        {
            var result = await Api.MergeWorktreeAsync(RunId);
            if (result is null)
            {
                _mergeError = L["chat.worktree_merge_failed"];
            }
            else if (result.Error is not null)
            {
                _mergeError = result.Error;
            }
            else
            {
                _mergeResult = result;
                if (result.Merged)
                {
                    // Worktree removido — o pai recarrega o snapshot do workdir.
                    await OnReverted.InvokeAsync();
                }
            }
        }
        finally
        {
            _mergingWorktree = false;
        }
    }
    private Dictionary<string, string>? _gitDiffByFile;
    private string? _gitDiffSource;

    /// <summary>Consome <see cref="RequestedTab"/> uma vez por valor — clique manual não é revertido.</summary>
    protected override void OnParametersSet()
    {
        if (RequestedTab is { } requested && requested != _consumedTab
            && Tabs.Contains(requested))
        {
            _consumedTab = requested;
            _tab = requested;
            _scrollTabPending = true;
        }
    }

    /// <summary>Rola a aba ativa para a vista quando uma troca ficou pendente
    /// de render (RequestedTab consumido antes do primeiro paint).</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollTabPending)
        {
            _scrollTabPending = false;
            await ScrollTabIntoViewAsync(_tab);
        }
    }

    /// <summary>Seção do unified diff que cobre <paramref name="path"/> (split por <c>diff --git</c>).</summary>
    private string? GitFileDiff(string path)
    {
        if (Git?.Diff is null)
        {
            return null;
        }
        if (!string.Equals(_gitDiffSource, Git.Diff, StringComparison.Ordinal))
        {
            _gitDiffSource = Git.Diff;
            _gitDiffByFile = GitDiffRender.SplitDiff(Git.Diff);
        }
        return _gitDiffByFile!.GetValueOrDefault(path);
    }

    private IEnumerable<string> Tabs => IsAdmin
        ? ["tasks", "changes", "pulls", "tests", "jobs", "terminal", "mcps", "skills", "memories", "info"]
        : ["tasks", "changes", "pulls", "tests", "jobs", "terminal", "skills", "memories", "info"];

    /// <summary>Troca de aba — dispara a carga lazy dos dados dela.</summary>
    private void SelectTab(string tab)
    {
        _tab = tab;
        _ = EnsureTabDataAsync(tab);
        _ = ScrollTabIntoViewAsync(tab);
    }

    /// <summary>Índice/quantidade da aba ativa — alimenta as setas &lt; &gt;.</summary>
    private int TabIndex => Tabs.ToList().IndexOf(_tab);

    private int TabCount => Tabs.Count();

    /// <summary>Seta &lt; &gt;: ativa a aba vizinha e a rola para a área visível.</summary>
    private void SelectTabByIndex(int index)
    {
        var tabs = Tabs.ToList();
        if (index < 0 || index >= tabs.Count)
        {
            return;
        }
        SelectTab(tabs[index]);
    }

    /// <summary>Rola a tablist até a aba ativa — painel estreito esconde as pontas.</summary>
    private async Task ScrollTabIntoViewAsync(string tab)
    {
        var index = Tabs.ToList().IndexOf(tab);
        if (index < 0)
        {
            return;
        }
        try
        {
            await JS.InvokeVoidAsync("openwebui.scrollTabIntoView", _tabList, index);
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            // JS interop indisponível no shutdown/attach — scroll é best-effort.
        }
    }

    /// <summary>Carga lazy por aba: usage (info), skills do repo e memórias.</summary>
    private async Task EnsureTabDataAsync(string tab)
    {
        try
        {
            switch (tab)
            {
                case "info":
                    if (ChatId is not null && !_usageLoaded)
                    {
                        _usageLoaded = true;
                        _usageLoading = true;
                        _usage = await Api.GetChatUsageAsync(ChatId);
                        _myUsage = await Api.GetMyUsageAsync();
                        _usageLoading = false;
                    }
                    break;
                case "skills":
                    if (_skills is null)
                    {
                        _skills = await Api.GetRepoSkillsAsync(ChatId);
                    }
                    break;
                case "memories":
                    if (_memFiles is null)
                    {
                        await LoadMemoriesAsync();
                    }
                    break;
            }
        }
        catch
        {
            _usageLoading = false;
            _skills ??= [];
            _memFiles ??= [];
        }
        await InvokeAsync(StateHasChanged);
    }

    private ChatUsageResponse? _usage;
    private MyUsageResponse? _myUsage;
    private bool _usageLoaded;
    private bool _usageLoading;
    private List<RepoSkillItemResponse>? _skills;

    private List<WorkspaceFileEntryResponse>? _memFiles;
    private string? _memViewPath;
    private WorkspaceFileReadResponse? _memView;
    private string _memDir = ".agents/memory";
    private string _memNewName = "";
    private string _memNewContent = "";
    private bool _memSaving;
    private string? _memNotice;
    private string? _memError;

    /// <summary>Diretórios de memória reconhecidos no workdir.</summary>
    private static readonly string[] MemoryDirs = [".claude/memory", ".agents/memory"];

    /// <summary>Lista os .md de .claude/memory e .agents/memory do workdir.</summary>
    private async Task LoadMemoriesAsync()
    {
        var files = new List<WorkspaceFileEntryResponse>();
        foreach (var dir in MemoryDirs)
        {
            var tree = await Api.GetWorkspaceTreeAsync(dir, depth: 1, chatId: ChatId);
            if (tree?.Entries is { } entries)
            {
                files.AddRange(entries.Where(e => e.Type == "file"));
            }
        }
        _memFiles = files.OrderBy(f => f.Path).ToList();
    }

    /// <summary>Expande/recolhe o conteúdo de uma memória (lazy read).</summary>
    private async Task ToggleMemoryAsync(string path)
    {
        if (_memViewPath == path)
        {
            _memViewPath = null;
            _memView = null;
            return;
        }
        _memViewPath = path;
        _memView = await Api.GetWorkspaceFileAsync(path, maxLines: 200, chatId: ChatId);
    }

    /// <summary>Salva uma memória .md nova no diretório escolhido.</summary>
    private async Task SaveMemoryAsync()
    {
        _memError = null;
        _memNotice = null;
        var name = _memNewName.Trim();
        if (name.Length == 0 || _memSaving)
        {
            return;
        }
        if (name.Contains('/') || name.Contains('\\'))
        {
            _memError = L["chat.panel_mem_name_invalid"];
            return;
        }
        if (!name.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
        {
            name += ".md";
        }

        _memSaving = true;
        try
        {
            await Api.WorkspaceMkdirAsync(_memDir, ChatId);
            var result = await Api.PutWorkspaceFileAsync(
                $"{_memDir}/{name}", _memNewContent, chatId: ChatId);
            if (result.Ok)
            {
                _memNewName = "";
                _memNewContent = "";
                _memNotice = L["chat.panel_mem_saved"];
                await LoadMemoriesAsync();
            }
            else
            {
                _memError = L["chat.panel_mem_save_failed"];
            }
        }
        finally
        {
            _memSaving = false;
        }
    }

    /// <summary>Séries do line chart: tokens (in+out+reasoning) por run de cada modelo.</summary>
    private IReadOnlyList<LineChart.ChartSeries> UsageSeries()
    {
        if (_usage is null)
        {
            return [];
        }
        return _usage.Models.Select(m => new LineChart.ChartSeries(
            m.ModelId,
            _usage.Runs.Where(r => (r.ModelId ?? "unknown") == m.ModelId)
                .Select(r => (double)(r.PromptTokens + r.CompletionTokens + r.ReasoningTokens))
                .ToList())).ToList();
    }

    /// <summary>Série única: custo USD acumulado por run (ordem cronológica).</summary>
    private IReadOnlyList<LineChart.ChartSeries> CostSeries()
    {
        if (_usage is null)
        {
            return [];
        }
        var acc = 0d;
        var values = _usage.Runs
            .Select(r => acc += r.CostUsd ?? 0)
            .ToList();
        return [new LineChart.ChartSeries("cost", values)];
    }

    /// <summary>Formata epoch seconds como data/hora local curta.</summary>
    private static string FormatDate(long epochSec) =>
        DateTimeOffset.FromUnixTimeSeconds(epochSec)
            .ToLocalTime().ToString("dd/MM HH:mm");

    /// <summary>Mesma paleta do LineChart — mantém cor por índice de modelo.</summary>
    private static string ModelColor(int index)
    {
        string[] palette = ["#3b82f6", "#a855f7", "#10b981", "#f59e0b", "#ef4444", "#06b6d4"];
        return palette[index % palette.Length];
    }

    /// <summary>Compacta contagens grandes (123k / 1.2M) para o painel.</summary>
    private static string FormatCount(long value) => value switch
    {
        >= 1_000_000 => (value / 1_000_000d).ToString("0.#") + "M",
        >= 1_000 => (value / 1_000d).ToString("0.#") + "k",
        _ => value.ToString(),
    };

    /// <summary>Salta à aba Tests quando um run é iniciado (botão Run tests).</summary>
    protected override void OnInitialized() => TestRun.Changed += OnTestRunChanged;

    /// <inheritdoc/>
    public void Dispose() => TestRun.Changed -= OnTestRunChanged;

    private void OnTestRunChanged()
    {
        if (TestRun.AttentionWanted)
        {
            _tab = "tests";
            TestRun.AttentionWanted = false;
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private string McpStatusLabel(McpServerResponse server) =>
        server switch
        {
            { Enabled: false } => L["chat.panel_mcp_disabled"],
            { LastError: not null } => L["chat.panel_mcp_error"],
            _ => L["chat.panel_mcp_ok"],
        };

    private static string McpDotCss(McpServerResponse server) =>
        server switch
        {
            { Enabled: true, LastError: null } => "bg-green-500",
            { Enabled: true } => "bg-amber-500",
            _ => "bg-gray-300 dark:bg-gray-600",
        };

    private static string UsageBarCss(double pct) =>
        pct switch
        {
            >= 90 => "bg-red-500",
            >= 70 => "bg-amber-500",
            _ => "bg-emerald-500",
        };

    private static string JobDotCss(string status) => status switch
    {
        "running" => "bg-blue-500 animate-pulse",
        "completed" => "bg-green-500",
        "killed" or "failed" => "bg-red-500",
        _ => "bg-gray-300 dark:bg-gray-600",
    };

    private static string FormatTime(long unixMs) =>
        DateTimeOffset.FromUnixTimeMilliseconds(unixMs).ToLocalTime().ToString("HH:mm:ss");
}
