@inject LocalizationService L
@inject IJSRuntime JS
@inject IdeTestRunService TestRun
@inject ApiService Api
@inject DialogService Dialogs
@implements IDisposable

@* Painel de workspace da run (SPEC-20261007-chat-agent-parity RF-015):
   tabs Tasks | Changes | Jobs | MCPs | Info — o "canvas" do agente ao
   lado do chat, no padrão Devin/OpenHands/opencode. Renderizado como
   coluna ≥lg e como drawer no mobile pelo ChatView. *@

<div class="flex h-full w-full flex-col bg-white dark:bg-gray-900 border-l border-gray-100 dark:border-gray-800">
    <div class="flex items-center justify-between px-3 py-2 border-b border-gray-100 dark:border-gray-800">
        <div class="text-xs font-semibold text-gray-700 dark:text-gray-300">@L["chat.panel_title"]</div>
        <button class="flex size-6 cursor-pointer items-center justify-center rounded-lg text-gray-400 transition hover:bg-gray-100 hover:text-gray-600 dark:hover:bg-gray-800 dark:hover:text-gray-300"
                title="@L["chat.panel_close"]" aria-label="@L["chat.panel_close"]" @onclick="OnClose">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
        </button>
    </div>

    @* Setas < > navegam as tabs quando a largura do painel não as comporta
       (sidebar estreita): a seta ativa a tab vizinha e a rola para a vista. *@
    <div class="flex items-center gap-0.5 px-1 py-1.5 border-b border-gray-100 dark:border-gray-800">
        <button class="flex size-5 flex-none cursor-pointer items-center justify-center rounded-md text-gray-400 transition
                       hover:bg-gray-100 hover:text-gray-600 disabled:cursor-default disabled:opacity-30 disabled:hover:bg-transparent
                       dark:hover:bg-gray-800 dark:hover:text-gray-300 dark:disabled:hover:bg-transparent"
                title="@L["chat.panel_tabs_prev"]" aria-label="@L["chat.panel_tabs_prev"]"
                disabled="@(TabIndex <= 0)"
                @onclick="() => SelectTabByIndex(TabIndex - 1)">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5"><path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" /></svg>
        </button>
        <div class="flex flex-1 gap-1 overflow-x-auto"
             role="tablist" @ref="_tabList" @onkeydown="OnTabKeyDown">
            @foreach (var tab in Tabs)
            {
                var active = _tab == tab;
                <button class="rounded-lg px-2.5 py-1 text-[0.6875rem] font-medium transition cursor-pointer flex-none
                               @(active ? "bg-gray-900 text-white dark:bg-white dark:text-gray-900"
                                        : "text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800")"
                        role="tab" aria-selected="@active"
                        @onclick="() => SelectTab(tab)">
                    @L["chat.panel_tab_" + tab]
                </button>
            }
        </div>
        <button class="flex size-5 flex-none cursor-pointer items-center justify-center rounded-md text-gray-400 transition
                       hover:bg-gray-100 hover:text-gray-600 disabled:cursor-default disabled:opacity-30 disabled:hover:bg-transparent
                       dark:hover:bg-gray-800 dark:hover:text-gray-300 dark:disabled:hover:bg-transparent"
                title="@L["chat.panel_tabs_next"]" aria-label="@L["chat.panel_tabs_next"]"
                disabled="@(TabIndex < 0 || TabIndex >= TabCount - 1)"
                @onclick="() => SelectTabByIndex(TabIndex + 1)">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5"><path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
        </button>
    </div>

    <div class="flex-1 overflow-y-auto p-2" role="tabpanel">
        @switch (_tab)
        {
            case "tasks":
                @if (Tasks.Count == 0)
                {
                    <div class="px-2 py-6 text-center text-[0.6875rem] text-gray-400 dark:text-gray-500">@L["chat.panel_no_tasks"]</div>
                }
                else
                {
                    <ul class="flex flex-col gap-1">
                        @foreach (var task in Tasks)
                        {
                            <li class="flex items-start gap-1.5 rounded-lg px-2 py-1.5 text-xs">
                                @if (task.Status == "completed")
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 size-3.5 flex-none text-green-600 dark:text-green-400">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
                                    </svg>
                                    <span class="text-gray-400 dark:text-gray-500 line-through decoration-gray-300 dark:decoration-gray-600">@task.Content</span>
                                }
                                else if (task.Status == "in_progress")
                                {
                                    <svg class="mt-0.5 size-3 flex-none animate-spin text-blue-600 dark:text-blue-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z" />
                                    </svg>
                                    <span class="text-gray-800 dark:text-gray-200 font-medium">@task.Content</span>
                                }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mt-0.5 size-3.5 flex-none text-gray-300 dark:text-gray-600">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                    </svg>
                                    <span class="text-gray-600 dark:text-gray-400">@task.Content</span>
                                }
                            </li>
                        }
                    </ul>
                }
                break;

            case "changes":
                @* Checkpoints da run (S6): Revert por snapshot. *@
                <CheckpointList Checkpoints="Checkpoints" ChatId="@ChatId" OnReverted="OnReverted" />
                @if (Git is { Git: true } git)
                {
                    @* Workspace é repo git: branch + numstat + diff real (RF-018). *@
                    <div class="mb-1.5 flex items-center gap-1.5 rounded-lg border border-gray-100 dark:border-gray-800 px-2 py-1.5">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5 flex-none text-gray-400">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 3v12" />
                            <circle cx="18" cy="6" r="3" />
                            <circle cx="6" cy="18" r="3" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9a9 9 0 0 1-9 9" />
                        </svg>
                        <span class="min-w-0 flex-1 truncate font-mono text-[0.6875rem] font-medium text-gray-700 dark:text-gray-300" title="@git.Branch">@git.Branch</span>
                        @if (git.BaseRef is { } baseRef)
                        {
                            <span class="flex-none truncate font-mono text-[0.5625rem] text-gray-400 dark:text-gray-500"
                                  title="@L.T("chat.panel_diff_base_hint", ("base", baseRef))">←@baseRef</span>
                        }
                        @if (git.Worktree)
                        {
                            @* Run isolada (E16 S9): snapshot lido do worktree. *@
                            <span class="flex-none rounded bg-violet-100 dark:bg-violet-900/40 px-1 text-[0.5625rem] font-medium text-violet-700 dark:text-violet-300"
                                  title="@L["chat.worktree_chip_hint"]">@L["chat.worktree_chip"]</span>
                        }
                        <span class="flex-none font-mono text-[0.625rem] text-green-600 dark:text-green-400">+@git.Added</span>
                        <span class="flex-none font-mono text-[0.625rem] text-red-500 dark:text-red-400">−@git.Removed</span>
                    </div>
                    @if (git.Worktree && RunId is not null)
                    {
                        @* Merge worktree → workdir (RF-002): confirma, aplica;
                           conflitos voltam listados, nunca forçados. *@
                        <div class="mb-1.5 rounded-lg border border-violet-100 dark:border-violet-900/40 bg-violet-50/50 dark:bg-violet-950/20 px-2 py-1.5">
                            <button class="cursor-pointer rounded-lg bg-violet-600 px-2 py-1 text-[0.625rem] font-medium text-white transition hover:bg-violet-500 disabled:opacity-50"
                                    disabled="@_mergingWorktree"
                                    @onclick="MergeWorktreeAsync">
                                @L["chat.worktree_merge"]
                            </button>
                            @if (_mergeResult is { } mergeResult)
                            {
                                @if (mergeResult.Conflicts.Count > 0)
                                {
                                    <div class="mt-1.5 text-[0.625rem] text-amber-700 dark:text-amber-400">
                                        @L.T("chat.worktree_merge_conflicts", ("count", mergeResult.Conflicts.Count.ToString()))
                                        <ul class="mt-1 flex flex-col gap-0.5 font-mono">
                                            @foreach (var conflict in mergeResult.Conflicts)
                                            {
                                                <li class="truncate" title="@conflict">· @conflict</li>
                                            }
                                        </ul>
                                    </div>
                                }
                                else if (mergeResult.Merged)
                                {
                                    <div class="mt-1.5 text-[0.625rem] text-green-700 dark:text-green-400">
                                        @L.T("chat.worktree_merge_done", ("count", mergeResult.Applied.Count.ToString()))
                                    </div>
                                }
                            }
                            @if (_mergeError is { } mergeError)
                            {
                                <div class="mt-1.5 text-[0.625rem] text-red-600 dark:text-red-400">@mergeError</div>
                            }
                        </div>
                    }
                    @if (git.Files.Count == 0)
                    {
                        <div class="px-2 py-6 text-center text-[0.6875rem] text-gray-400 dark:text-gray-500">@L["chat.panel_no_changes"]</div>
                    }
                    else
                    {
                        <ul class="flex flex-col gap-1">
                            @foreach (var file in git.Files)
                            {
                                var expanded = _expandedChange == file.Path;
                                <li class="rounded-lg border border-gray-100 dark:border-gray-800">
                                    <button class="flex w-full items-center gap-2 px-2 py-1.5 text-left cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-850 rounded-lg"
                                            aria-expanded="@expanded"
                                            @onclick="() => _expandedChange = expanded ? null : file.Path">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                                             class="size-3 flex-none text-gray-400 transition @(expanded ? "rotate-90" : "")">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                                        </svg>
                                        <span class="min-w-0 flex-1 truncate font-mono text-[0.6875rem] text-gray-700 dark:text-gray-300" title="@file.Path">@file.Path</span>
                                        @switch (file.Status)
                                        {
                                            case "A":
                                                <span class="flex-none rounded bg-green-100 dark:bg-green-900/40 px-1 text-[0.5625rem] font-medium text-green-700 dark:text-green-400">new</span>
                                                break;
                                            case "D":
                                                <span class="flex-none rounded bg-red-100 dark:bg-red-900/40 px-1 text-[0.5625rem] font-medium text-red-700 dark:text-red-400">del</span>
                                                break;
                                            case "R":
                                                <span class="flex-none rounded bg-violet-100 dark:bg-violet-900/40 px-1 text-[0.5625rem] font-medium text-violet-700 dark:text-violet-300"
                                                      title="@(file.OldPath is null ? file.Path : $"{file.OldPath} → {file.Path}")">ren</span>
                                                break;
                                            case "M":
                                                <span class="flex-none rounded bg-blue-100 dark:bg-blue-900/40 px-1 text-[0.5625rem] font-medium text-blue-700 dark:text-blue-400">mod</span>
                                                break;
                                        }
                                        <span class="flex-none font-mono text-[0.625rem] text-green-600 dark:text-green-400">+@file.Added</span>
                                        <span class="flex-none font-mono text-[0.625rem] text-red-500 dark:text-red-400">−@file.Removed</span>
                                    </button>
                                    @if (expanded)
                                    {
                                        @if (GitFileDiff(file.Path) is { Length: > 0 } fileDiff)
                                        {
                                            <pre class="max-h-64 overflow-auto whitespace-pre-wrap break-all border-t border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-950 px-2 py-1.5 text-[0.625rem] font-mono leading-4">@foreach (var line in GitDiffRender.Lines(fileDiff)){<span class="@line.Css">@line.Text
</span>}</pre>
                                        }
                                        else
                                        {
                                            <div class="border-t border-gray-100 dark:border-gray-800 px-2 py-1.5 text-[0.625rem] text-gray-400">@L["chat.panel_no_diff"]</div>
                                        }
                                    }
                                </li>
                            }
                        </ul>
                        @if (git.DiffTruncated)
                        {
                            <div class="mt-1 px-2 text-[0.625rem] text-gray-400 dark:text-gray-500">@L["chat.panel_diff_truncated"]</div>
                        }
                    }
                }
                else if (Changes.Count == 0)
                {
                    <div class="px-2 py-6 text-center text-[0.6875rem] text-gray-400 dark:text-gray-500">@L["chat.panel_no_changes"]</div>
                }
                else
                {
                    <ul class="flex flex-col gap-1">
                        @foreach (var change in Changes)
                        {
                            var expanded = _expandedChange == change.Path;
                            <li class="rounded-lg border border-gray-100 dark:border-gray-800">
                                <button class="flex w-full items-center gap-2 px-2 py-1.5 text-left cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-850 rounded-lg"
                                        aria-expanded="@expanded"
                                        @onclick="() => _expandedChange = expanded ? null : change.Path">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                                         class="size-3 flex-none text-gray-400 transition @(expanded ? "rotate-90" : "")">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                                    </svg>
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5 flex-none text-gray-400 dark:text-gray-500">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                                    </svg>
                                    <span class="min-w-0 flex-1 truncate font-mono text-[0.6875rem] text-gray-700 dark:text-gray-300" title="@change.Path">@change.Path</span>
                                    <span class="flex-none font-mono text-[0.625rem] text-green-600 dark:text-green-400">+@change.Added</span>
                                    <span class="flex-none font-mono text-[0.625rem] text-red-500 dark:text-red-400">−@change.Removed</span>
                                </button>
                                @if (expanded)
                                {
                                    @if (change.Diff is { Length: > 0 })
                                    {
                                        <pre class="max-h-64 overflow-auto whitespace-pre-wrap break-all border-t border-gray-100 dark:border-gray-800 bg-white dark:bg-gray-950 px-2 py-1.5 text-[0.625rem] font-mono leading-4">@foreach (var line in GitDiffRender.Lines(change.Diff)){<span class="@line.Css">@line.Text
</span>}</pre>
                                    }
                                    else
                                    {
                                        <div class="border-t border-gray-100 dark:border-gray-800 px-2 py-1.5 text-[0.625rem] text-gray-400">@L["chat.panel_no_diff"]</div>
                                    }
                                }
                            </li>
                        }
                    </ul>
                }
                break;

            case "jobs":
                @if (Jobs.Count == 0)
                {
                    <div class="px-2 py-6 text-center text-[0.6875rem] text-gray-400 dark:text-gray-500">@L["chat.panel_no_jobs"]</div>
                }
                else
                {
                    <ul class="flex flex-col gap-1">
                        @foreach (var job in Jobs.OrderByDescending(j => j.StartedAt))
                        {
                            <li class="rounded-lg border border-gray-100 dark:border-gray-800 px-2 py-1.5">
                                <div class="flex items-center gap-1.5">
                                    <span class="size-1.5 flex-none rounded-full @JobDotCss(job.Status)" title="@job.Status" aria-hidden="true"></span>
                                    <span class="min-w-0 flex-1 truncate font-mono text-[0.6875rem] text-gray-700 dark:text-gray-300" title="@job.Command">@job.Command</span>
                                    @if (job.Status == "running")
                                    {
                                        <button class="flex-none cursor-pointer rounded p-0.5 text-gray-400 hover:text-red-500"
                                                title="@L["chat.job_kill"]" aria-label="@L["chat.job_kill"]"
                                                @onclick="() => OnKillJob.InvokeAsync(job.Id)">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm-3.536-10.95a.75.75 0 1 0-1.06 1.06L8.94 10l-3.536 3.536a.75.75 0 1 0 1.06 1.06L10 11.061l3.536 3.535a.75.75 0 1 0 1.06-1.06L11.061 10l3.535-3.536a.75.75 0 1 0-1.06-1.06L10 8.94 6.464 5.404Z" clip-rule="evenodd" /></svg>
                                        </button>
                                    }
                                </div>
                                <div class="mt-0.5 flex items-center gap-2 pl-3 text-[0.625rem] text-gray-400 dark:text-gray-500">
                                    <span>@job.Status@(job.ExitCode is { } code ? $" · exit {code}" : "")</span>
                                    <span>@FormatTime(job.StartedAt)</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
                break;

            case "terminal":
                @* Terminal interativo compartilhado com /terminal — abas
                   jobs cobrem processos de background, esta cobre a shell. *@
                <div class="h-full min-h-0">
                    <TerminalView ChatId="@ChatId" />
                </div>
                break;

            case "pulls":
                @* PRs abertos do repo vinculado + rollup de checks (D1). *@
                <WorkspacePullsPanel ChatId="@ChatId" />
                break;

            case "tests":
                @* Runner de testes do repo vinculado (SPEC-20261009-ide-mentions-tests RF-004). *@
                <IdeTestsPanel />
                break;

            case "mcps":
                @if (Mcps.Count == 0)
                {
                    <div class="px-2 py-6 text-center text-[0.6875rem] text-gray-400 dark:text-gray-500">@L["chat.panel_no_mcps"]</div>
                }
                else
                {
                    <ul class="flex flex-col gap-1">
                        @foreach (var server in Mcps)
                        {
                            <li class="flex items-center gap-1.5 rounded-lg border border-gray-100 dark:border-gray-800 px-2 py-1.5">
                                <span class="size-1.5 flex-none rounded-full @McpDotCss(server)"
                                        role="img" aria-label="@McpStatusLabel(server)" title="@McpStatusLabel(server)"></span>
                                <div class="min-w-0 flex-1">
                                    <div class="truncate text-[0.6875rem] font-medium text-gray-700 dark:text-gray-300" title="@server.Name">@server.Name</div>
                                    <div class="truncate text-[0.625rem] text-gray-400 dark:text-gray-500">
                                        @server.Transport
                                        @if (server.LastError is not null)
                                        {
                                            <span title="@server.LastError"> · @L["chat.panel_mcp_error"]</span>
                                        }
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                    <a href="/admin/settings/mcp" class="mt-2 block rounded-lg px-2 py-1.5 text-[0.6875rem] text-blue-600 hover:bg-blue-50 dark:text-blue-400 dark:hover:bg-blue-950/30">
                        @L["chat.panel_mcp_manage"] →
                    </a>
                }
                break;

            case "skills":
                @* Skills descobertas no repo vinculado (**/SKILL.md). *@
                @if (_skills is null)
                {
                    <div class="px-2 py-6 text-center text-[0.6875rem] text-gray-400 dark:text-gray-500">@L["chat.panel_skills_loading"]</div>
                }
                else if (_skills.Count == 0)
                {
                    <div class="px-2 py-6 text-center text-[0.6875rem] text-gray-400 dark:text-gray-500">@L["chat.panel_skills_empty"]</div>
                }
                else
                {
                    <ul class="flex flex-col gap-1">
                        @foreach (var skill in _skills)
                        {
                            <li class="rounded-lg border border-gray-100 dark:border-gray-800 px-2 py-1.5">
                                <div class="flex items-center gap-1.5">
                                    <span class="min-w-0 flex-1 truncate font-mono text-[0.6875rem] font-medium text-gray-700 dark:text-gray-300" title="@skill.Name">/@skill.Name</span>
                                    <span class="flex-none rounded bg-gray-100 dark:bg-gray-800 px-1 text-[0.5625rem] font-medium text-gray-500 dark:text-gray-400">@skill.Scope</span>
                                    @if (!skill.Enabled)
                                    {
                                        <span class="flex-none rounded bg-amber-100 dark:bg-amber-900/40 px-1 text-[0.5625rem] font-medium text-amber-700 dark:text-amber-400"
                                              title="@(skill.DisabledByAdmin ? L["chat.panel_skill_admin_off"] : "")">@L["chat.panel_skill_disabled"]</span>
                                    }
                                </div>
                                @if (skill.Description is { Length: > 0 } desc)
                                {
                                    <div class="mt-0.5 text-[0.625rem] leading-4 text-gray-500 dark:text-gray-400" title="@desc">@desc</div>
                                }
                            </li>
                        }
                    </ul>
                }
                break;

            case "memories":
                @* Memórias do repo: .claude/memory + .agents/memory — lê e grava
                   arquivos .md via workspace file API. *@
                <div class="mb-1.5 rounded-lg border border-blue-100 dark:border-blue-900/40 bg-blue-50/50 dark:bg-blue-950/20 px-2 py-1.5 text-[0.625rem] leading-4 text-blue-800 dark:text-blue-300">
                    @L["chat.panel_mem_suggest"]
                </div>
                @if (_memFiles is null)
                {
                    <div class="px-2 py-6 text-center text-[0.6875rem] text-gray-400 dark:text-gray-500">@L["chat.panel_mem_loading"]</div>
                }
                else if (_memFiles.Count == 0)
                {
                    <div class="px-2 py-6 text-center text-[0.6875rem] text-gray-400 dark:text-gray-500">@L["chat.panel_mem_empty"]</div>
                }
                else
                {
                    <ul class="flex flex-col gap-1">
                        @foreach (var file in _memFiles)
                        {
                            var selected = _memViewPath == file.Path;
                            <li class="rounded-lg border border-gray-100 dark:border-gray-800">
                                <button class="flex w-full items-center gap-1.5 px-2 py-1.5 text-left cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-850 rounded-lg"
                                        aria-expanded="@selected"
                                        @onclick="() => ToggleMemoryAsync(file.Path)">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                                         class="size-3 flex-none text-gray-400 transition @(selected ? "rotate-90" : "")">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                                    </svg>
                                    <span class="min-w-0 flex-1 truncate font-mono text-[0.6875rem] text-gray-700 dark:text-gray-300" title="@file.Path">@file.Path</span>
                                </button>
                                @if (selected && _memView is { } memView)
                                {
                                    <pre class="max-h-48 overflow-auto whitespace-pre-wrap break-all border-t border-gray-100 dark:border-gray-800 px-2 py-1.5 text-[0.625rem] font-mono leading-4 text-gray-600 dark:text-gray-400">@memView.Content</pre>
                                }
                            </li>
                        }
                    </ul>
                }
                @* Nova memória — grava .md em .agents/memory (ou .claude/memory). *@
                <div class="mt-2 rounded-lg border border-gray-100 dark:border-gray-800 px-2 py-1.5">
                    <div class="mb-1 text-[0.625rem] font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">@L["chat.panel_mem_new"]</div>
                    <div class="flex gap-1">
                        @foreach (var dir in MemoryDirs)
                        {
                            <button class="cursor-pointer rounded px-1.5 py-0.5 text-[0.5625rem] font-mono transition
                                           @(_memDir == dir ? "bg-gray-900 text-white dark:bg-white dark:text-gray-900" : "text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800")"
                                    @onclick="() => _memDir = dir">@dir</button>
                        }
                    </div>
                    <input class="mt-1 w-full rounded-lg border border-gray-200 dark:border-gray-700 bg-transparent px-2 py-1 text-[0.6875rem] font-mono text-gray-700 dark:text-gray-300 placeholder:text-gray-400"
                           placeholder="@L["chat.panel_mem_name_ph"]" aria-label="@L["chat.panel_mem_name_ph"]"
                           @bind="_memNewName" />
                    <textarea class="mt-1 w-full rounded-lg border border-gray-200 dark:border-gray-700 bg-transparent px-2 py-1 text-[0.6875rem] text-gray-700 dark:text-gray-300 placeholder:text-gray-400"
                              rows="3" placeholder="@L["chat.panel_mem_content_ph"]" aria-label="@L["chat.panel_mem_content_ph"]"
                              @bind="_memNewContent"></textarea>
                    <div class="mt-1 flex items-center gap-2">
                        <button class="cursor-pointer rounded-lg bg-gray-900 px-2 py-1 text-[0.625rem] font-medium text-white transition hover:bg-gray-700 disabled:opacity-50 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200"
                                disabled="@(_memSaving || string.IsNullOrWhiteSpace(_memNewName) || string.IsNullOrWhiteSpace(_memNewContent))"
                                @onclick="SaveMemoryAsync">
                            @(_memSaving ? L["chat.panel_mem_saving"] : L["chat.panel_mem_save"])
                        </button>
                        @if (_memNotice is { } memNotice)
                        {
                            <span class="text-[0.625rem] text-green-600 dark:text-green-400">@memNotice</span>
                        }
                        @if (_memError is { } memError)
                        {
                            <span class="text-[0.625rem] text-red-600 dark:text-red-400">@memError</span>
                        }
                    </div>
                </div>
                break;

            default:
                <dl class="flex flex-col gap-1.5 px-1 text-xs">
                    <div class="flex justify-between gap-2">
                        <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_info_state"]</dt>
                        <dd class="text-gray-700 dark:text-gray-300">@(PhaseLabel ?? L["chat.panel_info_idle"])</dd>
                    </div>
                    <div class="flex justify-between gap-2">
                        <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_info_preset"]</dt>
                        <dd class="text-gray-700 dark:text-gray-300">@L["chat.preset_" + Preset]</dd>
                    </div>
                    @if (Git?.Worktree == true)
                    {
                        <div class="flex justify-between gap-2">
                            <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_info_isolation"]</dt>
                            <dd class="text-violet-700 dark:text-violet-300">@L["chat.worktree_chip"]</dd>
                        </div>
                    }
                    @if (Model is not null)
                    {
                        <div class="flex justify-between gap-2">
                            <dt class="text-gray-400 dark:text-gray-500">@L["chat.panel_info_model"]</dt>
                            <dd class="truncate text-gray-700 dark:text-gray-300">@Model</dd>
