@inject MarkdownService Markdown
@inject ApiService Api
@inject LocalizationService L
@inject IJSRuntime JS

<div class="group w-full flex gap-3 @(Message.Role == "user" ? "justify-end" : "")">
    @if (Message.Role != "user")
    {
        <div class="shrink-0 mt-0.5 relative">
            <img src="favicon.png"
                 class="size-7 rounded-full border border-gray-100 dark:border-gray-850" alt="" />
            @if (Streaming)
            {
                <span class="absolute inset-0 rounded-full border-2 border-blue-400 dark:border-blue-500 animate-ping" aria-hidden="true"></span>
            }
        </div>
    }

    <div class="flex flex-col min-w-0 @(Message.Role == "user" ? "items-end max-w-[85%]" : "flex-1")">
        <div class="text-[0.8125rem] font-medium text-gray-500 dark:text-gray-400 mb-0.5 @(Message.Role == "user" ? "text-right" : "")">
            @if (Message.Role == "assistant" && Streaming)
            {
                <img src="img/thinking-brain.svg" class="size-4 mr-1 inline-block align-middle" alt="" aria-hidden="true" />
            }
            @(Message.Role == "assistant" ? Message.Model ?? L["chat.assistant"] : L["chat.you"])
        </div>

        @* SPEC-20261013-chat-media-attachments RF-004: anexos da mensagem
           acima do texto — imagem/vídeo inline contido (clique abre o
           lightbox), demais tipos seguem chip de texto. *@
        @if (Message.Files is { Count: > 0 } files)
        {
            <div class="flex flex-wrap gap-1.5 mb-1 @(Message.Role == "user" ? "justify-end" : "")">
                @foreach (var f in files)
                {
                    <AttachmentThumb FileId="@f.Id" Name="@f.Name" Type="@f.Type"
                                     OnOpen="() => OpenPreviewAsync(f)" />
                }
            </div>
        }
        <div @ref="_contentRef" class="@(Message.Role == "user"
                ? "rounded-3xl bg-gray-100 dark:bg-gray-850 px-4 py-2.5 text-gray-800 dark:text-gray-100 text-[0.9375rem] whitespace-pre-wrap"
                : "prose prose-sm dark:prose-invert max-w-none text-gray-800 dark:text-gray-100")">
            @if (Message.Role == "assistant")
            {
                @if (string.IsNullOrEmpty(Message.Content) && Streaming)
                {
                    <span class="inline-flex items-center gap-1.5 text-sm text-gray-400 dark:text-gray-500">
                        <img src="img/thinking-brain.svg" class="size-4 inline-block" alt="" aria-hidden="true" />@L["chat.thinking"]<span class="thinking-dots" aria-hidden="true"></span>
                    </span>
                }
                else
                {
                    @((MarkupString)RenderedHtml)
                    @if (Streaming)
                    {
                        <span class="typing">▌</span>
                    }
                }
            }
            else
            {
                @DisplayContent
            }
        </div>

        @if (ShowActions && !Streaming)
        {
            <div class="flex items-center gap-1 mt-1 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 pointer-coarse:opacity-100 transition-opacity text-gray-400 dark:text-gray-500">
                @if (Message.Versions is { Count: > 0 } versions)
                {
                    var total = versions.Count + 1;
                    var position = total - _versionOffset;
                    <button class="size-6 flex items-center justify-center rounded-md hover:bg-gray-100 dark:hover:bg-gray-850 hover:text-gray-600 dark:hover:text-gray-300 cursor-pointer disabled:opacity-30"
                            title="@L["chat.prev_version"]" aria-label="@L["chat.prev_version"]" disabled="@(_versionOffset >= versions.Count)"
                            @onclick="() => _versionOffset++">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
                    </button>
                    <span class="text-xs tabular-nums select-none">@position/@total</span>
                    <button class="size-6 flex items-center justify-center rounded-md hover:bg-gray-100 dark:hover:bg-gray-850 hover:text-gray-600 dark:hover:text-gray-300 cursor-pointer disabled:opacity-30"
                            title="@L["chat.next_version"]" aria-label="@L["chat.next_version"]" disabled="@(_versionOffset == 0)"
                            @onclick="() => _versionOffset--">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
                    </button>
                }
                <button class="size-6 flex items-center justify-center rounded-md hover:bg-gray-100 dark:hover:bg-gray-850 hover:text-gray-600 dark:hover:text-gray-300 cursor-pointer"
                        title="@L["chat.copy"]" aria-label="@L["chat.copy"]" @onclick="CopyAsync">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5" /></svg>
                </button>
                @if (Message.Role == "assistant")
                {
                    @if (TtsSupported)
                    {
                        <button class="size-6 flex items-center justify-center rounded-md hover:bg-gray-100 dark:hover:bg-gray-850 hover:text-gray-600 dark:hover:text-gray-300 cursor-pointer
                                       @(Speaking ? "text-blue-500 dark:text-blue-400" : "")"
                                title="@(Speaking ? L["voice.stop_speaking"] : L["voice.listen"])"
                                aria-label="@(Speaking ? L["voice.stop_speaking"] : L["voice.listen"])"
                                @onclick="() => OnSpeak.InvokeAsync()">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 0 1 2.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75Z" /></svg>
                        </button>
                    }
                    <button class="size-6 flex items-center justify-center rounded-md hover:bg-gray-100 dark:hover:bg-gray-850 hover:text-gray-600 dark:hover:text-gray-300 cursor-pointer"
                            title="@L["chat.good_response"]" aria-label="@L["chat.good_response"]" @onclick="() => OnRate.InvokeAsync(1)">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.633 10.25c.806 0 1.533-.446 2.031-1.08a9.041 9.041 0 0 1 2.861-2.4c.723-.384 1.35-.956 1.653-1.715a4.498 4.498 0 0 0 .322-1.672V3a.75.75 0 0 1 .75-.75 2.25 2.25 0 0 1 2.25 2.25c0 1.152-.26 2.243-.723 3.218-.266.558.107 1.282.725 1.282h3.126c1.026 0 1.945.694 2.054 1.715.045.422.068.85.068 1.285a11.95 11.95 0 0 1-2.649 7.521c-.388.482-.987.729-1.605.729H14.23c-.483 0-.964-.078-1.423-.23l-3.114-1.04a4.501 4.501 0 0 0-1.423-.23H5.25m6.01-9.007a48.5 48.5 0 0 0-1.01.01m0 0v-.019a2.25 2.25 0 0 1-2.25-2.25" transform="scale(-1,1) translate(-24,0)" /></svg>
                    </button>
                    <button class="size-6 flex items-center justify-center rounded-md hover:bg-gray-100 dark:hover:bg-gray-850 hover:text-gray-600 dark:hover:text-gray-300 cursor-pointer"
                            title="@L["chat.bad_response"]" aria-label="@L["chat.bad_response"]" @onclick="() => OnRate.InvokeAsync(-1)">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5 rotate-180"><path stroke-linecap="round" stroke-linejoin="round" d="M6.633 10.25c.806 0 1.533-.446 2.031-1.08a9.041 9.041 0 0 1 2.861-2.4c.723-.384 1.35-.956 1.653-1.715a4.498 4.498 0 0 0 .322-1.672V3a.75.75 0 0 1 .75-.75 2.25 2.25 0 0 1 2.25 2.25c0 1.152-.26 2.243-.723 3.218-.266.558.107 1.282.725 1.282h3.126c1.026 0 1.945.694 2.054 1.715.045.422.068.85.068 1.285a11.95 11.95 0 0 1-2.649 7.521c-.388.482-.987.729-1.605.729H14.23c-.483 0-.964-.078-1.423-.23l-3.114-1.04a4.501 4.501 0 0 0-1.423-.23H5.25m6.01-9.007a48.5 48.5 0 0 0-1.01.01m0 0v-.019a2.25 2.25 0 0 1-2.25-2.25" /></svg>
                    </button>
                    <button class="size-6 flex items-center justify-center rounded-md hover:bg-gray-100 dark:hover:bg-gray-850 hover:text-gray-600 dark:hover:text-gray-300 cursor-pointer"
                            title="@L["chat.regenerate"]" aria-label="@L["chat.regenerate"]" @onclick="() => OnRegenerate.InvokeAsync()">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
                    </button>
                    @if (_imageGenEnabled)
                    {
                        <button class="size-6 flex items-center justify-center rounded-md hover:bg-gray-100 dark:hover:bg-gray-850 hover:text-gray-600 dark:hover:text-gray-300 cursor-pointer"
                                title="@L["chat.generate_image"]" aria-label="@L["chat.generate_image"]" @onclick="() => OnGenerateImage.InvokeAsync()">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>
                        </button>
                    }
                }
                else
                {
                    <button class="size-6 flex items-center justify-center rounded-md hover:bg-gray-100 dark:hover:bg-gray-850 hover:text-gray-600 dark:hover:text-gray-300 cursor-pointer"
                            title="@L["chat.edit"]" aria-label="@L["chat.edit"]" @onclick="() => OnEdit.InvokeAsync()">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Z" /></svg>
                    </button>
                }
            </div>
        }
    </div>
</div>

@if (_preview is { } preview)
{
    <MediaLightbox Src="@preview.Src" Name="@preview.Name" Type="@preview.Type"
                   OnClose="() => _preview = null" />
}

@code {
    /// <summary>Mensagem a renderizar.</summary>
    [Parameter, EditorRequired] public ChatMessageModel Message { get; set; } = default!;

    /// <summary>Indica que a mensagem está sendo transmitida.</summary>
    [Parameter] public bool Streaming { get; set; }

    /// <summary>Mostra ações da mensagem.</summary>
    [Parameter] public bool ShowActions { get; set; }

    /// <summary>Iniciais do usuário para o avatar.</summary>
    [Parameter] public string Initials { get; set; } = "U";

    /// <summary>Disparado ao pedir regeneração da resposta.</summary>
    [Parameter] public EventCallback OnRegenerate { get; set; }

    /// <summary>Disparado ao pedir edição da mensagem (usuário).</summary>
    [Parameter] public EventCallback OnEdit { get; set; }

    /// <summary>Disparado ao avaliar a resposta (1 ou -1).</summary>
    [Parameter] public EventCallback<int> OnRate { get; set; }

    /// <summary>Disparado ao pedir geração de imagem a partir da resposta.</summary>
    [Parameter] public EventCallback OnGenerateImage { get; set; }

    /// <summary>Reproduz/interrompe a leitura da mensagem (TTS).</summary>
    [Parameter] public EventCallback OnSpeak { get; set; }

    /// <summary>Esta mensagem está sendo lida em voz alta.</summary>
    [Parameter] public bool Speaking { get; set; }

    /// <summary>O navegador suporta TTS.</summary>
    [Parameter] public bool TtsSupported { get; set; }

    private ElementReference _contentRef;
    private bool _codeExecEnabled;
    private bool _imageGenEnabled;
    private int _versionOffset;
    private string? _htmlFor;
    private string _html = string.Empty;
    private string? _enhancedFor;
    private (string Src, string? Name, string Type)? _preview;

    /// <summary>Abre o lightbox do anexo (RF-005) — resolve o object URL primeiro.</summary>
    private async Task OpenPreviewAsync(ChatMessageFileModel f)
    {
        var src = await JS.InvokeAsync<string?>("openwebui.media.resolve", f.Id);
        if (src is not null)
        {
            _preview = (src, f.Name, f.Type);
        }
    }

    /// <summary>Conteúdo exibido: versão atual (_versionOffset=0) ou uma versão anterior.</summary>
    private string DisplayContent =>
        _versionOffset > 0 && Message.Versions is { Count: > 0 } versions && _versionOffset <= versions.Count
            ? versions[versions.Count - _versionOffset].Content
            : Message.Content;

    /// <summary>
    /// HTML cacheado por conteúdo: cada tecla no composer re-renderiza a
    /// view inteira — sem o cache, TODAS as mensagens re-parseavam markdown
    /// (Markdig + sanitizer) a cada keystroke, a jank principal do chat.
    /// </summary>
    private string RenderedHtml
    {
        get
        {
            var content = DisplayContent;
            if (content != _htmlFor)
            {
                _htmlFor = content;
                _html = Markdown.ToHtml(content);
            }
            return _html;
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Message.Versions is null || _versionOffset > Message.Versions.Count)
        {
            _versionOffset = 0;
        }
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        if (Message.Role == "assistant")
        {
            try
            {
                var config = await Api.GetAppConfigCachedAsync();
                _codeExecEnabled = config?.Features.EnableCodeExecution ?? false;
                _imageGenEnabled = config?.Features.EnableImageGeneration ?? false;
            }
            catch (Exception ex) when (ClientErrors.IsTransient(ex))
            {
                // Offline: bolha renderiza o texto; features extras ficam off.
            }
        }
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // O scan de blocos de código só vale quando o conteúdo mudou —
        // chamar a cada render disparava um interop + querySelectorAll por
        // bolha por keystroke do composer.
        if (_codeExecEnabled && Message.Role == "assistant"
            && DisplayContent != _enhancedFor)
        {
            _enhancedFor = DisplayContent;
            await JS.InvokeVoidAsync("openwebui.codeExec.enhance", _contentRef);
        }
    }

    private async Task CopyAsync() =>
        await JS.InvokeVoidAsync("openwebui.copyText", DisplayContent);
}
