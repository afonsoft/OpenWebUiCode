@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LocalizationService L
@implements IAsyncDisposable

@* Terminal interativo (xterm + ws /ws/terminal/{id}) — usado pela página
   /terminal e pela aba Terminal do painel do chat. *@

@if (_enabled is null)
{
    <div class="sidebar-empty">@L["common.loading"]</div>
}
else if (_enabled == false)
{
    <div class="sidebar-empty px-4">
        <div class="text-gray-500 dark:text-gray-400">@L["terminal.disabled"]</div>
        <div class="text-xs text-gray-400 dark:text-gray-500 mt-1">@L["terminal.disabled_hint"]</div>
    </div>
}
else
{
    <div class="flex h-full min-h-0 flex-col">
        <div class="flex items-center gap-1 px-3 pb-2 overflow-x-auto">
            @foreach (var session in _sessions)
            {
                <span class="flex items-center rounded-lg text-xs transition
                        @(_active == session.Id
                            ? "bg-gray-200 dark:bg-gray-800 text-gray-900 dark:text-gray-100"
                            : "text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-900")">
                    <button class="flex items-center gap-1.5 pl-2.5 pr-1 py-1 cursor-pointer"
                            @onclick="() => ActivateAsync(session)">
                        <span class="size-1.5 rounded-full @(session.IsRunning ? "bg-green-500" : "bg-gray-400")"
                              role="img" aria-label="@(session.IsRunning ? L["terminal.status_running"] : L["terminal.status_stopped"])"
                              title="@(session.IsRunning ? L["terminal.status_running"] : L["terminal.status_stopped"])"></span>
                        @session.Id
                    </button>
                    <button class="pr-2.5 pl-1 py-1 text-gray-400 hover:text-red-500 cursor-pointer" title="@L["terminal.kill"]"
                            aria-label="@L["terminal.kill"]" @onclick="() => KillAsync(session.Id)">✕</button>
                </span>
            }
            @if (_sessions.Count == 0)
            {
                <span class="text-xs text-gray-500 dark:text-gray-400">@L["terminal.empty"]</span>
            }
            <span class="ms-auto flex items-center gap-2">
                <button class="msg-action" @onclick="RefreshAsync" title="@L["terminal.refresh"]">@L["terminal.refresh"]</button>
                <button class="msg-action" @onclick="NewSessionAsync" title="@L["terminal.new"]">@L["terminal.new"]</button>
            </span>
        </div>
        <div class="flex-1 min-h-0 px-3 pb-3">
            @if (_loadError)
            {
                <div class="flex h-full items-center justify-center text-sm text-gray-400">@L["terminal.load_error"]</div>
            }
            else
            {
                @foreach (var session in _sessions)
                {
                    <div id="term-@session.Id"
                         class="h-full w-full rounded-xl overflow-hidden bg-[#0d1117] @(session.Id == _active ? "" : "hidden")"></div>
                }
            }
        </div>
    </div>
}

@code {
    /// <summary>Chat dono — quando informado, cria/lista sessões bindadas
    /// (SPEC-20261022): o PTY cai no workdir do workspace do chat.</summary>
    [Parameter] public string? ChatId { get; set; }

    private List<TerminalSessionInfoResponse> _sessions = [];
    private readonly HashSet<string> _opened = [];
    private string? _active;
    private bool? _enabled;
    private bool _loadError;
    private DotNetObjectReference<TerminalView>? _selfRef;
    private CancellationTokenSource? _pollCts;

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _enabled = await Api.GetTerminalEnabledAsync();
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            // Offline: painel degradado com retry manual, não a error UI.
            _enabled = true;
            _loadError = true;
            await Console.Error.WriteLineAsync($"[TerminalView] init falhou: {ex.Message}");
            return;
        }
        if (_enabled == true)
        {
            await RefreshAsync();
            // Sessões criadas por tools do chat (builtin:terminal) aparecem sem refresh manual.
            _pollCts = new CancellationTokenSource();
            _ = PollSessionsAsync(_pollCts.Token);
        }
    }

    private async Task PollSessionsAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Descarte da página.
        }
    }

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_enabled == true && _active is not null && _opened.Add(_active))
        {
            await OpenWsAsync(_active);
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            _sessions = await Api.GetTerminalSessionsAsync(ChatId);
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            // Offline: mantém a lista anterior; o poll/refresh retenta.
            _loadError = _sessions.Count == 0;
            await Console.Error.WriteLineAsync($"[TerminalView] refresh falhou: {ex.Message}");
            return;
        }
        _loadError = false;
        _active ??= _sessions.FirstOrDefault(s => s.IsRunning)?.Id ?? _sessions.FirstOrDefault()?.Id;
        if (_active is not null && _sessions.All(s => s.Id != _active))
        {
            await CloseTermAsync(_active);
            _active = _sessions.FirstOrDefault(s => s.IsRunning)?.Id ?? _sessions.FirstOrDefault()?.Id;
        }
    }

    private async Task NewSessionAsync()
    {
        var id = await Api.CreateTerminalSessionAsync(chatId: ChatId);
        if (id is not null)
        {
            await RefreshAsync();
            _active = id;
        }
    }

    private async Task ActivateAsync(TerminalSessionInfoResponse session)
    {
        _active = session.Id;
        // OnAfterRenderAsync abre o WS depois que o elemento existe.
    }

    private async Task KillAsync(string id)
    {
        await Api.KillTerminalSessionAsync(id);
        await CloseTermAsync(id);
        if (_active == id)
        {
            _active = null;
        }
        await RefreshAsync();
    }

    private async Task OpenWsAsync(string sessionId)
    {
        var token = Auth.Token;
        if (token is null)
        {
            return;
        }

        var scheme = Nav.Uri.StartsWith("https", StringComparison.OrdinalIgnoreCase) ? "wss" : "ws";
        var url = $"{scheme}://{new Uri(Nav.Uri).Authority}/ws/terminal?access_token={Uri.EscapeDataString(token)}";
        _selfRef ??= DotNetObjectReference.Create(this);
        _loadError = false;
        var opened = await JS.InvokeAsync<bool>(
            "owuiTerminal.openMux", $"term-{sessionId}", url, sessionId, _selfRef);
        if (!opened)
        {
            _opened.Remove(sessionId);
            _loadError = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CloseTermAsync(string sessionId)
    {
        _opened.Remove(sessionId);
        await JS.InvokeVoidAsync("owuiTerminal.detach", $"term-{sessionId}");
    }

    /// <summary>Callback do JS quando o WebSocket fecha — atualiza o dot de status.</summary>
    [JSInvokable]
    public async Task OnTerminalClosed(string elementId)
    {
        var id = elementId["term-".Length..];
        var session = _sessions.FirstOrDefault(s => s.Id == id);
        if (session is not null)
        {
            var index = _sessions.IndexOf(session);
            _sessions[index] = session with { IsRunning = false };
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <inheritdoc/>
    public async ValueTask DisposeAsync()
    {
        if (_pollCts is not null) { await _pollCts.CancelAsync(); }
        _pollCts?.Dispose();
        foreach (var session in _sessions)
        {
            await CloseTermAsync(session.Id);
        }
        _selfRef?.Dispose();
    }
}
