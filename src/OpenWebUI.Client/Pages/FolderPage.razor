@page "/folders/{FolderId}"
@inject ApiService Api
@inject NavigationManager Nav
@inject LocalizationService L

<PageTitle>@(_folder?.Name ?? L["folder.default_name"]) — Open WebUI</PageTitle>

<div class="page">
    <div class="page-header">
        <h1 class="page-title" tabindex="-1"><span aria-hidden="true">📁</span> @(_folder?.Name ?? "")</h1>
        <a class="msg-action" href="/">← @L["common.back"]</a>
    </div>

    @if (_loadFailed)
    {
        <OfflineRetry OnRetry="LoadAsync" />
    }
    else if (_notFound)
    {
        <div class="sidebar-empty">@L["common.not_found"]</div>
    }
    else if (_chats is null)
    {
        <div class="sidebar-empty">@L["common.loading"]</div>
    }
    else if (_chats.Count == 0)
    {
        <div class="sidebar-empty">@L["sidebar.empty"]</div>
    }
    else
    {
        <div class="card-list">
            @foreach (var chat in _chats)
            {
                <a class="card-row" href="/c/@chat.Id">
                    <div class="card-main">
                        <div class="card-title">@chat.Title</div>
                    </div>
                </a>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string? FolderId { get; set; }

    private FolderResponse? _folder;
    private List<ChatSummaryResponse>? _chats;
    private bool _notFound;
    private bool _loadFailed;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loadFailed = false;
        if (FolderId is null) { _notFound = true; return; }
        try
        {
            _folder = await Api.GetFolderAsync(FolderId);
            if (_folder is null)
            {
                _notFound = true;
                return;
            }
            _chats = await Api.GetFolderChatsAsync(FolderId);
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            _loadFailed = true;
            await Console.Error.WriteLineAsync($"[FolderPage] carga falhou: {ex.Message}");
        }
    }
}
