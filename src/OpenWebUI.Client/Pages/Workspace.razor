@page "/workspace"
@page "/workspace/prompts"
@page "/workspace/models"
@page "/workspace/files"
@page "/workspace/knowledge"
@page "/workspace/tools"
@page "/workspace/skills"
@implements IDisposable
@inject ApiService Api
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject LocalizationService L
@inject DialogService Dialogs

<PageTitle>Workspace — Open WebUI</PageTitle>

<div class="page">
    <h1 class="page-title" tabindex="-1">Workspace</h1>
    <div class="page-tabs" role="tablist" @ref="_tabList" @onkeydown="OnTabKeyDown">
        <a href="/workspace/prompts" class="modal-tab @(Section == "prompts" ? "active" : "")" role="tab" aria-selected="@(Section == "prompts")">@L["workspace.prompts"]</a>
        <a href="/workspace/models" class="modal-tab @(Section == "models" ? "active" : "")" role="tab" aria-selected="@(Section == "models")">@L["workspace.models"]</a>
        <a href="/workspace/files" class="modal-tab @(Section == "files" ? "active" : "")" role="tab" aria-selected="@(Section == "files")">@L["workspace.files"]</a>
        <a href="/workspace/knowledge" class="modal-tab @(Section == "knowledge" ? "active" : "")" role="tab" aria-selected="@(Section == "knowledge")">@L["workspace.knowledge"]</a>
        <a href="/workspace/tools" class="modal-tab @(Section == "tools" ? "active" : "")" role="tab" aria-selected="@(Section == "tools")">Tools</a>
        <a href="/workspace/skills" class="modal-tab @(Section == "skills" ? "active" : "")" role="tab" aria-selected="@(Section == "skills")">@L["workspace.skills"]</a>
    </div>

    @if (_loadFailed)
    {
        <OfflineRetry OnRetry="LoadAllAsync" />
    }

    <div class="card-row mb-3">
        <div class="card-main">
            <div class="card-title">@L["ide.title"]</div>
            <div class="card-sub">@L["ide.entry_desc"]</div>
        </div>
        <div class="card-actions">
            <a class="msg-action" href="/ide">@L["ide.open"]</a>
        </div>
    </div>

    @if (Section == "models")
    {
        <div class="card-list">
            <div class="card-row">
                <a href="/workspace/models/create" class="auth-submit text-center">@L["workspace.new_model"]</a>
            </div>
            @foreach (var model in _models)
            {
                <div class="card-row">
                    <div class="card-main">
                        <div class="card-title">@model.Name @(model.IsActive ? "" : L["workspace.inactive"])</div>
                        <div class="card-sub">Base: @model.BaseModelId</div>
                    </div>
                    <div class="card-actions">
                        <button class="msg-action" title="@L["workspace.share_community"]" aria-label="@L["workspace.share_community"]"
                                @onclick='() => ShareCommunityAsync("model", model)'>↗</button>
                        <a class="msg-action" href="/workspace/models/@model.Id">@L["common.edit"]</a>
                        <button class="msg-action" @onclick="() => ToggleModelAsync(model)">
                            @(model.IsActive ? L["workspace.hide"] : L["workspace.activate"])
                        </button>
                        <button class="msg-action danger" aria-label="@L["common.delete"]" @onclick="() => DeleteModelAsync(model)">🗑</button>
                    </div>
                </div>
            }
            @if (_models.Count == 0)
            {
                <div class="sidebar-empty">@L["workspace.no_models"]</div>
            }
        </div>
    }
    else if (Section == "files")
    {
        <div class="card-list">
            @foreach (var file in _files)
            {
                <div class="card-row">
                    <div class="card-main">
                        <div class="card-title"><span aria-hidden="true">📎 </span>@file.Filename</div>
                        <div class="card-sub">@FormatSize(file.Size) · @FormatDate(file.CreatedAt)</div>
                    </div>
                    <div class="card-actions">
                        <button class="msg-action danger" aria-label="@L["common.delete"]" @onclick="() => DeleteFileAsync(file)">🗑</button>
                    </div>
                </div>
            }
            @if (_files.Count == 0)
            {
                <div class="sidebar-empty">@L["workspace.no_files"]</div>
            }
        </div>
    }
    else if (Section == "knowledge")
    {
        <div class="card-list">
            <div class="card-row">
                <a href="/workspace/knowledge/create" class="auth-submit text-center">@L["workspace.new_collection"]</a>
                @if (_selectedKnowledge.Count > 0)
                {
                    <button class="msg-action danger" @onclick="BatchDeleteKnowledgeAsync">
                        @L.T("workspace.delete_selected", ("count", _selectedKnowledge.Count.ToString()))
                    </button>
                }
                @if (!string.IsNullOrEmpty(_knowledgeStatus))
                {
                    <span class="text-sm text-gray-500 dark:text-gray-400 self-center">@_knowledgeStatus</span>
                }
            </div>
            @foreach (var item in _knowledge)
            {
                <div class="card-row">
                    <div class="card-main">
                        <div class="card-title"><a class="hover:underline" href="/workspace/knowledge/@item.Id"># @item.Name</a></div>
                        <div class="card-sub">@L.T("workspace.file_count", ("count", item.FileCount.ToString())) — @(item.Description ?? L["admin.no_description"])</div>
                        @if (_knowledgeDetail?.Id == item.Id)
                        {
                            <div class="card-sub">
                                @foreach (var kf in _knowledgeDetail.Files)
                                {
                                    <div><span aria-hidden="true">📄 </span>@kf.Filename
                                        <button class="msg-action danger" aria-label="@L["common.delete"]" @onclick="() => RemoveKnowledgeFileAsync(kf)">×</button>
                                    </div>
                                }
                                @if (_knowledgeDetail.Files.Count == 0)
                                {
                                    <div>@L["workspace.no_files_yet"]</div>
                                }
                            </div>
                        }
                    </div>
                    <div class="card-actions">
                        <button class="msg-action" aria-expanded="@(_knowledgeDetail?.Id == item.Id)" aria-label="@L["common.toggle"]"
                                @onclick="() => ToggleKnowledgeDetailAsync(item)">
                            @(_knowledgeDetail?.Id == item.Id ? "▲" : "▼")
                        </button>
                        <button class="msg-action" @onclick="() => AddKnowledgeFileAsync(item)">@L["workspace.add_file"]</button>
                        <button class="msg-action" title="@L["workspace.reindex"]" aria-label="@L["workspace.reindex"]"
                                @onclick="() => ReindexKnowledgeAsync(item)">↻</button>
                        <button class="msg-action danger" aria-label="@L["common.delete"]" @onclick="() => DeleteKnowledgeAsync(item)">🗑</button>
                        <input type="checkbox" class="ml-1 cursor-pointer"
                               aria-label="@L.T("workspace.select", ("name", item.Name))"
                               checked="@_selectedKnowledge.Contains(item.Id)"
                               @onchange="() => ToggleKnowledgeSelection(item.Id)" />
                    </div>
                </div>
            }
            @if (_knowledge.Count == 0)
            {
                <div class="sidebar-empty">@L["workspace.no_collections"]</div>
            }
        </div>
    }
    else if (Section == "tools")
    {
        <div class="card-list">
            <div class="card-row">
                <a href="/workspace/tools/create" class="auth-submit text-center">@L["workspace.new_tool"]</a>
            </div>
            @foreach (var tool in _tools)
            {
                <div class="card-row">
                    <div class="card-main">
                        <div class="card-title">@tool.Name @(tool.Enabled ? "" : L["workspace.disabled"])</div>
                        <div class="card-sub">@tool.Description</div>
                    </div>
                    <div class="card-actions">
                        <button class="msg-action" title="@L["workspace.share_community"]" aria-label="@L["workspace.share_community"]"
                                @onclick='() => ShareCommunityAsync("tool", tool)'>↗</button>
                        <a class="msg-action" href="/workspace/tools/@tool.Id">@L["common.edit"]</a>
                        <button class="msg-action" @onclick="() => ToggleToolAsync(tool)">
                            @(tool.Enabled ? L["workspace.disable"] : L["workspace.enable"])
                        </button>
                        <button class="msg-action danger" aria-label="@L["common.delete"]" @onclick="() => DeleteToolAsync(tool)">🗑</button>
                    </div>
                </div>
            }
            @if (_tools.Count == 0)
            {
                <div class="sidebar-empty">@L["workspace.no_tools"]</div>
            }
        </div>
    }
    else if (Section == "skills")
    {
        <div class="card-list">
            <div class="card-row">
                <div class="flex flex-col gap-2 w-full text-sm py-1">
                    <input class="input" @bind="_skillName" placeholder="@L["workspace.skill_name"]" aria-label="@L["workspace.skill_name"]" />
                    <input class="input" @bind="_skillDesc" placeholder="@L["workspace.skill_desc"]" aria-label="@L["workspace.skill_desc"]" />
                    <textarea class="input" rows="4" @bind="_skillContent"
                        placeholder="@L["workspace.skill_content"]" aria-label="@L["workspace.skill_content"]"></textarea>
                    <div class="flex gap-2">
                        <button class="auth-submit" @onclick="SaveSkillAsync">
                            @(_skillEditId is null ? L["workspace.new_skill"] : L["common.save"])
                        </button>
                        @if (_skillEditId is not null)
                        {
                            <button class="msg-action" @onclick="ResetSkillForm">@L["common.cancel"]</button>
                        }
                    </div>
                </div>
            </div>
            @foreach (var skill in _skills)
            {
                <div class="card-row">
                    <div class="card-main">
                        <div class="card-title">@skill.Name</div>
                        <div class="card-sub">@skill.Description</div>
                    </div>
                    <div class="card-actions">
                        <button class="msg-action" @onclick="() => EditSkill(skill)">@L["common.edit"]</button>
                        <button class="msg-action danger" aria-label="@L["common.delete"]" @onclick="() => DeleteSkillAsync(skill)">🗑</button>
                    </div>
                </div>
            }
            @if (_skills.Count == 0)
            {
                <div class="sidebar-empty">@L["workspace.no_skills"]</div>
            }
        </div>
    }
    else
    {
        <div class="card-list">
            <div class="card-row">
                <a href="/workspace/prompts/create" class="auth-submit text-center">@L["workspace.new_prompt"]</a>
            </div>
            @foreach (var prompt in _prompts)
            {
                <div class="card-row">
                    <div class="card-main">
                        <div class="card-title">/@prompt.Command — @prompt.Title</div>
                        <div class="card-sub card-pre">@prompt.Content</div>
                    </div>
                    <div class="card-actions">
                        <button class="msg-action" title="@L["workspace.share_community"]" aria-label="@L["workspace.share_community"]"
                                @onclick='() => ShareCommunityAsync("prompt", prompt)'>↗</button>
                        <a class="msg-action" href="/workspace/prompts/@prompt.Id">@L["common.edit"]</a>
                        <button class="msg-action danger" aria-label="@L["common.delete"]" @onclick="() => DeletePromptAsync(prompt)">🗑</button>
                    </div>
                </div>
            }
            @if (_prompts.Count == 0)
            {
                <div class="sidebar-empty">@L["workspace.no_prompts"]</div>
            }
        </div>
    }
</div>

@code {
    private ElementReference _tabList;

    private async Task OnTabKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "ArrowLeft" or "ArrowRight" or "ArrowUp" or "ArrowDown" or "Home" or "End")
        {
            await JS.InvokeVoidAsync("openwebui.rovingFocus", _tabList, e.Key);
        }
    }

    private string Section =>
        Nav.Uri.Contains("/workspace/models") ? "models"
        : Nav.Uri.Contains("/workspace/files") ? "files"
        : Nav.Uri.Contains("/workspace/knowledge") ? "knowledge"
        : Nav.Uri.Contains("/workspace/tools") ? "tools"
        : Nav.Uri.Contains("/workspace/skills") ? "skills"
        : "prompts";

    private List<PromptResponse> _prompts = [];
    private List<ModelEntryResponse> _models = [];
    private List<FileResponse> _files = [];
    private List<KnowledgeResponse> _knowledge = [];
    private KnowledgeDetailResponse? _knowledgeDetail;
    private readonly HashSet<string> _selectedKnowledge = [];
    private string? _knowledgeStatus;
    private List<ToolResponse> _tools = [];
    private List<SkillResponse> _skills = [];
    private bool _loadFailed;
    private string? _skillEditId;
    private string _skillName = "";
    private string _skillDesc = "";
    private string _skillContent = "";

    /// <summary>Abre o post da comunidade openwebui.com numa nova aba e envia o item
    /// serializado via postMessage (mesmo protocolo do upstream). Só dispara pela
    /// ação explícita do usuário.</summary>
    private async Task ShareCommunityAsync(string type, object payload)
    {
        var json = System.Text.Json.JsonSerializer.Serialize(
            payload, new System.Text.Json.JsonSerializerOptions(
                System.Text.Json.JsonSerializerDefaults.Web));
        await JS.InvokeAsync<bool>("openwebui.shareCommunity", type, json);
    }

    protected override async Task OnInitializedAsync()
    {
        // Mesma instância serve /workspace/{seção}: sem escutar LocationChanged
        // a troca de aba atualiza a URL mas não re-renderiza o conteúdo.
        Nav.LocationChanged += OnLocationChanged;
        await LoadAllAsync();
    }

    /// <summary>Fetches de init — offline vira retry manual, não error UI.</summary>
    private async Task LoadAllAsync()
    {
        _loadFailed = false;
        try
        {
            _prompts = await Api.GetPromptsAsync();
            _models = await Api.GetCustomModelsAsync();
            _files = await Api.GetFilesAsync();
            _knowledge = await Api.GetKnowledgeAsync();
            _skills = await Api.GetSkillsAsync() ?? [];
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            _loadFailed = true;
            await Console.Error.WriteLineAsync($"[Workspace] carga falhou: {ex.Message}");
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    /// <summary>Desinscreve do LocationChanged ao sair da página.</summary>
    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void EditSkill(SkillResponse skill)
    {
        _skillEditId = skill.Id;
        _skillName = skill.Name;
        _skillDesc = skill.Description ?? "";
        _skillContent = skill.Content;
    }

    private void ResetSkillForm()
    {
        _skillEditId = null;
        _skillName = "";
        _skillDesc = "";
        _skillContent = "";
    }

    private async Task SaveSkillAsync()
    {
        var request = new SkillRequest(_skillName.Trim(), _skillDesc.Trim(), _skillContent);
        var saved = _skillEditId is null
            ? await Api.CreateSkillAsync(request)
            : await Api.UpdateSkillAsync(_skillEditId, request);
        if (saved is not null)
        {
            ResetSkillForm();
            _skills = await Api.GetSkillsAsync() ?? [];
        }
    }

    private async Task DeleteSkillAsync(SkillResponse skill)
    {
        await Api.DeleteSkillAsync(skill.Id);
        _skills.RemoveAll(s => s.Id == skill.Id);
    }

    private async Task ToggleKnowledgeDetailAsync(KnowledgeResponse item)
    {
        _knowledgeDetail = _knowledgeDetail?.Id == item.Id
            ? null
            : await Api.GetKnowledgeDetailAsync(item.Id);
    }

    private async Task AddKnowledgeFileAsync(KnowledgeResponse item)
    {
        var names = string.Join("\n", _files.Select(f => $"- {f.Filename}"));
        var filename = await Dialogs.PromptAsync(
            $"{L["workspace.prompt_file_name"]}\n{names}", "");
        var file = _files.FirstOrDefault(f =>
            f.Filename.Equals(filename?.Trim(), StringComparison.OrdinalIgnoreCase));
        if (file is null)
        {
            return;
        }
        if (await Api.AddKnowledgeFileAsync(item.Id, file.Id))
        {
            _knowledgeDetail = await Api.GetKnowledgeDetailAsync(item.Id);
            _knowledge = await Api.GetKnowledgeAsync();
        }
    }

    private void ToggleKnowledgeSelection(string id)
    {
        if (!_selectedKnowledge.Remove(id))
        {
            _selectedKnowledge.Add(id);
        }
    }

    private async Task ReindexKnowledgeAsync(KnowledgeResponse item)
    {
        _knowledgeStatus = L["workspace.reindexing"];
        var result = await Api.ReindexKnowledgeAsync(item.Id);
        _knowledgeStatus = result is null
            ? L["workspace.reindex_failed"]
            : result.Status
                ? L.T("workspace.reindexed", ("count", result.Indexed.ToString()))
                : L.T("workspace.reindex_partial", ("ok", result.Indexed.ToString()), ("fail", result.Failed.ToString()));
    }

    private async Task BatchDeleteKnowledgeAsync()
    {
        if (!await Dialogs.ConfirmAsync( L["workspace.confirm_delete_selected"], danger: true))
        {
            return;
        }
        var deleted = await Api.BatchDeleteKnowledgeAsync(_selectedKnowledge.ToList());
        _knowledge.RemoveAll(k => _selectedKnowledge.Contains(k.Id));
        _selectedKnowledge.Clear();
        _knowledgeStatus = L.T("workspace.deleted_count", ("count", deleted.ToString()));
    }

    private async Task RemoveKnowledgeFileAsync(KnowledgeFileResponse kf)
    {
        if (_knowledgeDetail is not null &&
            await Api.RemoveKnowledgeFileAsync(_knowledgeDetail.Id, kf.FileId))
        {
            _knowledgeDetail = await Api.GetKnowledgeDetailAsync(_knowledgeDetail.Id);
            _knowledge = await Api.GetKnowledgeAsync();
        }
    }

    private async Task DeleteKnowledgeAsync(KnowledgeResponse item)
    {
        if (await Api.DeleteKnowledgeAsync(item.Id))
        {
            _knowledge.Remove(item);
            if (_knowledgeDetail?.Id == item.Id)
            {
                _knowledgeDetail = null;
            }
        }
        // Tools virtuais MCP são geridas na aba MCP do Admin — não entram na lista editável.
        _tools = (await Api.GetToolsAsync()).Where(t => t.Source == "user").ToList();
    }

    private async Task DeletePromptAsync(PromptResponse prompt)
    {
        if (await Dialogs.ConfirmAsync( L.T("workspace.confirm_delete_prompt", ("command", prompt.Command)), danger: true)
            && await Api.DeletePromptAsync(prompt.Id))
        {
            _prompts.Remove(prompt);
        }
    }

    private async Task ToggleModelAsync(ModelEntryResponse model)
    {
        var updated = await Api.ToggleCustomModelAsync(model.Id);
        if (updated is not null)
        {
            var index = _models.FindIndex(m => m.Id == model.Id);
            if (index >= 0)
            {
                _models[index] = updated;
            }
        }
    }

    private async Task DeleteModelAsync(ModelEntryResponse model)
    {
        if (await Dialogs.ConfirmAsync( L.T("workspace.confirm_delete_model", ("name", model.Name)), danger: true)
            && await Api.DeleteCustomModelAsync(model.Id))
        {
            _models.Remove(model);
        }
    }

    private async Task DeleteFileAsync(FileResponse file)
    {
        if (await Dialogs.ConfirmAsync( L.T("common.confirm_delete", ("name", file.Filename)), danger: true)
            && await Api.DeleteFileAsync(file.Id))
        {
            _files.Remove(file);
        }
    }

    private async Task ToggleToolAsync(ToolResponse tool)
    {
        var updated = await Api.UpdateToolAsync(tool.Id,
            new ToolUpsertRequest(tool.Name, tool.Description, tool.SpecJson, null, null, !tool.Enabled));
        if (updated is not null)
        {
            var index = _tools.FindIndex(t => t.Id == tool.Id);
            if (index >= 0)
            {
                _tools[index] = updated;
            }
        }
    }

    private async Task DeleteToolAsync(ToolResponse tool)
    {
        if (await Dialogs.ConfirmAsync( L.T("workspace.confirm_delete_tool", ("name", tool.Name)), danger: true)
            && await Api.DeleteToolAsync(tool.Id))
        {
            _tools.Remove(tool);
        }
    }

    private static string FormatSize(long bytes) =>
        bytes > 1024 * 1024 ? $"{bytes / 1024.0 / 1024.0:F1} MB"
        : bytes > 1024 ? $"{bytes / 1024.0:F1} KB"
        : $"{bytes} B";

    private string FormatDate(long unixSeconds) =>
        L.FormatDateTime(DateTimeOffset.FromUnixTimeSeconds(unixSeconds).LocalDateTime);
}
