@page "/notes"
@inject ApiService Api
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject LocalizationService L
@inject DialogService Dialogs

<PageTitle>@L["page.notes"] — Open WebUI</PageTitle>

<div class="page">
    <div class="page-header">
        <h1 class="page-title" tabindex="-1">@L["page.notes"]</h1>
        <a href="/notes/new" class="auth-submit page-new text-center">@L["notes.new"]</a>
    </div>
    @if (_loadFailed)
    {
        <OfflineRetry OnRetry="LoadNotesAsync" />
    }
    else if (_notes is null)
    {
        <div class="sidebar-empty">@L["common.loading"]</div>
    }
    else if (_notes.Count == 0)
    {
        <div class="sidebar-empty">@L["notes.empty"]</div>
    }
    else
    {
        <div class="card-list">
            @foreach (var note in _notes)
            {
                <div class="card-row">
                    <div class="card-main">
                        <div class="card-title">@note.Title</div>
                        <div class="card-sub card-pre">@note.Content</div>
                    </div>
                    <div class="card-actions">
                        <a class="msg-action" href="/notes/@note.Id">@L["common.edit"]</a>
                        <button class="msg-action danger" aria-label="@L["common.delete"]" @onclick="() => DeleteNoteAsync(note)">🗑</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<NoteResponse>? _notes;
    private bool _loadFailed;

    protected override async Task OnInitializedAsync() => await LoadNotesAsync();

    private async Task LoadNotesAsync()
    {
        _loadFailed = false;
        try
        {
            _notes = await Api.GetNotesAsync();
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            _loadFailed = true;
            _notes = [];
            await Console.Error.WriteLineAsync($"[Notes] carga falhou: {ex.Message}");
        }
    }

    private async Task DeleteNoteAsync(NoteResponse note)
    {
        if (await Dialogs.ConfirmAsync( L.T("common.confirm_delete", ("name", note.Title)), danger: true)
            && await Api.DeleteNoteAsync(note.Id))
        {
            _notes?.Remove(note);
        }
    }
}
