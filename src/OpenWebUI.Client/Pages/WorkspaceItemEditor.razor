@page "/workspace/{Kind}/create"
@page "/workspace/{Kind}/{Id}"
@inject ApiService Api
@inject NavigationManager Nav
@inject LocalizationService L
@using System.Text.Json
@using System.Text.Json.Nodes

<PageTitle>@PageTitle — Open WebUI</PageTitle>

<div class="page">
    <div class="page-header">
        <h1 class="page-title" tabindex="-1">@PageTitle</h1>
        <a class="msg-action" href="/workspace/@Kind">← @L["common.back"]</a>
    </div>

    @if (_loadFailed)
    {
        <OfflineRetry OnRetry="LoadAsync" />
    }
    else if (_notFound)
    {
        <div class="sidebar-empty">@L["common.not_found"]</div>
    }
    else if (_loading)
    {
        <div class="sidebar-empty">@L["common.loading"]</div>
    }
    else
    {
        <div class="card-list">
            <div class="card-row">
                <div class="card-main w-full">
                    <div class="grid gap-3">
                        @if (Kind == "prompts")
                        {
                            <div class="field">
                                <label for="fld-39">@L["workspace.prompt_command"]</label>
                                <input class="input" placeholder="@L["workspace.command_ph"]" @bind="_pCommand" id="fld-39" />
                            </div>
                            <div class="field">
                                <label for="fld-40">@L["common.title"]</label>
                                <input class="input" @bind="_pTitle" id="fld-40" />
                            </div>
                            <div class="field">
                                <label for="fld-41">@L["common.content"]</label>
                                <textarea class="input" rows="8" @bind="_pContent" id="fld-41"></textarea>
                            </div>
                        }
                        else if (Kind == "models")
                        {
                            <div class="field">
                                <label for="fld-42">@L["common.name"]</label>
                                <input class="input" @bind="_mName" id="fld-42" />
                            </div>
                            <div class="field">
                                <label for="fld-43">@L["workspace.prompt_base_model"]</label>
                                <select class="input" @bind="_mBase" id="fld-43">
                                    @foreach (var m in _baseModels)
                                    {
                                        <option value="@m.Id">@m.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label for="fld-44">@L["workspace.prompt_system_plain"]</label>
                                <textarea class="input" rows="6" @bind="_mSystem" id="fld-44"></textarea>
                            </div>
                            <div class="field">
                                <label for="fld-45">@L["workspace.params_json"]</label>
                                <textarea class="input font-mono text-sm" rows="4"
                                          placeholder="{&quot;temperature&quot;: 0.7}" @bind="_mParams" id="fld-45"></textarea>
                            </div>
                            <div class="field">
                                <label for="fld-46">@L["workspace.meta_json"]</label>
                                <textarea class="input font-mono text-sm" rows="3"
                                          placeholder="{&quot;arena&quot;: true, &quot;model_ids&quot;: [&quot;a&quot;, &quot;b&quot;]}"
                                          @bind="_mMeta" id="fld-46"></textarea>
                                <div class="flex flex-wrap gap-1 mt-1">
                                    <span class="text-xs text-gray-500 w-full">@L["workspace.filter_presets"]</span>
                                    <button class="msg-action" @onclick='() => AddFilterPreset("system_inject")'>+ system_inject</button>
                                    <button class="msg-action" @onclick='() => AddFilterPreset("params_override")'>+ params_override</button>
                                    <button class="msg-action" @onclick='() => AddFilterPreset("regex_redact")'>+ regex_redact</button>
                                    <button class="msg-action" @onclick='() => AddFilterPreset("max_tokens_cap")'>+ max_tokens_cap</button>
                                </div>
                            </div>
                            <div class="field">
                                <label for="fld-47">@L["workspace.grants_json"]</label>
                                <textarea class="input font-mono text-sm" rows="3"
                                          placeholder="[{&quot;principal_type&quot;: &quot;*&quot;, &quot;permission&quot;: &quot;read&quot;}]"
                                          @bind="_mGrants" id="fld-47"></textarea>
                            </div>
                        }
                        else if (Kind == "tools")
                        {
                            <div class="field">
                                <label for="fld-48">@L["common.name"]</label>
                                <input class="input" @bind="_tName" id="fld-48" />
                            </div>
                            <div class="field">
                                <label for="fld-49">@L["common.description"]</label>
                                <input class="input" @bind="_tDesc" id="fld-49" />
                            </div>
                            <div class="field">
                                <label for="fld-50">@L["workspace.tool_url"]</label>
                                <input class="input" type="url" placeholder="https://…" @bind="_tUrl" id="fld-50" />
                            </div>
                            <div class="field">
                                <label for="fld-51">@L["workspace.tool_code"]</label>
                                <textarea class="input font-mono text-sm" rows="8" id="fld-51"
                                          placeholder="class Tools:&#10;    def my_func(self, arg: str) -&gt; str:&#10;        ..."
                                          @bind="_tCode"></textarea>
                                <small class="text-gray-500">@L["workspace.tool_code_hint"]</small>
                            </div>
                            <div class="field">
                                <label for="fld-52">@L["workspace.tool_spec"]</label>
                                <textarea class="input font-mono text-sm" rows="8" @bind="_tSpec" id="fld-52"></textarea>
                            </div>
                            <div class="field">
                                <label class="check"><input type="checkbox" @bind="_tEnabled" /> @L["automations.enabled"]</label>
                            </div>
                        }
                        else
                        {
                            <div class="field">
                                <label for="fld-53">@L["common.name"]</label>
                                <input class="input" @bind="_kName" id="fld-53" />
                            </div>
                            <div class="field">
                                <label for="fld-54">@L["common.description"]</label>
                                <input class="input" @bind="_kDesc" id="fld-54" />
                            </div>
                            @if (!IsCreate && _knowledge is not null)
                            {
                                <div class="field">
                                    <label>@L["workspace.files"] (@_knowledge.Files.Count)</label>
                                    <div class="card-sub">
                                        @foreach (var kf in _knowledge.Files)
                                        {
                                            <div><span aria-hidden="true">📄 </span>@kf.Filename
                                                <button class="msg-action danger" @onclick="() => RemoveFileAsync(kf)">×</button>
                                            </div>
                                        }
                                        @if (_knowledge.Files.Count == 0)
                                        {
                                            <div>@L["workspace.no_files_yet"]</div>
                                        }
                                    </div>
                                    <select aria-label="@L["workspace.select_file"]" class="input mt-2" @bind="_addFileId">
                                        <option value="">@L["workspace.add_file"]…</option>
                                        @foreach (var f in _files)
                                        {
                                            <option value="@f.Id">@f.Filename</option>
                                        }
                                    </select>
                                    <button class="msg-action mt-1" @onclick="AddFileAsync"
                                            disabled="@(string.IsNullOrEmpty(_addFileId))">@L["workspace.add_file"]</button>
                                </div>
                            }
                        }
                    </div>
                    @if (_error is not null)
                    {
                        <div class="text-sm text-red-500 mt-2">@_error</div>
                    }
                </div>
                <div class="card-actions">
                    <button class="auth-submit" @onclick="SaveAsync">@L["common.save"]</button>
                </div>
            </div>
            @if (Id is not null && ShareEntity is not null)
            {
                <ShareDialog Entity="@ShareEntity" ItemId="@Id" />
            }
        </div>
    }
</div>

@code {
    private static string? NullIfWhiteSpace(string? s) =>
        string.IsNullOrWhiteSpace(s) ? null : s;

    [Parameter] public string? Kind { get; set; }
    [Parameter] public string? Id { get; set; }

    private string? ShareEntity => Kind switch
    {
        "knowledge" => "knowledge",
        "models" => "models",
        _ => null,
    };

    private bool IsCreate => Id is null;
    private bool _loading = true;
    private bool _notFound;
    private string? _error;

    private string PageTitle =>
        (IsCreate ? L["common.new"] : L["common.edit"]) + " " + (Kind switch
        {
            "models" => L["workspace.models"],
            "tools" => "Tools",
            "knowledge" => "Knowledge",
            _ => L["workspace.prompts"],
        });

    private string _pCommand = "", _pTitle = "", _pContent = "";
    private string _mName = "", _mBase = "", _mSystem = "", _mParams = "";

    /// <summary>Insere um filtro declarativo padrão no MetaJson (campo filters).</summary>
    private void AddFilterPreset(string type)
    {
        JsonObject meta;
        try
        {
            meta = string.IsNullOrWhiteSpace(_mMeta)
                ? new JsonObject()
                : (JsonNode.Parse(_mMeta) as JsonObject) ?? new JsonObject();
        }
        catch (JsonException)
        {
            meta = new JsonObject();
        }

        JsonObject config = type switch
        {
            "system_inject" => new JsonObject
            {
                ["text"] = L["workspace.preset_inject_text"],
                ["position"] = "append",
            },
            "params_override" => new JsonObject { ["temperature"] = 0.2 },
            "regex_redact" => new JsonObject
            {
                ["pattern"] = @"\b\d{11}\b",
                ["replacement"] = "[cpf-redacted]",
                ["stage"] = "both",
            },
            _ => new JsonObject { ["max_tokens"] = 512 },
        };

        if (meta["filters"] is not JsonArray filters)
        {
            filters = new JsonArray();
            meta["filters"] = filters;
        }
        filters.Add(new JsonObject
        {
            ["type"] = type,
            ["config"] = config,
        });
        _mMeta = meta.ToJsonString();
    }
    private string _mMeta = string.Empty;
    private string _mGrants = string.Empty;
    private string _tName = "", _tDesc = "", _tUrl = "", _tSpec = "", _tCode = "";
    private bool _tEnabled = true;
    private string _kName = "", _kDesc = "", _addFileId = "";

    private List<ModelInfo> _baseModels = [];
    private List<FileResponse> _files = [];
    private KnowledgeDetailResponse? _knowledge;
    private PromptResponse? _prompt;
    private ModelEntryResponse? _model;
    private ToolResponse? _tool;

    private bool _loadFailed;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        try
        {
            await LoadCoreAsync();
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            // Offline: editor não abre — retry manual, não error UI.
            _loadFailed = true;
            await Console.Error.WriteLineAsync($"[WorkspaceItemEditor] carga falhou: {ex.Message}");
        }
        _loading = false;
    }

    private async Task LoadCoreAsync()
    {
        _notFound = false;
        _error = null;
        Kind ??= "prompts";

        if (Kind == "models")
        {
            await LoadBaseModelsAsync();
        }

        if (!IsCreate && Id is not null)
        {
            await LoadExistingAsync(Id);
        }
        else if (Kind == "knowledge")
        {
            _files = await Api.GetFilesAsync();
        }
    }

    private async Task LoadBaseModelsAsync()
    {
        _baseModels = await Api.GetModelsAsync();
        if (_baseModels.Count > 0 && string.IsNullOrEmpty(_mBase))
        {
            _mBase = _baseModels[0].Id;
        }
    }

    private async Task LoadExistingAsync(string id)
    {
        switch (Kind)
        {
            case "prompts": await LoadPromptAsync(id); break;
            case "models": await LoadModelAsync(id); break;
            case "tools": await LoadToolAsync(id); break;
            default: await LoadKnowledgeAsync(id); break;
        }
    }

    private async Task LoadPromptAsync(string id)
    {
        _prompt = await Api.GetPromptAsync(id);
        if (_prompt is null) { _notFound = true; return; }
        _pCommand = _prompt.Command; _pTitle = _prompt.Title; _pContent = _prompt.Content;
    }

    private async Task LoadModelAsync(string id)
    {
        _model = await Api.GetCustomModelAsync(id);
        if (_model is null) { _notFound = true; return; }
        _mName = _model.Name; _mBase = _model.BaseModelId ?? "";
        _mSystem = _model.SystemPrompt ?? ""; _mParams = _model.ParamsJson ?? "";
        _mMeta = _model.MetaJson ?? ""; _mGrants = _model.AccessGrantsJson ?? "";
    }

    private async Task LoadToolAsync(string id)
    {
        _tool = (await Api.GetToolsAsync()).FirstOrDefault(t => t.Id == id);
        if (_tool is null) { _notFound = true; return; }
        _tName = _tool.Name; _tDesc = _tool.Description ?? ""; _tSpec = _tool.SpecJson;
        _tCode = _tool.Code ?? ""; _tEnabled = _tool.Enabled;
    }

    private async Task LoadKnowledgeAsync(string id)
    {
        _files = await Api.GetFilesAsync();
        _knowledge = await Api.GetKnowledgeDetailAsync(id);
        if (_knowledge is null) { _notFound = true; return; }
        _kName = _knowledge.Name; _kDesc = _knowledge.Description ?? "";
    }

    private async Task SaveAsync()
    {
        _error = null;
        var ok = await SaveKindAsync();
        if (ok)
        {
            Nav.NavigateTo($"/workspace/{Kind}");
        }
        else
        {
            _error = L["common.save_failed"];
        }
    }

    /// <summary>Upsert do item em edição — dispatch por <see cref="Kind"/>.</summary>
    private Task<bool> SaveKindAsync() => Kind switch
    {
        "prompts" => SavePromptAsync(),
        "models" => SaveModelAsync(),
        "tools" => SaveToolAsync(),
        _ => SaveKnowledgeAsync(),
    };

    private async Task<bool> SavePromptAsync()
    {
        var request = new PromptUpsertRequest(
            _pCommand.Trim().TrimStart('/'), _pTitle.Trim(), _pContent);
        return IsCreate
            ? await Api.CreatePromptAsync(request) is not null
            : await Api.UpdatePromptAsync(Id!, request) is not null;
    }

    private async Task<bool> SaveModelAsync()
    {
        var request = new ModelEntryUpsertRequest(
            _mName.Trim(), _mBase, _mSystem,
            NullIfWhiteSpace(_mParams),
            IsCreate ? null : _model?.ProfileImageUrl,
            NullIfWhiteSpace(_mMeta),
            NullIfWhiteSpace(_mGrants));
        return IsCreate
            ? await Api.CreateCustomModelAsync(request) is not null
            : await Api.UpdateCustomModelAsync(Id!, request) is not null;
    }

    private async Task<bool> SaveToolAsync()
    {
        var request = new ToolUpsertRequest(
            _tName.Trim(), _tDesc, _tSpec,
            IsCreate ? NullIfWhiteSpace(_tUrl?.Trim()) : null,
            IsCreate ? NullIfWhiteSpace(_tCode) : NullIfWhiteSpace(_tCode) ?? "",
            _tEnabled);
        return IsCreate
            ? await Api.CreateToolAsync(request) is not null
            : await Api.UpdateToolAsync(Id!, request) is not null;
    }

    private async Task<bool> SaveKnowledgeAsync() => IsCreate
        ? await Api.CreateKnowledgeAsync(_kName.Trim(),
            NullIfWhiteSpace(_kDesc)) is not null
        : await Api.UpdateKnowledgeAsync(Id!, _kName.Trim(),
            NullIfWhiteSpace(_kDesc)) is not null;

    private async Task AddFileAsync()
    {
        if (!string.IsNullOrEmpty(_addFileId) && await Api.AddKnowledgeFileAsync(Id!, _addFileId))
        {
            _knowledge = await Api.GetKnowledgeDetailAsync(Id!);
            _addFileId = "";
        }
    }

    private async Task RemoveFileAsync(KnowledgeFileResponse kf)
    {
        if (await Api.RemoveKnowledgeFileAsync(Id!, kf.FileId))
        {
            _knowledge = await Api.GetKnowledgeDetailAsync(Id!);
        }
    }
}
