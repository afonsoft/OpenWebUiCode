@page "/archived"
@inject ApiService Api
@inject ChatListState ChatList
@inject LocalizationService L
@inject IJSRuntime JS
@inject DialogService Dialogs

<PageTitle>@L["page.archived"] — Open WebUI</PageTitle>

<div class="page">
    <h1 class="page-title" tabindex="-1">@L["archived.title"]</h1>
    @if (_loadFailed)
    {
        <OfflineRetry OnRetry="LoadChatsAsync" />
    }
    else if (_chats is null)
    {
        <div class="sidebar-empty">@L["common.loading"]</div>
    }
    else if (_chats.Count == 0)
    {
        <div class="sidebar-empty">@L["archived.empty"]</div>
    }
    else
    {
        <div class="card-list">
            @foreach (var chat in _chats)
            {
                <div class="card-row">
                    <div class="card-main">
                        <div class="card-title">@chat.Title</div>
                        <div class="card-sub">@L.T("archived.updated", ("date", FormatDate(chat.UpdatedAt)))</div>
                    </div>
                    <div class="card-actions">
                        <button class="msg-action" @onclick="() => UnarchiveAsync(chat)">@L["archived.unarchive"]</button>
                        <button class="msg-action danger" @onclick="() => DeleteAsync(chat)">@L["archived.delete"]</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ChatSummaryResponse>? _chats;
    private bool _loadFailed;

    protected override async Task OnInitializedAsync() => await LoadChatsAsync();

    private async Task LoadChatsAsync()
    {
        _loadFailed = false;
        try
        {
            _chats = await Api.GetArchivedChatsAsync();
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            _loadFailed = true;
            _chats = [];
            await Console.Error.WriteLineAsync($"[Archived] carga falhou: {ex.Message}");
        }
    }

    private async Task UnarchiveAsync(ChatSummaryResponse chat)
    {
        await Api.ToggleArchiveChatAsync(chat.Id);
        _chats?.Remove(chat);
        ChatList.NotifyChanged();
    }

    private async Task DeleteAsync(ChatSummaryResponse chat)
    {
        if (!await Dialogs.ConfirmAsync( L.T("archived.confirm_delete", ("name", chat.Title)), danger: true))
        {
            return;
        }

        if (await Api.DeleteChatAsync(chat.Id))
        {
            _chats?.Remove(chat);
        }
    }

    private string FormatDate(long unixSeconds) =>
        L.FormatDateTime(DateTimeOffset.FromUnixTimeSeconds(unixSeconds).LocalDateTime);
}
