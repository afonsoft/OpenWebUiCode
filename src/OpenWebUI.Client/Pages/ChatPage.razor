@page "/"
@page "/home"
@page "/c/{ChatId}"
@inject LocalizationService L

<PageTitle>@(_title)</PageTitle>

<ChatView ChatId="@ChatId" />

@code {
    /// <summary>Id do chat na rota /c/{id}; null na página inicial.</summary>
    [Parameter] public string? ChatId { get; set; }

    private string _title => ChatId is null ? "Open WebUI+Code" : $"{L["page.chat"]} — Open WebUI+Code";
}
