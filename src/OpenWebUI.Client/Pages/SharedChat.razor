@page "/s/{ShareId}"
@layout EmptyLayout
@inject ApiService Api
@inject MarkdownService Markdown
@inject LocalizationService L
@inject IJSRuntime JS

<PageTitle>@(_chat?.Title ?? L["shared.title_default"]) — Open WebUI</PageTitle>

<div class="shared-page">
    <div class="shared-card">
        @if (_loading)
        {
            <div class="sidebar-empty">@L["common.loading"]</div>
        }
        else if (_loadFailed)
        {
            <OfflineRetry OnRetry="LoadChatAsync" />
        }
        else if (_chat is null)
        {
            <div class="chat-empty">
                <div class="chat-empty-logo">Open WebUI</div>
                <div class="chat-empty-sub">@L["shared.not_found"]</div>
                <a class="auth-submit shared-back" href="/">@L["shared.back"]</a>
            </div>
        }
        else
        {
            <h1 class="shared-title" tabindex="-1">@_chat.Title</h1>
            <div class="shared-meta">
                @L.T("shared.by", ("name", _chat.User?.Name ?? L["shared.user"])) ·
                @FormatDate(_chat.UpdatedAt)
            </div>
            <div class="shared-messages" @ref="_messagesRef">
                @foreach (var message in _chat.Messages)
                {
                    <div class="message @message.Role">
                        <div class="message-avatar" aria-hidden="true">@(message.Role == "assistant" ? "◈" : "U")</div>
                        <div class="message-body">
                            <div class="message-meta">
                                @(message.Role == "assistant" ? message.Model ?? L["chat.assistant"] : _chat.User?.Name ?? L["chat.you"])
                            </div>
                            <div class="message-content">
                                @if (message.Role == "assistant")
                                {
                                    @((MarkupString)MarkdownService.ToHtml(message.Content))
                                }
                                else
                                {
                                    <span class="user-text">@message.Content</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>Id público de compartilhamento.</summary>
    [Parameter] public string ShareId { get; set; } = string.Empty;

    private SharedChatResponse? _chat;
    private bool _loading = true;
    private bool _loadFailed;
    private ElementReference _messagesRef;
    private string? _enhancedFor;

    protected override async Task OnParametersSetAsync() => await LoadChatAsync();

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // SPEC-20261019-codeblock-toolbar: shared chat ganha a mesma barra
        // (copiar/formatar/wrap); execução não existe fora da sessão do dono.
        var contentKey = _chat is null
            ? null
            : _chat.Messages.Count + ":" + _chat.UpdatedAt;
        if (contentKey is not null && contentKey != _enhancedFor)
        {
            _enhancedFor = contentKey;
            await JS.InvokeVoidAsync("openwebui.codeBlocks.enhance",
                _messagesRef, new
                {
                    run = false,
                    labels = new
                    {
                        copy = L["chat.copy"],
                        copied = L["chat.copied"],
                        format = L["chat.code.format"],
                        minify = L["chat.code.minify"],
                        wrap = L["chat.code.wrap"],
                        unwrap = L["chat.code.unwrap"],
                        run = L["chat.code.run"],
                        invalidJson = L["chat.code.invalid_json"],
                    },
                });
        }
    }

    private async Task LoadChatAsync()
    {
        _loading = true;
        _loadFailed = false;
        try
        {
            _chat = await Api.GetSharedChatAsync(ShareId);
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            _loadFailed = true;
            await Console.Error.WriteLineAsync($"[SharedChat] carga falhou: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private string FormatDate(long unixSeconds) =>
        L.FormatDateTime(DateTimeOffset.FromUnixTimeSeconds(unixSeconds).LocalDateTime);
}
