@page "/calendar"
@inject ApiService Api
@inject LocalizationService L

<PageTitle>@L["page.calendar"] — Open WebUI</PageTitle>

<div class="page">
    <div class="page-header">
        <h1 class="page-title" tabindex="-1">@MonthTitle()</h1>
        <div class="flex flex-wrap gap-2 items-center">
            <div class="flex rounded-full border border-gray-200 dark:border-gray-800 overflow-hidden text-xs">
                <button class="px-3 py-1.5 max-sm:px-4 max-sm:min-h-11 @(_layer == "events" ? "bg-gray-200 dark:bg-gray-700" : "")"
                        @onclick='() => SetLayer("events")'>@L["calendar.events"]</button>
                <button class="px-3 py-1.5 max-sm:px-4 max-sm:min-h-11 @(_layer == "automations" ? "bg-gray-200 dark:bg-gray-700" : "")"
                        @onclick='() => SetLayer("automations")'>@L["calendar.automations"]</button>
            </div>
            <button class="msg-action max-sm:min-h-11 max-sm:inline-flex max-sm:items-center" @onclick="() => ChangeMonthAsync(-1)">@L["admin.prev"]</button>
            <button class="msg-action max-sm:min-h-11 max-sm:inline-flex max-sm:items-center" @onclick="() => ChangeMonthAsync(1)">@L["admin.next"]</button>
        </div>
    </div>

    @if (_layer == "events")
    {
        <div class="card-list mb-4">
            <div class="card-row">
                <div class="card-main">
                    <div class="card-title">@L["calendar.new_event"]</div>
                    <div class="flex flex-wrap gap-2 mt-2 items-center">
                        @if (_calendars.Count == 0)
                        {
                            <input aria-label="@L["calendar.calendar_name"]" class="input w-full sm:w-48" placeholder="@L["calendar.calendar_name"]"
                                   @bind="_newCalendarName" />
                        }
                        else
                        {
                            <select aria-label="@L["calendar.calendar_name"]" class="input w-full sm:w-48" @bind="_eventCalendarId">
                                @foreach (var c in _calendars)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        }
                        <input aria-label="@L["calendar.event_title"]" class="input w-full sm:w-56" placeholder="@L["calendar.event_title"]" @bind="_eventTitle" />
                        <input aria-label="@L["calendar.event_date"]" class="input w-full sm:w-40" type="date" @bind="_eventDate" />
                        <button class="primary-btn max-sm:w-full max-sm:min-h-11" @onclick="CreateEventAsync" disabled="@_savingEvent">
                            @L["common.create"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_loading)
    {
        <div class="sidebar-empty">@L["common.loading"]</div>
    }
    else if (_loadFailed)
    {
        <OfflineRetry OnRetry="LoadAsync" />
    }
    else
    {
        <div class="grid grid-cols-7 gap-1 text-xs text-gray-500 dark:text-gray-400 mb-1">
            @for (var d = 0; d < 7; d++)
            {
                <div class="text-center py-1">@L[$"calendar.d{d}"]</div>
            }
        </div>
        <div class="mb-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.6875rem] text-gray-400 dark:text-gray-500">
            <span class="inline-flex items-center gap-1"><span class="size-1.5 rounded-full bg-blue-500" aria-hidden="true"></span>@L["calendar.today"]</span>
            @if (_layer == "events")
            {
                <span class="inline-flex items-center gap-1"><span class="size-2 rounded-full bg-purple-500" aria-hidden="true"></span>@L["calendar.has_events"]</span>
            }
            else
            {
                <span class="inline-flex items-center gap-1"><span class="size-2 rounded-full bg-green-500" aria-hidden="true"></span>@L["calendar.runs_ok"]</span>
                <span class="inline-flex items-center gap-1"><span class="size-2 rounded-full bg-red-500" aria-hidden="true"></span>@L["calendar.runs_error"]</span>
                <span class="inline-flex items-center gap-1"><span class="size-2 rounded-full bg-gray-400 dark:bg-gray-500" aria-hidden="true"></span>@L["calendar.scheduled"]</span>
            }
        </div>
        <div class="grid grid-cols-7 gap-1">
            @foreach (var cell in Cells())
            {
                @if (cell.Day == 0)
                {
                    <div class="h-16 sm:h-20"></div>
                }
                else
                {
                    var day = cell.Day;
                    var runs = RunsOn(day);
                    var scheduled = ScheduledOn(day);
                    var events = EventsOn(day);
                    var selected = _selectedDay == day;
                    <button class="h-16 sm:h-20 rounded-xl border text-left p-1 sm:p-1.5 text-sm align-top transition overflow-hidden
                            @(selected ? "border-gray-400 dark:border-gray-500" : "border-gray-200 dark:border-gray-800")
                            @(cell.Today ? "font-semibold" : "")
                            hover:border-gray-400 dark:hover:border-gray-600"
                            @onclick="() => SelectDay(day)">
                        <div class="flex items-center justify-between">
                            <span>@day</span>
                            @if (cell.Today)
                            {
                                <span class="size-1.5 rounded-full bg-blue-500" aria-hidden="true"></span>
                                <span class="sr-only">@L["calendar.today"]</span>
                            }
                        </div>
                        <div class="mt-1 flex flex-wrap gap-1" aria-hidden="true">
                            @if (_layer == "events" && events.Count > 0)
                            {
                                <span class="size-2 rounded-full bg-purple-500" title="@L["calendar.has_events"]"></span>
                            }
                            @if (_layer == "automations" && runs.Count > 0)
                            {
                                <span class="size-2 rounded-full @(runs.Any(r => r.Status != "ok") ? "bg-red-500" : "bg-green-500")"
                                      title="@(runs.Any(r => r.Status != "ok") ? L["calendar.runs_error"] : L["calendar.runs_ok"])"></span>
                            }
                            @if (_layer == "automations" && scheduled.Count > 0)
                            {
                                <span class="size-2 rounded-full bg-gray-400 dark:bg-gray-500" title="@L["calendar.scheduled"]"></span>
                            }
                        </div>
                        @if (_layer == "events" && events.Count > 0)
                        {
                            <span class="sr-only">@L["calendar.has_events"]</span>
                        }
                        @if (_layer == "automations" && runs.Count > 0)
                        {
                            <span class="sr-only">@(runs.Any(r => r.Status != "ok") ? L["calendar.runs_error"] : L["calendar.runs_ok"])</span>
                        }
                        @if (_layer == "automations" && scheduled.Count > 0)
                        {
                            <span class="sr-only">@L["calendar.scheduled"]</span>
                        }
                    </button>
                }
            }
        </div>

        @if (_selectedDay is not null)
        {
            <div class="card-list mt-4">
                <div class="card-title px-3 pt-2">@DayTitle(_selectedDay.Value)</div>
                @if (_layer == "events")
                {
                    var events = EventsOn(_selectedDay.Value);
                    @if (events.Count == 0)
                    {
                        <div class="sidebar-empty">@L["calendar.no_events"]</div>
                    }
                    else
                    {
                        @foreach (var e in events)
                        {
                            <div class="card-row">
                                <div class="card-main">
                                    <div class="card-title">@e.Title</div>
                                    <div class="card-sub">
                                        @FormatTime(e.StartTs) — @FormatTime(e.EndTs)
                                        @if (!string.IsNullOrWhiteSpace(e.Notes))
                                        {
                                            <span> · @e.Notes</span>
                                        }
                                    </div>
                                </div>
                                <div class="card-actions">
                                    <button class="msg-action" @onclick="() => DeleteEventAsync(e.Id)">
                                        @L["common.delete"]
                                    </button>
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    @if (RunsOn(_selectedDay.Value).Count == 0 && ScheduledOn(_selectedDay.Value).Count == 0)
                    {
                        <div class="sidebar-empty">@L["calendar.no_events"]</div>
                    }
                    else
                    {
                        @foreach (var s in ScheduledOn(_selectedDay.Value))
                        {
                            <div class="card-row">
                                <div class="card-main">
                                    <div class="card-title">@s.Name</div>
                                    <div class="card-sub">@L["calendar.scheduled"] · @s.ModelId</div>
                                </div>
                            </div>
                        }
                        @foreach (var r in RunsOn(_selectedDay.Value))
                        {
                            <div class="card-row">
                                <div class="card-main">
                                    <div class="card-title">@r.AutomationName</div>
                                    <div class="card-sub">
                                        @FormatTime(r.StartedAt)
                                        @if (r.Status == "ok")
                                        {
                                            <span class="text-green-500">✓</span>
                                        }
                                        else
                                        {
                                            <span class="text-red-500">✗ @r.Error</span>
                                        }
                                    </div>
                                </div>
                                @if (r.ChatId is not null)
                                {
                                    <div class="card-actions">
                                        <a class="msg-action underline" href="/c/@r.ChatId">@L["automations.open_chat"]</a>
                                    </div>
                                }
                            </div>
                        }
                    }
                }
            </div>
        }
    }
</div>

@code {
    private int _year;
    private int _month;
    private int? _selectedDay;
    private string _layer = "events";
    private bool _loading = true;
    private bool _loadFailed;
    private List<AutomationRunResponse>? _runs;
    private List<AutomationResponse> _automations = [];
    private List<CalendarResponse> _calendars = [];
    private List<CalendarEventResponse> _events = [];
    private string _newCalendarName = "Meu calendário";
    private string? _eventCalendarId;
    private string _eventTitle = string.Empty;
    private DateTime _eventDate = DateTime.Today;
    private bool _savingEvent;

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.Now;
        _year = now.Year;
        _month = now.Month;
        await LoadAsync();
    }

    private void SetLayer(string layer)
    {
        _layer = layer;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var first = new DateTimeOffset(new DateTime(_year, _month, 1, 0, 0, 0, DateTimeKind.Unspecified));
        var last = first.AddMonths(1).AddSeconds(-1);
        var from = first.ToUnixTimeSeconds();
        var to = last.ToUnixTimeSeconds();
        try
        {
            _calendars = await Api.GetCalendarsAsync();
            _eventCalendarId = _calendars.FirstOrDefault()?.Id;
            _events = await Api.GetCalendarEventsAsync(from, to);
            _automations = await Api.GetAutomationsAsync();
            _runs = await Api.GetAutomationRunsInRangeAsync(from, to);
            _loadFailed = false;
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            // Offline: grade renderiza vazia + retry manual.
            _loadFailed = true;
            await Console.Error.WriteLineAsync($"[Calendar] carga falhou: {ex.Message}");
        }
        _loading = false;
    }

    private async Task ChangeMonthAsync(int delta)
    {
        var d = new DateTime(_year, _month, 1, 0, 0, 0, DateTimeKind.Unspecified).AddMonths(delta);
        _year = d.Year;
        _month = d.Month;
        _selectedDay = null;
        await LoadAsync();
    }

    private void SelectDay(int day) => _selectedDay = _selectedDay == day ? null : day;

    private async Task CreateEventAsync()
    {
        if (string.IsNullOrWhiteSpace(_eventTitle))
        {
            return;
        }

        _savingEvent = true;
        try
        {
            var calendarId = _eventCalendarId;
            if (calendarId is null)
            {
                var created = await Api.CreateCalendarAsync(
                    string.IsNullOrWhiteSpace(_newCalendarName) ? "Meu calendário" : _newCalendarName.Trim(),
                    null);
                if (created is null)
                {
                    return;
                }
                _calendars.Add(created);
                calendarId = created.Id;
                _eventCalendarId = created.Id;
            }

            var start = new DateTimeOffset(
                DateTime.SpecifyKind(_eventDate.Date.AddHours(9), DateTimeKind.Local)).ToUnixTimeSeconds();
            var ev = await Api.CreateCalendarEventAsync(
                calendarId, _eventTitle.Trim(), start, start + 3600);
            if (ev is not null)
            {
                _events.Add(ev);
                _eventTitle = string.Empty;
            }
        }
        finally
        {
            _savingEvent = false;
        }
    }

    private async Task DeleteEventAsync(string eventId)
    {
        if (await Api.DeleteCalendarEventAsync(eventId))
        {
            _events = _events.Where(e => e.Id != eventId).ToList();
        }
    }

    private List<AutomationRunResponse> RunsOn(int day) => _runs?
        .Where(r => DateTimeOffset.FromUnixTimeSeconds(r.StartedAt).LocalDateTime.Day == day &&
                    DateTimeOffset.FromUnixTimeSeconds(r.StartedAt).LocalDateTime.Month == _month)
        .ToList() ?? [];

    private List<AutomationResponse> ScheduledOn(int day) => _automations
        .Where(a => a.NextRunAt is not null &&
                    LocalDate(a.NextRunAt.Value).Day == day &&
                    LocalDate(a.NextRunAt.Value).Month == _month &&
                    LocalDate(a.NextRunAt.Value).Year == _year)
        .ToList();

    private List<CalendarEventResponse> EventsOn(int day) => _events
        .Where(e => LocalDate(e.StartTs).Day == day &&
                    LocalDate(e.StartTs).Month == _month &&
                    LocalDate(e.StartTs).Year == _year)
        .ToList();

    private IEnumerable<(int Day, bool Today)> Cells()
    {
        var first = new DateTime(_year, _month, 1, 0, 0, 0, DateTimeKind.Unspecified);
        var days = DateTime.DaysInMonth(_year, _month);
        var today = DateTime.Today;
        for (var i = 0; i < (int)first.DayOfWeek; i++)
        {
            yield return (0, false);
        }
        for (var d = 1; d <= days; d++)
        {
            yield return (d, today.Year == _year && today.Month == _month && today.Day == d);
        }
    }

    private static DateTime LocalDate(long epoch) =>
        DateTimeOffset.FromUnixTimeSeconds(epoch).LocalDateTime;

    private string MonthTitle() => $"{MonthName(_month)} {_year}";

    private string DayTitle(int day) =>
        $"{day} {MonthName(_month).ToLowerInvariant()}";

    /// <summary>Nome do mês 1-12 via chave CSV calendar.months (traduzida em todos os locales).</summary>
    private string MonthName(int month)
    {
        var names = L["calendar.months"].Split(',');
        return month >= 1 && month <= names.Length ? names[month - 1].Trim() : month.ToString();
    }

    private static string FormatTime(long epoch) =>
        DateTimeOffset.FromUnixTimeSeconds(epoch).LocalDateTime.ToString("HH:mm");
}
