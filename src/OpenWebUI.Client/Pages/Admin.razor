    private async Task RefreshMcpAsync(McpServerResponse server)
    {
        _mcpBusy.Add(server.Id);
        _mcpTestResults.Remove(server.Id);
        try
        {
            var count = await Api.RefreshMcpServerAsync(server.Id);
            _mcpServers = await Api.GetMcpServersAsync();
        _policies = await Api.GetAdminPoliciesAsync() ?? [];
        _policyDenials = await Api.GetAdminPolicyDenialsAsync() ?? [];
            var updated = _mcpServers.FirstOrDefault(s => s.Id == server.Id);
            if (count >= 0)
            {
                _mcpTools[server.Id] = await Api.GetMcpToolsAsync(server.Id);
                _mcpTestResults[server.Id] = (true,
                    L.T("admin.mcp_tools_found", ("count", count.ToString())));
            }
            else
            {
                _mcpTestResults[server.Id] = (false,
                    updated?.LastError ?? L["settings.save_failed"]);
            }
        }
        finally
        {
            _mcpBusy.Remove(server.Id);
        }
    }

