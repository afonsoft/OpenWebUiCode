        }
    }

    private async Task SaveProvidersAsync()
    {
        var ollama = _provOllamaRows.Select(r => r.Url.Trim()).Where(u => u.Length > 0).ToList();
        var ollamaNames = _provOllamaRows.Where(r => r.Url.Trim().Length > 0)
            .Select(r => r.Name.Trim()).ToList();
        var openAiRows = _provOpenAiRows.Where(r => r.Url.Trim().Length > 0).ToList();
        var typedRows = _provTypedRows
            .Where(r => r.Url.Trim().Length > 0)
            .Select(r => new ProviderConnection(
                r.Type, r.Url.Trim(),
                r.Key.Trim().Length > 0 ? r.Key.Trim() : null,
                r.Name.Trim().Length > 0 ? r.Name.Trim() : null))
            .ToList();
        var result = await Api.UpdateConnectionsAsync(new ConnectionsConfig(
            ollama,
            openAiRows.Select(r => r.Url.Trim()).ToList(),
            openAiRows.Select(r => r.Key.Trim()).ToList(),
            ollamaNames,
            openAiRows.Select(r => r.Name.Trim()).ToList(),
            typedRows));
        _provMessage = result is null ? L["settings.save_failed"] : L["settings.saved"];
        _connections = result;
        if (result is not null)
        {
            _availableModels = await Api.GetModelsAsync();
            for (var i = 0; i < _provOpenAiRows.Count && i < result.OpenAiKeyConfigured.Count; i++)
            {
                _provOpenAiRows[i].KeyConfigured = result.OpenAiKeyConfigured[i];
                _provOpenAiRows[i].Key = string.Empty;
            }

            for (var i = 0; i < _provTypedRows.Count && result.Providers is not null && i < result.Providers.Count; i++)
            {
                _provTypedRows[i].KeyConfigured = result.Providers[i].KeyConfigured;
                _provTypedRows[i].Key = string.Empty;
            }
        }
    }

