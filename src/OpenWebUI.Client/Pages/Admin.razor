                                <input aria-label="@L["admin.function_name"]" class="input" @bind="_fnName" placeholder="@L["admin.function_name"]" />
                                <select aria-label="@L["admin.function_type"]" class="input" @bind="_fnType">
                                    <option value="filter">filter</option>
                                    <option value="pipe">pipe</option>
                                    <option value="action">action</option>
                                </select>
                                <textarea aria-label="@L["admin.function_manifest"]" class="input" rows="2" @bind="_fnManifest"
                                    placeholder="@L["admin.function_manifest"]"></textarea>
                                <textarea aria-label="@L["admin.function_valves"]" class="input" rows="2" @bind="_fnValves"
                                    placeholder="@L["admin.function_valves"]"></textarea>
                                <button class="auth-submit" @onclick="SaveFunctionAsync">@L["admin.function_add"]</button>
                            </div>
                        </div>
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@L["admin.pipelines"]</div>
                            </div>
                        </div>
                        @foreach (var pipe in _pipelineServers)
                        {
                            <div class="card-row">
                                <div class="card-main">
                                    <div class="card-title">@pipe.Name</div>
                                    <div class="card-sub">@pipe.Url @(pipe.HasKey ? "· 🔑" : "")</div>
                                </div>
                                <div class="card-actions">
                                    <button class="msg-action danger" aria-label="@L["common.delete"]" @onclick="() => DeletePipelineServerAsync(pipe)">🗑</button>
                                </div>
                            </div>
                        }
                        <div class="card-row">
                            <div class="flex flex-col gap-2 w-full text-sm py-1">
                                <input aria-label="@L["admin.pipeline_name"]" class="input" @bind="_pipeName" placeholder="@L["admin.pipeline_name"]" />
                                <input aria-label="@L["common.url"]" class="input" @bind="_pipeUrl" placeholder="http://pipelines:9099" />
                                <input aria-label="@L["admin.pipeline_key"]" class="input" type="password" @bind="_pipeKey" placeholder="@L["admin.pipeline_key"]" />
                                <button class="auth-submit" @onclick="SavePipelineServerAsync">@L["admin.pipeline_add"]</button>
                            </div>
                        </div>
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@L["admin.flags_readonly"]</div>
                                <div class="card-sub">
                                    notes: @FlagBadge(_appConfig.Features.EnableNotes) ·
                                    web search: @FlagBadge(_appConfig.Features.EnableWebSearch) ·
                                    images: @FlagBadge(_appConfig.Features.EnableImageGeneration) ·
                                    video: @FlagBadge(_appConfig.Features.EnableVideoGeneration) ·
                                    tts: @FlagBadge(_appConfig.Features.EnableTextToSpeech) ·
                                    stt: @FlagBadge(_appConfig.Features.EnableSpeechToText) ·
                                    sharing: @FlagBadge(_appConfig.Features.EnableCommunitySharing)
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        }
        else
        {
            if (_groups is null)
            {
                <div class="sidebar-empty">@L["common.loading"]</div>
            }
            else
            {
                <div class="card-row">
                    <button class="auth-submit" @onclick="AddGroupAsync">@L["admin.new_group"]</button>
                </div>
                <div class="card-list">
                    @foreach (var group in _groups)
                    {
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@group.Name</div>
                                <div class="card-sub">
                                    @(group.Description ?? L["admin.no_description"]) ·
                                    @L.T("admin.member_count", ("count", group.Members.Count.ToString())) ·
                                    sharing: @(group.Permissions.Sharing?.PublicChats == false ? "off" : "on") ·
                                    prompts: @(group.Permissions.Workspace?.Prompts == false ? "off" : "on")
                                </div>
                                @if (group.Members.Count > 0)
                                {
                                    <div class="card-sub">
                                        @string.Join(", ", group.Members.Select(m => m.Name))
                                    </div>
                                }
                            </div>
                            <div class="card-actions">
                                <button class="msg-action" @onclick="() => AddMemberAsync(group)">@L["admin.add_member"]</button>
                                <button class="msg-action" title="@L["admin.group_domains"]" aria-label="@L["admin.group_domains"]"
                                        @onclick="() => EditDomainsAsync(group)">🌐</button>
                                <button class="msg-action" @onclick="() => ToggleSharingAsync(group)">
                                    @(group.Permissions.Sharing?.PublicChats == false ? L["admin.allow_share"] : L["admin.block_share"])
                                </button>
                                <button class="msg-action danger" aria-label="@L["common.delete"]" @onclick="() => DeleteGroupAsync(group)">🗑</button>
                            </div>
                        </div>
                    }
                    @if (_groups.Count == 0)
                    {
                        <div class="sidebar-empty">@L["admin.no_groups"]</div>
                    }
                </div>
            }
        }
        </div>
        </div>
    }
</div>

