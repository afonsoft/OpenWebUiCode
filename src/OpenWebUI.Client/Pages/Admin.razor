@page "/admin"
@page "/admin/{Tab}"
@inject ApiService Api
@inject AuthService Auth
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject LocalizationService L
@inject DialogService Dialogs
@using System.Text.Json.Nodes

<PageTitle>@L["page.admin"] — Open WebUI</PageTitle>

<div class="page">
    <h1 class="page-title" tabindex="-1">@L["admin.title"]</h1>
    @if (!IsAdmin)
    {
        <div class="chat-error">@L["admin.restricted"]</div>
    }
    else
    {
        @* Mobile: pills horizontais roláveis *@
        <div class="flex lg:hidden gap-2 mb-4 border-b border-gray-200 dark:border-gray-800 pb-2 overflow-x-auto whitespace-nowrap scrollbar-hidden">
            @foreach (var item in NavItems())
            {
                <button class="text-sm px-3 py-1.5 rounded-full shrink-0 transition
                               @(_tab == item.Id ? "bg-gray-900 text-white dark:bg-gray-200 dark:text-gray-900 font-medium" : "text-gray-500 hover:text-gray-800 dark:hover:text-gray-200")"
                        @onclick="() => SetTab(item.Id)">@L[item.LabelKey]</button>
            }
        </div>

        <div class="flex gap-6">
        @* Desktop: rail de navegação lateral com ícones (padrão Devin/OpenHands) *@
        <nav class="hidden lg:flex flex-col gap-0.5 w-44 shrink-0" aria-label="@L["admin.title"]">
            @foreach (var group in NavGroups())
            {
                <div class="px-2 pt-3 pb-1 text-[0.625rem] font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500">
                    @L[group.LabelKey]
                </div>
                @foreach (var item in group.Items)
                {
                    <button class="flex items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-sm text-left transition
                                   @(_tab == item.Id
                                       ? "bg-gray-900 text-white dark:bg-gray-200 dark:text-gray-900 font-medium"
                                       : "text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-gray-100")"
                            @onclick="() => SetTab(item.Id)">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 shrink-0">
                            @((MarkupString)item.Icon)
                        </svg>
                        @L[item.LabelKey]
                    </button>
                }
            }
        </nav>

        <div class="flex-1 min-w-0">

        @if (_loadFailed)
        {
            <OfflineRetry OnRetry="LoadAdminDataAsync" />
        }

        @if (_tab == "users")
        {
            if (_users is null)
            {
                <div class="sidebar-empty">@L["common.loading"]</div>
            }
            else
            {
                <div class="card-row">
                    <button class="auth-submit" @onclick="AddUserAsync">@L["admin.new_user"]</button>
                </div>
                <div class="card-row">
                    <div class="card-main w-full flex flex-row flex-wrap gap-2 items-center">
                        <input aria-label="@L["admin.search_users"]" class="input flex-1 min-w-40" placeholder="@L["admin.search_users"]"
                               @bind="_userQuery" @bind:event="oninput"
                               @onchange="() => ReloadUsersAsync(1)" />
                        <select class="input w-auto flex-none" aria-label="@L["admin.filter_role"]" @bind="_userFilter" @bind:after="() => ReloadUsersAsync(1)">
                            <option value="">@L["admin.all_roles"]</option>
                            <option value="admin">admin</option>
                            <option value="user">user</option>
                            <option value="pending">pending</option>
                        </select>
                        <select class="input w-auto flex-none" aria-label="@L["admin.sort_by"]" @bind="_userOrderBy" @bind:after="() => ReloadUsersAsync(1)">
                            <option value="created_at">@L["admin.col_date"]</option>
                            <option value="name">@L["common.name"]</option>
                            <option value="email">@L["common.email"]</option>
                            <option value="role">Role</option>
                        </select>
                        <button class="msg-action" @onclick="ToggleDirection">
                            @(_userDirection == "desc" ? "↓" : "↑")
                        </button>
                    </div>
                </div>
                <div class="card-list">
                    @foreach (var user in _users)
                    {
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@user.Name <span class="role-badge role-@user.Role">@user.Role</span></div>
                                <div class="card-sub">@user.Email · @L.T("admin.created_at", ("date", FormatDate(user.CreatedAt)))</div>
                            </div>
                            <div class="card-actions">
                                @if (user.Role == "pending")
                                {
                                    <button class="msg-action" @onclick='() => SetRoleAsync(user, "user")'>@L["admin.approve"]</button>
                                }
                                @if (user.Role == "user")
                                {
                                    <button class="msg-action" @onclick='() => SetRoleAsync(user, "admin")'>@L["admin.make_admin"]</button>
                                }
                                @if (user.Role == "admin" && user.Id != Auth.CurrentUser?.Id)
                                {
                                    <button class="msg-action" @onclick='() => SetRoleAsync(user, "user")'>@L["admin.demote"]</button>
                                }
                                @if (user.Id != Auth.CurrentUser?.Id)
                                {
                                    <button class="msg-action" title="@L["admin.perms"]" aria-label="@L["admin.perms"]"
                                            @onclick="() => TogglePermEditorAsync(user)">🛡</button>
                                    <button class="msg-action danger" aria-label="@L["common.delete"]" @onclick="() => DeleteUserAsync(user)">🗑</button>
                                }
                            </div>
                        </div>
                        @if (_permUserId == user.Id)
                        {
                            <div class="card-row">
                                <div class="flex flex-col gap-1 w-full text-sm py-1">
                                    <div class="text-xs text-gray-500">@L["admin.perm_hint"]</div>
                                    @foreach (var (key, label) in PermFlags)
                                    {
                                        <div class="flex items-center justify-between py-0.5">
                                            <span>@label</span>
                                            <button class="msg-action" @onclick="() => CyclePermAsync(key)">
                                                @PermLabel(key)
                                            </button>
                                        </div>
                                    }
                                    <button class="auth-submit" @onclick="SavePermsAsync">@L["common.save"]</button>
                                </div>
                            </div>
                        }
                    }
                    @if (_users.Count == 0)
                    {
                        <div class="sidebar-empty">@L["admin.no_users"]</div>
                    }
                </div>
                @if (UsersTotalPages > 1)
                {
                    <div class="flex gap-2 items-center justify-center mt-3 text-sm">
                        <button class="msg-action" @onclick="() => ReloadUsersAsync(_usersPage - 1)"
                                disabled="@(_usersPage <= 1)">@L["admin.prev"]</button>
                        <span>@L.T("admin.page_of", ("page", _usersPage.ToString()), ("total", UsersTotalPages.ToString()))</span>
                        <button class="msg-action" @onclick="() => ReloadUsersAsync(_usersPage + 1)"
                                disabled="@(_usersPage >= UsersTotalPages)">@L["admin.next"]</button>
                    </div>
                }
            }
        }
        else if (_tab == "chats")
        {
            if (_adminChats is null)
            {
                <div class="sidebar-empty">@L["common.loading"]</div>
            }
            else
            {
                <div class="card-row">
                    <div class="card-main w-full">
                        <input aria-label="@L["admin.search_chats"]" class="input w-full" placeholder="@L["admin.search_chats"]"
                               @bind="_chatQuery" @bind:event="oninput"
                               @onchange="() => ReloadAdminChatsAsync(1)" />
                    </div>
                </div>
                <div class="flex flex-col gap-1">
                    @foreach (var chat in _adminChats.Items)
                    {
                        <div class="card-row">
                            <div class="card-main">
                                <div class="flex items-center gap-2 min-w-0">
                                    <span class="card-title truncate">@chat.Title</span>
                                    @if (chat.Archived)
                                    {
                                        <span class="text-xs text-gray-400">@L["chat.archived"]</span>
                                    }
                                </div>
                                <div class="card-meta">
                                    @chat.UserName &lt;@chat.UserEmail&gt; ·
                                    @L.T("admin.chats_messages", ("count", chat.MessageCount.ToString())) ·
                                    @L.FormatDateTime(DateTimeOffset.FromUnixTimeSeconds(chat.UpdatedAt).LocalDateTime)
                                </div>
                            </div>
                            <div class="card-actions">
                                <a class="msg-action" href="/c/@chat.Id" target="_blank">@L["common.open"]</a>
                            </div>
                        </div>
                    }
                    @if (_adminChats.Items.Count == 0)
                    {
                        <div class="sidebar-empty">@L["admin.no_chats"]</div>
                    }
                </div>
                @if (AdminChatsTotalPages > 1)
                {
                    <div class="flex gap-2 items-center justify-center mt-3 text-sm">
                        <button class="msg-action" @onclick="() => ReloadAdminChatsAsync(_chatsPage - 1)"
                                disabled="@(_chatsPage <= 1)">@L["admin.prev"]</button>
                        <span>@L.T("admin.page_of", ("page", _chatsPage.ToString()), ("total", AdminChatsTotalPages.ToString()))</span>
                        <button class="msg-action" @onclick="() => ReloadAdminChatsAsync(_chatsPage + 1)"
                                disabled="@(_chatsPage >= AdminChatsTotalPages)">@L["admin.next"]</button>
                    </div>
                }
            }
        }
        else if (_tab == "analytics")
        {
            if (_analytics is null)
            {
                <div class="sidebar-empty">@L["common.loading"]</div>
            }
            else
            {
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
                    <div class="rounded-2xl bg-gray-50 dark:bg-gray-850 border border-gray-100 dark:border-gray-800/50 p-4">
                        <div class="text-2xl font-medium">@_analytics.Users.Total</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">@L.T("admin.users_card", ("count", _analytics.Users.New.ToString()))</div>
                    </div>
                    <div class="rounded-2xl bg-gray-50 dark:bg-gray-850 border border-gray-100 dark:border-gray-800/50 p-4">
                        <div class="text-2xl font-medium">@TotalMessages</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">@L["admin.messages"]</div>
                    </div>
                    <div class="rounded-2xl bg-gray-50 dark:bg-gray-850 border border-gray-100 dark:border-gray-800/50 p-4">
                        <div class="text-2xl font-medium">@TotalChats</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">@L["admin.chats"]</div>
                    </div>
                    <div class="rounded-2xl bg-gray-50 dark:bg-gray-850 border border-gray-100 dark:border-gray-800/50 p-4">
                        <div class="text-2xl font-medium">@_analytics.Evaluations.Positive / @_analytics.Evaluations.Negative</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">@L["admin.evaluations"]</div>
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-3">
                    <div class="rounded-2xl bg-gray-50 dark:bg-gray-850 border border-gray-100 dark:border-gray-800/50 p-4">
                        <div class="text-sm font-medium mb-2">@L["admin.messages_per_day"]</div>
                        <BarChart Points="_analytics.Series.Messages" />
                    </div>
                    <div class="rounded-2xl bg-gray-50 dark:bg-gray-850 border border-gray-100 dark:border-gray-800/50 p-4">
                        <div class="text-sm font-medium mb-2">@L["admin.top_models"]</div>
                        @if (_analytics.Models.Count == 0)
                        {
                            <div class="sidebar-empty">@L["admin.no_data"]</div>
                        }
                        else
                        {
                            @foreach (var model in _analytics.Models)
                            {
                                <div class="flex justify-between text-sm py-1 border-b border-gray-100 dark:border-gray-800/50 last:border-0">
                                    <span class="truncate mr-2">@model.Model</span>
                                    <span class="text-gray-500">@model.Count</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        }
        else if (_tab == "evaluations")
        {
            if (_feedbacks is null)
            {
                <div class="sidebar-empty">@L["common.loading"]</div>
            }
            else if (_feedbacks.Count == 0)
            {
                <div class="sidebar-empty">@L["admin.no_feedbacks"]</div>
            }
            else
            {
                <div class="card-list overflow-x-auto">
                    <div class="grid grid-cols-[1fr_1fr_80px_1fr_110px] gap-2 px-3 py-1.5 text-xs text-gray-500 dark:text-gray-400 min-w-[540px]">
                        <span>@L["admin.col_user"]</span>
                        <span>@L["admin.col_model"]</span>
                        <span>@L["admin.col_rating"]</span>
                        <span>@L["admin.col_reason"]</span>
                        <span>@L["admin.col_date"]</span>
                    </div>
                    @foreach (var fb in PagedFeedbacks)
                    {
                        <div class="card-row min-w-[540px]">
                            <div class="grid grid-cols-[1fr_1fr_80px_1fr_110px] gap-2 w-full text-sm">
                                <span class="truncate">@fb.UserName</span>
                                <span class="truncate text-gray-500">@(fb.ModelId ?? "—")</span>
                                <span>@(fb.Rating > 0 ? "👍" : "👎")</span>
                                <span class="truncate text-gray-500">@(fb.Reason ?? "—")</span>
                                <span class="text-gray-500">@FormatDate(fb.CreatedAt)</span>
                            </div>
                        </div>
                    }
                    @if (FeedbackPages > 1)
                    {
                        <div class="flex items-center gap-3 justify-center py-2 text-sm">
                            <button class="msg-action" disabled="@(_fbPage == 0)" @onclick="() => _fbPage--">@L["admin.prev"]</button>
                            <span class="text-gray-500">@L.T("admin.page_of", ("page", (_fbPage + 1).ToString()), ("total", FeedbackPages.ToString()))</span>
                            <button class="msg-action" disabled="@(_fbPage >= FeedbackPages - 1)" @onclick="() => _fbPage++">@L["admin.next"]</button>
                        </div>
                    }
                </div>
            }
        }
        else if (_tab == "leaderboard")
        {
            if (_leaderboard is null)
            {
                <div class="sidebar-empty">@L["common.loading"]</div>
            }
            else if (_leaderboard.Count == 0)
            {
                <div class="sidebar-empty">@L["admin.no_leaderboard"]</div>
            }
            else
            {
                <div class="card-list overflow-x-auto">
                    <div class="grid grid-cols-[1fr_100px_100px_100px] gap-2 px-3 py-1.5 text-xs text-gray-500 dark:text-gray-400 min-w-[420px]">
                        <span>@L["admin.col_model"]</span>
                        <span>@L["admin.col_rating_elo"]</span>
                        <span>@L["admin.col_battles"]</span>
                        <span>@L["admin.col_wins"]</span>
                    </div>
                    @foreach (var entry in _leaderboard)
                    {
                        <div class="card-row min-w-[420px]">
                            <div class="grid grid-cols-[1fr_100px_100px_100px] gap-2 w-full text-sm">
                                <span class="truncate">@entry.ModelId</span>
                                <span>@entry.Rating.ToString("F0")</span>
                                <span>@entry.Battles</span>
                                <span>@(double.IsInteger(entry.Wins) ? entry.Wins.ToString("F0") : entry.Wins.ToString("F1"))</span>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (_tab == "policies")
        {
            <div class="card-list">
                <div class="card-row">
                    <div class="flex flex-col gap-2 w-full text-sm py-1">
                        <div class="font-medium">@L["admin.policies_new"]</div>
                        <div class="flex flex-wrap gap-2">
                            <select class="input w-44" @bind="_polAction" aria-label="@L["admin.policies_action"]">
                                @foreach (var a in PolicyActions) { <option value="@a">@a</option> }
                            </select>
                            <input class="input flex-1 min-w-40" placeholder="shell:rm *" @bind="_polResource" aria-label="@L["admin.policies_resource"]" />
                            <input class="input flex-1 min-w-40" placeholder="@L["admin.policies_note"]" @bind="_polNote" aria-label="@L["admin.policies_note"]" />
                            <button class="button-sm" @onclick="CreatePolicyAsync">@L["common.add"]</button>
                        </div>
                        <span class="field-note">@L["admin.policies_hint"]</span>
                    </div>
                </div>
                @if (_policies.Count == 0)
                {
                    <div class="card-row"><span class="text-sm text-gray-500">@L["admin.policies_empty"]</span></div>
                }
                @foreach (var st in _policies)
                {
                    <div class="card-row">
                        <div class="flex items-center gap-2 w-full text-sm">
                            <span class="shrink-0 text-xs px-2 py-0.5 rounded bg-gray-200 dark:bg-gray-700">@st.Action</span>
                            <code class="flex-1 truncate">@st.Resource</code>
                            <span class="text-gray-500 text-xs truncate">@st.Note</span>
                            <button class="msg-action" @onclick="() => DeletePolicyAsync(st.Id)">@L["common.delete"]</button>
                        </div>
                    </div>
                }
            </div>
            <div class="card-list mt-3">
                <div class="card-row">
                    <div class="flex flex-wrap items-center gap-2 w-full text-sm py-1">
                        <span class="font-medium">@L["admin.policies_simulate"]</span>
                        <select class="input w-44" @bind="_polSimAction" aria-label="@L["admin.policies_action"]">
                            @foreach (var a in PolicyActions) { <option value="@a">@a</option> }
                        </select>
                        <input class="input flex-1 min-w-40" @bind="_polSimResource" aria-label="@L["admin.policies_resource"]" />
                        <button class="button-sm" @onclick="SimulatePolicyAsync">@L["admin.policies_test"]</button>
                        @if (_polSimResult is not null)
                        {
                            <span>@(_polSimResult.Denied ? L["admin.policies_denied"] : L["admin.policies_allowed"])</span>
                        }
                    </div>
                </div>
                @if (_policyDenials.Count > 0)
                {
                    <div class="card-row"><span class="text-xs text-gray-500">@L["admin.policies_denials"]</span></div>
                    @foreach (var d in _policyDenials.Take(10))
                    {
                        <div class="card-row">
                            <div class="flex gap-2 w-full text-xs">
                                <span class="shrink-0">@d.Action</span>
                                <code class="flex-1 truncate">@d.Resource</code>
                                <span class="text-gray-500 truncate">@d.UserId</span>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else if (_tab == "config")
        {
            if (_adminConfig is null || _appConfig is null)
            {
                <div class="sidebar-empty">@L["common.loading"]</div>
            }
            else
            {
                <div class="flex gap-1 mb-3 overflow-x-auto whitespace-nowrap scrollbar-hidden">
                    @foreach (var sub in new[] { "general", "providers", "models", "features", "audio", "retrieval", "mcp", "media", "integrations" })
                    {
                        <button class="text-sm px-3 py-1.5 rounded-full shrink-0 @(_configTab == sub ? "bg-gray-200 dark:bg-gray-800" : "text-gray-500")"
                                @onclick="() => _configTab = sub">@L[$"admin.config_{sub}"]</button>
                    }
                </div>

                @if (_configTab == "general")
                {
                    <div class="card-list">
                        <div class="card-row">
                            <div class="flex flex-col gap-2 w-full text-sm py-1">
                                <label class="check"><input type="checkbox" @bind="_flagSignup" /> @L["settings.allow_signup"]</label>
                                <label class="check"><input type="checkbox" @bind="_flagLoginForm" /> @L["settings.allow_password_login"]</label>
                                <label class="check"><input type="checkbox" @bind="_flagApiKeys" /> @L["settings.allow_api_keys"]</label>
                                <label class="check"><input type="checkbox" @bind="_flagRating" /> @L["settings.enable_rating"]</label>
                                <label class="check"><input type="checkbox" @bind="_flagFolders" /> @L["settings.enable_folders"]</label>
                                <label class="check"><input type="checkbox" @bind="_flagMemories" /> @L["settings.enable_memories"]</label>
                            </div>
                        </div>
                        <div class="card-row">
                            <div class="card-main w-full flex flex-col gap-2">
                                <label class="text-sm text-gray-600 dark:text-gray-300" for="fld-27">@L["admin.webui_name"]</label>
                                <input class="input" @bind="_webUiName" id="fld-27" />
                                <label class="text-sm text-gray-600 dark:text-gray-300 mt-1" for="fld-28">@L["admin.default_role"]</label>
                                <select class="input w-40" @bind="_defaultRole" id="fld-28">
                                    <option value="pending">pending</option>
                                    <option value="user">user</option>
                                    <option value="admin">admin</option>
                                </select>
                                <label class="text-sm text-gray-600 dark:text-gray-300 mt-1" for="fld-29">@L["admin.jwt_expires"]</label>
                                <input class="input w-40" @bind="_jwtExpiresIn" placeholder="7d" id="fld-29" />
                            </div>
                        </div>
                        <div class="card-row">
                            @if (_configMessage is not null)
                            {
                                <div class="field-note">@_configMessage</div>
                            }
                            <button class="auth-submit" @onclick="SaveFlagsAsync">@L["common.save"]</button>
                        </div>
                    </div>
                }
                else if (_configTab == "providers")
                {
                    <div class="card-list">
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">Ollama</div>
                                <div class="card-sub">@L["admin.prov_ollama_sub"]</div>
                            </div>
                            <div class="card-actions">
                                <button class="button-sm" @onclick="() => _provOllamaRows.Add(new())">+ @L["common.add"]</button>
                            </div>
                        </div>
                        @for (var i = 0; i < _provOllamaRows.Count; i++)
                        {
                            var row = _provOllamaRows[i];
                            var idx = i;
                            <div class="card-row">
                                <div class="flex flex-col sm:flex-row gap-2 w-full">
                                    <input aria-label="@L["admin.prov_name"]" class="input sm:w-40" @bind="row.Name" placeholder="@L["admin.prov_name"]" />
                                    <input aria-label="URL" class="input flex-1" @bind="row.Url" placeholder="http://localhost:11434" />
                                    <div class="flex gap-2 items-center">
                                        <button class="button-sm" disabled="@_provTesting"
                                                @onclick='() => TestConnectionAsync("ollama", idx)'>@L["admin.prov_test"]</button>
                                        <button class="msg-action danger" aria-label="@L["common.delete"]" @onclick="() => _provOllamaRows.Remove(row)">🗑</button>
                                    </div>
                                </div>
                            </div>
                            @if (_provConnModels.TryGetValue(("ollama", idx), out var ollamaModels) && ollamaModels.Count > 0)
                            {
                                <div class="card-row">
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var m in ollamaModels)
                                        {
                                            <span class="role-badge">@m</span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">OpenAI-compatible</div>
                                <div class="card-sub">@L["admin.prov_openai_sub"]</div>
                            </div>
                            <div class="card-actions">
                                <button class="button-sm" @onclick="() => _provOpenAiRows.Add(new())">+ @L["common.add"]</button>
                            </div>
                        </div>
                        @for (var i = 0; i < _provOpenAiRows.Count; i++)
                        {
                            var row = _provOpenAiRows[i];
                            var idx = i;
                            <div class="card-row">
                                <div class="flex flex-col sm:flex-row gap-2 w-full">
                                    <input aria-label="@L["admin.prov_name"]" class="input sm:w-40" @bind="row.Name" placeholder="@L["admin.prov_name"]" />
