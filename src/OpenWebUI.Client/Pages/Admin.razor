    private async Task LoadProvidersAsync()
    {
        if (_connections is not null)
        {
            _provOllamaRows = _connections.OllamaBaseUrls
                .Select((u, i) => new ProvConnectionRow
                {
                    Url = u,
                    Name = _connections.OllamaNames is { } names && i < names.Count ? names[i] : "",
                }).ToList();
            _provOpenAiRows = _connections.OpenAiBaseUrls
                .Select((u, i) => new ProvConnectionRow
                {
                    Url = u,
                    Name = _connections.OpenAiNames is { } names && i < names.Count ? names[i] : "",
                    KeyConfigured = i < _connections.OpenAiKeyConfigured.Count
                        && _connections.OpenAiKeyConfigured[i],
                }).ToList();
        }
        _provTypedRows = (_connections?.Providers ?? [])
            .Select(p => new ProvTypedRow
            {
                Type = p.Type,
                Url = p.BaseUrl,
                Name = p.Name ?? string.Empty,
                KeyConfigured = p.KeyConfigured,
            })
            .ToList();
        // Sem conexão Ollama cadastrada o proxy responde 503 — evita a chamada.
        _provOllamaInstalled = _provOllamaRows.Count > 0
            ? (await Api.GetOllamaTagsAsync())?.Models.ToList() ?? []
            : [];
    }

    private void AddProvTypedRow() => _provTypedRows.Add(
        new ProvTypedRow { Url = ProviderTypes.DefaultBaseUrl(ProviderTypes.Anthropic) });

    /// <summary>Trocar o tipo recarrega o endpoint oficial quando a URL está
    /// vazia ou ainda é um default conhecido (URL custom é preservada).</summary>
    private static void OnProvTypedTypeChanged(ProvTypedRow row)
    {
        var knownDefaults = ProviderTypes.All
            .Select(ProviderTypes.DefaultBaseUrl)
            .Where(u => u.Length > 0)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (row.Url.Trim().Length == 0 || knownDefaults.Contains(row.Url.Trim().TrimEnd('/')))
        {
            row.Url = ProviderTypes.DefaultBaseUrl(row.Type);
        }
    }

    private async Task TestProvTypedConnectionAsync(ProvTypedRow row)
    {
        _provTesting = true;
        _provMessage = null;
        row.TestedModels = null;
        try
        {
            // Índice da linha dentro das conexões do mesmo tipo (contrato do endpoint).
            var sameTypeIndex = _provTypedRows
                .Where(r => r.Type == row.Type)
                .ToList()
                .IndexOf(row);
            var result = await Api.GetConnectionModelsAsync(row.Type, sameTypeIndex);
            row.TestedModels = result?.Data.Select(m => m.Id).ToList() ?? [];
            _provMessage = row.TestedModels.Count == 0
                ? L["admin.prov_test_empty"]
                : L.T("admin.prov_test_ok", ("count", row.TestedModels.Count.ToString()));
        }
        finally
        {
            _provTesting = false;
        }
    }

    private async Task TestConnectionAsync(string type, int index)
    {
        _provTesting = true;
        _provConnModels.Remove((type, index));
        _provMessage = null;
        try
        {
            var result = await Api.GetConnectionModelsAsync(type, index);
            _provConnModels[(type, index)] = result?.Data.Select(m => m.Id).ToList() ?? [];
            _provMessage = result is null || result.Data.Count == 0
                ? L["admin.prov_test_empty"]
                : L.T("admin.prov_test_ok", ("count", result.Data.Count.ToString()));
