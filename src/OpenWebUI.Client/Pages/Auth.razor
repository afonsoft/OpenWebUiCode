@page "/auth"
@layout EmptyLayout
@inject AuthService AuthService
@inject ApiService Api
@inject NavigationManager Nav
@inject LocalizationService L
@inject ThemeService Theme

<PageTitle>@L["page.auth"] — Open WebUI</PageTitle>

<div class="w-full h-screen max-h-[100dvh] text-white relative">
    <div class="w-full h-full absolute top-0 left-0 bg-white dark:bg-black"></div>

    <div class="fixed bg-transparent min-h-screen w-full flex justify-center z-10 text-black dark:text-white font-primary">
        <div class="fixed top-4 right-6">
            <select class="text-sm bg-transparent border border-gray-300 dark:border-gray-700 rounded-full px-3 py-1.5 text-gray-600 dark:text-gray-300 outline-none cursor-pointer"
                    value="@Theme.Current" @onchange="OnThemeChanged" aria-label="@L["settings.theme"]">
                <option class="text-gray-800" value="system">@L["settings.theme_system"]</option>
                <option class="text-gray-800" value="light">@L["settings.theme_light"]</option>
                <option class="text-gray-800" value="dark">@L["settings.theme_dark"]</option>
            </select>
        </div>
        <div class="w-full px-10 min-h-screen flex flex-col text-center">
            <div class="my-auto flex flex-col justify-center items-center">
                <div class="sm:max-w-md my-auto pb-10 w-full dark:text-gray-100">
                    <div class="flex justify-center mb-6">
                        <img src="assets/splash-dark.png" class="size-24 rounded-full" alt="Open WebUI" />
                    </div>

                    <div class="flex flex-col justify-center">
                        @if (!AuthService.IsAuthenticated)
                        {
                            <div class="mb-1">
                                <h1 class="text-2xl font-normal" tabindex="-1">
                                    @(_signUp ? L["auth.signup_title"] : L["auth.signin_title"]) Open WebUI
                                </h1>
                                <div class="mt-1 text-xs font-normal text-gray-600 dark:text-gray-500">
                                    @(_signUp
                                        ? L["auth.have_account"]
                                        : L["auth.no_account"])
                                    <button class="font-normal underline cursor-pointer px-1.5 -mx-1.5 py-1 -my-1" @onclick="() => SetMode(!_signUp)">
                                        @(_signUp ? L["auth.sign_in"] : L["auth.sign_up"])
                                    </button>
                                </div>
                            </div>

                            <form class="flex flex-col mt-4 text-left" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
                                @if (_signUp)
                                {
                                    <div class="mb-2">
                                        <label class="text-sm font-normal mb-1 block" for="auth-name">@L["common.name"]</label>
                                        <input id="auth-name" name="name" autocomplete="name"
                                               class="my-0.5 w-full text-sm outline-none bg-transparent placeholder:text-gray-300 dark:placeholder:text-gray-600 border-b border-gray-200 dark:border-gray-700 py-2"
                                               type="text" placeholder="@L["auth.name_placeholder"]" @bind="_name" />
                                    </div>
                                }
                                <div class="mb-2">
                                    <label class="text-sm font-normal mb-1 block" for="auth-email">@L["common.email"]</label>
                                    <input id="auth-email" name="email" autocomplete="email"
                                           class="my-0.5 w-full text-sm outline-none bg-transparent placeholder:text-gray-300 dark:placeholder:text-gray-600 border-b border-gray-200 dark:border-gray-700 py-2"
                                           type="email" placeholder="@L["auth.email_placeholder"]" @bind="_email" />
                                </div>
                                <div class="mb-2">
                                    <label class="text-sm font-normal mb-1 block" for="auth-password">@L["common.password"]</label>
                                    <input id="auth-password" name="password" autocomplete="@(_signUp ? "new-password" : "current-password")"
                                           class="my-0.5 w-full text-sm outline-none bg-transparent placeholder:text-gray-300 dark:placeholder:text-gray-600 border-b border-gray-200 dark:border-gray-700 py-2"
                                           type="password" placeholder="••••••••" @bind="_password" />
                                </div>

                                @if (_error is not null)
                                {
                                    <div class="mt-3 text-sm text-red-500" role="alert">@_error</div>
                                }

                                <div class="mt-5">
                                    <button type="submit" class="bg-gray-700/5 hover:bg-gray-700/10 dark:bg-gray-100/5 dark:hover:bg-gray-100/10 dark:text-gray-300 dark:hover:text-white transition w-full rounded-full font-normal text-sm py-2.5 disabled:opacity-50 flex justify-center cursor-pointer"
                                            disabled="@(_busy || !FormValid)">
                                        <span class="self-center">@SubmitLabel</span>
                                    </button>
                                </div>
                            </form>

                            @if (_oauthProviders.Count > 0)
                            {
                                <div class="mt-5 flex items-center gap-3">
                                    <div class="flex-1 border-t border-gray-200 dark:border-gray-700"></div>
                                    <div class="text-xs text-gray-500">@L["common.or"]</div>
                                    <div class="flex-1 border-t border-gray-200 dark:border-gray-700"></div>
                                </div>
                                <div class="mt-4 flex flex-col gap-2">
                                    @foreach (var provider in _oauthProviders)
                                    {
                                        <button class="bg-gray-700/5 hover:bg-gray-700/10 dark:bg-gray-100/5 dark:hover:bg-gray-100/10 dark:text-gray-300 dark:hover:text-white transition w-full rounded-full font-normal text-sm py-2.5 flex justify-center cursor-pointer"
                                                @onclick="() => LoginOAuth(provider)">
                                            <span class="self-center">@L.T("auth.continue_with", ("provider", ProviderLabel(provider)))</span>
                                        </button>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <div class="mb-1">
                                <div class="text-2xl font-normal">Open WebUI</div>
                                <div class="mt-1 text-xs font-normal text-gray-600 dark:text-gray-500">
                                    @L["auth.authenticated_as"] <strong>@AuthService.CurrentUser?.Email</strong>
                                </div>
                            </div>
                            <div class="mt-5">
                                <button class="bg-gray-700/5 hover:bg-gray-700/10 dark:bg-gray-100/5 dark:hover:bg-gray-100/10 dark:text-gray-300 dark:hover:text-white transition w-full rounded-full font-normal text-sm py-2.5 flex justify-center cursor-pointer"
                                        @onclick="GoToApp">@L["auth.go_to_app"]</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string SubmitLabel
    {
        get
        {
            if (_busy)
            {
                return L["auth.wait"];
            }
            return _signUp ? L["auth.create_account"] : L["auth.sign_in"];
        }
    }

    private bool _signUp;
    private bool _busy;
    private string _name = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _error;

    private bool FormValid =>
        !string.IsNullOrWhiteSpace(_email)
        && !string.IsNullOrWhiteSpace(_password)
        && (!_signUp || !string.IsNullOrWhiteSpace(_name));

    private IReadOnlyList<string> _oauthProviders = [];

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        try
        {
            var config = await Api.GetAppConfigAsync();
            _oauthProviders = config?.OAuthProviders ?? [];
        }
        catch (Exception ex) when (ClientErrors.IsTransient(ex))
        {
            // Offline: form de login continua; só os botões OAuth somem.
        }
    }

    private void LoginOAuth(string provider) =>
        Nav.NavigateTo($"/oauth/{provider}/login", forceLoad: true);

    private static string ProviderLabel(string provider) => provider switch
    {
        "google" => "Google",
        "github" => "GitHub",
        "microsoft" => "Microsoft",
        "oidc" => "SSO",
        _ => provider,
    };

    private void GoToApp() => Nav.NavigateTo("/");

    private async Task OnThemeChanged(ChangeEventArgs e) =>
        await Theme.SetAsync(e.Value?.ToString() ?? "dark");

    private void SetMode(bool signUp)
    {
        _signUp = signUp;
        _error = null;
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var error = _signUp
                ? await AuthService.SignUpAsync(_name.Trim(), _email.Trim(), _password)
                : await AuthService.SignInAsync(_email.Trim(), _password);

            if (error is null)
            {
                Nav.NavigateTo("/", replace: true);
            }
            else
            {
                _error = error;
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
