@page "/ide"
@implements IDisposable
@inject ApiService Api
@inject LocalizationService L
@inject NavigationManager Nav
@inject ThemeService Theme
@inject IdeTestRunService TestRun
@inject IJSRuntime JS

@* /ide — Web IDE (SPEC-20261009-web-ide-surface): explorer + editor CodeMirror +
   painel direito (Chat/Changes/Terminal/Jobs). Gated pela flag ide.enabled;
   exige repo vinculado (empty-state com CTA de bind). *@

@if (!_ready)
{
    <div class="flex h-full items-center justify-center text-sm text-gray-400">…</div>
}
else if (_loadFailed)
{
    @* Offline: o fetch de init falhou — painel com retry manual. *@
    <div class="flex h-full flex-col items-center justify-center gap-2 p-6">
        <h2 class="text-base font-semibold text-gray-900 dark:text-white">@L["ide.title"]</h2>
        <OfflineRetry OnRetry="LoadInitAsync" />
    </div>
}
else if (!_enabled)
{
    <div class="flex h-full flex-col items-center justify-center gap-2 p-6 text-center">
        <p class="text-sm text-gray-500">@L["ide.disabled"]</p>
    </div>
}
else if (_repo?.Repo is null)
{
    <div class="flex h-full flex-col items-center justify-center gap-3 p-6">
        <h2 class="text-base font-semibold text-gray-900 dark:text-white">@L["ide.title"]</h2>
        <p class="max-w-md text-center text-xs text-gray-500">@L["ide.bind_hint"]</p>
        <div class="w-full max-w-md rounded-lg border border-gray-200 dark:border-gray-800 p-3 text-left">
            <RepoBindingPanel BoundChanged="OnBoundChangedAsync" />
        </div>
    </div>
}
else
{
    <div class="flex h-full min-h-0 flex-col">
        <header class="flex items-center gap-2 border-b border-gray-200 dark:border-gray-800 px-2 py-1">
            <button class="msg-action lg:hidden" aria-label="@L["ide.explorer"]"
                    @onclick="() => _explorerOpen = !_explorerOpen">☰</button>
            <span class="min-w-0 flex-1 truncate text-xs font-medium text-gray-700 dark:text-gray-300">
                @_repo.Repo<span class="text-gray-400">@("@")@_repo.Branch</span>
            </span>
            @if (TestRun.Running)
            {
                @* Chip de run de testes em andamento (SPEC-20261009-ide-mentions-tests RF-004). *@
                <span class="test-running-chip">
                    <span class="inline-block size-2 animate-pulse rounded-full bg-blue-500"></span>@L["ide.tests_running"]
                </span>
            }
            <button class="msg-action" title="@L["ide.run_tests"]" aria-label="@L["ide.run_tests"]"
                    @onclick="RunTestsAsync">▶</button>
            <button class="msg-action" title="@L["common.refresh"]" aria-label="@L["common.refresh"]"
                    @onclick="RefreshSideAsync">⟳</button>
            <button class="msg-action lg:hidden" aria-label="@L["ide.panel"]"
                    @onclick="() => _panelOpen = !_panelOpen">◧</button>
        </header>

        <div class="relative flex flex-1 min-h-0">
            <IdeActivityBar Active="_sideView" DirtyCount="@(_git?.Files.Count ?? 0)"
                            Zen="_zen" OnView="OnSideView" OnZenToggle="ToggleZen" />

            @if (!_zen && _sideOpen)
            {
                <aside id="ide-side" style="width:@(_sideW)px"
                       class="shrink-0 overflow-auto border-r border-gray-200 dark:border-gray-800 max-lg:absolute max-lg:inset-y-0 max-lg:left-11 max-lg:z-30 max-lg:bg-white max-lg:dark:bg-gray-950 @(_explorerOpen ? "" : "max-lg:hidden")">
                    @if (_sideView == "scm")
                    {
                        <IdeScmView Git="_git" Checkpoints="_checkpoints" ChatId="ChatId"
                                    OnChanged="RefreshSideAsync" />
                    }
                    else
                    {
                        <IdeExplorer @ref="_explorer" Branch="@_git?.Branch" ChatId="ChatId"
                                     DirtyCount="@(_git?.Files.Count ?? 0)"
                                     OnOpenFile="OnOpenFileAsync" OnChanged="RefreshSideAsync" />
                    }
                </aside>
                <div class="ide-sash" data-ide-sash="side" data-ide-target="#ide-side"
                     data-ide-axis="x" data-ide-min="140" data-ide-max="600" role="separator"
                     aria-orientation="vertical" aria-hidden="true"></div>
            }

            <main class="flex min-w-0 flex-1 min-h-0 flex-col">
                @if (_activePath is { } activePath)
                {
                    @* Breadcrumbs do arquivo ativo (SPEC-20261011 Fase A). *@
                    <nav class="ide-crumbs" aria-label="@L["ide.breadcrumbs"]">
                        @foreach (var (seg, idx) in activePath.Split('/').Select((s, i) => (s, i)))
                        {
                            @if (idx > 0)
                            {
                                <span class="ide-crumb-sep" aria-hidden="true">›</span>
                            }
                            <span class="ide-crumb">@seg</span>
                        }
                    </nav>
                }
                <div class="relative min-w-0 flex-1 min-h-0">
                    <IdeEditor @ref="_editor" Dark="_dark" ChatId="ChatId"
                               OnSaved="RefreshSideAsync" OnActiveFileChanged="OnActiveFileChanged"
                               OnProblemsChanged="OnProblemsChanged" />
                </div>
                @if (_bottomOpen && !_zen)
                {
                    <div class="ide-sash" data-ide-sash="bottom" data-ide-target="#ide-bottom"
                         data-ide-axis="y" data-ide-grow="reverse" data-ide-min="120" data-ide-max="600"
                         role="separator" aria-orientation="horizontal" aria-hidden="true"></div>
                    <section id="ide-bottom" style="height:@(_bottomH)px" class="shrink-0">
                        <IdeBottomPanel @ref="_bottomPanel" Jobs="_jobs" Problems="_problems"
                                        OnClose="() => _bottomOpen = false"
                                        OnProblemClick="OnProblemClickAsync" OnChanged="RefreshSideAsync" />
                    </section>
                }
            </main>

            @if (!_zen && _auxOpen)
            {
                <div class="ide-sash" data-ide-sash="aux" data-ide-target="#ide-aux"
                     data-ide-axis="x" data-ide-grow="reverse" data-ide-min="180" data-ide-max="640"
                     role="separator" aria-orientation="vertical" aria-hidden="true"></div>
                <aside id="ide-aux" style="width:@(_auxW)px"
                       class="shrink-0 overflow-auto border-l border-gray-200 dark:border-gray-800 max-lg:absolute max-lg:inset-y-0 max-lg:right-0 max-lg:z-30 max-lg:bg-white max-lg:dark:bg-gray-950 @(_panelOpen ? "" : "max-lg:hidden")">
                    <IdeRightPanel ChatId="ChatId"
                                   ActiveFile="@_activePath" OnChanged="RefreshSideAsync" />
                </aside>
            }
        </div>

        <IdeStatusBar Branch="@_git?.Branch" DirtyCount="@(_git?.Files.Count ?? 0)"
                      Errors="_errCount" Warnings="_warnCount" Language="@LangFor(_activePath)"
                      OnScmClick="OnScmClicked" OnProblemsClick="OpenProblemsPanel"
                      OnTogglePanel="() => _bottomOpen = !_bottomOpen" />

        @* Quick Open / Command Palette (SPEC-20261011-ide-editor-core Fase B). *@
        @if (_qoOpen)
        {
            <IdeQuickOpen Seed="_qoSeed" Files="_qoFiles" Commands="_qoCommands" Symbols="_qoSymbols"
                          OnClose="() => _qoOpen = false"
                          OnPickFile="OnQoFileAsync" OnPickCommand="OnQoCommandAsync"
                          OnPickLine="OnQoLineAsync" OnPickSymbol="OnQoSymbolAsync" />
        }
    </div>
}

@code {
    private bool _ready;
    private bool _enabled;
    private bool _loadFailed;
    private WorkspaceRepoResponse? _repo;
    private WorkspaceGitResponse? _git;
    private List<ChatJobResponse> _jobs = [];
    private IReadOnlyList<WorkspaceCheckpointItem> _checkpoints = [];
    /// <summary>Chat cujo binding resolve o workspace da IDE (?chatId= — SPEC-20261010-workspace-chatid-scope).</summary>
    [Parameter, SupplyParameterFromQuery] public string? ChatId { get; set; }

    private IdeExplorer? _explorer;
    private IdeEditor? _editor;
    private IdeBottomPanel? _bottomPanel;
    private string? _activePath;
    private bool _explorerOpen = true;
    private bool _panelOpen;
    private bool _dark;
    private Timer? _poll;
    // Workbench (SPEC-20261011-ide-workbench Fase A): views/toggles/sashes.
    private string _sideView = "explorer";
    private bool _sideOpen = true;
    private bool _auxOpen = true;
    private bool _bottomOpen;
    private bool _zen;
    private int _sideW = 224;
    private int _auxW = 288;
    private int _bottomH = 220;
    private IReadOnlyList<LspDiagnosticItem> _problems = [];
    private int _errCount;
    private int _warnCount;
    private DotNetObjectReference<Ide>? _selfRef;
    // Quick Open (Fase B): estado + caches lazy.
    private bool _qoOpen;
    private string _qoSeed = "";
    private IReadOnlyList<string> _qoFiles = [];
    private IReadOnlyList<IdeQuickOpen.IdeCommand> _qoCommands = [];
    private IReadOnlyList<IdeQuickOpen.IdeSymbol> _qoSymbols = [];
    private bool _filesLoaded;

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync() => await LoadInitAsync();

    /// <summary>Fetch inicial (flag + repo) — falha de rede vira estado
    /// degradado com retry, nunca a blazor-error-ui.</summary>
    private async Task LoadInitAsync()
    {
        try
        {
            _enabled = await Api.GetIdeEnabledAsync();
            if (_enabled)
            {
                // ?chatId= → binding efetivo do chat (chat → user → none).
                _repo = ChatId is null
                    ? await Api.GetWorkspaceRepoAsync()
                    : (await Api.GetChatWorkspaceRepoAsync(ChatId))?.Binding;
                TestRun.ChatId = ChatId;
            }
            _loadFailed = false;
        }
        catch (HttpRequestException ex)
        {
            _loadFailed = true;
            await Console.Error.WriteLineAsync($"[Ide] init falhou: {ex.Message}");
        }
        _ready = true;
    }

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // _repo pode chegar depois do primeiro render (empty-state → bind):
        // inicia o polling na primeira render em que existir repo vinculado.
        if (_repo is not null && _poll is null)
        {
            _dark = Theme.Current == "dark";
            // Atalhos globais + restaura sashes persistidos (Fase A).
            _selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("owuiIdeLayout.attachKeys", _selfRef);
            _sideW = await SashAsync("side", _sideW);
            _auxW = await SashAsync("aux", _auxW);
            _bottomH = await SashAsync("bottom", _bottomH);
            await RefreshSideAsync();
            _poll = new Timer(_ => _ = RefreshSideAsync(), null,
                TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
        }
    }

    private async Task<int> SashAsync(string key, int fallback)
    {
        var v = await JS.InvokeAsync<string?>("owuiIdeLayout.sashValue", key);
        return int.TryParse(v, out var n) && n > 0 ? n : fallback;
    }

    /// <summary>Atalho global vindo do JS (Ctrl+B/J/` e chord Ctrl+K Z).</summary>
    [JSInvokable]
    public Task OnLayoutKey(string what)
    {
        switch (what)
        {
            case "side": _sideOpen = !_sideOpen; _explorerOpen = _sideOpen; break;
            case "bottom": _bottomOpen = !_bottomOpen; break;
            case "terminal":
                _bottomOpen = true;
                _bottomPanel?.ShowTab("terminal");
                break;
            case "zen": _zen = !_zen; break;
            // Fase B: quick open / palette / goto line / goto symbol.
            case "quickopen": OpenQuickOpen(""); break;
            case "palette": OpenQuickOpen(">"); break;
            case "gotoline": OpenQuickOpen(":"); break;
            case "symbol": OpenQuickOpen("@"); break;
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    // ---------- Quick Open / Command Palette (SPEC-20261011-ide-editor-core) ----------

    /// <summary>Abre o Quick Open com o seed do modo; carrega a lista de arquivos lazy.</summary>
    private void OpenQuickOpen(string seed)
    {
        _qoSeed = seed;
        _qoOpen = true;
        BuildCommands();
        if (_editor is not null)
        {
            _qoSymbols = _editor.GetSymbols()
                .Select(s => new IdeQuickOpen.IdeSymbol(s.Line, s.Label)).ToList();
        }
        if (!_filesLoaded)
        {
            _ = LoadFileListAsync();
        }
    }

    /// <summary>Walk recursivo da tree API (depth 3 por chamada, dirs comum) — cap 4000.</summary>
    private async Task LoadFileListAsync()
    {
        var files = new List<string>();
        try
        {
            await WalkDirAsync("", files, 0);
        }
        catch (HttpRequestException)
        {
            /* offline — lista fica vazia, quick open segue funcional */ 
        }
        _qoFiles = files;
        _filesLoaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task WalkDirAsync(string dir, List<string> files, int depth)
    {
        if (files.Count >= 4000 || depth > 10)
        {
            return;
        }
        var tree = await Api.GetWorkspaceTreeAsync(dir, 3, chatId: ChatId);
        if (tree is null)
        {
            return;
        }
        foreach (var e in tree.Entries)
        {
            if (files.Count >= 4000)
            {
                return;
            }
            if (e.Type == "file")
            {
                files.Add(e.Path);
            }
            else if (e.Type == "dir" && !e.Collapsed)
            {
                await WalkDirAsync(e.Path, files, depth + 1);
            }
        }
    }

    /// <summary>Lista da paleta — labels localizadas, ids estáveis.</summary>
    private void BuildCommands() => _qoCommands =
    [
        new("save", L["ide.cmd_save"]),
        new("save_all", L["ide.cmd_save_all"]),
        new("run_tests", L["ide.run_tests"]),
        new("toggle_sidebar", L["ide.cmd_toggle_sidebar"]),
        new("toggle_panel", L["ide.toggle_bottom"]),
        new("toggle_aux", L["ide.cmd_toggle_aux"]),
        new("toggle_zen", L["ide.zen_mode"]),
        new("goto_line", L["ide.goto_line"]),
        new("close_all", L["ide.tab_close_all"]),
        new("toggle_autosave", L["ide.cmd_autosave"]),
    ];

    private async Task OnQoFileAsync(string path)
    {
        _activePath = path;
        if (_editor is not null)
        {
            await _editor.OpenFileAsync(path, preview: false);
        }
    }

    private async Task OnQoLineAsync(int line)
    {
        if (_editor is not null)
        {
            await _editor.GotoLineAsync(line - 1, 0);
        }
    }

    private async Task OnQoSymbolAsync(int line)
    {
        if (_editor is not null)
        {
            await _editor.GotoLineAsync(line - 1, 0);
        }
    }

    /// <summary>Ação da Command Palette.</summary>
    private async Task OnQoCommandAsync(string id)
    {
        switch (id)
        {
            case "save":
                if (_editor is not null) { await _editor.SaveAsync(); }
                break;
            case "save_all":
                if (_editor is not null) { await _editor.SaveAllAsync(); }
                break;
            case "run_tests": await RunTestsAsync(); break;
            case "toggle_sidebar": _sideOpen = !_sideOpen; _explorerOpen = _sideOpen; break;
            case "toggle_panel": _bottomOpen = !_bottomOpen; break;
            case "toggle_aux": _auxOpen = !_auxOpen; _panelOpen = _auxOpen; break;
            case "toggle_zen": _zen = !_zen; break;
            case "goto_line": OpenQuickOpen(":"); break;
            case "close_all":
                if (_editor is not null) { await _editor.CloseAllTabsAsync(); }
                break;
            case "toggle_autosave":
                if (_editor is not null) { await _editor.ToggleAutosaveAsync(); }
                break;
        }
        StateHasChanged();
    }

    private void OnSideView(string view)
    {
        _sideView = view;
        _sideOpen = true;
        _explorerOpen = true;
    }

    private void OnScmClicked() => OnSideView("scm");

    private void ToggleZen() => _zen = !_zen;

    private Task OnActiveFileChanged(string? path)
    {
        _activePath = path;
        return Task.CompletedTask;
    }

    private Task OnProblemsChanged(IReadOnlyList<LspDiagnosticItem> problems)
    {
        _problems = problems;
        _errCount = problems.Count(p => p.Severity == 1);
        _warnCount = problems.Count(p => p.Severity != 1);
        return Task.CompletedTask;
    }

    private void OpenProblemsPanel()
    {
        _bottomOpen = true;
        _bottomPanel?.ShowTab("problems");
    }

    /// <summary>Clique num problema → abre o arquivo e pula pra linha.</summary>
    private async Task OnProblemClickAsync(LspDiagnosticItem p)
    {
        if (_editor is not null)
        {
            await _editor.OpenFileAsync(p.Path);
            await _editor.GotoLineAsync(p.Line, p.Col);
        }
    }

    private static string? LangFor(string? path) => path?.Split('.').LastOrDefault() switch
    {
        "cs" => "C#",
        "razor" or "cshtml" => "Razor",
        "js" => "JavaScript",
        "ts" => "TypeScript",
        "json" => "JSON",
        "md" => "Markdown",
        "css" => "CSS",
        "html" or "htm" => "HTML",
        "py" => "Python",
        "xml" or "csproj" or "slnx" => "XML",
        "yml" or "yaml" => "YAML",
        "sh" => "Shell",
        { Length: > 0 } ext => ext.ToUpperInvariant(),
        _ => null,
    };

    private Task OnBoundChangedAsync(WorkspaceRepoResponse? bound) => ReloadAsync();

    private async Task ReloadAsync()
    {
        await LoadInitAsync();
        _dark = Theme.Current == "dark";
        await RefreshSideAsync();
    }

    private async Task OnOpenFileAsync(string path)
    {
        _activePath = path;
        _explorerOpen = false;
        if (_editor is not null)
        {
            await _editor.OpenFileAsync(path);
        }
    }

    /// <summary>Refresh do lado direito (git + jobs) + badge do explorer.</summary>
    private async Task RefreshSideAsync()
    {
        try
        {
            _git = await Api.GetWorkspaceGitAsync(ChatId);
            _jobs = await Api.GetJobsAsync(all: true);
            _checkpoints = await Api.GetCheckpointsAsync(ChatId);
        }
        catch (HttpRequestException ex)
        {
            // Offline: mantém o último snapshot; o timer retenta sozinho.
            await Console.Error.WriteLineAsync($"[Ide] refresh falhou: {ex.Message}");
        }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Botão ▶ do header — inicia o test run (RF-004).</summary>
    private Task RunTestsAsync() => TestRun.StartAsync();

    /// <inheritdoc/>
    protected override void OnInitialized() => TestRun.Changed += OnTestRunChanged;

    private void OnTestRunChanged() => _ = InvokeAsync(StateHasChanged);

    /// <inheritdoc/>
    public void Dispose()
    {
        TestRun.Changed -= OnTestRunChanged;
        _poll?.Dispose();
        _ = JS.InvokeVoidAsync("owuiIdeLayout.detachKeys");
        _selfRef?.Dispose();
    }
}
