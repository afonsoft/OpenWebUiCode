<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Novell.Directory.Ldap.NETStandard" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenWebUI.Domain\OpenWebUI.Domain.csproj" />
    <ProjectReference Include="..\OpenWebUI.Application\OpenWebUI.Application.csproj" />
    <!-- Expõe helpers internos (ex.: RagService.Cosine/L2Norm) aos testes. -->
    <InternalsVisibleTo Include="OpenWebUI.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Catálogo estático de capacidades por modelo (SPEC-20261013-model-roles). -->
    <EmbeddedResource Include="Services\model-capabilities.json" />
    <!-- Prompt do revisor de run (SPEC-20261013-run-advisor). -->
    <EmbeddedResource Include="prompts\advisor-system.md" />
    <EmbeddedResource Include="agents\*.agent.md" />
  </ItemGroup>

</Project>
